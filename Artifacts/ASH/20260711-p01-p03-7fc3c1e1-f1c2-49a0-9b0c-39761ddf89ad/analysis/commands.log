# Normalized reproducibility record. Substitute the three placeholders below.
REPOSITORY=<repository-root>
INSTRUCTIONS=<instruction-package>
RUNTIME="$REPOSITORY/Artifacts/ASH/.20260711-p01-p03-7fc3c1e1-f1c2-49a0-9b0c-39761ddf89ad.partial/runtime"

cd "$REPOSITORY"
rg -n "ASHTelemetry|telemetry\.|beginStage|endStage|recordGPUTime|recordState|recordMessage|recordOperator|recordDecode|recordCandidateCount|increment" Mirmir MirmirTests -g '*.swift'
rg -n "snapshot\(\)|telemetry\.finish|JSONEncoder|ASHTelemetrySnapshot|recordGPUTime|fullFrameGPUReadbacks|commandBufferErrors|inFlightFrames|temporalFuse|reopenVerify" Mirmir MirmirTests -g '*.swift'
nl -ba Mirmir/Modules/Telemetry/ASHTelemetryCatalog.swift
nl -ba Mirmir/Modules/Telemetry/ASHTelemetryRecorder.swift
nl -ba Mirmir/Modules/UpscalerEngine/DefaultUpscalerEngineService.swift
nl -ba Mirmir/Modules/UpscalerEngine/ASH/ASHDeterministicUpscaleBackend.swift
nl -ba Mirmir/Modules/UpscalerEngine/ASH/ASHTileProcessing.swift
nl -ba Mirmir/Modules/UpscalerEngine/ASH/ASHReferencePipeline.swift
nl -ba Mirmir/Modules/UpscalerEngine/ASH/ASHBranchTree.swift
nl -ba Mirmir/Modules/UpscalerEngine/ASH/ASHReconstruction.swift
nl -ba Mirmir/Modules/UpscalerEngine/ASH/ASHReconstructionHelpers.swift
nl -ba Mirmir/Modules/UpscalerEngine/ASH/ASHState.swift
nl -ba Mirmir/Modules/MediaPipeline/AVFoundationMediaPipeline.swift
nl -ba Mirmir/Modules/MediaPipeline/AtomicMediaOutput.swift
nl -ba Mirmir/Modules/UpscalerEngine/LanczosPolishPass.swift

xmllint --noout "$RUNTIME/production-time-profile.xml" "$RUNTIME/production-time-profiler-toc.xml"
shasum -a 256 "$RUNTIME/production-time-profile.xml" "$RUNTIME/production-time-profiler-toc.xml" "$RUNTIME/telemetry.json" "$RUNTIME/production-trace-config.json"
/usr/bin/python3 /tmp/mirmir-p01-evidence-draft/aggregate_time_profile.py "$RUNTIME/production-time-profile.xml" "$RUNTIME/production-time-profiler-toc.xml" --repository-root "$REPOSITORY"
xcrun xcresulttool get test-results summary --path "$REPOSITORY/Artifacts/ASH/.20260711-p01-p03-7fc3c1e1-f1c2-49a0-9b0c-39761ddf89ad.partial/tests/full-debug-pass.xcresult"
xcrun xcresulttool get test-results tests --path "$REPOSITORY/Artifacts/ASH/.20260711-p01-p03-7fc3c1e1-f1c2-49a0-9b0c-39761ddf89ad.partial/tests/full-debug-pass.xcresult"
xcrun xcresulttool get test-results summary --path "$RUNTIME/production-optimized-debug-2.xcresult"

/usr/bin/python3 -m json.tool /tmp/mirmir-p01-evidence-draft/call-graph.json
/usr/bin/python3 -m json.tool /tmp/mirmir-p01-evidence-draft/synchronization-inventory.json
/usr/bin/python3 -m json.tool /tmp/mirmir-p01-evidence-draft/failure-patterns.json
/usr/bin/python3 -m json.tool /tmp/mirmir-p01-evidence-draft/telemetry-coverage.json
/usr/bin/python3 -m json.tool /tmp/mirmir-p01-evidence-draft/production-time-profile-aggregation.json

# Locked final-schema audit of the successful recorder artifact.
/usr/bin/python3 -m jsonschema -i "$RUNTIME/telemetry.json" "$INSTRUCTIONS/schemas/telemetry.schema.json"

rg -ni -f <(jq -r '.scan_patterns[]' "$INSTRUCTIONS/config/attribution_policy.json") /tmp/mirmir-p01-evidence-draft
find /tmp/mirmir-p01-evidence-draft -maxdepth 1 -type f -print0 | sort -z | xargs -0 shasum -a 256
