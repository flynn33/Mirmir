{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mirmir.local/schemas/development-mapping.schema.json",
  "allOf": [
    {"$ref": "p05-common.schema.json#/$defs/artifact"},
    {
      "properties": {
        "artifact_type": {"const": "development-mapping"},
        "data": {
          "required": ["mapping_id", "mapping_sha256", "valid_state_count", "invalid_state_count", "thresholds", "range_vectors"],
          "properties": {
            "mapping_id": {"const": "ash-video-mapping-v2"},
            "mapping_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
            "valid_state_count": {"const": 256},
            "invalid_state_count": {"const": 256},
            "thresholds": {"type": "object"},
            "range_vectors": {"type": "array", "minItems": 8}
          }
        }
      }
    }
  ]
}

