{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mirmir.local/schemas/coordinate-comparison.schema.json",
  "allOf": [
    {"$ref": "p05-common.schema.json#/$defs/artifact"},
    {
      "properties": {
        "artifact_type": {"const": "coordinate-comparison"},
        "data": {
          "required": ["coordinate_policy_count", "route_count", "progressive_chroma_siting_count", "route_policy_records", "luma_route_policy_records", "siting_route_policy_records", "siting_corrected_phase_cardinality_pass", "identity_vectors", "ramp_vectors", "border_vectors"],
          "properties": {
            "coordinate_policy_count": {"const": 2},
            "route_count": {"const": 2},
            "progressive_chroma_siting_count": {"const": 6},
            "route_policy_records": {"type": "array", "minItems": 4, "maxItems": 4},
            "luma_route_policy_records": {"type": "array", "minItems": 4, "maxItems": 4, "uniqueItems": true},
            "siting_route_policy_records": {"type": "array", "minItems": 24, "maxItems": 24, "uniqueItems": true},
            "siting_corrected_phase_cardinality_pass": {"const": true},
            "identity_vectors": {"type": "array", "minItems": 16, "maxItems": 16},
            "ramp_vectors": {"type": "array", "minItems": 4, "maxItems": 4},
            "border_vectors": {"type": "array", "minItems": 2, "maxItems": 2}
          }
        }
      }
    }
  ]
}
