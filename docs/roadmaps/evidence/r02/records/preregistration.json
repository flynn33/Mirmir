  "stop_rules": [
    {
      "description": "Stop this preregistered run if the local R01 closure commit or tree binding changes.",
      "id": "identity_drift"
    },
    {
      "description": "Stop if a fixture, schema, generator, or catalog byte changes without a new preregistration.",
      "id": "fixture_or_schema_drift"
    },
    {
      "description": "Stop closure when frame order, dimensions, PTS, duration, audio, or metadata identity differs.",
      "id": "media_contract_violation"
    },
    {
      "description": "Stop closure on session serialization, reset, finish, cancellation, or resource-lifetime violation.",
      "id": "lifecycle_violation"
    },
    {
      "description": "Stop closure on backend-local fallback, unlinked fallback, or any other silent substitution.",
      "id": "silent_fallback"
    },
    {
      "description": "Stop closure when an outcome lacks backend, revision, configuration, policy, model or not-required, asset, fallback, or ASH decision identity.",
      "id": "incomplete_identity"
    },
    {
      "description": "Stop closure if production composition can reach an R02 fixture or retained comparator backend.",
      "id": "production_reachability"
    },
    {
      "description": "Stop closure if reopen verification or atomic publication behavior is bypassed.",
      "id": "publication_boundary"
    },
    {
      "description": "Stop any hardware, simulator, runtime-support, performance, memory, or quality claim not directly measured and bound to evidence.",
