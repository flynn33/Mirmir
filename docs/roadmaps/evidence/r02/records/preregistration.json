    "lifecycle_requirements": [
      {
        "description": "AppleUpscaleBackend is Sendable, exposes immutable structured identity and explicit capability lookup, and asynchronously creates a session from validated configuration and context.",
        "id": "backend_creation"
      },
      {
        "description": "AppleUpscaleSession is actor-isolated and serializes submit, reset, finish, and cancel through one FIFO operation boundary despite actor reentrancy.",
        "id": "actor_isolation"
      },
      {
        "description": "Every admitted frame retains the complete frozen frame contract until a typed outcome transfers or releases ownership.",
        "id": "frame_ownership"
      },
      {
        "description": "Every output is exactly processed, unavailable, rejected, failed, or fallback-applied and carries complete structured processing identity.",
        "id": "typed_outcomes"
      },
      {
        "description": "Reset drains earlier work, clears temporal history, advances history generation, and preserves clip-global sequence numbering.",
        "id": "reset_semantics"
      },
      {
        "description": "Cancellation is idempotent, closes admission, rejects queued work, waits for active work to quiesce, and releases resources exactly once.",
        "id": "cancel_semantics"
      },
      {
        "description": "Finish installs an admission fence, drains ordered work, finalizes once, caches its result, and rejects later mutation.",
        "id": "finish_semantics"
      },
      {
        "description": "Fallback is selected only by the planner or orchestrator and visibly links the failed route to the selected route.",
        "id": "fallback_visibility"
      }
    ],
    "outcome_vocabulary": [
      "processed",
      "unavailable",
      "rejected",
      "failed",
      "fallback_applied"
    ],
    "planner_contract": "exactly_one_primary_deterministic_order_explicit_fallback",
    "processing_identity_fields": [
      "backend_id",
      "backend_revision",
      "model_assets_identity",
      "configuration_identity",
      "policy_identity",
      "fallback_history",
      "material_decision_identity"
    ],
    "production_composition": "unavailable",
    "scenarios": [
      {
        "description": "Concurrent submissions reach the driver in FIFO order with maximum driver concurrency one.",
        "id": "concurrent_fifo"
      },
      {
        "description": "A suspended driver call cannot be bypassed by actor reentrancy.",
        "id": "actor_reentrancy"
      },
      {
        "description": "Reset orders after earlier submissions and before later submissions while clearing history.",
        "id": "reset_ordering"
      },
      {
        "description": "Finish drains admitted work, installs a fence, and finalizes the driver once.",
        "id": "finish_drain_and_fence"
      },
      {
        "description": "Cancellation closes admission, cancels active work, rejects queued work, and terminalizes once.",
        "id": "active_cancel"
      },
      {
        "description": "A late success from cancelled work cannot reopen or mutate the terminal session.",
        "id": "stale_completion"
      },
      {
        "description": "Every input and output lifetime token releases exactly once on success, failure, rejection, and cancellation paths.",
        "id": "resource_lifetime"
      },
      {
        "description": "Duplicate sequence, nonmonotonic PTS, and invalid duration reject before reaching the driver.",
        "id": "sequence_and_timing"
      },
      {
        "description": "Exactly one primary stage is selected and stage order is deterministic.",
        "id": "planner_determinism"
      },
      {
        "description": "Fallback is explicit and links failed and selected route identities without backend-local substitution.",
        "id": "fallback_linkage"
      },
      {
        "description": "Both deterministic fixture backends use the same session contract and preserve dimensions, frame order, PTS, and duration.",
        "id": "multiple_backend_fixture"
      },
      {
        "description": "Audio and metadata fixture identities are preserved by the media transaction.",
        "id": "audio_metadata_identity"
      },
      {
        "description": "Output is reopened and verified before publication.",
        "id": "reopen_verification"
      },
      {
        "description": "Cancellation or verification failure prevents atomic destination publication.",
        "id": "atomic_publication"
      },
      {
        "description": "Production dependency composition remains the unavailable upscaler service.",
        "id": "production_unavailable"
      }
    ],
