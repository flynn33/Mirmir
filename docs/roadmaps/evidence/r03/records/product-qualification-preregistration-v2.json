  "checks": [
    {"id": "historical_v1_preserved", "description": "Keep the blocked R03 v1 preregistration, catalog, and conformance byte-exact and historical."},
    {"id": "schema_bindings_exact", "description": "Bind every additive v2 schema by repository path, size, and SHA-256."},
    {"id": "fixture_catalog_binding_exact", "description": "Bind the route-compatible v2 catalog exactly."},
    {"id": "candidate_identity_exact", "description": "Permit only r03.mps.lanczos capability A11 as the primary functional product candidate."},
    {"id": "genuine_mps_execution_observed", "description": "Require observed MPSImageLanczosScale execution rather than source presence or a fixture alias."},
    {"id": "both_routes_observed", "description": "Require exact 720p-to-1080p and 1080p-to-2160p route execution."},
    {"id": "three_repeat_single_hash", "description": "Require runs one through three and one logical output hash for each route and media transaction."},
    {"id": "format_and_color_exact", "description": "Require exact 420v BT.709 video-range left-chroma output."},
    {"id": "timing_and_metadata_exact", "description": "Require exact frame order, PTS, duration, and metadata identity."},
    {"id": "media_transaction_exact", "description": "Require the R03-owned 1920x1080-to-3840x2160 three-frame H.264/AAC transaction, reopen, and atomic publication."},
    {"id": "lifecycle_and_lifetime_exact", "description": "Require the common session lifecycle and exactly-once input/output release."},
    {"id": "processing_identity_and_no_fallback_exact", "description": "Require complete route-specific processing identities and empty fallback history."},
    {"id": "source_test_artifact_bindings_exact", "description": "Require exact post-implementation source, test, and raw artifact bindings in the execution receipt."},
    {"id": "toolchain_complete", "description": "Require the complete source-bound Xcode, Swift, SDK, destination, command, OS, and architecture fields."},
    {"id": "metric_matrix_exact", "description": "Require all 23 legacy metric identities in their frozen order."},
    {"id": "functional_metric_floors_pass", "description": "Derive every applicable functional, session, media, repeatability, and lifecycle floor from measured values."},
    {"id": "nonapplicable_metric_reasons_exact", "description": "Allow only preregistered reasons for non-identical parity and no-claim perceptual or performance metrics."},
    {"id": "observation_status_truthful", "description": "Keep hardware and operator observation not observed and record simulator use consistently with the execution platform."},
    {"id": "decision_derived_from_receipt", "description": "Reject any product-qualified decision that is not exactly derived from a complete bound receipt."},
    {"id": "authorization_boundary_preserved", "description": "Keep R03 in progress with default, Auto, holdout, acceptance, quality, performance, publication, and release disabled or unclaimed."}
  ],
  "stop_rules": [
    {"id": "v1_history_drift", "description": "Stop on any byte drift in the bound blocked R03 v1 evidence."},
    {"id": "v2_contract_drift", "description": "Stop on schema, preregistration, catalog, or binding drift."},
    {"id": "candidate_or_identity_drift", "description": "Stop any candidate, capability, framework, route, policy, material, or configuration identity drift."},
    {"id": "nongenuine_framework_path", "description": "Stop source presence, copy, placeholder, reference, or fixture-alias evidence in place of genuine MPS execution."},
    {"id": "route_or_repeatability_failure", "description": "Stop missing routes, wrong dimensions, wrong run ordinals, or more than one logical hash per three repeats."},
    {"id": "media_contract_failure", "description": "Stop H.264/AAC, frame order, PTS, duration, metadata, reopen, or atomic-publication deviation."},
    {"id": "format_lifecycle_or_fallback_failure", "description": "Stop format, color, lifecycle, lifetime, processing-identity, or fallback deviation."},
    {"id": "binding_or_toolchain_failure", "description": "Stop missing, unbound, private-path, or mismatched source, test, artifact, toolchain, commit, or tree evidence."},
    {"id": "metric_matrix_or_floor_failure", "description": "Stop missing, duplicate, reordered, nonfinite, failed, or self-authored metric dispositions."},
    {"id": "fabricated_observation", "description": "Stop hand-authored product decisions or unsupported hardware, simulator, operator, runtime, quality, or performance claims."},
    {"id": "noncandidate_qualification", "description": "Stop qualification of every backend, reference path, support stage, or fixture alias other than r03.mps.lanczos A11."},
    {"id": "authorization_boundary", "description": "Stop phase acceptance, production-default, Auto, holdout, perceptual-quality, performance, publication, or release authorization."}
