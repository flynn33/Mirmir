  "checks": [
    {"id": "predecessor_bindings_exact", "description": "Bind the exact accepted R07 and R09 canonical predecessors."},
    {"id": "operator_continuation_scope_exact", "description": "Require the operator continuation directive without production Auto or holdout authority."},
    {"id": "schemas_and_catalogs_exact", "description": "Require byte-exact closed schemas and three one-way catalog records."},
    {"id": "optimizer_and_persistence_bytes_exact", "description": "Require exact independent optimizer and persistence contract bytes."},
    {"id": "fixture_evaluator_policy_hashes_exact", "description": "Keep raw fixture, raw evaluation, semantic evaluator, and raw policy identities separately identified."},
    {"id": "finite_declared_causal_search_exact", "description": "Limit search to nine candidates over three declared causal variables."},
    {"id": "six_independent_constraints_exact", "description": "Reject one fixture for each of six independent constraints before scoring."},
    {"id": "absolute_score_no_comparison_exact", "description": "Use five absolute Q16 score dimensions without baseline, control, delta, or superiority fields."},
    {"id": "ordering_rejection_ranking_tie_break_exact", "description": "Freeze deterministic candidate order, rejection order, ranking, and canonical-byte tie-breaking."},
    {"id": "checkpoint_resume_identity_exact", "description": "Require incremental hash-chained checkpoints and exact-identity resume."},
    {"id": "failure_cancellation_transaction_exact", "description": "Require transactional cancellation and callback failure checkpoints."},
    {"id": "content_addressed_publication_exact", "description": "Require bounded no-follow atomic content-addressed persistence and typed reopen."},
    {"id": "frozen_fixture_policy_boundary_exact", "description": "Limit frozen publication to deterministic fixture policy evidence."},
    {"id": "observation_and_claim_boundary_truthful", "description": "Keep unavailable observations not_observed and production, quality, performance, and release claims unauthorized."}
  ],
  "stop_rules": [
    {"id": "predecessor_binding_drift", "description": "Stop on any accepted R07 or R09 byte, commit, or tree drift."},
    {"id": "schema_catalog_or_contract_byte_drift", "description": "Stop on any frozen schema, catalog, optimizer, persistence, or runner byte drift."},
    {"id": "undeclared_or_unbounded_candidate", "description": "Stop when search exceeds nine candidates or uses an undeclared causal variable."},
    {"id": "combined_or_missing_constraint", "description": "Stop when any independent constraint is missing or hidden in one scalar."},
    {"id": "rejected_candidate_observed_by_evaluator", "description": "Stop if a rejected candidate reaches evaluator observation."},
    {"id": "comparison_field_or_gate_reintroduced", "description": "Stop on baseline, control, delta, comparative, A/B, or superiority acceptance fields."},
    {"id": "nondeterministic_order_rank_or_tie_break", "description": "Stop on order, ranking, selection, or byte repeatability drift."},
    {"id": "checkpoint_or_resume_identity_drift", "description": "Stop on incomplete progress, broken hash chain, or mismatched resume identity."},
    {"id": "partial_failure_or_cancellation_commit", "description": "Stop on any partial attempt or state commit after failure or cancellation."},
    {"id": "unsafe_or_non_durable_publication", "description": "Stop on path escape, symlink following, overwrite, unbounded read, unsealed artifact, or missing typed reopen."},
    {"id": "post_freeze_policy_change", "description": "Stop any unreviewed change after the fixture contract is frozen."},
    {"id": "production_or_claim_authority_expansion", "description": "Stop production Auto, holdout, product publication, quality, performance, or release authority expansion."}
  ],
