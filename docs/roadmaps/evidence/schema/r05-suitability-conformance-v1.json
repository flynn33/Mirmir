{
  "$id": "https://mirmir.local/docs/roadmaps/evidence/schema/r05-suitability-conformance-v1.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "fileBinding": {
      "additionalProperties": false,
      "properties": {
        "path": {"minLength": 1, "type": "string"},
        "sha256": {"pattern": "^(?!0{64}$)[0-9a-f]{64}$", "type": "string"},
        "size_bytes": {"minimum": 1, "type": "integer"}
      },
      "required": ["path", "size_bytes", "sha256"],
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "checks": {
      "items": {
        "additionalProperties": false,
        "properties": {"id": {"type": "string"}, "status": {"enum": ["passed", "failed", "not_observed"], "type": "string"}},
        "required": ["id", "status"],
        "type": "object"
      },
      "maxItems": 20,
      "minItems": 20,
      "type": "array"
    },
    "evidence_kind": {"const": "r05_metalfx_suitability_contract", "type": "string"},
    "fixture_catalog_binding": {"$ref": "#/$defs/fileBinding"},
    "limitations": {"items": {"minLength": 1, "type": "string"}, "minItems": 1, "type": "array", "uniqueItems": true},
    "observation_status": {
      "additionalProperties": false,
      "properties": {
        "hardware_capability_observation": {"const": "not_observed", "type": "string"},
        "operator_observed_operation": {"const": "not_observed", "type": "string"},
        "performance_claims": {"const": "forbidden", "type": "string"},
        "quality_claims": {"const": "forbidden", "type": "string"},
        "simulator_execution": {"const": "not_observed", "type": "string"}
      },
      "required": ["hardware_capability_observation", "simulator_execution", "operator_observed_operation", "quality_claims", "performance_claims"],
      "type": "object"
    },
    "phase_id": {"const": "R05", "type": "string"},
    "preregistration_binding": {"$ref": "#/$defs/fileBinding"},
    "result": {
      "additionalProperties": false,
      "properties": {
        "acceptance": {"const": "not_claimed", "type": "string"},
        "default_backend_id": {"const": null, "type": "null"},
        "disposition": {"enum": ["qualified_spatial", "qualified_temporal", "qualified_temporal_denoised", "diagnostic_only", "rejected_for_decoded_video", "blocked"], "type": "string"},
        "performance_claims": {"const": "forbidden", "type": "string"},
        "product_qualification": {"const": "not_claimed", "type": "string"},
        "quality_claims": {"const": "forbidden", "type": "string"},
        "status": {"enum": ["passed", "diagnostic_only", "rejected", "blocked"], "type": "string"}
      },
      "required": ["status", "disposition", "default_backend_id", "product_qualification", "quality_claims", "performance_claims", "acceptance"],
      "type": "object"
    },
    "roadmap_version": {"const": "1.0.1", "type": "string"},
    "schema_version": {"const": "1.0.0", "type": "string"},
    "source": {
      "additionalProperties": false,
      "properties": {
        "commit": {"pattern": "^(?!0{40}$)[0-9a-f]{40}$", "type": "string"},
        "tree": {"pattern": "^(?!0{40}$)[0-9a-f]{40}$", "type": "string"}
      },
      "required": ["commit", "tree"],
      "type": "object"
    },
    "subject_results": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "disposition": {"enum": ["qualified_spatial", "diagnostic_only", "rejected_for_decoded_video", "not_observed"], "type": "string"},
          "execution_status": {"enum": ["observed", "not_observed", "contract_rejected"], "type": "string"},
          "reason": {"enum": ["runtime_not_observed_under_operator_override", "observed_contract_only_no_quality_or_performance_claim", "missing_renderer_motion_depth_jitter_semantics", "missing_renderer_gbuffer_motion_depth_camera_semantics", "missing_renderer_motion_depth_camera_and_output_timing_contract"], "type": "string"},
          "subject_id": {"pattern": "^r05\\.[a-z0-9.-]+$", "type": "string"}
        },
        "required": ["subject_id", "execution_status", "disposition", "reason"],
        "type": "object"
      },
      "maxItems": 7,
      "minItems": 7,
      "type": "array"
    }
  },
  "required": ["schema_version", "roadmap_version", "phase_id", "evidence_kind", "source", "preregistration_binding", "fixture_catalog_binding", "observation_status", "subject_results", "checks", "result", "limitations"],
  "type": "object"
}
