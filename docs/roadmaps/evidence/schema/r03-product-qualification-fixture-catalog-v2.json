{
  "$id": "https://mirmir.local/docs/roadmaps/evidence/schema/r03-product-qualification-fixture-catalog-v2.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "dimensions": {
      "additionalProperties": false,
      "properties": {
        "height": {"minimum": 1, "type": "integer"},
        "width": {"minimum": 1, "type": "integer"}
      },
      "required": ["width", "height"],
      "type": "object"
    },
    "fileBinding": {
      "additionalProperties": false,
      "properties": {
        "id": {"type": "string"},
        "path": {"minLength": 1, "type": "string"},
        "sha256": {"pattern": "^(?!0{64}$)[0-9a-f]{64}$", "type": "string"},
        "size_bytes": {"minimum": 1, "type": "integer"}
      },
      "required": ["id", "path", "size_bytes", "sha256"],
      "type": "object"
    },
    "time": {
      "additionalProperties": false,
      "properties": {
        "timescale": {"const": 30000, "type": "integer"},
        "value": {"minimum": 0, "type": "integer"}
      },
      "required": ["value", "timescale"],
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schema_version": {"const": "2.0.0", "type": "string"},
    "phase_id": {"const": "R03", "type": "string"},
    "contract_id": {"const": "r03-a11-product-qualification-fixtures-v2", "type": "string"},
    "candidate_identity": {
      "additionalProperties": false,
      "properties": {
        "backend_id": {"const": "r03.mps.lanczos", "type": "string"},
        "capability_id": {"const": "A11", "type": "string"},
        "framework": {"const": "MetalPerformanceShaders", "type": "string"},
        "framework_symbol": {"const": "MPSImageLanczosScale", "type": "string"},
        "material_decision_identity": {"const": "r03.a11.genuine-mps-lanczos-product-admission.v1", "type": "string"},
        "policy_identity": {"const": "r03.a11.product-qualified.no-fallback.v1", "type": "string"}
      },
      "required": ["backend_id", "capability_id", "framework", "framework_symbol", "policy_identity", "material_decision_identity"],
      "type": "object"
    },
    "color_contract": {
      "additionalProperties": false,
      "properties": {
        "bit_depth": {"const": 8, "type": "integer"},
        "chroma_location": {"const": "left", "type": "string"},
        "matrix": {"const": "ITU_R_709_2", "type": "string"},
        "pixel_format": {"const": "420v", "type": "string"},
        "primaries": {"const": "ITU_R_709_2", "type": "string"},
        "range": {"const": "video", "type": "string"},
        "transfer_function": {"const": "ITU_R_709_2", "type": "string"}
      },
      "required": ["pixel_format", "bit_depth", "primaries", "transfer_function", "matrix", "range", "chroma_location"],
      "type": "object"
    },
    "source_bindings": {
      "items": {"$ref": "#/$defs/fileBinding"},
      "minItems": 8,
      "type": "array"
    },
    "routes": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "configuration_identity": {"type": "string"},
          "fixture_binding_id": {"type": "string"},
          "id": {"enum": ["scale_3_over_2", "scale_2x"], "type": "string"},
          "input_dimensions": {"$ref": "#/$defs/dimensions"},
          "output_dimensions": {"$ref": "#/$defs/dimensions"},
          "scale_denominator": {"minimum": 1, "type": "integer"},
          "scale_numerator": {"minimum": 1, "type": "integer"}
        },
        "required": ["id", "input_dimensions", "output_dimensions", "scale_numerator", "scale_denominator", "fixture_binding_id", "configuration_identity"],
        "type": "object"
      },
      "maxItems": 2,
      "minItems": 2,
      "type": "array",
      "uniqueItems": true
    },
    "media_transaction": {
      "additionalProperties": false,
      "properties": {
        "audio_contract": {
          "additionalProperties": false,
          "properties": {
            "channel_count": {"const": 2, "type": "integer"},
            "codec": {"const": "aac", "type": "string"},
            "sample_rate": {"const": 48000, "type": "integer"},
            "semantic_sha256": {"pattern": "[0-9a-f]{64}", "type": "string"},
            "source_generator_id": {"const": "r02-deterministic-pcm-s16le-v1", "type": "string"},
            "source_pcm_sha256": {"pattern": "[0-9a-f]{64}", "type": "string"},
            "source_sample_frames": {"const": 480, "type": "integer"},
            "track_count": {"const": 1, "type": "integer"}
          },
          "required": ["codec", "track_count", "sample_rate", "channel_count", "source_sample_frames", "source_generator_id", "source_pcm_sha256", "semantic_sha256"],
          "type": "object"
        },
        "container_contract": {
          "additionalProperties": false,
          "properties": {
            "atomic_publication_required": {"const": true, "type": "boolean"},
            "file_type": {"const": "mp4", "type": "string"},
            "reopen_required": {"const": true, "type": "boolean"},
            "video_codec": {"const": "h264", "type": "string"}
          },
          "required": ["file_type", "video_codec", "reopen_required", "atomic_publication_required"],
          "type": "object"
        },
        "frames": {
          "items": {
            "additionalProperties": false,
            "properties": {
              "duration": {"$ref": "#/$defs/time"},
              "generated_content_sha256": {"pattern": "[0-9a-f]{64}", "type": "string"},
              "metadata_identity": {"type": "string"},
              "pts": {"$ref": "#/$defs/time"},
              "resource_token_id": {"type": "string"},
              "sequence_number": {"minimum": 0, "type": "integer"}
            },
            "required": ["sequence_number", "pts", "duration", "metadata_identity", "resource_token_id", "generated_content_sha256"],
            "type": "object"
          },
          "maxItems": 3,
          "minItems": 3,
          "type": "array"
        },
        "generator_contract": {"const": "r02-deterministic-contract-fixtures-v1", "type": "string"},
        "generator_id": {"const": "r02-deterministic-nv12-v1", "type": "string"},
        "id": {"const": "r03-v2-media-transaction-2x", "type": "string"},
        "materialization": {"const": "runtime_ephemeral", "type": "string"},
        "ownership": {"const": "r03_owned_dimension_corrective_fixture", "type": "string"},
        "pixel_format": {"const": "420v", "type": "string"},
        "preserved_r02_semantics": {
          "items": {"type": "string"},
          "minItems": 8,
          "type": "array",
          "uniqueItems": true
        },
        "route_id": {"const": "scale_2x", "type": "string"},
        "seed": {"const": 303, "type": "integer"},
        "source_dimensions": {"$ref": "#/$defs/dimensions"},
        "target_dimensions": {"$ref": "#/$defs/dimensions"}
      },
      "required": ["id", "ownership", "route_id", "generator_contract", "generator_id", "materialization", "seed", "pixel_format", "source_dimensions", "target_dimensions", "container_contract", "audio_contract", "frames", "preserved_r02_semantics"],
      "type": "object"
    }
  },
  "required": ["schema_version", "phase_id", "contract_id", "candidate_identity", "color_contract", "source_bindings", "routes", "media_transaction"],
  "type": "object"
}
