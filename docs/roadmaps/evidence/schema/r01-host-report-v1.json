              "xcode_version": {"pattern": "^(?:2[7-9]|[3-9][0-9]|[1-9][0-9]{2,})(?:\\.[0-9]+)*$"},
              "sdk_version": {"pattern": "^(?:2[7-9]|[3-9][0-9]|[1-9][0-9]{2,})(?:\\.[0-9]+)*$"},
