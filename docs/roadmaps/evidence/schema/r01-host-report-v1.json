              "support_query": {"properties": {"observed": {"const": true}, "reason_code": {"type": "null"}}},
              "model_readiness": {"const": "acquisition_failed"},
              "offline_suitability": {"const": "unavailable"}
            }
          }
        },
        {
          "if": {"properties": {"reason_code": {"const": "input_contract_unsatisfied"}}, "required": ["reason_code"]},
          "then": {
            "properties": {
              "compile_state": {"enum": ["available", "conditional"]},
              "runtime_disposition": {"enum": ["restricted", "unsupported", "rejected"]},
              "public_api_status": {"const": "public"},
              "support_query": {"properties": {"observed": {"const": true}, "reason_code": {"type": "null"}}}
            }
          }
        },
        {
          "if": {"properties": {"reason_code": {"const": "runtime_probe_failed"}}, "required": ["reason_code"]},
          "then": {
            "properties": {
              "compile_state": {"enum": ["available", "conditional"]},
              "runtime_disposition": {"enum": ["rejected", "unavailable", "diagnostic_only"]},
              "public_api_status": {"const": "public"},
              "support_query": {"properties": {"observed": {"const": true}, "reason_code": {"type": "null"}}}
            }
          }
        },
        {
          "if": {"properties": {"reason_code": {"const": "resource_limit"}}, "required": ["reason_code"]},
          "then": {
            "properties": {
              "compile_state": {"enum": ["available", "conditional"]},
              "runtime_disposition": {"enum": ["restricted", "rejected", "unavailable"]},
              "public_api_status": {"const": "public"},
              "support_query": {"properties": {"observed": {"const": true}, "reason_code": {"type": "null"}}}
            }
          }
        },
        {
          "if": {"properties": {"reason_code": {"const": "not_applicable"}}, "required": ["reason_code"]},
          "then": {
            "properties": {
              "runtime_disposition": {"enum": ["unsupported", "diagnostic_only"]},
              "support_query": {"properties": {"observed": {"const": "not_available"}, "reason_code": {"const": "not_applicable"}}},
              "offline_suitability": {"const": "unavailable"}
            }
          }
        },
        {
          "if": {"properties": {"public_api_status": {"const": "absent"}}, "required": ["public_api_status"]},
          "then": {"properties": {"reason_code": {"const": "api_absent"}}}
        },
        {
          "if": {"properties": {"public_api_status": {"const": "not_public"}}, "required": ["public_api_status"]},
          "then": {"properties": {"reason_code": {"const": "not_public_api"}}}
        },
        {
          "if": {"properties": {"hardware_eligibility": {"const": "ineligible"}}, "required": ["hardware_eligibility"]},
          "then": {"properties": {"reason_code": {"const": "hardware_unsupported"}}}
        },
        {
          "if": {"properties": {"model_readiness": {"const": "unavailable"}}, "required": ["model_readiness"]},
          "then": {"properties": {"reason_code": {"const": "model_unavailable"}}}
        },
        {
          "if": {"properties": {"model_readiness": {"const": "acquisition_failed"}}, "required": ["model_readiness"]},
          "then": {"properties": {"reason_code": {"const": "model_acquisition_failed"}}}
        },
        {
          "if": {"properties": {"offline_suitability": {"const": "requires_acquisition"}}, "required": ["offline_suitability"]},
          "then": {"properties": {"reason_code": {"const": "model_unavailable"}, "model_readiness": {"const": "unavailable"}}}
        },
        {
          "if": {"properties": {"support_query": {"properties": {"observed": {"const": false}}}}, "required": ["support_query"]},
          "then": {"properties": {"reason_code": {"enum": ["os_too_old", "hardware_unsupported"]}}}
        },
        {
          "if": {"properties": {"support_query": {"properties": {"observed": {"const": "not_available"}}}}, "required": ["support_query"]},
          "then": {"properties": {"reason_code": {"enum": ["api_absent", "sdk_too_old", "not_public_api", "not_applicable"]}}}
        },
        {
          "if": {"properties": {"support_query": {"properties": {"observed": {"const": true}}}}, "required": ["support_query"]},
          "then": {"properties": {"reason_code": {"enum": ["none", "model_unavailable", "model_acquisition_failed", "input_contract_unsatisfied", "runtime_probe_failed", "resource_limit"]}}}
        }
      ]
    },
