              "support_query": {"properties": {"observed": {"const": false}, "reason_code": {"const": "os_too_old"}}},
              "offline_suitability": {"const": "unavailable"}
            }
          }
        },
        {
          "if": {"properties": {"reason_code": {"const": "sdk_too_old"}}, "required": ["reason_code"]},
          "then": {
            "properties": {
              "compile_state": {"enum": ["unavailable", "conditional"]},
              "runtime_disposition": {"enum": ["unavailable", "unsupported"]},
              "public_api_status": {"const": "public"},
              "support_query": {"properties": {"observed": {"const": "not_available"}, "reason_code": {"const": "sdk_too_old"}}},
              "offline_suitability": {"const": "unavailable"}
            }
          }
        },
        {
