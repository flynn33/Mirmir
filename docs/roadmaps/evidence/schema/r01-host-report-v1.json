              "support_query": {"properties": {"observed": {"const": false}, "reason_code": {"const": "hardware_unsupported"}}},
              "offline_suitability": {"const": "unavailable"}
            }
          }
        },
        {
          "if": {"properties": {"reason_code": {"const": "model_unavailable"}}, "required": ["reason_code"]},
