              true,
              true,
              true,
              true,
              true,
              true,
              true,
              true,
              true,
              true,
              true,
              true,
              true,
              true,
              true,
              true,
              {
                "properties": {
                  "compile_state": {"enum": ["available", "conditional"]},
                  "public_api_status": {"const": "public"}
                }
              }
            ]
          }
        }
      }
