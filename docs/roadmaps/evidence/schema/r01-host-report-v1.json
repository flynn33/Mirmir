  "allOf": [
    {
      "if": {"properties": {"anchor": {"const": "oldest-supported"}}},
      "then": {
        "properties": {
          "host": {
            "properties": {
              "chip": {"pattern": "^Apple M"},
              "os_version": {"pattern": "^15\\.4(?:\\.[0-9]+)*$"},
              "hardware_classes": {"contains": {"const": "apple_silicon"}}
            }
          }
        }
      }
    },
    {
      "if": {"properties": {"anchor": {"const": "m3-air"}}},
      "then": {
        "properties": {
          "host": {
            "properties": {
              "chip": {"const": "Apple M3"},
              "model_identifier": {"enum": ["Mac15,12", "Mac15,13"]},
              "os_version": {"pattern": "^26(?:\\.[0-9]+)*$"},
              "hardware_classes": {
                "allOf": [
                  {"contains": {"const": "apple_silicon"}},
                  {"contains": {"const": "macbook_air"}}
                ]
              }
            }
          }
        }
      }
    },
    {
      "if": {"properties": {"anchor": {"const": "pro-max"}}},
      "then": {
        "properties": {
          "host": {
            "properties": {
              "chip": {"pattern": "^Apple M[0-9]+ (?:Pro|Max)$"},
              "hardware_classes": {
                "allOf": [
                  {"contains": {"const": "apple_silicon"}},
                  {"contains": {"const": "pro_max_tier"}}
                ]
              }
            }
          }
        }
      }
    },
    {
      "if": {"properties": {"anchor": {"const": "core-ai"}}},
