{
  "$id": "https://mirmir.local/docs/roadmaps/evidence/schema/r02-fixture-catalog-v1.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "dimensions": {
      "additionalProperties": false,
      "properties": {
        "height": {
          "minimum": 1,
          "type": "integer"
        },
        "width": {
          "minimum": 1,
          "type": "integer"
        }
      },
      "required": [
        "width",
        "height"
      ],
      "type": "object"
    },
    "time": {
      "additionalProperties": false,
      "properties": {
        "timescale": {
          "minimum": 1,
          "type": "integer"
        },
        "value": {
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "value",
        "timescale"
      ],
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "fixtures": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "audio_contract": {
            "oneOf": [
              {
                "additionalProperties": false,
                "properties": {
                  "channel_count": {
                    "const": 2,
                    "type": "integer"
                  },
                  "codec": {
                    "const": "aac",
                    "type": "string"
                  },
                  "sample_rate": {
                    "const": 48000,
                    "type": "integer"
                  },
                  "semantic_sha256": {
                    "pattern": "^(?!0{64}$)[0-9a-f]{64}$",
                    "type": "string"
                  },
                  "source_generator_id": {
                    "const": "r02-deterministic-pcm-s16le-v1",
                    "type": "string"
                  },
                  "source_pcm_sha256": {
                    "pattern": "^(?!0{64}$)[0-9a-f]{64}$",
                    "type": "string"
                  },
                  "source_sample_frames": {
                    "const": 480,
                    "type": "integer"
                  },
                  "track_count": {
                    "const": 1,
                    "type": "integer"
                  }
                },
                "required": [
                  "track_count",
                  "codec",
                  "sample_rate",
                  "channel_count",
                  "source_generator_id",
                  "source_sample_frames",
                  "source_pcm_sha256",
                  "semantic_sha256"
                ],
                "type": "object"
              },
              {
                "type": "null"
              }
            ]
          },
          "color_contract": {
            "additionalProperties": false,
            "properties": {
              "chroma_siting": {
                "const": "left",
                "type": "string"
              },
              "color_primaries": {
                "const": "ITU_R_709_2",
                "type": "string"
              },
              "matrix": {
                "const": "ITU_R_709_2",
                "type": "string"
              },
              "range": {
                "const": "video",
                "type": "string"
              },
              "transfer_function": {
                "const": "ITU_R_709_2",
                "type": "string"
              }
            },
            "required": [
              "color_primaries",
              "transfer_function",
              "matrix",
              "range",
              "chroma_siting"
            ],
            "type": "object"
          },
          "container_contract": {
            "oneOf": [
              {
                "additionalProperties": false,
                "properties": {
                  "atomic_publication_required": {
                    "const": true,
                    "type": "boolean"
                  },
                  "file_type": {
                    "const": "mp4",
                    "type": "string"
                  },
                  "reopen_required": {
                    "const": true,
                    "type": "boolean"
                  },
                  "video_codec": {
                    "const": "h264",
                    "type": "string"
                  }
                },
                "required": [
                  "file_type",
                  "video_codec",
                  "reopen_required",
                  "atomic_publication_required"
                ],
                "type": "object"
              },
              {
                "type": "null"
              }
            ]
          },
          "frames": {
            "items": {
              "additionalProperties": false,
              "properties": {
                "duration": {
                  "$ref": "#/$defs/time"
                },
                "generated_content_sha256": {
                  "pattern": "^(?!0{64}$)[0-9a-f]{64}$",
                  "type": "string"
                },
                "metadata_identity": {
                  "minLength": 1,
                  "type": "string"
                },
                "pts": {
                  "$ref": "#/$defs/time"
                },
                "resource_token_id": {
                  "minLength": 1,
                  "type": "string"
                },
                "sequence_number": {
                  "minimum": 0,
                  "type": "integer"
                }
              },
              "required": [
                "sequence_number",
                "pts",
                "duration",
                "generated_content_sha256",
                "metadata_identity",
                "resource_token_id"
              ],
              "type": "object"
            },
            "minItems": 2,
            "type": "array"
          },
          "generator_id": {
            "const": "r02-deterministic-nv12-v1",
            "type": "string"
          },
          "id": {
            "enum": [
              "fixture-sequence-a",
              "fixture-sequence-b",
              "fixture-media-transaction"
            ],
            "type": "string"
          },
          "kind": {
            "enum": [
              "frame_sequence",
              "media_transaction"
            ],
            "type": "string"
          },
          "materialization": {
            "const": "runtime_ephemeral",
            "type": "string"
          },
          "pixel_format": {
            "const": "420v",
            "type": "string"
          },
          "seed": {
            "minimum": 1,
            "type": "integer"
          },
          "semantic_sha256": {
            "pattern": "^(?!0{64}$)[0-9a-f]{64}$",
            "type": "string"
          },
          "source_dimensions": {
            "$ref": "#/$defs/dimensions"
          },
          "target_dimensions": {
            "$ref": "#/$defs/dimensions"
          }
        },
        "required": [
          "id",
          "kind",
          "generator_id",
          "seed",
          "source_dimensions",
          "target_dimensions",
          "pixel_format",
          "color_contract",
          "frames",
          "audio_contract",
          "container_contract",
          "materialization",
          "semantic_sha256"
        ],
        "type": "object"
      },
      "maxItems": 3,
      "minItems": 3,
      "type": "array"
    },
    "generator_contract": {
      "const": "r02-deterministic-contract-fixtures-v1",
      "type": "string"
    },
    "phase_id": {
      "const": "R02",
      "type": "string"
    },
    "scenarios": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "backend_ids": {
            "items": {
              "minLength": 1,
              "type": "string"
            },
            "type": "array",
            "uniqueItems": true
          },
          "fixture_ids": {
            "items": {
              "minLength": 1,
              "type": "string"
            },
            "minItems": 1,
            "type": "array",
            "uniqueItems": true
          },
          "id": {
            "enum": [
              "multiple_backends_common_session",
              "session_lifecycle",
              "typed_outcomes_and_fallback",
              "media_transaction_preservation"
            ],
            "type": "string"
          },
          "required_checks": {
            "items": {
              "minLength": 1,
              "type": "string"
            },
            "minItems": 1,
            "type": "array",
            "uniqueItems": true
          }
        },
        "required": [
          "id",
          "fixture_ids",
          "backend_ids",
          "required_checks"
        ],
        "type": "object"
      },
      "maxItems": 4,
      "minItems": 4,
      "type": "array"
    },
    "schema_version": {
      "const": "1.0.0",
      "type": "string"
    }
  },
  "required": [
    "schema_version",
    "phase_id",
    "generator_contract",
    "fixtures",
    "scenarios"
  ],
  "type": "object"
}
