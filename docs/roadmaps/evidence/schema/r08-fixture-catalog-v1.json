{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mirmir.invalid/schema/r08-fixture-catalog-v1.json",
  "title": "Mirmir R08 Core AI analysis-only fixture catalog",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "phase_id",
    "contract_id",
    "predecessor_binding",
    "fixture_parameters",
    "calibrated_output_fixtures",
    "scheduling_fixtures",
    "integration_fixtures",
    "lifecycle_fixtures",
    "fallback_fixtures",
    "authorization_fixtures"
  ],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "phase_id": {"const": "R08"},
    "contract_id": {"const": "r08-core-ai-analysis-only-fixtures-v1"},
    "predecessor_binding": {"$ref": "#/$defs/predecessor"},
    "fixture_parameters": {"$ref": "#/$defs/fixtureParameters"},
    "calibrated_output_fixtures": {"$ref": "#/$defs/fixtureArray"},
    "scheduling_fixtures": {"$ref": "#/$defs/fixtureArray"},
    "integration_fixtures": {"$ref": "#/$defs/fixtureArray"},
    "lifecycle_fixtures": {"$ref": "#/$defs/fixtureArray"},
    "fallback_fixtures": {"$ref": "#/$defs/fixtureArray"},
    "authorization_fixtures": {"$ref": "#/$defs/fixtureArray"}
  },
  "$defs": {
    "predecessor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["phase_id", "merge_commit", "merge_tree"],
      "properties": {
        "phase_id": {"const": "R07"},
        "merge_commit": {"const": "3fd13e57ec95b1ed98df71f4c83ab165bdfbab6b"},
        "merge_tree": {"const": "eb1614dd2a93e1bc4e1911bcf74f41cf372a3304"}
      }
    },
    "fixtureParameters": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "q15_minimum",
        "q15_maximum",
        "spatial_width",
        "spatial_height",
        "periodic_proxy_interval_frames",
        "memory_budget_bytes",
        "latency_budget_milliseconds",
        "simulation_identity",
        "native_execution"
      ],
      "properties": {
        "q15_minimum": {"const": 0},
        "q15_maximum": {"const": 32767},
        "spatial_width": {"const": 2},
        "spatial_height": {"const": 2},
        "periodic_proxy_interval_frames": {"const": 12},
        "memory_budget_bytes": {"const": 67108864},
        "latency_budget_milliseconds": {"const": 20},
        "simulation_identity": {"const": "r08.deterministic-analysis-fixture-simulation.v1"},
        "native_execution": {"const": "not_observed"}
      }
    },
    "fixture": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "inputs", "expected"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "inputs": {"type": "object"},
        "expected": {"type": "object"}
      }
    },
    "fixtureArray": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/fixture"}
    }
  }
}
