{
  "$id": "https://mirmir.local/docs/roadmaps/evidence/schema/r04-preregistration-v1.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "fileBinding": {
      "additionalProperties": false,
      "properties": {
        "path": {"minLength": 1, "type": "string"},
        "sha256": {"pattern": "^(?!0{64}$)[0-9a-f]{64}$", "type": "string"},
        "size_bytes": {"minimum": 1, "type": "integer"}
      },
      "required": ["path", "size_bytes", "sha256"],
      "type": "object"
    },
    "statement": {
      "additionalProperties": false,
      "properties": {
        "description": {"minLength": 1, "type": "string"},
        "id": {"pattern": "^[a-z][a-z0-9_]{0,79}$", "type": "string"}
      },
      "required": ["id", "description"],
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "authorization_boundary": {
      "additionalProperties": false,
      "properties": {
        "acceptance": {"const": "not_claimed", "type": "string"},
        "auto_mode": {"const": "blocked", "type": "string"},
        "holdout": {"const": "blocked", "type": "string"},
        "performance_claims": {"const": "forbidden", "type": "string"},
        "product_qualification": {"const": "not_claimed", "type": "string"},
        "production_default": {"const": "not_enabled", "type": "string"},
        "publication": {"const": "not_authorized_by_this_record", "type": "string"},
        "quality_claims": {"const": "forbidden", "type": "string"},
        "release": {"const": "not_authorized", "type": "string"}
      },
      "required": ["production_default", "product_qualification", "quality_claims", "performance_claims", "auto_mode", "holdout", "acceptance", "release", "publication"],
      "type": "object"
    },
    "checks": {"items": {"$ref": "#/$defs/statement"}, "maxItems": 22, "minItems": 22, "type": "array"},
    "contract": {
      "additionalProperties": false,
      "properties": {
        "capability_inference": {"const": "forbidden", "type": "string"},
        "color_scope": {"const": "8_bit_nv12_sdr_bt709_video_range_left_chroma", "type": "string"},
        "flow_support": {"const": "A05_optional_support_only", "type": "string"},
        "history_contract": {"const": "presentation_order_previous_source_and_previous_output", "type": "string"},
        "identity_contract": {"const": "exact_dimensions_format_color_timing_audio_metadata_and_processing_identity", "type": "string"},
        "low_latency_routes": {"const": "A02_1p5x_and_2x_after_exact_dimension_query_only", "type": "string"},
        "quality_1p5x_disposition": {"const": "rejected_public_contract_unrepresentable", "type": "string"},
        "quality_route": {"const": "A01_2x_only", "type": "string"},
        "reset_contract": {"const": "first_frame_scene_cut_cancellation_and_end_session", "type": "string"},
        "session_contract": {"const": "VTFrameProcessor", "type": "string"},
        "submission_contract": {"const": "explicit_sequential_or_random", "type": "string"}
      },
      "required": ["session_contract", "color_scope", "quality_route", "quality_1p5x_disposition", "low_latency_routes", "flow_support", "history_contract", "reset_contract", "submission_contract", "identity_contract", "capability_inference"],
      "type": "object"
    },
    "fixture_catalog": {"$ref": "#/$defs/fileBinding"},
    "observation_policy": {
      "additionalProperties": false,
      "properties": {
        "deterministic_software_conformance": {"const": "required", "type": "string"},
        "hardware_capability_observation": {"const": "not_observed", "type": "string"},
        "hardware_requirement": {"const": "waived_not_a_blocker", "type": "string"},
        "operator_observed_operation": {"const": "not_observed", "type": "string"},
        "operator_observation_requirement": {"const": "waived_not_a_blocker", "type": "string"},
        "performance_claims": {"const": "forbidden", "type": "string"},
        "quality_claims": {"const": "forbidden", "type": "string"},
        "runtime_execution": {"const": "observed_or_not_observed_per_subject", "type": "string"},
        "simulator_execution": {"const": "not_observed", "type": "string"},
        "simulator_requirement": {"const": "waived_not_a_blocker", "type": "string"}
      },
      "required": ["hardware_requirement", "simulator_requirement", "operator_observation_requirement", "hardware_capability_observation", "simulator_execution", "operator_observed_operation", "runtime_execution", "deterministic_software_conformance", "quality_claims", "performance_claims"],
      "type": "object"
    },
    "phase_id": {"const": "R04", "type": "string"},
    "predecessor_binding": {
      "additionalProperties": false,
      "properties": {
        "acceptance_state": {"const": "not_claimed", "type": "string"},
        "accepted_merge_commit": {"type": "null"},
        "closure_commit": {"const": "947983a8414c60e4f5f4246e6cb658792fc7c357", "type": "string"},
        "closure_state": {"const": "local_unpublished_blocked_closure", "type": "string"},
        "closure_tree": {"const": "d1a89e5b9edf8d42b1da9ba06a3b6a0c139f08f3", "type": "string"},
        "continuation_scope": {"const": "local_implementation_only", "type": "string"},
        "phase_id": {"const": "R03", "type": "string"},
        "predecessor_result": {"const": "blocked", "type": "string"}
      },
      "required": ["phase_id", "closure_state", "closure_commit", "closure_tree", "predecessor_result", "accepted_merge_commit", "acceptance_state", "continuation_scope"],
      "type": "object"
    },
    "preregistration_state": {"const": "contract_frozen_for_local_implementation", "type": "string"},
    "roadmap_version": {"const": "1.0.1", "type": "string"},
    "schema_bindings": {
      "additionalProperties": false,
      "properties": {
        "conformance": {"$ref": "#/$defs/fileBinding"},
        "fixture_catalog": {"$ref": "#/$defs/fileBinding"},
        "preregistration": {"$ref": "#/$defs/fileBinding"}
      },
      "required": ["preregistration", "fixture_catalog", "conformance"],
      "type": "object"
    },
    "schema_version": {"const": "1.0.0", "type": "string"},
    "stop_rules": {"items": {"$ref": "#/$defs/statement"}, "maxItems": 11, "minItems": 11, "type": "array"},
    "subjects": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "backend_identity": {"enum": ["quality", "low_latency", "optional_flow_support"], "type": "string"},
          "capability_id": {"enum": ["A01", "A02", "A05"], "type": "string"},
          "id": {"pattern": "^r04\\.[a-z0-9.-]+$", "type": "string"},
          "initial_disposition": {"enum": ["not_observed", "rejected"], "type": "string"},
          "initial_status": {"enum": ["not_observed", "contract_rejected"], "type": "string"},
          "product_default_eligibility": {"enum": ["candidate_after_observed_qualification", "ineligible_contract_rejection", "ineligible_optional_support"], "type": "string"},
          "reason": {"enum": ["runtime_not_observed_under_operator_override", "public_contract_unrepresentable"], "type": "string"},
          "route_id": {"type": "string"},
          "route_policy": {"enum": ["runtime_observation_required", "exact_dimension_query_required", "typed_rejection", "optional_runtime_support"], "type": "string"}
        },
        "required": ["id", "capability_id", "backend_identity", "route_id", "route_policy", "initial_status", "initial_disposition", "reason", "product_default_eligibility"],
        "type": "object"
      },
      "maxItems": 5,
      "minItems": 5,
      "type": "array"
    },
    "toolchain_boundary": {
      "additionalProperties": false,
      "properties": {
        "compiler_floor": {"const": "Swift 6.2", "type": "string"},
        "platform": {"const": "macOS", "type": "string"},
        "runtime_floor": {"const": "macOS 26.0", "type": "string"},
        "sdk_family": {"const": "macOS 26", "type": "string"},
        "simulator_availability": {"const": "unavailable", "type": "string"},
        "simulator_availability_effect": {"const": "not_a_blocker", "type": "string"}
      },
      "required": ["platform", "runtime_floor", "sdk_family", "compiler_floor", "simulator_availability", "simulator_availability_effect"],
      "type": "object"
    }
  },
  "required": ["schema_version", "roadmap_version", "phase_id", "preregistration_state", "predecessor_binding", "toolchain_boundary", "observation_policy", "fixture_catalog", "schema_bindings", "contract", "subjects", "checks", "stop_rules", "authorization_boundary"],
  "type": "object"
}
