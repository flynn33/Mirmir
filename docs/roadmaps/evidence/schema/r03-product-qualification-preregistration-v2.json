{
  "$id": "https://mirmir.local/docs/roadmaps/evidence/schema/r03-product-qualification-preregistration-v2.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "fileBinding": {
      "additionalProperties": false,
      "properties": {
        "path": {"minLength": 1, "type": "string"},
        "sha256": {"pattern": "^(?!0{64}$)[0-9a-f]{64}$", "type": "string"},
        "size_bytes": {"minimum": 1, "type": "integer"}
      },
      "required": ["path", "size_bytes", "sha256"],
      "type": "object"
    },
    "statement": {
      "additionalProperties": false,
      "properties": {
        "description": {"minLength": 1, "type": "string"},
        "id": {"pattern": "^[a-z][a-z0-9_]{0,95}$", "type": "string"}
      },
      "required": ["id", "description"],
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schema_version": {"const": "2.0.0", "type": "string"},
    "roadmap_version": {"const": "1.0.1", "type": "string"},
    "phase_id": {"const": "R03", "type": "string"},
    "contract_id": {"const": "r03-a11-functional-product-qualification-v2", "type": "string"},
    "preregistration_state": {"const": "frozen_before_product_implementation", "type": "string"},
    "historical_v1_bindings": {
      "additionalProperties": false,
      "properties": {
        "baseline_conformance": {"$ref": "#/$defs/fileBinding"},
        "fixture_catalog": {"$ref": "#/$defs/fileBinding"},
        "preregistration": {"$ref": "#/$defs/fileBinding"}
      },
      "required": ["preregistration", "fixture_catalog", "baseline_conformance"],
      "type": "object"
    },
    "schema_bindings": {
      "additionalProperties": false,
      "properties": {
        "decision": {"$ref": "#/$defs/fileBinding"},
        "execution_receipt": {"$ref": "#/$defs/fileBinding"},
        "fixture_catalog": {"$ref": "#/$defs/fileBinding"},
        "preregistration": {"$ref": "#/$defs/fileBinding"}
      },
      "required": ["preregistration", "fixture_catalog", "execution_receipt", "decision"],
      "type": "object"
    },
    "fixture_catalog_binding": {"$ref": "#/$defs/fileBinding"},
    "candidate_contract": {
      "additionalProperties": false,
      "properties": {
        "backend_id": {"const": "r03.mps.lanczos", "type": "string"},
        "capability_id": {"const": "A11", "type": "string"},
        "framework": {"const": "MetalPerformanceShaders", "type": "string"},
        "framework_symbol": {"const": "MPSImageLanczosScale", "type": "string"},
        "kind": {"const": "whole_frame_primary_backend", "type": "string"},
        "material_decision_identity": {"const": "r03.a11.genuine-mps-lanczos-product-admission.v1", "type": "string"},
        "policy_identity": {"const": "r03.a11.product-qualified.no-fallback.v1", "type": "string"},
        "qualification_scope": {"const": "functional_product_eligibility", "type": "string"},
        "route_ids": {
          "items": {"enum": ["scale_3_over_2", "scale_2x"], "type": "string"},
          "maxItems": 2,
          "minItems": 2,
          "type": "array",
          "uniqueItems": true
        }
      },
      "required": ["backend_id", "capability_id", "framework", "framework_symbol", "kind", "qualification_scope", "route_ids", "policy_identity", "material_decision_identity"],
      "type": "object"
    },
    "execution_contract": {
      "additionalProperties": false,
      "properties": {
        "color_contract": {"const": "8_bit_nv12_420v_sdr_bt709_video_range_left_chroma", "type": "string"},
        "framework_execution": {"const": "genuine_MPSImageLanczosScale_required", "type": "string"},
        "lifecycle_contract": {"const": "apple-upscale-session-v1", "type": "string"},
        "media_transaction_fixture_id": {"const": "r03-v2-media-transaction-2x", "type": "string"},
        "no_fallback": {"const": true, "type": "boolean"},
        "repeat_count": {"const": 3, "type": "integer"},
        "required_artifact_binding_ids": {
          "items": {"type": "string"},
          "minItems": 5,
          "type": "array",
          "uniqueItems": true
        },
        "required_source_bindings": {
          "items": {
            "additionalProperties": false,
            "properties": {
              "id": {"type": "string"},
              "path": {"type": "string"}
            },
            "required": ["id", "path"],
            "type": "object"
          },
          "minItems": 3,
          "type": "array",
          "uniqueItems": true
        },
        "required_test_bindings": {
          "items": {
            "additionalProperties": false,
            "properties": {
              "id": {"type": "string"},
              "path": {"type": "string"}
            },
            "required": ["id", "path"],
            "type": "object"
          },
          "minItems": 2,
          "type": "array",
          "uniqueItems": true
        },
        "single_logical_hash_per_route": {"const": true, "type": "boolean"},
        "toolchain_fields": {
          "items": {"type": "string"},
          "minItems": 7,
          "type": "array",
          "uniqueItems": true
        }
      },
      "required": ["framework_execution", "color_contract", "lifecycle_contract", "media_transaction_fixture_id", "repeat_count", "single_logical_hash_per_route", "no_fallback", "required_source_bindings", "required_test_bindings", "required_artifact_binding_ids", "toolchain_fields"],
      "type": "object"
    },
    "observation_policy": {
      "additionalProperties": false,
      "properties": {
        "current_hardware_capability_observation": {"const": "not_observed", "type": "string"},
        "current_operator_observed_operation": {"const": "not_observed", "type": "string"},
        "current_simulator_execution": {"const": "not_observed", "type": "string"},
        "deterministic_software_execution": {"const": "observed_required_for_qualification", "type": "string"},
        "hardware_simulator_operator_requirement": {"const": "waived_not_a_blocker", "type": "string"},
        "product_runtime_support": {"const": "not_claimed", "type": "string"},
        "truthful_observation_recording": {"const": "required", "type": "string"}
      },
      "required": ["hardware_simulator_operator_requirement", "current_hardware_capability_observation", "current_simulator_execution", "current_operator_observed_operation", "deterministic_software_execution", "truthful_observation_recording", "product_runtime_support"],
      "type": "object"
    },
    "metrics": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "claim_scope": {"enum": ["functional_qualification", "no_claim_not_applicable"], "type": "string"},
          "id": {"type": "string"},
          "not_applicable_reason": {"type": ["string", "null"]},
          "operator": {"enum": ["equal", "less_than_or_equal", "greater_than", "greater_than_or_equal", "finite_nonnegative"], "type": "string"},
          "receipt_status": {"enum": ["measured", "not_applicable"], "type": "string"},
          "threshold": {"oneOf": [{"type": "number"}, {"type": "string"}]},
          "unit": {"type": "string"}
        },
        "required": ["id", "unit", "operator", "threshold", "claim_scope", "receipt_status", "not_applicable_reason"],
        "type": "object"
      },
      "maxItems": 23,
      "minItems": 23,
      "type": "array"
    },
    "checks": {"items": {"$ref": "#/$defs/statement"}, "minItems": 15, "type": "array"},
    "stop_rules": {"items": {"$ref": "#/$defs/statement"}, "minItems": 10, "type": "array"},
    "optional_evidence_paths": {
      "additionalProperties": false,
      "properties": {
        "decision": {"type": "string"},
        "execution_receipt": {"type": "string"}
      },
      "required": ["execution_receipt", "decision"],
      "type": "object"
    },
    "authorization_boundary": {
      "additionalProperties": false,
      "properties": {
        "acceptance": {"const": "not_claimed", "type": "string"},
        "auto_mode": {"const": "blocked", "type": "string"},
        "holdout": {"const": "blocked", "type": "string"},
        "performance_claims": {"const": "forbidden", "type": "string"},
        "perceptual_quality_claims": {"const": "forbidden", "type": "string"},
        "phase_status": {"const": "in_progress", "type": "string"},
        "product_qualification": {"const": "only_by_complete_derived_v2_decision", "type": "string"},
        "production_default": {"const": "not_enabled", "type": "string"},
        "publication": {"const": "not_authorized_by_this_record", "type": "string"},
        "release": {"const": "not_authorized", "type": "string"}
      },
      "required": ["phase_status", "product_qualification", "production_default", "auto_mode", "holdout", "acceptance", "perceptual_quality_claims", "performance_claims", "publication", "release"],
      "type": "object"
    }
  },
  "required": ["schema_version", "roadmap_version", "phase_id", "contract_id", "preregistration_state", "historical_v1_bindings", "schema_bindings", "fixture_catalog_binding", "candidate_contract", "execution_contract", "observation_policy", "metrics", "checks", "stop_rules", "optional_evidence_paths", "authorization_boundary"],
  "type": "object"
}
