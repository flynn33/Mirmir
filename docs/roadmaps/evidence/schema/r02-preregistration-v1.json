{
  "$id": "https://mirmir.local/docs/roadmaps/evidence/schema/r02-preregistration-v1.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "closedStatement": {
      "additionalProperties": false,
      "properties": {
        "description": {
          "minLength": 1,
          "type": "string"
        },
        "id": {
          "pattern": "^[a-z][a-z0-9_]{0,63}$",
          "type": "string"
        }
      },
      "required": [
        "id",
        "description"
      ],
      "type": "object"
    },
    "fileBinding": {
      "additionalProperties": false,
      "properties": {
        "path": {
          "minLength": 1,
          "type": "string"
        },
        "sha256": {
          "pattern": "^(?!0{64}$)[0-9a-f]{64}$",
          "type": "string"
        },
        "size_bytes": {
          "minimum": 1,
          "type": "integer"
        }
      },
      "required": [
        "path",
        "size_bytes",
        "sha256"
      ],
      "type": "object"
    },
    "sha1OrNull": {
      "oneOf": [
        {
          "pattern": "^(?!0{40}$)[0-9a-f]{40}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "additionalProperties": false,
  "properties": {
    "authorization_boundary": {
      "additionalProperties": false,
      "properties": {
        "auto_mode": {
          "const": "blocked",
          "type": "string"
        },
        "holdout": {
          "const": "blocked",
          "type": "string"
        },
        "performance_claims": {
          "const": "forbidden",
          "type": "string"
        },
        "production_upscaling": {
          "const": "unavailable",
          "type": "string"
        },
        "publication": {
          "const": "not_authorized_by_this_record",
          "type": "string"
        },
        "release": {
          "const": "not_authorized",
          "type": "string"
        }
      },
      "required": [
        "production_upscaling",
        "auto_mode",
        "holdout",
        "release",
        "publication",
        "performance_claims"
      ],
      "type": "object"
    },
    "contract": {
      "additionalProperties": false,
      "properties": {
        "capability_registry": {
          "additionalProperties": false,
          "properties": {
            "eligibility_inference": {
              "const": "forbidden",
              "type": "string"
            },
            "immutability": {
              "const": "snapshot",
              "type": "string"
            },
            "source_binding": {
              "additionalProperties": false,
              "properties": {
                "path": {
                  "const": "project-notes/apple-upscale-capabilities.json",
                  "type": "string"
                },
                "sha256": {
                  "pattern": "^(?!0{64}$)[0-9a-f]{64}$",
                  "type": "string"
                },
                "size_bytes": {
                  "minimum": 1,
                  "type": "integer"
                }
              },
              "required": [
                "path",
                "size_bytes",
                "sha256"
              ],
              "type": "object"
            },
            "unobserved_disposition": {
              "const": "preserve_diagnostic_only",
              "type": "string"
            }
          },
          "required": [
            "source_binding",
            "immutability",
            "unobserved_disposition",
            "eligibility_inference"
          ],
          "type": "object"
        },
        "backend_contract": {
          "additionalProperties": false,
          "properties": {
            "capability_source": {
              "const": "explicit_immutable_registry_only",
              "type": "string"
            },
            "fallback_owner": {
              "const": "planner_orchestrator_only",
              "type": "string"
            },
            "fixture_backend_identities": {
              "items": {
                "enum": [
                  "r02.fixture.copy-a",
                  "r02.fixture.copy-b"
                ],
                "type": "string"
              },
              "maxItems": 2,
              "minItems": 2,
              "type": "array",
              "uniqueItems": true
            },
            "minimum_deterministic_backends": {
              "const": 2,
              "type": "integer"
            },
            "session_contract": {
              "const": "apple-upscale-session-v1",
              "type": "string"
            }
          },
          "required": [
            "minimum_deterministic_backends",
            "fixture_backend_identities",
            "session_contract",
            "capability_source",
            "fallback_owner"
          ],
          "type": "object"
        },
        "frame_fields": {
          "items": {
            "type": "string"
          },
          "maxItems": 7,
          "minItems": 7,
          "type": "array",
          "uniqueItems": true
        },
        "fixture_generator": {
          "additionalProperties": false,
          "properties": {
            "generator_contract": {
              "const": "r02-deterministic-contract-fixtures-v1",
              "type": "string"
            },
            "source_binding": {
              "additionalProperties": false,
              "properties": {
                "path": {
                  "const": "Scripts/r02_fixture_generator.py",
                  "type": "string"
                },
                "sha256": {
                  "pattern": "^(?!0{64}$)[0-9a-f]{64}$",
                  "type": "string"
                },
                "size_bytes": {
                  "minimum": 1,
                  "type": "integer"
                }
              },
              "required": [
                "path",
                "size_bytes",
                "sha256"
              ],
              "type": "object"
            }
          },
          "required": [
            "generator_contract",
            "source_binding"
          ],
          "type": "object"
        },
        "lifecycle_requirements": {
          "items": {
            "$ref": "#/$defs/closedStatement"
          },
          "maxItems": 8,
          "minItems": 8,
          "type": "array"
        },
        "outcome_vocabulary": {
          "items": {
            "enum": [
              "processed",
              "unavailable",
              "rejected",
              "failed",
              "fallback_applied"
            ],
            "type": "string"
          },
          "maxItems": 5,
          "minItems": 5,
          "type": "array",
          "uniqueItems": true
        },
        "planner_contract": {
          "const": "exactly_one_primary_deterministic_order_explicit_fallback",
          "type": "string"
        },
        "processing_identity_fields": {
          "items": {
            "type": "string"
          },
          "maxItems": 7,
          "minItems": 7,
          "type": "array",
          "uniqueItems": true
        },
        "production_composition": {
          "const": "unavailable",
          "type": "string"
        },
        "scenarios": {
          "items": {
            "$ref": "#/$defs/closedStatement"
          },
          "maxItems": 15,
          "minItems": 15,
          "type": "array"
        },
        "schema_bindings": {
          "additionalProperties": false,
          "properties": {
            "conformance": {
              "$ref": "#/$defs/fileBinding"
            },
            "fixture_catalog": {
              "$ref": "#/$defs/fileBinding"
            },
            "preregistration": {
              "$ref": "#/$defs/fileBinding"
            }
          },
          "required": [
            "preregistration",
            "fixture_catalog",
            "conformance"
          ],
          "type": "object"
        },
        "stage_protocols": {
          "items": {
            "enum": [
              "preprocessing",
              "primary_scaling",
              "postprocessing",
              "temporal",
              "analysis"
            ],
            "type": "string"
          },
          "maxItems": 5,
          "minItems": 5,
          "type": "array",
          "uniqueItems": true
        }
      },
      "required": [
        "capability_registry",
        "backend_contract",
        "fixture_generator",
        "lifecycle_requirements",
        "frame_fields",
        "outcome_vocabulary",
        "stage_protocols",
        "planner_contract",
        "processing_identity_fields",
        "scenarios",
        "schema_bindings",
        "production_composition"
      ],
      "type": "object"
    },
    "fixture_catalog": {
      "additionalProperties": false,
      "properties": {
        "path": {
          "const": "docs/roadmaps/evidence/r02/records/fixtures/fixture-catalog.json",
          "type": "string"
        },
        "sha256": {
          "pattern": "^(?!0{64}$)[0-9a-f]{64}$",
          "type": "string"
        },
        "size_bytes": {
          "minimum": 1,
          "type": "integer"
        }
      },
      "required": [
        "path",
        "size_bytes",
        "sha256"
      ],
      "type": "object"
    },
    "metrics": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "direction": {
            "enum": [
              "lower_is_better",
              "higher_is_better"
            ],
            "type": "string"
          },
          "floor": {
            "minimum": 0,
            "type": "integer"
          },
          "id": {
            "pattern": "^[a-z][a-z0-9_]{0,63}$",
            "type": "string"
          },
          "operator": {
            "enum": [
              "equal",
              "greater_than_or_equal"
            ],
            "type": "string"
          },
          "unit": {
            "const": "count",
            "type": "string"
          }
        },
        "required": [
          "id",
          "unit",
          "direction",
          "operator",
          "floor"
        ],
        "type": "object"
      },
      "maxItems": 18,
      "minItems": 18,
      "type": "array"
    },
    "observation_policy": {
      "additionalProperties": false,
      "properties": {
        "deterministic_software_conformance": {
          "const": "required",
          "type": "string"
        },
        "hardware_capability_observation": {
          "const": "not_observed",
          "type": "string"
        },
        "operator_observed_operation": {
          "const": "not_observed",
          "type": "string"
        },
        "performance_claims": {
          "const": "forbidden",
          "type": "string"
        },
        "requirement": {
          "const": "waived_not_a_blocker",
          "type": "string"
        },
        "simulator_execution": {
          "const": "not_observed",
          "type": "string"
        }
      },
      "required": [
        "requirement",
        "hardware_capability_observation",
        "simulator_execution",
        "operator_observed_operation",
        "deterministic_software_conformance",
        "performance_claims"
      ],
      "type": "object"
    },
    "phase_id": {
      "const": "R02",
      "type": "string"
    },
    "predecessor_binding": {
      "additionalProperties": false,
      "properties": {
        "acceptance_state": {
          "const": "not_claimed",
          "type": "string"
        },
        "accepted_merge_commit": {
          "$ref": "#/$defs/sha1OrNull"
        },
        "closure_commit": {
          "pattern": "^(?!0{40}$)[0-9a-f]{40}$",
          "type": "string"
        },
        "closure_state": {
          "const": "local_unpublished_closure",
          "type": "string"
        },
        "closure_tree": {
          "pattern": "^(?!0{40}$)[0-9a-f]{40}$",
          "type": "string"
        },
        "continuation_scope": {
          "const": "local_implementation_only",
          "type": "string"
        },
        "phase_id": {
          "const": "R01",
          "type": "string"
        }
      },
      "required": [
        "phase_id",
        "closure_state",
        "closure_commit",
        "closure_tree",
        "accepted_merge_commit",
        "acceptance_state",
        "continuation_scope"
      ],
      "type": "object"
    },
    "preregistration_state": {
      "const": "contract_frozen_for_local_implementation",
      "type": "string"
    },
    "roadmap_version": {
      "const": "1.0.1",
      "type": "string"
    },
    "schema_version": {
      "const": "1.0.0",
      "type": "string"
    },
    "stop_rules": {
      "items": {
        "$ref": "#/$defs/closedStatement"
      },
      "maxItems": 10,
      "minItems": 10,
      "type": "array"
    }
  },
  "required": [
    "schema_version",
    "roadmap_version",
    "phase_id",
    "preregistration_state",
    "predecessor_binding",
    "observation_policy",
    "fixture_catalog",
    "contract",
    "metrics",
    "stop_rules",
    "authorization_boundary"
  ],
  "type": "object"
}
