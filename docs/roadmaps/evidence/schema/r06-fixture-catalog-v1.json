{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mirmir.invalid/schema/r06-fixture-catalog-v1.json",
  "title": "Mirmir R06 ASH orchestration fixture catalog",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "phase_id",
    "contract_id",
    "source_bindings",
    "constructor_parameters",
    "policy_profiles",
    "backend_fixtures",
    "decision_context_fixtures",
    "mask_fixtures",
    "transition_fixtures",
    "ablation_scenarios"
  ],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "phase_id": {"const": "R06"},
    "contract_id": {"const": "r06-ash-orchestration-fixtures-v1"},
    "source_bindings": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/sourceBinding"}
    },
    "constructor_parameters": {"$ref": "#/$defs/constructorParameters"},
    "policy_profiles": {
      "type": "array",
      "minItems": 16,
      "maxItems": 16,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/policyProfile"}
    },
    "backend_fixtures": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/backendFixture"}
    },
    "decision_context_fixtures": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/contextFixture"}
    },
    "mask_fixtures": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/maskFixture"}
    },
    "transition_fixtures": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/transitionFixture"}
    },
    "ablation_scenarios": {
      "type": "array",
      "minItems": 6,
      "maxItems": 6,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/ablationScenario"}
    }
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "sourceBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "path", "size_bytes", "sha256"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "path": {"type": "string", "minLength": 1},
        "size_bytes": {"type": "integer", "minimum": 1},
        "sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "weights": {
      "type": "object",
      "additionalProperties": false,
      "required": ["quality_confidence", "message_alignment", "artifact_risk_penalty", "transition_cost_penalty", "resource_cost_penalty", "postflight_penalty"],
      "properties": {
        "quality_confidence": {"type": "integer", "minimum": 0},
        "message_alignment": {"type": "integer", "minimum": 0},
        "artifact_risk_penalty": {"type": "integer", "minimum": 0},
        "transition_cost_penalty": {"type": "integer", "minimum": 0},
        "resource_cost_penalty": {"type": "integer", "minimum": 0},
        "postflight_penalty": {"type": "integer", "minimum": 0}
      }
    },
    "thresholds": {
      "type": "object",
      "additionalProperties": false,
      "required": ["hysteresis_margin_q16", "minimum_dwell_frames", "scene_cut_confidence_q16", "mask_minimum_q15", "mask_maximum_q15", "mask_maximum_width", "mask_maximum_height"],
      "properties": {
        "hysteresis_margin_q16": {"type": "integer", "minimum": 0, "maximum": 65536},
        "minimum_dwell_frames": {"type": "integer", "minimum": 1},
        "scene_cut_confidence_q16": {"type": "integer", "minimum": 0, "maximum": 65536},
        "mask_minimum_q15": {"const": 0},
        "mask_maximum_q15": {"const": 32767},
        "mask_maximum_width": {"type": "integer", "minimum": 1},
        "mask_maximum_height": {"type": "integer", "minimum": 1}
      }
    },
    "constructorParameters": {
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "fixed_point_scale", "weights", "thresholds", "fatal_backend_error_bypasses_hysteresis_and_dwell"],
      "properties": {
        "version": {"const": "r06.parameters.v1"},
        "fixed_point_scale": {"const": 65536},
        "weights": {"$ref": "#/$defs/weights"},
        "thresholds": {"$ref": "#/$defs/thresholds"},
        "fatal_backend_error_bypasses_hysteresis_and_dwell": {"const": true}
      }
    },
    "bits": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "items": {"type": "integer", "enum": [0, 1]}
    },
    "policyProfile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "raw_value", "bits", "denoise", "primary_backend_preference", "postprocess", "temporal_history"],
      "properties": {
        "id": {"type": "string", "pattern": "^policy\\.message\\.[0-9]{2}$"},
        "raw_value": {"type": "integer", "minimum": 0, "maximum": 15},
        "bits": {"$ref": "#/$defs/bits"},
        "denoise": {"enum": ["off", "low"]},
        "primary_backend_preference": {"enum": ["spatial", "temporal"]},
        "postprocess": {"enum": ["conservative", "detail_oriented"]},
        "temporal_history": {"enum": ["retain", "reset"]}
      }
    },
    "scoreComponents": {
      "type": "object",
      "additionalProperties": false,
      "required": ["quality_confidence_q16", "message_alignment_q16", "artifact_risk_q16", "transition_cost_q16", "resource_cost_q16", "postflight_penalty_q16"],
      "properties": {
        "quality_confidence_q16": {"type": "integer", "minimum": 0, "maximum": 65536},
        "message_alignment_q16": {"type": "integer", "minimum": 0, "maximum": 65536},
        "artifact_risk_q16": {"type": "integer", "minimum": 0, "maximum": 65536},
        "transition_cost_q16": {"type": "integer", "minimum": 0, "maximum": 65536},
        "resource_cost_q16": {"type": "integer", "minimum": 0, "maximum": 65536},
        "postflight_penalty_q16": {"type": "integer", "minimum": 0, "maximum": 65536}
      }
    },
    "backendFixture": {
      "type": "object",
      "additionalProperties": false,
      "required": ["backend_id", "route_id", "fixture_eligible", "product_qualified", "whole_frame_only", "score_components"],
      "properties": {
        "backend_id": {"type": "string", "minLength": 1},
        "route_id": {"type": "string", "minLength": 1},
        "fixture_eligible": {"const": true},
        "product_qualified": {"const": false},
        "whole_frame_only": {"const": true},
        "score_components": {"$ref": "#/$defs/scoreComponents"}
      }
    },
    "contextFixture": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "current_state_raw", "previous_state_raw", "message_raw", "dwell_frames", "scene_cut_confidence_q16", "fatal_backend_id", "current_backend_id", "postflight_risk_q16"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "current_state_raw": {"type": "integer", "minimum": 0, "maximum": 511},
        "previous_state_raw": {"type": "integer", "minimum": 0, "maximum": 511},
        "message_raw": {"type": "integer", "minimum": 0, "maximum": 15},
        "dwell_frames": {"type": "integer", "minimum": 0},
        "scene_cut_confidence_q16": {"type": "integer", "minimum": 0, "maximum": 65536},
        "fatal_backend_id": {"type": ["string", "null"]},
        "current_backend_id": {"type": ["string", "null"]},
        "postflight_risk_q16": {"type": "integer", "minimum": 0, "maximum": 65536}
      }
    },
    "maskFixture": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "width", "height", "samples_q15"],
      "properties": {
        "id": {"enum": ["luma_protection", "chroma_protection", "postprocess_suppression"]},
        "width": {"type": "integer", "minimum": 1, "maximum": 64},
        "height": {"type": "integer", "minimum": 1, "maximum": 64},
        "samples_q15": {"type": "array", "minItems": 1, "items": {"type": "integer", "minimum": 0, "maximum": 32767}}
      }
    },
    "transitionFixture": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "context_fixture_id", "candidate_route_ids", "expected_selected_route_id", "expected_reason"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "context_fixture_id": {"type": "string", "minLength": 1},
        "candidate_route_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "expected_selected_route_id": {"type": ["string", "null"]},
        "expected_reason": {"type": "string", "minLength": 1}
      }
    },
    "ablationScenario": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "fixture_contract_status", "product_execution_status", "required_context_fixture_ids"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "fixture_contract_status": {"const": "deterministic_fixture_only"},
        "product_execution_status": {"const": "not_observed"},
        "required_context_fixture_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
      }
    }
  }
}
