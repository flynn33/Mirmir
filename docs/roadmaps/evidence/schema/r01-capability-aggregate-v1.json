{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mirmir.local/docs/roadmaps/evidence/schema/r01-capability-aggregate-v1.json",
  "title": "Mirmir R01 aggregate capability report v1",
  "$defs": {
    "gitObjectID": {
      "type": "string",
      "pattern": "^(?!0{40}$)[0-9a-f]{40}$"
    },
    "sourceReportBinding": {
      "type": "object",
      "required": ["path", "size_bytes", "sha256"],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1,
          "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.?/)(?!.*\\\\)[^\\u0000]+$"
        },
        "size_bytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 26214400
        },
        "sha256": {
          "type": "string",
          "pattern": "^(?!0{64}$)[0-9a-f]{64}$"
        }
      },
      "additionalProperties": false
    },
    "anchor": {
      "type": "object",
      "required": [
        "anchor",
        "generated_at",
        "host",
        "source_report_binding",
        "limitations"
      ],
      "properties": {
        "anchor": {
          "enum": ["oldest-supported", "m3-air", "pro-max", "core-ai"]
        },
        "generated_at": {
          "type": "string",
          "format": "date-time",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]+)?(?:Z|[+-][0-9]{2}:[0-9]{2})$"
        },
        "host": {
          "$ref": "r01-host-report-v1.json#/$defs/host"
        },
        "source_report_binding": {"$ref": "#/$defs/sourceReportBinding"},
        "limitations": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "r01-host-report-v1.json#/$defs/sanitizedString"
          }
        }
      },
      "additionalProperties": false
    },
    "anchors": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "prefixItems": [
        {
          "allOf": [
            {"$ref": "#/$defs/anchor"},
            {
              "properties": {
                "anchor": {"const": "oldest-supported"},
                "source_report_binding": {
                  "properties": {
                    "path": {
                      "const": "project-notes/evidence/r01/hosts/anchor-oldest-supported.json"
                    }
                  }
                }
              }
            }
          ]
        },
        {
          "allOf": [
            {"$ref": "#/$defs/anchor"},
            {
              "properties": {
                "anchor": {"const": "m3-air"},
                "source_report_binding": {
                  "properties": {
                    "path": {
                      "const": "project-notes/evidence/r01/hosts/anchor-m3-air.json"
                    }
                  }
                }
              }
            }
          ]
        },
        {
          "allOf": [
            {"$ref": "#/$defs/anchor"},
            {
              "properties": {
                "anchor": {"const": "pro-max"},
                "source_report_binding": {
                  "properties": {
                    "path": {
                      "const": "project-notes/evidence/r01/hosts/anchor-pro-max.json"
                    }
                  }
                }
              }
            }
          ]
        },
        {
          "allOf": [
            {"$ref": "#/$defs/anchor"},
            {
              "properties": {
                "anchor": {"const": "core-ai"},
                "source_report_binding": {
                  "properties": {
                    "path": {
                      "const": "project-notes/evidence/r01/hosts/anchor-core-ai.json"
                    }
                  }
                }
              }
            }
          ]
        }
      ],
      "items": false
    },
    "anchorCapability": {
      "type": "object",
      "required": ["anchor", "report"],
      "properties": {
        "anchor": {
          "enum": ["oldest-supported", "m3-air", "pro-max", "core-ai"]
        },
        "report": {
          "$ref": "r01-host-report-v1.json#/$defs/capability"
        }
      },
      "additionalProperties": false
    },
    "anchorCapabilities": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "prefixItems": [
        {
          "allOf": [
            {"$ref": "#/$defs/anchorCapability"},
            {"properties": {"anchor": {"const": "oldest-supported"}}}
          ]
        },
        {
          "allOf": [
            {"$ref": "#/$defs/anchorCapability"},
            {"properties": {"anchor": {"const": "m3-air"}}}
          ]
        },
        {
          "allOf": [
            {"$ref": "#/$defs/anchorCapability"},
            {"properties": {"anchor": {"const": "pro-max"}}}
          ]
        },
        {
          "allOf": [
            {"$ref": "#/$defs/anchorCapability"},
            {"properties": {"anchor": {"const": "core-ai"}}}
          ]
        }
      ],
      "items": false
    },
    "capability": {
      "type": "object",
      "required": ["id", "family", "method", "probe_class", "anchor_records"],
      "properties": {
        "id": {"pattern": "^A(?:0[1-9]|1[0-8])$"},
        "family": {
          "enum": ["VideoToolbox", "MetalFX", "MPS", "CoreImage", "Accelerate", "Metal", "CoreAI"]
        },
        "method": {
          "$ref": "r01-host-report-v1.json#/$defs/sanitizedString"
        },
        "probe_class": {
          "enum": ["primary_scaler", "support_filter", "temporal_analyzer", "cadence_transform", "analysis_runtime"]
        },
        "anchor_records": {"$ref": "#/$defs/anchorCapabilities"}
      },
      "additionalProperties": false
    },
    "capabilities": {
      "type": "array",
      "minItems": 18,
      "maxItems": 18,
      "prefixItems": [
        {"allOf": [{"$ref": "#/$defs/capability"}, {"properties": {"id": {"const": "A01"}, "family": {"const": "VideoToolbox"}, "method": {"const": "VTSuperResolutionScaler"}, "probe_class": {"const": "primary_scaler"}}}]},
        {"allOf": [{"$ref": "#/$defs/capability"}, {"properties": {"id": {"const": "A02"}, "family": {"const": "VideoToolbox"}, "method": {"const": "VTLowLatencySuperResolutionScaler"}, "probe_class": {"const": "primary_scaler"}}}]},
        {"allOf": [{"$ref": "#/$defs/capability"}, {"properties": {"id": {"const": "A03"}, "family": {"const": "VideoToolbox"}, "method": {"const": "VTLowLatencyFrameInterpolation spatial scaling"}, "probe_class": {"const": "cadence_transform"}}}]},
        {"allOf": [{"$ref": "#/$defs/capability"}, {"properties": {"id": {"const": "A04"}, "family": {"const": "VideoToolbox"}, "method": {"const": "VTTemporalNoiseFilter"}, "probe_class": {"const": "support_filter"}}}]},
        {"allOf": [{"$ref": "#/$defs/capability"}, {"properties": {"id": {"const": "A05"}, "family": {"const": "VideoToolbox"}, "method": {"const": "VTOpticalFlow"}, "probe_class": {"const": "temporal_analyzer"}}}]},
        {"allOf": [{"$ref": "#/$defs/capability"}, {"properties": {"id": {"const": "A06"}, "family": {"const": "VideoToolbox"}, "method": {"const": "VTPixelTransferSession"}, "probe_class": {"const": "primary_scaler"}}}]},
        {"allOf": [{"$ref": "#/$defs/capability"}, {"properties": {"id": {"const": "A07"}, "family": {"const": "MetalFX"}, "method": {"const": "Spatial scaler"}, "probe_class": {"const": "primary_scaler"}}}]},
        {"allOf": [{"$ref": "#/$defs/capability"}, {"properties": {"id": {"const": "A08"}, "family": {"const": "MetalFX"}, "method": {"const": "Temporal scaler"}, "probe_class": {"const": "primary_scaler"}}}]},
        {"allOf": [{"$ref": "#/$defs/capability"}, {"properties": {"id": {"const": "A09"}, "family": {"const": "MetalFX"}, "method": {"const": "Temporal denoised scaler"}, "probe_class": {"const": "primary_scaler"}}}]},
        {"allOf": [{"$ref": "#/$defs/capability"}, {"properties": {"id": {"const": "A10"}, "family": {"const": "MetalFX"}, "method": {"const": "Frame interpolator"}, "probe_class": {"const": "cadence_transform"}}}]},
        {"allOf": [{"$ref": "#/$defs/capability"}, {"properties": {"id": {"const": "A11"}, "family": {"const": "MPS"}, "method": {"const": "MPSImageLanczosScale"}, "probe_class": {"const": "primary_scaler"}}}]},
        {"allOf": [{"$ref": "#/$defs/capability"}, {"properties": {"id": {"const": "A12"}, "family": {"const": "MPS"}, "method": {"const": "MPSImageBilinearScale"}, "probe_class": {"const": "primary_scaler"}}}]},
        {"allOf": [{"$ref": "#/$defs/capability"}, {"properties": {"id": {"const": "A13"}, "family": {"const": "MPS"}, "method": {"const": "Guided/detail/artifact filters"}, "probe_class": {"const": "support_filter"}}}]},
        {"allOf": [{"$ref": "#/$defs/capability"}, {"properties": {"id": {"const": "A14"}, "family": {"const": "CoreImage"}, "method": {"const": "Lanczos/Bicubic scale"}, "probe_class": {"const": "primary_scaler"}}}]},
        {"allOf": [{"$ref": "#/$defs/capability"}, {"properties": {"id": {"const": "A15"}, "family": {"const": "CoreImage"}, "method": {"const": "EdgePreserveUpsample"}, "probe_class": {"const": "support_filter"}}}]},
        {"allOf": [{"$ref": "#/$defs/capability"}, {"properties": {"id": {"const": "A16"}, "family": {"const": "Accelerate"}, "method": {"const": "vImage Lanczos-3/Lanczos-5/custom"}, "probe_class": {"const": "primary_scaler"}}}]},
        {"allOf": [{"$ref": "#/$defs/capability"}, {"properties": {"id": {"const": "A17"}, "family": {"const": "Metal"}, "method": {"const": "Custom compute"}, "probe_class": {"const": "support_filter"}}}]},
        {"allOf": [{"$ref": "#/$defs/capability"}, {"properties": {"id": {"const": "A18"}, "family": {"const": "CoreAI"}, "method": {"const": "Custom model runtime"}, "probe_class": {"const": "analysis_runtime"}}}]}
      ],
      "items": false
    }
  },
  "type": "object",
  "required": [
    "schema_version",
    "roadmap_version",
    "phase_id",
    "source_commit",
    "source_tree",
    "generated_at",
    "anchors",
    "capabilities"
  ],
  "properties": {
    "schema_version": {"const": "1.0"},
    "roadmap_version": {"const": "1.0.1"},
    "phase_id": {"const": "R01"},
    "source_commit": {"$ref": "#/$defs/gitObjectID"},
    "source_tree": {"$ref": "#/$defs/gitObjectID"},
    "generated_at": {
      "type": "string",
      "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]+)?(?:Z|[+-][0-9]{2}:[0-9]{2})$"
    },
    "anchors": {"$ref": "#/$defs/anchors"},
    "capabilities": {"$ref": "#/$defs/capabilities"}
  },
  "additionalProperties": false
}
