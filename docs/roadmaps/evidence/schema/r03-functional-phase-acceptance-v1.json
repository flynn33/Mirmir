{
  "$id": "https://mirmir.local/docs/roadmaps/evidence/schema/r03-functional-phase-acceptance-v1.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "binding": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "enum": [
            "r02_session_conformance",
            "r03_v2_execution_receipt",
            "r03_v2_qualification_decision"
          ],
          "type": "string"
        },
        "path": {"minLength": 1, "type": "string"},
        "sha256": {"pattern": "^(?!0{64}$)[0-9a-f]{64}$", "type": "string"},
        "size_bytes": {"minimum": 1, "type": "integer"}
      },
      "required": ["id", "path", "size_bytes", "sha256"],
      "type": "object"
    },
    "passedCheck": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "enum": [
            "source_checkpoint_exact",
            "evidence_bindings_exact",
            "r02_common_session_conformance",
            "r03_v2_decision_valid",
            "genuine_mps_execution",
            "canonical_routes",
            "three_repeat_determinism",
            "media_transaction_preservation",
            "lifecycle_and_resource_lifetime",
            "identity_and_no_fallback",
            "functional_metrics",
            "truthful_observation_boundary"
          ],
          "type": "string"
        },
        "status": {"const": "passed", "type": "string"}
      },
      "required": ["id", "status"],
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schema_version": {"const": "1.0.0", "type": "string"},
    "roadmap_version": {"const": "1.0.1", "type": "string"},
    "phase_id": {"const": "R03", "type": "string"},
    "evidence_kind": {
      "const": "r03_operator_functional_phase_acceptance_v1",
      "type": "string"
    },
    "source": {
      "additionalProperties": false,
      "properties": {
        "commit": {
          "const": "b5c19c0040f845b7f32fe98bd5f01249c1b071f2",
          "type": "string"
        },
        "tree": {
          "const": "74e39285521fe31f9588cff5e43184c8f91f9180",
          "type": "string"
        }
      },
      "required": ["commit", "tree"],
      "type": "object"
    },
    "operator_override": {
      "additionalProperties": false,
      "properties": {
        "authority": {"const": "operator", "type": "string"},
        "authorization_date": {"const": "2026-07-21", "type": "string"},
        "acceptance_basis": {
          "const": "software_performs_intended_task",
          "type": "string"
        },
        "override_id": {
          "const": "r03.software-function-phase-acceptance.v1",
          "type": "string"
        },
        "hardware_simulator_operator_observation": {
          "const": "waived_not_a_blocker",
          "type": "string"
        },
        "historical_evidence_policy": {
          "const": "preserve_r03_v1_and_v2_unchanged",
          "type": "string"
        }
      },
      "required": [
        "authority",
        "authorization_date",
        "acceptance_basis",
        "override_id",
        "hardware_simulator_operator_observation",
        "historical_evidence_policy"
      ],
      "type": "object"
    },
    "superseded_gate": {
      "additionalProperties": false,
      "properties": {
        "gate": {
          "const": "One baseline matrix establishes the quality/performance/resource envelope of every deterministic Apple path.",
          "type": "string"
        },
        "disposition": {
          "const": "superseded_for_r03_phase_acceptance",
          "type": "string"
        },
        "retained_value": {
          "const": "optional_comparative_evidence",
          "type": "string"
        }
      },
      "required": ["gate", "disposition", "retained_value"],
      "type": "object"
    },
    "functional_gate": {
      "additionalProperties": false,
      "properties": {
        "backend_id": {"const": "r03.mps.lanczos", "type": "string"},
        "capability_id": {"const": "A11", "type": "string"},
        "framework": {"const": "MetalPerformanceShaders", "type": "string"},
        "framework_symbol": {"const": "MPSImageLanczosScale", "type": "string"},
        "qualification_scope": {
          "const": "functional_product_eligibility",
          "type": "string"
        },
        "required_route_ids": {
          "const": ["scale_3_over_2", "scale_2x"],
          "type": "array"
        },
        "repeat_count_per_route": {"const": 3, "type": "integer"},
        "required_media_contract": {
          "const": "1920x1080_to_3840x2160_h264_aac_timing_metadata_reopen_atomic",
          "type": "string"
        },
        "required_lifecycle_contract": {
          "const": "apple-upscale-session-v1",
          "type": "string"
        },
        "fallback_policy": {"const": "none", "type": "string"},
        "functional_metric_ids": {
          "items": {"minLength": 1, "type": "string"},
          "minItems": 1,
          "type": "array"
        }
      },
      "required": [
        "backend_id",
        "capability_id",
        "framework",
        "framework_symbol",
        "qualification_scope",
        "required_route_ids",
        "repeat_count_per_route",
        "required_media_contract",
        "required_lifecycle_contract",
        "fallback_policy",
        "functional_metric_ids"
      ],
      "type": "object"
    },
    "evidence_bindings": {
      "items": {"$ref": "#/$defs/binding"},
      "maxItems": 3,
      "minItems": 3,
      "type": "array"
    },
    "qualification_source": {
      "additionalProperties": false,
      "properties": {
        "commit": {"pattern": "^[0-9a-f]{40}$", "type": "string"},
        "tree": {"pattern": "^[0-9a-f]{40}$", "type": "string"}
      },
      "required": ["commit", "tree"],
      "type": "object"
    },
    "derived_checks": {
      "items": {"$ref": "#/$defs/passedCheck"},
      "maxItems": 12,
      "minItems": 12,
      "type": "array"
    },
    "result": {
      "additionalProperties": false,
      "properties": {
        "status": {"const": "passed", "type": "string"},
        "phase_status_before": {"const": "in_progress", "type": "string"},
        "phase_status_after": {"const": "passed", "type": "string"},
        "acceptance": {"const": "accepted", "type": "string"},
        "accepted_backend_id": {"const": "r03.mps.lanczos", "type": "string"},
        "acceptance_scope": {
          "const": "functional_software_phase_acceptance",
          "type": "string"
        }
      },
      "required": [
        "status",
        "phase_status_before",
        "phase_status_after",
        "acceptance",
        "accepted_backend_id",
        "acceptance_scope"
      ],
      "type": "object"
    },
    "authorizations": {
      "additionalProperties": false,
      "properties": {
        "phase_progression": {"const": "authorized", "type": "string"},
        "product_qualification": {
          "const": "r03.mps.lanczos_A11_only",
          "type": "string"
        },
        "production_default": {"const": "not_authorized", "type": "string"},
        "auto_mode": {"const": "blocked", "type": "string"},
        "holdout": {"const": "blocked", "type": "string"},
        "perceptual_quality_claims": {"const": "not_authorized", "type": "string"},
        "performance_claims": {"const": "not_authorized", "type": "string"},
        "product_publication": {"const": "not_authorized", "type": "string"},
        "release": {"const": "not_authorized", "type": "string"}
      },
      "required": [
        "phase_progression",
        "product_qualification",
        "production_default",
        "auto_mode",
        "holdout",
        "perceptual_quality_claims",
        "performance_claims",
        "product_publication",
        "release"
      ],
      "type": "object"
    },
    "limitations": {
      "items": {"minLength": 1, "type": "string"},
      "maxItems": 3,
      "minItems": 3,
      "type": "array"
    }
  },
  "required": [
    "schema_version",
    "roadmap_version",
    "phase_id",
    "evidence_kind",
    "source",
    "operator_override",
    "superseded_gate",
    "functional_gate",
    "evidence_bindings",
    "qualification_source",
    "derived_checks",
    "result",
    "authorizations",
    "limitations"
  ],
  "type": "object"
}
