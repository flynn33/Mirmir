{
  "$id": "https://github.com/flynn33/Mirmir/docs/roadmaps/evidence/schema/r13-functional-phase-acceptance-v1.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "checks": {
      "items": {
        "$ref": "#/$defs/check"
      },
      "maxItems": 19,
      "minItems": 19,
      "type": "array"
    },
    "claim_boundary": {
      "$ref": "#/$defs/claimBoundary"
    },
    "comparison_policy": {
      "$ref": "#/$defs/comparisonPolicy"
    },
    "distribution_boundary": {
      "$ref": "#/$defs/distributionBoundary"
    },
    "evidence_kind": {
      "const": "r13_functional_phase_acceptance_v1"
    },
    "execution_receipt_binding": {
      "$ref": "#/$defs/fileBinding"
    },
    "execution_boundary": {
      "$ref": "#/$defs/executionBoundary"
    },
    "functional_gate": {
      "$ref": "#/$defs/functionalGate"
    },
    "limitations": {
      "$ref": "#/$defs/limitations"
    },
    "observations": {
      "$ref": "#/$defs/observations"
    },
    "phase_id": {
      "const": "R13"
    },
    "release_candidate_receipt_binding": {
      "$ref": "#/$defs/fileBinding"
    },
    "roadmap_version": {
      "const": "1.0.1"
    },
    "schema_version": {
      "const": "1.0.0"
    },
    "source": {
      "$ref": "#/$defs/source"
    }
  },
  "required": [
    "schema_version",
    "roadmap_version",
    "phase_id",
    "evidence_kind",
    "source",
    "execution_receipt_binding",
    "release_candidate_receipt_binding",
    "checks",
    "functional_gate",
    "execution_boundary",
    "distribution_boundary",
    "observations",
    "claim_boundary",
    "comparison_policy",
    "limitations"
  ],
  "title": "R13 functional phase acceptance",
  "type": "object",
  "$defs": {
    "check": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "pattern": "^[a-z0-9_]+$",
          "type": "string"
        },
        "status": {
          "const": "passed"
        }
      },
      "required": [
        "id",
        "status"
      ],
      "type": "object"
    },
    "claimBoundary": {
      "additionalProperties": false,
      "properties": {
        "auto_mode": {
          "const": "not_authorized"
        },
        "claim_scope": {
          "const": "software_behavior_report"
        },
        "fallback": {
          "const": "none"
        },
        "market_claim": {
          "const": "not_authorized"
        },
        "model": {
          "const": "not_required"
        },
        "product_publication": {
          "const": "not_authorized"
        },
        "release_publication": {
          "const": "not_authorized"
        },
        "tag_publication": {
          "const": "not_authorized"
        }
      },
      "required": [
        "auto_mode",
        "claim_scope",
        "fallback",
        "market_claim",
        "model",
        "product_publication",
        "release_publication",
        "tag_publication"
      ],
      "type": "object"
    },
    "comparisonPolicy": {
      "additionalProperties": false,
      "properties": {
        "ab_test": {
          "const": "absent_not_required"
        },
        "acceptance_dependency": {
          "const": "none"
        },
        "comparison_method": {
          "const": "absent_not_required"
        }
      },
      "required": [
        "ab_test",
        "acceptance_dependency",
        "comparison_method"
      ],
      "type": "object"
    },
    "fileBinding": {
      "additionalProperties": false,
      "properties": {
        "path": {
          "minLength": 1,
          "type": "string"
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        },
        "size_bytes": {
          "minimum": 1,
          "type": "integer"
        }
      },
      "required": [
        "path",
        "sha256",
        "size_bytes"
      ],
      "type": "object"
    },
    "distributionBoundary": {
      "additionalProperties": false,
      "properties": {
        "distributable_claim": {
          "const": "not_authorized"
        },
        "distribution_authority": {
          "const": "not_authorized"
        },
        "distribution_signing_identity": {
          "const": "not_observed"
        },
        "gatekeeper": {
          "const": "not_observed"
        },
        "launch_smoke": {
          "const": "not_observed"
        },
        "notarization": {
          "const": "not_observed"
        },
        "notarized_claim": {
          "const": "not_authorized"
        }
      },
      "required": [
        "distributable_claim",
        "distribution_authority",
        "distribution_signing_identity",
        "gatekeeper",
        "launch_smoke",
        "notarization",
        "notarized_claim"
      ],
      "type": "object"
    },
    "executionBoundary": {
      "additionalProperties": false,
      "properties": {
        "output_execution": {
          "const": "debug_xctest_genuine_a11_mps_avfoundation"
        },
        "release_app_execution": {
          "const": "not_observed"
        },
        "release_app_produced_output": {
          "const": false
        }
      },
      "required": [
        "output_execution",
        "release_app_execution",
        "release_app_produced_output"
      ],
      "type": "object"
    },
    "functionalGate": {
      "additionalProperties": false,
      "properties": {
        "acceptance_basis": {
          "const": "software_does_what_it_says_it_does"
        },
        "acceptance_scope": {
          "const": "declared_software_function_only"
        },
        "outcome": {
          "const": "release_ready_candidate"
        },
        "phase_status_after": {
          "const": "passed"
        },
        "phase_status_before": {
          "enum": [
            "evidence_ready",
            "in_progress"
          ]
        },
        "status": {
          "const": "passed"
        }
      },
      "required": [
        "acceptance_basis",
        "acceptance_scope",
        "outcome",
        "phase_status_after",
        "phase_status_before",
        "status"
      ],
      "type": "object"
    },
    "gitOid": {
      "pattern": "^(?!0{40}$)[0-9a-f]{40}$",
      "type": "string"
    },
    "limitations": {
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "minItems": 1,
      "type": "array"
    },
    "observations": {
      "additionalProperties": false,
      "properties": {
        "debug_xctest_mps_lanczos_execution": {
          "const": "observed_both_product_routes"
        },
        "gpu_profiling": {
          "const": "not_observed"
        },
        "hardware_qualification": {
          "const": "not_observed"
        },
        "instruments": {
          "const": "not_observed"
        },
        "nonblocking_for_software_function_acceptance": {
          "const": true
        },
        "operator": {
          "const": "not_observed"
        },
        "release_candidate_gpu_execution": {
          "const": "not_observed"
        },
        "simulator": {
          "const": "not_observed"
        }
      },
      "required": [
        "debug_xctest_mps_lanczos_execution",
        "gpu_profiling",
        "hardware_qualification",
        "instruments",
        "operator",
        "release_candidate_gpu_execution",
        "simulator",
        "nonblocking_for_software_function_acceptance"
      ],
      "type": "object"
    },
    "sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "source": {
      "additionalProperties": false,
      "properties": {
        "commit": {
          "$ref": "#/$defs/gitOid"
        },
        "tree": {
          "$ref": "#/$defs/gitOid"
        }
      },
      "required": [
        "commit",
        "tree"
      ],
      "type": "object"
    }
  }
}
