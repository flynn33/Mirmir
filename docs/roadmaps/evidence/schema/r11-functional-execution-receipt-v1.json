{
  "$id": "https://github.com/flynn33/Mirmir/docs/roadmaps/evidence/schema/r11-functional-execution-receipt-v1.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "acceptance_basis": {
      "const": "software_does_what_it_says_it_does"
    },
    "artifact_bindings": {
      "items": {
        "$ref": "#/$defs/namedFileBinding"
      },
      "minItems": 2,
      "type": "array"
    },
    "claim_boundary": {
      "$ref": "#/$defs/claimBoundary"
    },
    "comparison_policy": {
      "$ref": "#/$defs/comparisonPolicy"
    },
    "contract_bindings": {
      "items": {
        "$ref": "#/$defs/namedFileBinding"
      },
      "minItems": 7,
      "type": "array"
    },
    "evidence_kind": {
      "const": "r11_deterministic_functional_execution_receipt_v1"
    },
    "implementation_bindings": {
      "items": {
        "$ref": "#/$defs/namedFileBinding"
      },
      "minItems": 2,
      "type": "array"
    },
    "limitations": {
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "minItems": 1,
      "type": "array"
    },
    "phase_id": {
      "const": "R11"
    },
    "predecessor_binding": {
      "$ref": "#/$defs/predecessorBinding"
    },
    "roadmap_version": {
      "const": "1.0.1"
    },
    "run_summary": {
      "$ref": "#/$defs/aggregate"
    },
    "schema_version": {
      "const": "1.0.0"
    },
    "source": {
      "$ref": "#/$defs/source"
    },
    "test_execution": {
      "additionalProperties": false,
      "properties": {
        "failed_test_count": {
          "const": 0
        },
        "passed_test_count": {
          "minimum": 1,
          "type": "integer"
        },
        "selected_test_count": {
          "minimum": 1,
          "type": "integer"
        },
        "skipped_test_count": {
          "const": 0
        }
      },
      "required": [
        "selected_test_count",
        "passed_test_count",
        "failed_test_count",
        "skipped_test_count"
      ],
      "type": "object"
    }
  },
  "required": [
    "schema_version",
    "roadmap_version",
    "phase_id",
    "evidence_kind",
    "source",
    "predecessor_binding",
    "contract_bindings",
    "implementation_bindings",
    "artifact_bindings",
    "test_execution",
    "run_summary",
    "acceptance_basis",
    "claim_boundary",
    "comparison_policy",
    "limitations"
  ],
  "title": "R11 functional execution receipt",
  "type": "object",
  "$defs": {
    "aggregate": {
      "additionalProperties": false,
      "properties": {
        "aggregate_state": {
          "enum": [
            "observed",
            "not_applicable",
            "not_observed",
            "failed",
            "absent",
            "mixed"
          ]
        },
        "counts": {
          "additionalProperties": false,
          "properties": {
            "absent": {
              "minimum": 0,
              "type": "integer"
            },
            "failed": {
              "minimum": 0,
              "type": "integer"
            },
            "not_applicable": {
              "minimum": 0,
              "type": "integer"
            },
            "not_observed": {
              "minimum": 0,
              "type": "integer"
            },
            "observed": {
              "minimum": 0,
              "type": "integer"
            }
          },
          "required": [
            "observed",
            "not_applicable",
            "not_observed",
            "failed",
            "absent"
          ],
          "type": "object"
        },
        "record_count": {
          "minimum": 1,
          "type": "integer"
        }
      },
      "required": [
        "record_count",
        "counts",
        "aggregate_state"
      ],
      "type": "object"
    },
    "claimBoundary": {
      "additionalProperties": false,
      "properties": {
        "claim_scope": {
          "const": "software_behavior_report"
        },
        "market_disposition": {
          "const": "no_market_claim"
        },
        "market_leading_claim": {
          "const": "blocked"
        },
        "production_auto_mode": {
          "const": "blocked"
        }
      },
      "required": [
        "claim_scope",
        "market_disposition",
        "production_auto_mode",
        "market_leading_claim"
      ],
      "type": "object"
    },
    "comparisonPolicy": {
      "additionalProperties": false,
      "properties": {
        "acceptance_dependency": {
          "const": "none"
        },
        "comparison_method": {
          "const": "absent_not_required"
        },
        "comparison_success_case": {
          "const": "absent"
        }
      },
      "required": [
        "comparison_method",
        "comparison_success_case",
        "acceptance_dependency"
      ],
      "type": "object"
    },
    "fileBinding": {
      "additionalProperties": false,
      "properties": {
        "path": {
          "pattern": "^[a-zA-Z0-9._/-]+$",
          "type": "string"
        },
        "sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        "size_bytes": {
          "minimum": 1,
          "type": "integer"
        }
      },
      "required": [
        "path",
        "size_bytes",
        "sha256"
      ],
      "type": "object"
    },
    "namedFileBinding": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "pattern": "^[a-z0-9][a-z0-9_-]*$",
          "type": "string"
        },
        "path": {
          "pattern": "^[a-zA-Z0-9._/-]+$",
          "type": "string"
        },
        "sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        "size_bytes": {
          "minimum": 1,
          "type": "integer"
        }
      },
      "required": [
        "id",
        "path",
        "size_bytes",
        "sha256"
      ],
      "type": "object"
    },
    "predecessorBinding": {
      "additionalProperties": false,
      "properties": {
        "acceptance_scope": {
          "const": "declared_software_function_only"
        },
        "accepted_source": {
          "additionalProperties": false,
          "properties": {
            "commit": {
              "const": "3a76c6a03ea0f52f2a2395925badd5d5d1c03c6b"
            },
            "tree": {
              "const": "37951da694ab4fbca6f8c663bb2883e5084b861c"
            }
          },
          "required": [
            "commit",
            "tree"
          ],
          "type": "object"
        },
        "functional_phase_acceptance": {
          "$ref": "#/$defs/fileBinding"
        },
        "phase_id": {
          "const": "R10"
        },
        "phase_result": {
          "const": "passed"
        }
      },
      "required": [
        "phase_id",
        "phase_result",
        "acceptance_scope",
        "accepted_source",
        "functional_phase_acceptance"
      ],
      "type": "object"
    },
    "source": {
      "additionalProperties": false,
      "properties": {
        "commit": {
          "pattern": "^[0-9a-f]{40}$",
          "type": "string"
        },
        "tree": {
          "pattern": "^[0-9a-f]{40}$",
          "type": "string"
        }
      },
      "required": [
        "commit",
        "tree"
      ],
      "type": "object"
    }
  }
}
