{
  "$id": "https://mirmir.local/docs/roadmaps/evidence/schema/r04-fixture-catalog-v1.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "dimensions": {
      "additionalProperties": false,
      "properties": {"height": {"minimum": 1, "type": "integer"}, "width": {"minimum": 1, "type": "integer"}},
      "required": ["width", "height"],
      "type": "object"
    },
    "fileBinding": {
      "additionalProperties": false,
      "properties": {
        "id": {"pattern": "^[a-z][a-z0-9_]{0,63}$", "type": "string"},
        "path": {"minLength": 1, "type": "string"},
        "sha256": {"pattern": "^(?!0{64}$)[0-9a-f]{64}$", "type": "string"},
        "size_bytes": {"minimum": 1, "type": "integer"}
      },
      "required": ["id", "path", "size_bytes", "sha256"],
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "color_contract": {
      "additionalProperties": false,
      "properties": {
        "bit_depth": {"const": 8, "type": "integer"},
        "chroma_location": {"const": "left", "type": "string"},
        "matrix": {"const": "ITU_R_709_2", "type": "string"},
        "pixel_format": {"const": "420v", "type": "string"},
        "primaries": {"const": "ITU_R_709_2", "type": "string"},
        "range": {"const": "video", "type": "string"},
        "transfer_function": {"const": "ITU_R_709_2", "type": "string"}
      },
      "required": ["pixel_format", "bit_depth", "primaries", "transfer_function", "matrix", "range", "chroma_location"],
      "type": "object"
    },
    "contract_id": {"const": "r04-videotoolbox-integration-fixtures-v1", "type": "string"},
    "fixtures": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "id": {"pattern": "^[a-z][a-z0-9-]{0,79}$", "type": "string"},
          "kind": {"enum": ["full_frame_nv12", "typed_contract_rejection", "frame_sequence", "optical_flow_pair"], "type": "string"},
          "member_ids": {"items": {"type": "string"}, "minItems": 1, "type": "array"},
          "route_id": {"type": "string"},
          "source_binding_ids": {"items": {"type": "string"}, "minItems": 1, "type": "array", "uniqueItems": true}
        },
        "required": ["id", "kind", "route_id", "source_binding_ids", "member_ids"],
        "type": "object"
      },
      "maxItems": 6,
      "minItems": 6,
      "type": "array"
    },
    "phase_id": {"const": "R04", "type": "string"},
    "routes": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "capability_id": {"enum": ["A01", "A02", "A05"], "type": "string"},
          "gate": {"enum": ["runtime_support_required", "public_contract_unrepresentable", "exact_dimension_query_required", "optional_runtime_support"], "type": "string"},
          "id": {"pattern": "^[a-z][a-z0-9_]{0,63}$", "type": "string"},
          "input_dimensions": {"$ref": "#/$defs/dimensions"},
          "output_dimensions": {"$ref": "#/$defs/dimensions"},
          "scale_denominator": {"minimum": 1, "type": "integer"},
          "scale_numerator": {"minimum": 1, "type": "integer"}
        },
        "required": ["id", "capability_id", "input_dimensions", "output_dimensions", "scale_numerator", "scale_denominator", "gate"],
        "type": "object"
      },
      "maxItems": 5,
      "minItems": 5,
      "type": "array"
    },
    "scenarios": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "fixture_ids": {"items": {"type": "string"}, "minItems": 1, "type": "array", "uniqueItems": true},
          "id": {"pattern": "^[a-z][a-z0-9_]{0,63}$", "type": "string"},
          "required_check_ids": {"items": {"type": "string"}, "minItems": 1, "type": "array", "uniqueItems": true},
          "subject_ids": {"items": {"type": "string"}, "minItems": 1, "type": "array", "uniqueItems": true}
        },
        "required": ["id", "subject_ids", "fixture_ids", "required_check_ids"],
        "type": "object"
      },
      "maxItems": 6,
      "minItems": 6,
      "type": "array"
    },
    "schema_version": {"const": "1.0.0", "type": "string"},
    "source_bindings": {"items": {"$ref": "#/$defs/fileBinding"}, "maxItems": 6, "minItems": 6, "type": "array"}
  },
  "required": ["schema_version", "phase_id", "contract_id", "color_contract", "source_bindings", "routes", "fixtures", "scenarios"],
  "type": "object"
}
