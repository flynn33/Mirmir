{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mirmir.local/docs/roadmaps/evidence/schema/r06-functional-phase-acceptance-v1.json",
  "title": "R06 declared-software-function phase acceptance",
  "$defs": {
    "binding": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$",
          "type": "string"
        },
        "path": {
          "minLength": 1,
          "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))[A-Za-z0-9._/-]+$",
          "type": "string"
        },
        "sha256": {
          "pattern": "^(?!0{64}$)[0-9a-f]{64}$",
          "type": "string"
        },
        "size_bytes": {
          "minimum": 1,
          "type": "integer"
        }
      },
      "required": [
        "id",
        "path",
        "size_bytes",
        "sha256"
      ],
      "type": "object"
    },
    "checkID": {
      "enum": [
        "source_checkpoint_exact",
        "frozen_evidence_valid_and_unchanged",
        "historical_blocked_reason_preserved",
        "implementation_bindings_exact",
        "execution_artifacts_exact",
        "selected_test_set_exact",
        "decision_context_fields_and_validation",
        "fixed_point_domains_fail_closed",
        "bounded_masks_and_ablations",
        "policy_catalog_sixteen_profiles",
        "eligibility_filter_before_scoring",
        "candidate_order_invariance",
        "one_traceable_whole_frame_plan",
        "input_immutability",
        "hysteresis_dwell_and_transition",
        "typed_failures_and_no_silent_fallback",
        "product_gate_precedes_validation",
        "product_scope_rejected_unimplemented",
        "r07_coordinator_fixture_integration",
        "transaction_failure_preserves_state",
        "native_observation_boundary_truthful",
        "authorization_boundary_exact"
      ],
      "type": "string"
    },
    "passedCheck": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "$ref": "#/$defs/checkID"
        },
        "status": {
          "const": "passed",
          "type": "string"
        }
      },
      "required": [
        "id",
        "status"
      ],
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "1.0.0",
      "type": "string"
    },
    "roadmap_version": {
      "const": "1.0.1",
      "type": "string"
    },
    "phase_id": {
      "const": "R06",
      "type": "string"
    },
    "evidence_kind": {
      "const": "r06_operator_functional_phase_acceptance_v1",
      "type": "string"
    },
    "source": {
      "additionalProperties": false,
      "properties": {
        "commit": {
          "const": "6c4a6d3d5f8a59c553b10c23783c148ccb3388a5",
          "type": "string"
        },
        "tree": {
          "const": "beb0f8c666550c6c36dae5a2185cac58d2494132",
          "type": "string"
        }
      },
      "required": [
        "commit",
        "tree"
      ],
      "type": "object"
    },
    "operator_override": {
      "additionalProperties": false,
      "properties": {
        "authority": {
          "const": "operator",
          "type": "string"
        },
        "authorization_date": {
          "const": "2026-07-23",
          "type": "string"
        },
        "acceptance_basis": {
          "const": "software_does_what_it_says_it_does",
          "type": "string"
        },
        "override_id": {
          "const": "r06.software-function-only-phase-acceptance.v1",
          "type": "string"
        },
        "hardware_simulator_operator_observation": {
          "const": "waived_not_a_blocker",
          "type": "string"
        },
        "comparative_requirement": {
          "const": "not_required_for_phase_acceptance",
          "type": "string"
        },
        "historical_evidence_policy": {
          "const": "preserve_r06_blocked_evidence_unchanged_non_authorizing",
          "type": "string"
        }
      },
      "required": [
        "authority",
        "authorization_date",
        "acceptance_basis",
        "override_id",
        "hardware_simulator_operator_observation",
        "comparative_requirement",
        "historical_evidence_policy"
      ],
      "type": "object"
    },
    "functional_gate": {
      "additionalProperties": false,
      "properties": {
        "acceptance_scope": {
          "const": "declared_software_function_only",
          "type": "string"
        },
        "execution_mode": {
          "const": "deterministic_fixture_integration",
          "type": "string"
        },
        "required_test_suites": {
          "items": {
            "enum": [
              "R06ASHDecisionContextTests",
              "R06ASHMasksAndAblationsTests",
              "R06ASHOrchestratorTests",
              "R06ASHPolicyCatalogTests",
              "R06FunctionalPhaseAcceptanceTests",
              "R07FunctionalCoordinatorTests",
              "R07FunctionalCoordinatorTransactionTests"
            ],
            "type": "string"
          },
          "maxItems": 7,
          "minItems": 7,
          "type": "array",
          "uniqueItems": true
        },
        "required_selected_test_count": {
          "const": 42,
          "type": "integer"
        },
        "required_behavior_ids": {
          "items": {
            "$ref": "#/$defs/checkID"
          },
          "maxItems": 22,
          "minItems": 22,
          "type": "array",
          "uniqueItems": true
        },
        "historical_blocked_evidence_role": {
          "const": "preserved_non_authorizing_not_acceptance_basis",
          "type": "string"
        },
        "historical_blocked_reason": {
          "const": "no_product_qualified_primary_backend",
          "type": "string"
        },
        "product_scope_orchestration": {
          "const": "unsupported_rejected_unimplemented",
          "type": "string"
        },
        "product_scope_rerun": {
          "const": "not_claimed",
          "type": "string"
        },
        "hardware_simulator_operator_observation": {
          "const": "not_required_not_observed",
          "type": "string"
        },
        "raw_xcresult_ci_validation": {
          "const": "required",
          "type": "string"
        }
      },
      "required": [
        "acceptance_scope",
        "execution_mode",
        "required_test_suites",
        "required_selected_test_count",
        "required_behavior_ids",
        "historical_blocked_evidence_role",
        "historical_blocked_reason",
        "product_scope_orchestration",
        "product_scope_rerun",
        "hardware_simulator_operator_observation",
        "raw_xcresult_ci_validation"
      ],
      "type": "object"
    },
    "evidence_bindings": {
      "items": {
        "$ref": "#/$defs/binding"
      },
      "maxItems": 8,
      "minItems": 8,
      "type": "array",
      "uniqueItems": true
    },
    "implementation_bindings": {
      "items": {
        "$ref": "#/$defs/binding"
      },
      "maxItems": 23,
      "minItems": 23,
      "type": "array",
      "uniqueItems": true
    },
    "artifact_bindings": {
      "items": {
        "$ref": "#/$defs/binding"
      },
      "maxItems": 2,
      "minItems": 2,
      "type": "array",
      "uniqueItems": true
    },
    "derived_checks": {
      "items": {
        "$ref": "#/$defs/passedCheck"
      },
      "maxItems": 22,
      "minItems": 22,
      "type": "array",
      "uniqueItems": true
    },
    "result": {
      "additionalProperties": false,
      "properties": {
        "status": {
          "const": "passed",
          "type": "string"
        },
        "phase_status_before": {
          "const": "in_progress",
          "type": "string"
        },
        "phase_status_after": {
          "const": "passed",
          "type": "string"
        },
        "acceptance": {
          "const": "accepted",
          "type": "string"
        },
        "acceptance_scope": {
          "const": "declared_software_function_only",
          "type": "string"
        },
        "execution_mode": {
          "const": "deterministic_fixture_integration",
          "type": "string"
        }
      },
      "required": [
        "status",
        "phase_status_before",
        "phase_status_after",
        "acceptance",
        "acceptance_scope",
        "execution_mode"
      ],
      "type": "object"
    },
    "authorizations": {
      "additionalProperties": false,
      "properties": {
        "r06_phase_acceptance": {
          "const": "authorized",
          "type": "string"
        },
        "r06_phase_status": {
          "const": "passed",
          "type": "string"
        },
        "phase_progression": {
          "const": "authorized",
          "type": "string"
        },
        "deterministic_fixture_integration": {
          "const": "authorized",
          "type": "string"
        },
        "historical_blocked_evidence": {
          "const": "preserved_non_authorizing",
          "type": "string"
        },
        "product_scope_orchestration": {
          "const": "rejected_unimplemented",
          "type": "string"
        },
        "product_qualification": {
          "const": "not_claimed",
          "type": "string"
        },
        "product_routing": {
          "const": "not_authorized",
          "type": "string"
        },
        "production_upscaling": {
          "const": "not_authorized",
          "type": "string"
        },
        "production_default": {
          "const": "not_authorized",
          "type": "string"
        },
        "auto_mode": {
          "const": "not_authorized",
          "type": "string"
        },
        "holdout": {
          "const": "not_authorized",
          "type": "string"
        },
        "native_framework_execution": {
          "const": "not_claimed",
          "type": "string"
        },
        "hardware_observation": {
          "const": "not_claimed",
          "type": "string"
        },
        "simulator_observation": {
          "const": "not_claimed",
          "type": "string"
        },
        "operator_observation": {
          "const": "not_claimed",
          "type": "string"
        },
        "quality_claims": {
          "const": "not_authorized",
          "type": "string"
        },
        "performance_claims": {
          "const": "not_authorized",
          "type": "string"
        },
        "product_publication": {
          "const": "not_authorized",
          "type": "string"
        },
        "release": {
          "const": "not_authorized",
          "type": "string"
        }
      },
      "required": [
        "r06_phase_acceptance",
        "r06_phase_status",
        "phase_progression",
        "deterministic_fixture_integration",
        "historical_blocked_evidence",
        "product_scope_orchestration",
        "product_qualification",
        "product_routing",
        "production_upscaling",
        "production_default",
        "auto_mode",
        "holdout",
        "native_framework_execution",
        "hardware_observation",
        "simulator_observation",
        "operator_observation",
        "quality_claims",
        "performance_claims",
        "product_publication",
        "release"
      ],
      "type": "object"
    },
    "limitations": {
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "maxItems": 4,
      "minItems": 4,
      "type": "array"
    }
  },
  "required": [
    "schema_version",
    "roadmap_version",
    "phase_id",
    "evidence_kind",
    "source",
    "operator_override",
    "functional_gate",
    "evidence_bindings",
    "implementation_bindings",
    "artifact_bindings",
    "derived_checks",
    "result",
    "authorizations",
    "limitations"
  ],
  "type": "object"
}
