{
  "$id": "https://github.com/flynn33/Mirmir/docs/roadmaps/evidence/schema/r11-preregistration-v1.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "aggregation_contract": {
      "additionalProperties": false,
      "properties": {
        "aggregate_state_order": {
          "items": false,
          "maxItems": 6,
          "minItems": 6,
          "prefixItems": [
            {
              "const": "observed"
            },
            {
              "const": "not_applicable"
            },
            {
              "const": "not_observed"
            },
            {
              "const": "failed"
            },
            {
              "const": "absent"
            },
            {
              "const": "mixed"
            }
          ],
          "type": "array"
        },
        "averages_authorized": {
          "const": false
        },
        "method": {
          "const": "deterministic_state_counts"
        },
        "mixed_rule": {
          "const": "mixed_when_multiple_observation_state_counts_are_nonzero"
        },
        "opaque_scalar_authorized": {
          "const": false
        },
        "preserves_each_state_count": {
          "const": true
        }
      },
      "required": [
        "method",
        "aggregate_state_order",
        "preserves_each_state_count",
        "mixed_rule",
        "averages_authorized",
        "opaque_scalar_authorized"
      ],
      "type": "object"
    },
    "authorization_boundary": {
      "additionalProperties": false,
      "properties": {
        "fixture_evidence_publication": {
          "const": "authorized"
        },
        "market_leading_claim": {
          "const": "blocked"
        },
        "production_auto_mode": {
          "const": "blocked"
        },
        "r11_implementation": {
          "const": "authorized"
        },
        "release": {
          "const": "not_authorized"
        }
      },
      "required": [
        "r11_implementation",
        "fixture_evidence_publication",
        "production_auto_mode",
        "market_leading_claim",
        "release"
      ],
      "type": "object"
    },
    "checks": {
      "items": {
        "enum": [
          "accepted_r10_binding_exact",
          "seven_identity_components_exact",
          "five_observation_states_exact",
          "deterministic_complete_aggregate_exact",
          "missing_duplicate_mismatch_rejected",
          "software_behavior_report_only",
          "no_market_claim_unconditional",
          "production_and_market_authority_blocked",
          "comparison_methods_and_success_cases_absent",
          "schemas_and_fixture_catalog_exact"
        ],
        "type": "string"
      },
      "maxItems": 10,
      "minItems": 10,
      "type": "array",
      "uniqueItems": true
    },
    "claim_contract": {
      "additionalProperties": false,
      "properties": {
        "market_disposition": {
          "const": "no_market_claim"
        },
        "market_leading_claim": {
          "const": "blocked"
        },
        "permitted_claims": {
          "items": false,
          "maxItems": 1,
          "minItems": 1,
          "prefixItems": [
            {
              "const": "software_behavior_report"
            }
          ],
          "type": "array"
        },
        "production_auto_mode": {
          "const": "blocked"
        }
      },
      "required": [
        "permitted_claims",
        "market_disposition",
        "production_auto_mode",
        "market_leading_claim"
      ],
      "type": "object"
    },
    "comparison_policy": {
      "additionalProperties": false,
      "properties": {
        "acceptance_dependency": {
          "const": "none"
        },
        "comparison_methods": {
          "const": "absent_not_required"
        },
        "comparison_success_cases": {
          "const": "absent"
        }
      },
      "required": [
        "comparison_methods",
        "comparison_success_cases",
        "acceptance_dependency"
      ],
      "type": "object"
    },
    "fixture_catalog_binding": {
      "$ref": "#/$defs/fileBinding"
    },
    "identity_contract": {
      "additionalProperties": false,
      "properties": {
        "component_digest_algorithm": {
          "const": "sha256_canonical_json_seven_component_documents"
        },
        "component_order": {
          "$ref": "#/$defs/identityComponentOrder"
        },
        "component_fields": {
          "additionalProperties": false,
          "properties": {
            "execution": {
              "$ref": "#/$defs/exactStringArrayExecution"
            },
            "input": {
              "$ref": "#/$defs/exactStringArrayInput"
            },
            "preprocessing": {
              "$ref": "#/$defs/exactStringArrayPreprocessing"
            },
            "software": {
              "$ref": "#/$defs/exactStringArraySoftware"
            },
            "source": {
              "$ref": "#/$defs/exactStringArraySource"
            },
            "subject": {
              "$ref": "#/$defs/exactStringArraySubject"
            },
            "toolchain": {
              "$ref": "#/$defs/exactStringArrayToolchain"
            }
          },
          "required": [
            "source",
            "software",
            "subject",
            "input",
            "preprocessing",
            "toolchain",
            "execution"
          ],
          "type": "object"
        },
        "complete_identity_required": {
          "const": true
        },
        "duplicate_component_result": {
          "const": "rejected"
        },
        "mismatched_component_result": {
          "const": "rejected"
        },
        "missing_component_result": {
          "const": "rejected"
        }
      },
      "required": [
        "component_order",
        "component_fields",
        "component_digest_algorithm",
        "complete_identity_required",
        "missing_component_result",
        "duplicate_component_result",
        "mismatched_component_result"
      ],
      "type": "object"
    },
    "implementation_binding_policy": {
      "const": "current_contract_bytes_preregistered_execution_source_bound_later"
    },
    "implementation_contract_bindings": {
      "items": false,
      "maxItems": 2,
      "minItems": 2,
      "prefixItems": [
        {
          "additionalProperties": false,
          "properties": {
            "id": {
              "const": "traceability_core"
            },
            "path": {
              "const": "validation/calibration_v2/r11_traceability.py"
            },
            "sha256": {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            },
            "size_bytes": {
              "minimum": 1,
              "type": "integer"
            }
          },
          "required": [
            "id",
            "path",
            "size_bytes",
            "sha256"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "id": {
              "const": "traceability_core_tests"
            },
            "path": {
              "const": "validation/calibration_v2/tests/test_r11_traceability.py"
            },
            "sha256": {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            },
            "size_bytes": {
              "minimum": 1,
              "type": "integer"
            }
          },
          "required": [
            "id",
            "path",
            "size_bytes",
            "sha256"
          ],
          "type": "object"
        }
      ],
      "type": "array"
    },
    "observation_contract": {
      "additionalProperties": false,
      "properties": {
        "explicit_absent_record_required": {
          "const": true
        },
        "missing_is_not_absent": {
          "const": true
        },
        "non_observed_codes": {
          "additionalProperties": false,
          "properties": {
            "absent": {
              "const": "evidence_explicitly_absent"
            },
            "failed": {
              "const": "execution_failed"
            },
            "not_applicable": {
              "const": "not_applicable_by_contract"
            },
            "not_observed": {
              "const": "execution_not_observed"
            }
          },
          "required": [
            "not_applicable",
            "not_observed",
            "failed",
            "absent"
          ],
          "type": "object"
        },
        "observed_value_contract": {
          "const": "canonical_json_value_required"
        },
        "state_order": {
          "$ref": "#/$defs/observationStateOrder"
        }
      },
      "required": [
        "state_order",
        "observed_value_contract",
        "non_observed_codes",
        "explicit_absent_record_required",
        "missing_is_not_absent"
      ],
      "type": "object"
    },
    "phase_id": {
      "const": "R11"
    },
    "predecessor_binding": {
      "additionalProperties": false,
      "properties": {
        "acceptance": {
          "const": "accepted"
        },
        "acceptance_scope": {
          "const": "declared_software_function_only"
        },
        "accepted_implementation_source": {
          "additionalProperties": false,
          "properties": {
            "commit": {
              "const": "3a76c6a03ea0f52f2a2395925badd5d5d1c03c6b"
            },
            "tree": {
              "const": "37951da694ab4fbca6f8c663bb2883e5084b861c"
            }
          },
          "required": [
            "commit",
            "tree"
          ],
          "type": "object"
        },
        "closure_source": {
          "additionalProperties": false,
          "properties": {
            "commit": {
              "const": "8d4283d2f3fbb104ef589f002de2fd6ccadad0f8"
            },
            "tree": {
              "const": "ee0461cff1fea9461f619ce904376ebdb128a2f5"
            }
          },
          "required": [
            "commit",
            "tree"
          ],
          "type": "object"
        },
        "direct_predecessors": {
          "items": false,
          "maxItems": 1,
          "minItems": 1,
          "prefixItems": [
            {
              "const": "R10"
            }
          ],
          "type": "array"
        },
        "functional_execution_receipt": {
          "$ref": "#/$defs/fileBinding"
        },
        "functional_phase_acceptance": {
          "$ref": "#/$defs/fileBinding"
        },
        "phase_id": {
          "const": "R10"
        },
        "phase_result": {
          "const": "passed"
        }
      },
      "required": [
        "direct_predecessors",
        "phase_id",
        "phase_result",
        "acceptance",
        "acceptance_scope",
        "closure_source",
        "accepted_implementation_source",
        "functional_execution_receipt",
        "functional_phase_acceptance"
      ],
      "type": "object"
    },
    "preregistration_state": {
      "const": "contract_frozen_for_local_implementation"
    },
    "roadmap_version": {
      "const": "1.0.1"
    },
    "schema_bindings": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "id": {
            "enum": [
              "preregistration",
              "fixture_catalog",
              "traceability_run_receipt",
              "functional_execution_receipt",
              "functional_phase_acceptance"
            ]
          },
          "path": {
            "pattern": "^docs/roadmaps/evidence/schema/r11-[a-z0-9-]+-v1\\.json$",
            "type": "string"
          },
          "sha256": {
            "pattern": "^[0-9a-f]{64}$",
            "type": "string"
          },
          "size_bytes": {
            "minimum": 1,
            "type": "integer"
          }
        },
        "required": [
          "id",
          "path",
          "size_bytes",
          "sha256"
        ],
        "type": "object"
      },
      "maxItems": 5,
      "minItems": 5,
      "type": "array"
    },
    "schema_version": {
      "const": "1.0.0"
    },
    "stop_rules": {
      "items": {
        "enum": [
          "accepted_r10_binding_drift",
          "schema_or_fixture_byte_drift",
          "identity_component_missing_duplicate_or_mismatch",
          "observation_state_out_of_scope",
          "aggregate_count_or_state_mismatch",
          "claim_scope_expansion",
          "forged_production_or_market_authorization",
          "comparison_method_or_success_case_introduced"
        ],
        "type": "string"
      },
      "maxItems": 8,
      "minItems": 8,
      "type": "array",
      "uniqueItems": true
    }
  },
  "required": [
    "schema_version",
    "roadmap_version",
    "phase_id",
    "preregistration_state",
    "predecessor_binding",
    "implementation_binding_policy",
    "implementation_contract_bindings",
    "identity_contract",
    "observation_contract",
    "aggregation_contract",
    "claim_contract",
    "comparison_policy",
    "fixture_catalog_binding",
    "schema_bindings",
    "checks",
    "stop_rules",
    "authorization_boundary"
  ],
  "title": "R11 traceability preregistration",
  "type": "object",
  "$defs": {
    "fileBinding": {
      "additionalProperties": false,
      "properties": {
        "path": {
          "pattern": "^[a-zA-Z0-9._/-]+$",
          "type": "string"
        },
        "sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        "size_bytes": {
          "minimum": 1,
          "type": "integer"
        }
      },
      "required": [
        "path",
        "size_bytes",
        "sha256"
      ],
      "type": "object"
    },
    "identityComponentOrder": {
      "items": false,
      "maxItems": 7,
      "minItems": 7,
      "prefixItems": [
        {
          "const": "source"
        },
        {
          "const": "software"
        },
        {
          "const": "subject"
        },
        {
          "const": "input"
        },
        {
          "const": "preprocessing"
        },
        {
          "const": "toolchain"
        },
        {
          "const": "execution"
        }
      ],
      "type": "array"
    },
    "exactStringArrayExecution": {
      "items": false,
      "maxItems": 3,
      "minItems": 3,
      "prefixItems": [
        {
          "const": "execution_id"
        },
        {
          "const": "execution_mode"
        },
        {
          "const": "invocation_sha256"
        }
      ],
      "type": "array"
    },
    "exactStringArrayInput": {
      "items": false,
      "maxItems": 3,
      "minItems": 3,
      "prefixItems": [
        {
          "const": "input_id"
        },
        {
          "const": "input_kind"
        },
        {
          "const": "payload_sha256"
        }
      ],
      "type": "array"
    },
    "exactStringArrayPreprocessing": {
      "items": false,
      "maxItems": 2,
      "minItems": 2,
      "prefixItems": [
        {
          "const": "pipeline_id"
        },
        {
          "const": "configuration_sha256"
        }
      ],
      "type": "array"
    },
    "exactStringArraySoftware": {
      "items": false,
      "maxItems": 3,
      "minItems": 3,
      "prefixItems": [
        {
          "const": "component_id"
        },
        {
          "const": "implementation_manifest_sha256"
        },
        {
          "const": "contract_sha256"
        }
      ],
      "type": "array"
    },
    "exactStringArraySource": {
      "items": false,
      "maxItems": 2,
      "minItems": 2,
      "prefixItems": [
        {
          "const": "commit"
        },
        {
          "const": "tree"
        }
      ],
      "type": "array"
    },
    "exactStringArraySubject": {
      "items": false,
      "maxItems": 3,
      "minItems": 3,
      "prefixItems": [
        {
          "const": "subject_id"
        },
        {
          "const": "subject_kind"
        },
        {
          "const": "behavior_contract_sha256"
        }
      ],
      "type": "array"
    },
    "exactStringArrayToolchain": {
      "items": false,
      "maxItems": 5,
      "minItems": 5,
      "prefixItems": [
        {
          "const": "platform"
        },
        {
          "const": "architecture"
        },
        {
          "const": "runtime_id"
        },
        {
          "const": "runtime_version"
        },
        {
          "const": "command_sha256"
        }
      ],
      "type": "array"
    },
    "observationStateOrder": {
      "items": false,
      "maxItems": 5,
      "minItems": 5,
      "prefixItems": [
        {
          "const": "observed"
        },
        {
          "const": "not_applicable"
        },
        {
          "const": "not_observed"
        },
        {
          "const": "failed"
        },
        {
          "const": "absent"
        }
      ],
      "type": "array"
    }
  }
}
