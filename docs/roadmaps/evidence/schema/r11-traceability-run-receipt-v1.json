{
  "$defs": {
    "aggregate": {
      "additionalProperties": false,
      "properties": {
        "aggregate_state": {
          "const": "mixed"
        },
        "expected_observation_ids": {
          "items": false,
          "maxItems": 5,
          "minItems": 5,
          "prefixItems": [
            {
              "const": "observation-absent"
            },
            {
              "const": "observation-failed"
            },
            {
              "const": "observation-not-applicable"
            },
            {
              "const": "observation-not-observed"
            },
            {
              "const": "observation-observed"
            }
          ],
          "type": "array"
        },
        "identity": {
          "$ref": "#/$defs/evidenceIdentity"
        },
        "observation_sha256_values": {
          "items": {
            "pattern": "^(?!0{64}$)[0-9a-f]{64}$",
            "type": "string"
          },
          "maxItems": 5,
          "minItems": 5,
          "type": "array",
          "uniqueItems": true
        },
        "observed_values": {
          "items": false,
          "maxItems": 1,
          "minItems": 1,
          "prefixItems": [
            {
              "additionalProperties": false,
              "properties": {
                "observation_id": {
                  "const": "observation-observed"
                },
                "value": {
                  "const": "declared_behavior_passed"
                }
              },
              "required": [
                "observation_id",
                "value"
              ],
              "type": "object"
            }
          ],
          "type": "array"
        },
        "state_counts": {
          "additionalProperties": false,
          "properties": {
            "absent": {
              "const": 1
            },
            "failed": {
              "const": 1
            },
            "not_applicable": {
              "const": 1
            },
            "not_observed": {
              "const": 1
            },
            "observed": {
              "const": 1
            }
          },
          "required": [
            "observed",
            "not_applicable",
            "not_observed",
            "failed",
            "absent"
          ],
          "type": "object"
        }
      },
      "required": [
        "identity",
        "expected_observation_ids",
        "observation_sha256_values",
        "observed_values",
        "state_counts",
        "aggregate_state"
      ],
      "type": "object"
    },
    "claimDecision": {
      "additionalProperties": false,
      "properties": {
