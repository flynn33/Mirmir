    "observation": {
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "state": {
                "const": "observed"
              }
            }
          },
          "then": {
            "properties": {
              "failure_code": {
                "const": null
              },
              "reason_code": {
                "const": null
              },
              "value": {
                "type": [
                  "string",
                  "integer",
                  "number",
                  "boolean"
                ]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "state": {
                "const": "not_applicable"
              }
            }
          },
          "then": {
            "properties": {
              "failure_code": {
                "const": null
              },
              "reason_code": {
                "const": "declared_not_applicable"
              },
              "value": {
                "const": null
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "state": {
                "const": "not_observed"
              }
            }
          },
          "then": {
            "properties": {
              "failure_code": {
                "const": null
              },
              "reason_code": {
                "enum": [
                  "environment_unavailable",
                  "hardware_not_observed",
                  "simulator_not_observed",
                  "operator_observation_not_observed"
                ]
              },
              "value": {
                "const": null
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "state": {
                "const": "failed"
              }
            }
          },
          "then": {
            "properties": {
              "failure_code": {
                "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$",
                "type": "string"
              },
              "reason_code": {
                "const": "execution_failed"
              },
              "value": {
                "const": null
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "state": {
                "const": "absent"
              }
            }
          },
          "then": {
            "properties": {
              "failure_code": {
                "const": null
              },
              "reason_code": {
                "const": "source_data_absent"
              },
              "value": {
                "const": null
              }
            }
          }
        }
      ],
      "properties": {
        "failure_code": {
          "type": [
            "string",
            "null"
          ]
        },
        "identity": {
          "$ref": "#/$defs/evidenceIdentity"
        },
        "observation_id": {
          "pattern": "^observation-[a-z0-9-]+$",
          "type": "string"
        },
        "reason_code": {
          "type": [
            "string",
            "null"
          ]
        },
        "state": {
          "enum": [
            "observed",
            "not_applicable",
            "not_observed",
            "failed",
            "absent"
          ],
          "type": "string"
        },
        "value": {
          "type": [
            "string",
            "integer",
            "number",
            "boolean",
            "null"
          ]
        }
      },
      "required": [
        "observation_id",
        "identity",
        "state",
        "value",
        "reason_code",
        "failure_code"
      ],
      "type": "object"
    },
