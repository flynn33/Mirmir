          "pattern": "^(?!0{64}$)[0-9a-f]{64}$",
          "type": "string"
        },
        "market_leading_claim": {
          "const": "blocked"
        },
        "market_position": {
          "const": "blocked"
        },
        "permitted_claim": {
          "const": "software_behavior_report"
        },
        "product_qualification": {
          "const": "blocked"
        },
        "production_auto_mode": {
          "const": "blocked"
        },
        "reason_code": {
          "const": "declared_software_behavior_only"
        },
        "requested_claim": {
          "const": "software_behavior_report"
        }
      },
      "required": [
        "requested_claim",
        "permitted_claim",
        "disposition",
        "reason_code",
        "evidence_identity_sha256",
        "aggregate_sha256",
        "product_qualification",
