{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mirmir.local/docs/roadmaps/evidence/schema/r04-functional-phase-acceptance-v1.json",
  "title": "R04 declared-software-function phase acceptance",
  "$defs": {
    "binding": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$",
          "type": "string"
        },
        "path": {
          "minLength": 1,
          "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))[A-Za-z0-9._/-]+$",
          "type": "string"
        },
        "sha256": {
          "pattern": "^(?!0{64}$)[0-9a-f]{64}$",
          "type": "string"
        },
        "size_bytes": {
          "minimum": 1,
          "type": "integer"
        }
      },
      "required": [
        "id",
        "path",
        "size_bytes",
        "sha256"
      ],
      "type": "object"
    },
    "checkID": {
      "enum": [
            "source_checkpoint_exact",
            "frozen_evidence_valid_and_unchanged",
            "implementation_bindings_exact",
            "execution_artifacts_exact",
            "selected_test_set_exact",
            "route_catalog_and_identity_contract",
            "quality_2x_and_typed_1p5x_rejection",
            "low_latency_exact_dimension_query",
            "quality_history_and_reset_lifecycle",
            "configuration_and_request_contract",
            "fifo_submission_contract",
            "runtime_unavailable_without_fallback",
            "cancellation_propagation_without_fallback",
            "media_identity_preserved",
            "reopen_verification_before_atomic_publication",
            "resource_lifetime_exactly_once",
            "model_asset_authority_fail_closed",
            "native_observation_boundary_truthful",
            "authorization_boundary_exact"
      ],
      "type": "string"
    },
    "passedCheck": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "$ref": "#/$defs/checkID"
        },
        "status": {
          "const": "passed",
          "type": "string"
        }
      },
      "required": [
        "id",
        "status"
      ],
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "1.0.0",
      "type": "string"
    },
    "roadmap_version": {
      "const": "1.0.1",
      "type": "string"
    },
    "phase_id": {
      "const": "R04",
      "type": "string"
    },
    "evidence_kind": {
      "const": "r04_operator_functional_phase_acceptance_v1",
      "type": "string"
    },
    "source": {
      "additionalProperties": false,
      "properties": {
        "commit": {
          "const": "ab77e97867d51168e90c0190f6430d4acd769e68",
          "type": "string"
        },
        "tree": {
          "const": "446f71bb584f5d1fffcd20a17ac5e5507d3222b6",
          "type": "string"
        }
      },
      "required": [
        "commit",
        "tree"
      ],
      "type": "object"
    },
    "operator_override": {
      "additionalProperties": false,
      "properties": {
        "authority": {
          "const": "operator",
          "type": "string"
        },
        "authorization_date": {
          "const": "2026-07-23",
          "type": "string"
        },
        "acceptance_basis": {
          "const": "software_does_what_it_says_it_does",
          "type": "string"
        },
        "override_id": {
          "const": "r04.software-function-only-phase-acceptance.v1",
          "type": "string"
        },
        "hardware_simulator_operator_observation": {
          "const": "waived_not_a_blocker",
          "type": "string"
        },
        "comparative_requirement": {
          "const": "not_required_for_phase_acceptance",
          "type": "string"
        },
        "historical_evidence_policy": {
          "const": "preserve_r04_preregistration_fixture_and_conformance_unchanged",
          "type": "string"
        }
      },
      "required": [
        "authority",
        "authorization_date",
        "acceptance_basis",
        "override_id",
        "hardware_simulator_operator_observation",
        "comparative_requirement",
        "historical_evidence_policy"
      ],
      "type": "object"
    },
    "functional_gate": {
      "additionalProperties": false,
      "properties": {
        "acceptance_scope": {
          "const": "declared_software_function_only",
          "type": "string"
        },
        "execution_mode": {
          "const": "deterministic_simulated_runtime_integration",
          "type": "string"
        },
        "required_test_suites": {
          "items": {
            "enum": [
              "R04VideoToolboxContractsTests",
              "R04VideoToolboxSessionAdapterTests",
              "UpscalerEngineAvailabilityTests",
              "R04FunctionalPhaseAcceptanceTests"
            ],
            "type": "string"
          },
          "maxItems": 4,
          "minItems": 4,
          "type": "array",
          "uniqueItems": true
        },
        "required_selected_test_count": {
          "const": 42,
          "type": "integer"
        },
        "required_behavior_ids": {
          "items": {
            "$ref": "#/$defs/checkID"
          },
          "maxItems": 19,
          "minItems": 19,
          "type": "array",
          "uniqueItems": true
        },
        "frozen_diagnostic_evidence_role": {
          "const": "preserved_boundary_only_not_acceptance_basis",
          "type": "string"
        },
        "native_videotoolbox_model_execution": {
          "const": "not_required_not_observed",
          "type": "string"
        },
        "hardware_simulator_operator_observation": {
          "const": "not_required_not_observed",
          "type": "string"
        },
        "raw_xcresult_ci_validation": {
          "const": "required",
          "type": "string"
        }
      },
      "required": [
        "acceptance_scope",
        "execution_mode",
        "required_test_suites",
        "required_selected_test_count",
        "required_behavior_ids",
        "frozen_diagnostic_evidence_role",
        "native_videotoolbox_model_execution",
        "hardware_simulator_operator_observation",
        "raw_xcresult_ci_validation"
      ],
      "type": "object"
    },
    "evidence_bindings": {
      "items": {
        "$ref": "#/$defs/binding"
      },
      "maxItems": 6,
      "minItems": 6,
      "type": "array",
      "uniqueItems": true
    },
    "implementation_bindings": {
      "items": {
        "$ref": "#/$defs/binding"
      },
      "maxItems": 34,
      "minItems": 34,
      "type": "array",
      "uniqueItems": true
    },
    "artifact_bindings": {
      "items": {
        "$ref": "#/$defs/binding"
      },
      "maxItems": 2,
      "minItems": 2,
      "type": "array",
      "uniqueItems": true
    },
    "derived_checks": {
      "items": {
        "$ref": "#/$defs/passedCheck"
      },
      "maxItems": 19,
      "minItems": 19,
      "type": "array",
      "uniqueItems": true
    },
    "result": {
      "additionalProperties": false,
      "properties": {
        "status": {
          "const": "passed",
          "type": "string"
        },
        "phase_status_before": {
          "const": "in_progress",
          "type": "string"
        },
        "phase_status_after": {
          "const": "passed",
          "type": "string"
        },
        "acceptance": {
          "const": "accepted",
          "type": "string"
        },
        "acceptance_scope": {
          "const": "declared_software_function_only",
          "type": "string"
        },
        "execution_mode": {
          "const": "deterministic_simulated_runtime_integration",
          "type": "string"
        }
      },
      "required": [
        "status",
        "phase_status_before",
        "phase_status_after",
        "acceptance",
        "acceptance_scope",
        "execution_mode"
      ],
      "type": "object"
    },
    "authorizations": {
      "additionalProperties": false,
      "properties": {
        "r04_phase_acceptance": {
          "const": "authorized",
          "type": "string"
        },
        "r04_phase_status": {
          "const": "passed",
          "type": "string"
        },
        "phase_progression": {
          "const": "authorized",
          "type": "string"
        },
        "deterministic_simulated_runtime_integration": {
          "const": "authorized",
          "type": "string"
        },
        "native_videotoolbox_execution": {
          "const": "not_claimed",
          "type": "string"
        },
        "native_model_execution": {
          "const": "not_claimed",
          "type": "string"
        },
        "hardware_observation": {
          "const": "not_claimed",
          "type": "string"
        },
        "simulator_observation": {
          "const": "not_claimed",
          "type": "string"
        },
        "operator_observation": {
          "const": "not_claimed",
          "type": "string"
        },
        "product_qualification": {
          "const": "not_claimed",
          "type": "string"
        },
        "production_upscaling": {
          "const": "not_authorized",
          "type": "string"
        },
        "production_default": {
          "const": "not_authorized",
          "type": "string"
        },
        "auto_mode": {
          "const": "not_authorized",
          "type": "string"
        },
        "holdout": {
          "const": "not_authorized",
          "type": "string"
        },
        "quality_claims": {
          "const": "not_authorized",
          "type": "string"
        },
        "performance_claims": {
          "const": "not_authorized",
          "type": "string"
        },
        "product_publication": {
          "const": "not_authorized",
          "type": "string"
        },
        "release": {
          "const": "not_authorized",
          "type": "string"
        }
      },
      "required": [
        "r04_phase_acceptance",
        "r04_phase_status",
        "phase_progression",
        "deterministic_simulated_runtime_integration",
        "native_videotoolbox_execution",
        "native_model_execution",
        "hardware_observation",
        "simulator_observation",
        "operator_observation",
        "product_qualification",
        "production_upscaling",
        "production_default",
        "auto_mode",
        "holdout",
        "quality_claims",
        "performance_claims",
        "product_publication",
        "release"
      ],
      "type": "object"
    },
    "limitations": {
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "maxItems": 4,
      "minItems": 4,
      "type": "array"
    }
  },
  "required": [
    "schema_version",
    "roadmap_version",
    "phase_id",
    "evidence_kind",
    "source",
    "operator_override",
    "functional_gate",
    "evidence_bindings",
    "implementation_bindings",
    "artifact_bindings",
    "derived_checks",
    "result",
    "authorizations",
    "limitations"
  ],
  "type": "object"
}
