{
  "$id": "https://mirmir.local/docs/roadmaps/evidence/schema/r09-functional-phase-acceptance-v1.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "namedBinding": {
      "additionalProperties": false,
      "properties": {
        "id": {"minLength": 1, "type": "string"},
        "path": {"minLength": 1, "type": "string"},
        "sha256": {"pattern": "^(?!0{64}$)[0-9a-f]{64}$", "type": "string"},
        "size_bytes": {"minimum": 1, "type": "integer"}
      },
      "required": ["id", "path", "size_bytes", "sha256"],
      "type": "object"
    },
    "source": {
      "additionalProperties": false,
      "properties": {
        "commit": {"pattern": "^(?!0{40}$)[0-9a-f]{40}$", "type": "string"},
        "tree": {"pattern": "^(?!0{40}$)[0-9a-f]{40}$", "type": "string"}
      },
      "required": ["commit", "tree"],
      "type": "object"
    },
    "comparisonPolicy": {
      "additionalProperties": false,
      "properties": {
        "comparative_testing": {"const": "not_run_not_required", "type": "string"},
        "a_b_testing": {"const": "not_run_not_required", "type": "string"},
        "blinded_testing": {"const": "not_run_not_required", "type": "string"},
        "ablation_testing": {"const": "not_run_not_required", "type": "string"},
        "superiority_requirement": {"const": "not_run_not_required", "type": "string"},
        "acceptance_dependency": {"const": "none", "type": "string"}
      },
      "required": [
        "comparative_testing",
        "a_b_testing",
        "blinded_testing",
        "ablation_testing",
        "superiority_requirement",
        "acceptance_dependency"
      ],
      "type": "object"
    },
    "contractInterpretations": {
      "additionalProperties": false,
      "properties": {
        "hallucination_risk_present": {
          "const": "typed_risk_exceeds_request_supplied_maximum",
          "type": "string"
        },
        "deterministic_provider_content_sha256": {
          "const": "semantic_contract_identity_not_source_file_digest",
          "type": "string"
        },
        "provider_source_provenance": {
          "const": "checkpoint_commit_tree_and_implementation_binding",
          "type": "string"
        },
        "fixture_catalog_execution": {
          "const": "semantic_test_mapping_not_direct_catalog_execution",
          "type": "string"
        }
      },
      "required": [
        "hallucination_risk_present",
        "deterministic_provider_content_sha256",
        "provider_source_provenance",
        "fixture_catalog_execution"
      ],
      "type": "object"
    },
    "passedCheck": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "enum": [
            "source_checkpoint_exact",
            "contract_bindings_exact",
            "implementation_bindings_exact",
            "execution_artifacts_exact",
            "execution_receipt_exact",
            "selected_26_test_set_exact",
            "numeric_contracts_geometry_plane_and_range",
            "request_authorization_execution_identity_and_budget",
            "deterministic_signed_bounded_residual_proposal",
            "service_fail_closed_confidence_resource_safety_lifecycle",
            "ash_authorization_mask_and_chroma_bounds",
            "ash_bypass_identity_and_replay_rejection",
            "transactional_application_rollback_and_independent_validation",
            "nv12_planar_round_trip_and_format_rejection",
            "comparative_methods_absent_and_non_gating",
            "native_observations_truthful",
            "authorization_boundary_exact"
          ],
          "type": "string"
        },
        "status": {"const": "passed", "type": "string"}
      },
      "required": ["id", "status"],
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schema_version": {"const": "1.0.0", "type": "string"},
    "roadmap_version": {"const": "1.0.1", "type": "string"},
    "phase_id": {"const": "R09", "type": "string"},
    "evidence_kind": {
      "const": "r09_operator_functional_phase_acceptance_v1",
      "type": "string"
    },
    "source": {"$ref": "#/$defs/source"},
    "operator_override": {
      "additionalProperties": false,
      "properties": {
        "authority": {"const": "operator", "type": "string"},
        "authorization_date": {"const": "2026-07-22", "type": "string"},
        "acceptance_basis": {"const": "software_does_what_it_says_it_does", "type": "string"},
        "override_id": {"const": "r09.software-function-only-phase-acceptance.v1", "type": "string"},
        "comparative_requirement": {"const": "not_run_not_required", "type": "string"},
        "a_b_requirement": {"const": "not_run_not_required", "type": "string"},
        "blinded_requirement": {"const": "not_run_not_required", "type": "string"},
        "ablation_requirement": {"const": "not_run_not_required", "type": "string"},
        "superiority_requirement": {"const": "not_run_not_required", "type": "string"},
        "native_execution": {"const": "supplemental_not_required", "type": "string"}
      },
      "required": [
        "authority",
        "authorization_date",
        "acceptance_basis",
        "override_id",
        "comparative_requirement",
        "a_b_requirement",
        "blinded_requirement",
        "ablation_requirement",
        "superiority_requirement",
        "native_execution"
      ],
      "type": "object"
    },
    "functional_gate": {
      "additionalProperties": false,
      "properties": {
        "acceptance_basis": {"const": "software_does_what_it_says_it_does", "type": "string"},
        "acceptance_scope": {"const": "declared_software_function_only", "type": "string"},
        "execution_mode": {"const": "deterministic_fixture_simulation", "type": "string"},
        "required_test_suites": {
          "const": [
            "R09CoreAIResidualContractsTests",
            "R09DeterministicResidualServiceTests",
            "R09ASHResidualAuthorizationTests",
            "R09BoundedResidualStageTests"
          ],
          "type": "array"
        },
        "required_test_count": {"const": 26, "type": "integer"},
        "required_functional_check_ids": {
          "const": [
            "numeric_contracts_geometry_plane_and_range",
            "request_authorization_execution_identity_and_budget",
            "deterministic_signed_bounded_residual_proposal",
            "service_fail_closed_confidence_resource_safety_lifecycle",
            "ash_authorization_mask_and_chroma_bounds",
            "ash_bypass_identity_and_replay_rejection",
            "transactional_application_rollback_and_independent_validation",
            "nv12_planar_round_trip_and_format_rejection"
          ],
          "type": "array"
        },
        "comparison_policy": {"$ref": "#/$defs/comparisonPolicy"},
        "native_core_ai_qualification": {"const": "not_claimed", "type": "string"},
        "product_qualification": {"const": "not_claimed", "type": "string"}
      },
      "required": [
        "acceptance_basis",
        "acceptance_scope",
        "execution_mode",
        "required_test_suites",
        "required_test_count",
        "required_functional_check_ids",
        "comparison_policy",
        "native_core_ai_qualification",
        "product_qualification"
      ],
      "type": "object"
    },
    "contract_bindings": {
      "items": {"$ref": "#/$defs/namedBinding"},
      "maxItems": 13,
      "minItems": 13,
      "type": "array"
    },
    "implementation_bindings": {
      "items": {"$ref": "#/$defs/namedBinding"},
      "maxItems": 20,
      "minItems": 20,
      "type": "array"
    },
    "execution_receipt_binding": {"$ref": "#/$defs/namedBinding"},
    "comparison_policy": {"$ref": "#/$defs/comparisonPolicy"},
    "contract_interpretations": {"$ref": "#/$defs/contractInterpretations"},
    "derived_checks": {
      "items": {"$ref": "#/$defs/passedCheck"},
      "maxItems": 17,
      "minItems": 17,
      "type": "array"
    },
    "result": {
      "additionalProperties": false,
      "properties": {
        "status": {"const": "passed", "type": "string"},
        "phase_status_before": {"const": "in_progress", "type": "string"},
        "phase_status_after": {"const": "passed", "type": "string"},
        "acceptance": {"const": "accepted", "type": "string"},
        "acceptance_basis": {"const": "software_does_what_it_says_it_does", "type": "string"},
        "acceptance_scope": {"const": "declared_software_function_only", "type": "string"},
        "execution_mode": {"const": "deterministic_fixture_simulation", "type": "string"},
        "native_core_ai_qualification": {"const": "not_claimed", "type": "string"},
        "product_qualification": {"const": "not_claimed", "type": "string"},
        "roadmap_exit_outcome": {"const": "qualified_local_residual", "type": "string"}
      },
      "required": [
        "status",
        "phase_status_before",
        "phase_status_after",
        "acceptance",
        "acceptance_basis",
        "acceptance_scope",
        "execution_mode",
        "native_core_ai_qualification",
        "product_qualification",
        "roadmap_exit_outcome"
      ],
      "type": "object"
    },
    "authorizations": {
      "additionalProperties": false,
      "properties": {
        "r09_phase_acceptance": {"const": "authorized", "type": "string"},
        "r09_phase_status": {"const": "passed", "type": "string"},
        "r10_phase_progression": {
          "const": "not_authorized_requires_separate_operator_authorization",
          "type": "string"
        },
        "production_default": {"const": "not_authorized", "type": "string"},
        "auto_mode": {"const": "not_authorized", "type": "string"},
        "holdout": {"const": "not_authorized", "type": "string"},
        "quality_claims": {"const": "not_authorized", "type": "string"},
        "performance_claims": {"const": "not_authorized", "type": "string"},
        "product_publication": {"const": "not_authorized", "type": "string"},
        "release": {"const": "not_authorized", "type": "string"},
        "native_core_ai_claims": {"const": "not_authorized", "type": "string"}
      },
      "required": [
        "r09_phase_acceptance",
        "r09_phase_status",
        "r10_phase_progression",
        "production_default",
        "auto_mode",
        "holdout",
        "quality_claims",
        "performance_claims",
        "product_publication",
        "release",
        "native_core_ai_claims"
      ],
      "type": "object"
    },
    "limitations": {
      "items": {"minLength": 1, "type": "string"},
      "maxItems": 7,
      "minItems": 7,
      "type": "array"
    }
  },
  "required": [
    "schema_version",
    "roadmap_version",
    "phase_id",
    "evidence_kind",
    "source",
    "operator_override",
    "functional_gate",
    "contract_bindings",
    "implementation_bindings",
    "execution_receipt_binding",
    "comparison_policy",
    "contract_interpretations",
    "derived_checks",
    "result",
    "authorizations",
    "limitations"
  ],
  "type": "object"
}
