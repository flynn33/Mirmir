{
  "$id": "https://mirmir.local/docs/roadmaps/evidence/schema/r01-observation-waiver-v1.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "anchors": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "anchor": {
            "$ref": "#/$defs/anchor"
          },
          "hardware_observation": {
            "const": "not_observed"
          },
          "simulator_observation": {
            "const": "not_observed"
          },
          "target_contract": {
            "$ref": "#/$defs/nonemptyString"
          }
        },
        "required": [
          "anchor",
          "hardware_observation",
          "simulator_observation",
          "target_contract"
        ],
        "type": "object"
      },
      "maxItems": 4,
      "minItems": 4,
      "type": "array"
    },
    "capabilities": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "anchor_records": {
            "items": {
              "$ref": "#/$defs/notObservedCapability"
            },
            "maxItems": 4,
            "minItems": 4,
            "type": "array"
          },
          "family": {
            "$ref": "#/$defs/nonemptyString"
          },
          "id": {
            "pattern": "^A(?:0[1-9]|1[0-8])$",
            "type": "string"
          },
          "method": {
            "$ref": "#/$defs/nonemptyString"
          },
          "probe_class": {
            "enum": [
              "primary_scaler",
              "support_filter",
              "temporal_analyzer",
              "cadence_transform",
              "analysis_runtime"
            ],
            "type": "string"
          }
        },
        "required": [
          "id",
          "family",
          "method",
          "probe_class",
          "anchor_records"
        ],
        "type": "object"
      },
      "maxItems": 18,
      "minItems": 18,
      "type": "array"
    },
    "evidence_kind": {
      "const": "operator_observation_waiver"
    },
    "fixture_catalog_binding": {
      "$ref": "#/$defs/repositoryBinding"
    },
    "generated_at": {
      "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]+)?(?:Z|[+-][0-9]{2}:[0-9]{2})$",
      "type": "string"
    },
    "limitations": {
      "items": {
        "$ref": "#/$defs/nonemptyString"
      },
      "minItems": 3,
      "type": "array",
      "uniqueItems": true
    },
    "model_observation": {
      "additionalProperties": false,
      "properties": {
        "identity": {
          "type": "null"
        },
        "sha256": {
          "type": "null"
        },
        "status": {
          "const": "not_observed"
        }
      },
      "required": [
        "status",
        "identity",
        "sha256"
      ],
      "type": "object"
    },
    "observation_policy": {
      "additionalProperties": false,
      "properties": {
        "hardware_required": {
          "const": false
        },
        "observed_operation_required": {
          "const": false
        },
        "performance_claims": {
          "const": "forbidden"
        },
        "simulator_required": {
          "const": false
        }
      },
      "required": [
        "hardware_required",
        "simulator_required",
        "observed_operation_required",
        "performance_claims"
      ],
      "type": "object"
    },
    "observation_requirement": {
      "const": "waived_not_a_blocker"
    },
    "phase_id": {
      "const": "R01"
    },
    "preregistration_binding": {
      "$ref": "#/$defs/repositoryBinding"
    },
    "roadmap_version": {
      "const": "1.0.1"
    },
    "schema_version": {
      "const": "1.0"
    },
    "source_commit": {
      "$ref": "#/$defs/gitObjectID"
    },
    "source_tree": {
      "$ref": "#/$defs/gitObjectID"
    }
  },
  "required": [
    "schema_version",
    "roadmap_version",
    "phase_id",
    "evidence_kind",
    "observation_requirement",
    "observation_policy",
    "source_commit",
    "source_tree",
    "generated_at",
    "preregistration_binding",
    "fixture_catalog_binding",
    "model_observation",
    "anchors",
    "capabilities",
    "limitations"
  ],
  "title": "Mirmir R01 Operator-Waived Observation Matrix",
  "type": "object",
  "$defs": {
    "anchor": {
      "enum": [
        "oldest-supported",
        "m3-air",
        "pro-max",
        "core-ai"
      ],
      "type": "string"
    },
    "gitObjectID": {
      "pattern": "^(?!0{40}$)[0-9a-f]{40}$",
      "type": "string"
    },
    "nonemptyString": {
      "minLength": 1,
      "type": "string"
    },
    "notObservedCapability": {
      "additionalProperties": false,
      "properties": {
        "anchor": {
          "$ref": "#/$defs/anchor"
        },
        "backend_eligibility": {
          "const": "not_evaluated_in_r01"
        },
        "compile_state": {
          "const": "not_observed"
        },
        "hardware_eligibility": {
          "const": "not_observed"
        },
        "measurement_status": {
          "const": "not_measured"
        },
        "model_readiness": {
          "const": "not_observed"
        },
        "observation_status": {
          "const": "not_observed"
        },
        "performance_claims": {
          "const": "forbidden"
        },
        "product_qualification": {
          "const": "not_evaluated_in_r01"
        },
        "public_api_status": {
          "const": "not_observed"
        },
        "quality_evaluation": {
          "const": "not_evaluated_in_r01"
        },
        "reason_code": {
          "const": "operator_gate_waiver"
        },
        "runtime_disposition": {
          "const": "diagnostic_only"
        },
        "support_query": {
          "const": "not_observed"
        }
      },
      "required": [
        "anchor",
        "observation_status",
        "compile_state",
        "runtime_disposition",
        "reason_code",
        "public_api_status",
        "hardware_eligibility",
        "support_query",
        "model_readiness",
        "measurement_status",
        "performance_claims",
        "product_qualification",
        "backend_eligibility",
        "quality_evaluation"
      ],
      "type": "object"
    },
    "repositoryBinding": {
      "additionalProperties": false,
      "properties": {
        "path": {
          "minLength": 1,
          "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\\\)(?!.*\\u0000).+$",
          "type": "string"
        },
        "sha256": {
          "pattern": "^(?!0{64}$)[0-9a-f]{64}$",
          "type": "string"
        },
        "size_bytes": {
          "maximum": 26214400,
          "minimum": 1,
          "type": "integer"
        }
      },
      "required": [
        "path",
        "size_bytes",
        "sha256"
      ],
      "type": "object"
    }
  }
}
