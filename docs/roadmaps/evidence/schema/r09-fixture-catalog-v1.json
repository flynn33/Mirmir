{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mirmir.invalid/schema/r09-fixture-catalog-v1.json",
  "title": "Mirmir R09 bounded-residual fixture catalog",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "phase_id",
    "contract_id",
    "accepted_r08_binding",
    "fixture_parameters",
    "authorization_fixtures",
    "application_fixtures",
    "safety_fixtures",
    "lifecycle_fixtures",
    "boundary_fixtures"
  ],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "phase_id": {"const": "R09"},
    "contract_id": {"const": "r09-core-ai-bounded-residual-fixtures-v1"},
    "accepted_r08_binding": {"$ref": "#/$defs/acceptedR08Binding"},
    "fixture_parameters": {"$ref": "#/$defs/fixtureParameters"},
    "authorization_fixtures": {"$ref": "#/$defs/fixtureArray"},
    "application_fixtures": {"$ref": "#/$defs/fixtureArray"},
    "safety_fixtures": {"$ref": "#/$defs/fixtureArray"},
    "lifecycle_fixtures": {"$ref": "#/$defs/fixtureArray"},
    "boundary_fixtures": {"$ref": "#/$defs/fixtureArray"}
  },
  "$defs": {
    "acceptedR08Binding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["raw_sha256", "implementation_commit", "implementation_tree"],
      "properties": {
        "raw_sha256": {"const": "0d81917a93cf56cae867c11b7c65fb3c85e53b7596929cf9eec2ef09c24634b0"},
        "implementation_commit": {"const": "368b9284883c189be6a1139df6208bf0e88139dd"},
        "implementation_tree": {"const": "f8e73d193b7b0c9df7005a7aa006de48ca48f77c"}
      }
    },
    "fixtureParameters": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "numeric_encoding",
        "residual_minimum",
        "residual_maximum",
        "spatial_width",
        "spatial_height",
        "simulation_identity",
        "fixture_value_scope",
        "native_core_ai_execution",
        "model_asset_execution",
        "physical_hardware_execution",
        "simulator_execution",
        "operator_observation"
      ],
      "properties": {
        "numeric_encoding": {"const": "signed_q16"},
        "residual_minimum": {"const": -4096},
        "residual_maximum": {"const": 4096},
        "spatial_width": {"const": 2},
        "spatial_height": {"const": 2},
        "simulation_identity": {"const": "r09.deterministic-bounded-residual-fixture-simulation.v1"},
        "fixture_value_scope": {"const": "software_test_inputs_not_product_or_quality_thresholds"},
        "native_core_ai_execution": {"const": "not_observed"},
        "model_asset_execution": {"const": "not_observed"},
        "physical_hardware_execution": {"const": "not_observed"},
        "simulator_execution": {"const": "not_observed"},
        "operator_observation": {"const": "not_observed"}
      }
    },
    "fixture": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "inputs", "expected"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "inputs": {"type": "object"},
        "expected": {"type": "object"}
      }
    },
    "fixtureArray": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/fixture"}
    }
  }
}
