{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mirmir.invalid/schema/r07-temporal-artifact-conformance-v1.json",
  "title": "Mirmir R07 temporal and artifact-control conformance",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "roadmap_version",
    "phase_id",
    "evidence_kind",
    "source",
    "preregistration_binding",
    "fixture_catalog_binding",
    "observation_status",
    "product_gate_result",
    "fixture_checks",
    "product_comparisons",
    "checks",
    "result",
    "limitations"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "roadmap_version": {
      "const": "1.0.1"
    },
    "phase_id": {
      "const": "R07"
    },
    "evidence_kind": {
      "const": "r07_temporal_artifact_contract"
    },
    "source": {
      "$ref": "#/$defs/source"
    },
    "preregistration_binding": {
      "$ref": "#/$defs/binding"
    },
    "fixture_catalog_binding": {
      "$ref": "#/$defs/binding"
    },
    "observation_status": {
      "const": {
        "hardware_capability_observation": "not_observed",
        "simulator_execution": "not_observed",
        "operator_observed_operation": "not_observed",
        "product_comparison_execution": "not_observed",
        "quality_claims": "forbidden",
        "performance_claims": "forbidden"
      }
    },
    "product_gate_result": {
      "const": {
        "reason": "upstream_no_product_qualified_primary_backend",
        "eligible_backend_count": 0,
        "selected_route_id": null,
        "selected_plan_id": null,
        "output_identity": null,
        "disposition": "blocked"
      }
    },
    "fixture_checks": {
      "const": [
        {
          "id": "source_bindings_exact",
          "status": "passed"
        },
        {
          "id": "temporal_metrics_exact",
          "status": "passed"
        },
        {
          "id": "temporal_threshold_equality_exact",
          "status": "passed"
        },
        {
          "id": "vector_bounds_exact",
          "status": "passed"
        },
        {
          "id": "history_window_churn_reset_exact",
          "status": "passed"
        },
        {
          "id": "artifact_metrics_exact",
          "status": "passed"
        },
        {
          "id": "artifact_normalization_aggregate_exact",
          "status": "passed"
        },
        {
          "id": "protected_masks_exact",
          "status": "passed"
        },
        {
          "id": "weighted_mae_exact",
          "status": "passed"
        },
        {
          "id": "support_stage_admission_exact",
          "status": "passed"
        },
        {
          "id": "product_gate_before_construction",
          "status": "passed"
        },
        {
          "id": "postflight_feedback_exact",
          "status": "passed"
        },
        {
          "id": "comparator_nonvacuity_exact",
          "status": "passed"
        }
      ]
    },
    "product_comparisons": {
      "const": [
        {
          "id": "temporal_artifact",
          "status": "not_observed",
          "reason": "upstream_no_product_qualified_primary_backend"
        },
        {
          "id": "chroma_displacement",
          "status": "not_observed",
          "reason": "upstream_no_product_qualified_primary_backend"
        },
        {
          "id": "spatial_ms_ssim",
          "status": "not_observed",
          "reason": "upstream_no_product_qualified_primary_backend"
        },
        {
          "id": "protected_integrity",
          "status": "not_observed",
          "reason": "upstream_no_product_qualified_primary_backend"
        }
      ]
    },
    "checks": {
      "const": [
        {
          "id": "predecessor_closure_exact",
          "status": "passed"
        },
        {
          "id": "frozen_bindings_exact",
          "status": "passed"
        },
        {
          "id": "checked_fixed_point_exact",
          "status": "passed"
        },
        {
          "id": "vector_bounds_exact",
          "status": "passed"
        },
        {
          "id": "temporal_contract_exact",
          "status": "passed"
        },
        {
          "id": "history_contract_exact",
          "status": "passed"
        },
        {
          "id": "artifact_contract_exact",
          "status": "passed"
        },
        {
          "id": "protected_content_exact",
          "status": "passed"
        },
        {
          "id": "weighted_mae_exact",
          "status": "passed"
        },
        {
          "id": "support_stage_policy_exact",
          "status": "passed"
        },
        {
          "id": "postflight_governance_exact",
          "status": "passed"
        },
        {
          "id": "product_comparator_exact",
          "status": "passed"
        },
        {
          "id": "product_gate_closed",
          "status": "passed"
        },
        {
          "id": "observation_override_nonblocking",
          "status": "passed"
        },
        {
          "id": "product_comparisons_not_observed",
          "status": "passed"
        },
        {
          "id": "no_quality_or_performance_claim",
          "status": "passed"
        },
        {
          "id": "production_default_disabled",
          "status": "passed"
        }
      ]
    },
    "result": {
      "const": {
        "status": "blocked",
        "reason": "upstream_no_product_qualified_primary_backend",
        "default_backend_id": null,
        "selected_route_id": null,
        "selected_plan_id": null,
        "output_identity": null,
        "product_qualification": "not_claimed",
        "quality_claims": "forbidden",
        "performance_claims": "forbidden",
        "acceptance": "not_claimed"
      }
    },
    "limitations": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      },
      "contains": {
        "const": "R07 A13/A15 support reconstruction execution was not observed; descriptor-and-admission conformance makes no support output claim."
      },
      "minContains": 1,
      "maxContains": 1
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "gitObject": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "commit",
        "tree"
      ],
      "properties": {
        "commit": {
          "$ref": "#/$defs/gitObject"
        },
        "tree": {
          "$ref": "#/$defs/gitObject"
        }
      }
    },
    "binding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "size_bytes",
        "sha256"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "size_bytes": {
          "type": "integer",
          "minimum": 1
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "observation": {
      "const": {
        "hardware_capability_observation": "not_observed",
        "simulator_execution": "not_observed",
        "operator_observed_operation": "not_observed",
        "product_comparison_execution": "not_observed",
        "quality_claims": "forbidden",
        "performance_claims": "forbidden"
      }
    },
    "productGate": {
      "const": {
        "reason": "upstream_no_product_qualified_primary_backend",
        "eligible_backend_count": 0,
        "selected_route_id": null,
        "selected_plan_id": null,
        "output_identity": null,
        "disposition": "blocked"
      }
    },
    "check": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "status"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "enum": [
            "passed",
            "blocked",
            "not_observed"
          ]
        }
      }
    },
    "checkArray": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/check"
      }
    },
    "productComparison": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "status",
        "reason"
      ],
      "properties": {
        "id": {
          "enum": [
            "temporal_artifact",
            "chroma_displacement",
            "spatial_ms_ssim",
            "protected_integrity"
          ]
        },
        "status": {
          "const": "not_observed"
        },
        "reason": {
          "const": "upstream_no_product_qualified_primary_backend"
        }
      }
    },
    "result": {
      "const": {
        "status": "blocked",
        "reason": "upstream_no_product_qualified_primary_backend",
        "default_backend_id": null,
        "selected_route_id": null,
        "selected_plan_id": null,
        "output_identity": null,
        "product_qualification": "not_claimed",
        "quality_claims": "forbidden",
        "performance_claims": "forbidden",
        "acceptance": "not_claimed"
      }
    }
  }
}
