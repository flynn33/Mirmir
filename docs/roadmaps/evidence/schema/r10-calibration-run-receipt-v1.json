{
  "$id": "https://mirmir.local/docs/roadmaps/evidence/schema/r10-calibration-run-receipt-v1.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "sha256": {
      "pattern": "^(?!0{64}$)[0-9a-f]{64}$",
      "type": "string"
    },
    "gitObject": {
      "pattern": "^(?!0{40}$)(?:[0-9a-f]{40}|[0-9a-f]{64})$",
      "type": "string"
    },
    "rawBinding": {
      "additionalProperties": false,
      "properties": {
        "path": {"minLength": 1, "type": "string"},
        "size_bytes": {"minimum": 1, "type": "integer"},
        "sha256": {"$ref": "#/$defs/sha256"}
      },
      "required": ["path", "size_bytes", "sha256"],
      "type": "object"
    },
    "sourceBinding": {
      "additionalProperties": false,
      "properties": {
        "role": {
          "enum": [
            "optimizer_contract",
            "persistence_contract",
            "fixture_catalog",
            "evaluation_catalog_raw_envelope",
            "policy_catalog",
            "fixture_catalog_schema",
            "evaluation_catalog_schema",
            "policy_catalog_schema",
            "schema_validation_runtime",
            "fixture_calibration_runner",
            "catalog_contract_parser"
          ],
          "type": "string"
        },
        "path": {"minLength": 1, "type": "string"},
        "git_blob": {"$ref": "#/$defs/gitObject"},
        "size_bytes": {"minimum": 1, "type": "integer"},
        "sha256": {"$ref": "#/$defs/sha256"}
      },
      "required": ["role", "path", "git_blob", "size_bytes", "sha256"],
      "type": "object"
    },
    "processingIdentity": {
      "additionalProperties": false,
      "properties": {
        "source_commit": {"$ref": "#/$defs/gitObject"},
        "source_tree": {"$ref": "#/$defs/gitObject"},
        "optimizer_contract_sha256": {"$ref": "#/$defs/sha256"},
        "persistence_contract_sha256": {"$ref": "#/$defs/sha256"},
        "fixture_catalog_sha256": {"$ref": "#/$defs/sha256"},
        "evaluator_sha256": {"$ref": "#/$defs/sha256"},
        "policy_catalog_sha256": {"$ref": "#/$defs/sha256"}
      },
      "required": [
        "source_commit",
        "source_tree",
        "optimizer_contract_sha256",
        "persistence_contract_sha256",
        "fixture_catalog_sha256",
        "evaluator_sha256",
        "policy_catalog_sha256"
      ],
      "type": "object"
    },
    "artifactBinding": {
      "additionalProperties": false,
      "properties": {
        "path": {"pattern": "^(checkpoints|frozen-policies)/[0-9a-f]{64}\\.json$", "type": "string"},
        "size_bytes": {"minimum": 1, "type": "integer"},
        "sha256": {"$ref": "#/$defs/sha256"}
      },
      "required": ["path", "size_bytes", "sha256"],
      "type": "object"
    },
    "checkpointArtifactBinding": {
      "allOf": [
        {"$ref": "#/$defs/artifactBinding"},
        {
          "properties": {
            "path": {
              "pattern": "^checkpoints/[0-9a-f]{64}\\.json$",
              "type": "string"
            }
          }
        }
      ]
    },
    "frozenPolicyArtifactBinding": {
      "allOf": [
        {"$ref": "#/$defs/artifactBinding"},
        {
          "properties": {
            "path": {
              "pattern": "^frozen-policies/[0-9a-f]{64}\\.json$",
              "type": "string"
            }
          }
        }
      ]
    },
    "checkpointBinding": {
      "additionalProperties": false,
      "properties": {
        "artifact": {"$ref": "#/$defs/checkpointArtifactBinding"},
        "checkpoint_sha256": {"$ref": "#/$defs/sha256"},
        "status": {"enum": ["in_progress", "completed"], "type": "string"},
        "next_candidate_index": {"maximum": 9, "minimum": 0, "type": "integer"}
      },
      "required": [
        "artifact",
        "checkpoint_sha256",
        "status",
        "next_candidate_index"
      ],
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schema_version": {"const": "1.0.0", "type": "string"},
    "phase_id": {"const": "R10", "type": "string"},
    "artifact_kind": {
      "const": "r10_fixture_calibration_run_receipt",
      "type": "string"
    },
    "result_status": {"const": "succeeded", "type": "string"},
    "processing_identity": {"$ref": "#/$defs/processingIdentity"},
    "processing_identity_sha256": {"$ref": "#/$defs/sha256"},
    "source_files": {
      "items": false,
      "maxItems": 11,
      "minItems": 11,
      "prefixItems": [
        {
          "allOf": [
            {"$ref": "#/$defs/sourceBinding"},
            {
              "properties": {
                "role": {"const": "optimizer_contract"},
                "path": {
                  "const": "validation/calibration_v2/r10_optimizer.py"
                }
              }
            }
          ]
        },
        {
          "allOf": [
            {"$ref": "#/$defs/sourceBinding"},
            {
              "properties": {
                "role": {"const": "persistence_contract"},
                "path": {
                  "const": "validation/calibration_v2/r10_persistence.py"
                }
              }
            }
          ]
        },
        {
          "allOf": [
            {"$ref": "#/$defs/sourceBinding"},
            {
              "properties": {
                "role": {"const": "fixture_catalog"},
                "path": {
                  "const": "docs/roadmaps/evidence/r10/records/fixtures/fixture-catalog.json"
                }
              }
            }
          ]
        },
        {
          "allOf": [
            {"$ref": "#/$defs/sourceBinding"},
            {
              "properties": {
                "role": {"const": "evaluation_catalog_raw_envelope"},
                "path": {
                  "const": "docs/roadmaps/evidence/r10/records/fixtures/evaluation-catalog.json"
                }
              }
            }
          ]
        },
        {
          "allOf": [
            {"$ref": "#/$defs/sourceBinding"},
            {
              "properties": {
                "role": {"const": "policy_catalog"},
                "path": {
                  "const": "docs/roadmaps/evidence/r10/records/fixtures/policy-catalog.json"
                }
              }
            }
          ]
        },
        {
          "allOf": [
            {"$ref": "#/$defs/sourceBinding"},
            {
              "properties": {
                "role": {"const": "fixture_catalog_schema"},
                "path": {
                  "const": "docs/roadmaps/evidence/schema/r10-fixture-catalog-v1.json"
                }
              }
            }
          ]
        },
        {
          "allOf": [
            {"$ref": "#/$defs/sourceBinding"},
            {
              "properties": {
                "role": {"const": "evaluation_catalog_schema"},
                "path": {
                  "const": "docs/roadmaps/evidence/schema/r10-evaluation-catalog-v1.json"
                }
              }
            }
          ]
        },
        {
          "allOf": [
            {"$ref": "#/$defs/sourceBinding"},
            {
              "properties": {
                "role": {"const": "policy_catalog_schema"},
                "path": {
                  "const": "docs/roadmaps/evidence/schema/r10-policy-catalog-v1.json"
                }
              }
            }
          ]
        },
        {
          "allOf": [
            {"$ref": "#/$defs/sourceBinding"},
            {
              "properties": {
                "role": {"const": "schema_validation_runtime"},
                "path": {"const": "Scripts/phase_evidence.py"}
              }
            }
          ]
        },
        {
          "allOf": [
            {"$ref": "#/$defs/sourceBinding"},
            {
              "properties": {
                "role": {"const": "fixture_calibration_runner"},
                "path": {
                  "const": "validation/calibration_v2/tools/run_r10_fixture_calibration.py"
                }
              }
            }
          ]
        },
        {
          "allOf": [
            {"$ref": "#/$defs/sourceBinding"},
            {
              "properties": {
                "role": {"const": "catalog_contract_parser"},
                "path": {"const": "Scripts/r10_contracts.py"}
              }
            }
          ]
        }
      ],
      "type": "array"
    },
    "raw_evaluation_catalog_binding": {"$ref": "#/$defs/rawBinding"},
    "semantic_evaluator_sha256": {"$ref": "#/$defs/sha256"},
    "execution_contract": {
      "additionalProperties": false,
      "properties": {
        "maximum_candidates": {"const": 9, "type": "integer"},
        "candidate_count": {"const": 9, "type": "integer"},
        "scored_count": {"const": 3, "type": "integer"},
        "rejected_count": {"const": 6, "type": "integer"},
        "independently_rejected_constraints": {
          "items": false,
          "maxItems": 6,
          "minItems": 6,
          "prefixItems": [
            {"const": "route", "type": "string"},
            {"const": "plane", "type": "string"},
            {"const": "temporal", "type": "string"},
            {"const": "protected_region", "type": "string"},
            {"const": "resource", "type": "string"},
            {"const": "safety", "type": "string"}
          ],
          "type": "array"
        },
        "evaluation_observation_count": {"const": 3, "type": "integer"},
        "tie_break": {
          "additionalProperties": false,
          "properties": {
            "equal_score_candidate_ids": {
              "items": false,
              "maxItems": 2,
              "minItems": 2,
              "prefixItems": [
                {"const": "fixture-valid-alpha", "type": "string"},
                {"const": "fixture-valid-beta", "type": "string"}
              ],
              "type": "array"
            },
            "rule": {
              "const": "absolute_score_dimensions_descending_then_canonical_candidate_bytes_ascending",
              "type": "string"
            },
            "winner_candidate_id": {
              "const": "fixture-valid-alpha",
              "type": "string"
            }
          },
          "required": ["equal_score_candidate_ids", "rule", "winner_candidate_id"],
          "type": "object"
        },
        "execution_scope": {
          "const": "deterministic_fixture_policy_only",
          "type": "string"
        },
        "comparison_methods_used": {"const": false, "type": "boolean"},
        "production_auto_authorized": {"const": false, "type": "boolean"},
        "holdout_authorized": {"const": false, "type": "boolean"}
      },
      "required": [
        "maximum_candidates",
        "candidate_count",
        "scored_count",
        "rejected_count",
        "independently_rejected_constraints",
        "evaluation_observation_count",
        "tie_break",
        "execution_scope",
        "comparison_methods_used",
        "production_auto_authorized",
        "holdout_authorized"
      ],
      "type": "object"
    },
    "checkpoint_bindings": {
      "items": false,
      "maxItems": 10,
      "minItems": 10,
      "prefixItems": [
        {
          "allOf": [
            {"$ref": "#/$defs/checkpointBinding"},
            {
              "properties": {
                "next_candidate_index": {"const": 0},
                "status": {"const": "in_progress"}
              }
            }
          ]
        },
        {
          "allOf": [
            {"$ref": "#/$defs/checkpointBinding"},
            {
              "properties": {
                "next_candidate_index": {"const": 1},
                "status": {"const": "in_progress"}
              }
            }
          ]
        },
        {
          "allOf": [
            {"$ref": "#/$defs/checkpointBinding"},
            {
              "properties": {
                "next_candidate_index": {"const": 2},
                "status": {"const": "in_progress"}
              }
            }
          ]
        },
        {
          "allOf": [
            {"$ref": "#/$defs/checkpointBinding"},
            {
              "properties": {
                "next_candidate_index": {"const": 3},
                "status": {"const": "in_progress"}
              }
            }
          ]
        },
        {
          "allOf": [
            {"$ref": "#/$defs/checkpointBinding"},
            {
              "properties": {
                "next_candidate_index": {"const": 4},
                "status": {"const": "in_progress"}
              }
            }
          ]
        },
        {
          "allOf": [
            {"$ref": "#/$defs/checkpointBinding"},
            {
              "properties": {
                "next_candidate_index": {"const": 5},
                "status": {"const": "in_progress"}
              }
            }
          ]
        },
        {
          "allOf": [
            {"$ref": "#/$defs/checkpointBinding"},
            {
              "properties": {
                "next_candidate_index": {"const": 6},
                "status": {"const": "in_progress"}
              }
            }
          ]
        },
        {
          "allOf": [
            {"$ref": "#/$defs/checkpointBinding"},
            {
              "properties": {
                "next_candidate_index": {"const": 7},
                "status": {"const": "in_progress"}
              }
            }
          ]
        },
        {
          "allOf": [
            {"$ref": "#/$defs/checkpointBinding"},
            {
              "properties": {
                "next_candidate_index": {"const": 8},
                "status": {"const": "in_progress"}
              }
            }
          ]
        },
        {
          "allOf": [
            {"$ref": "#/$defs/checkpointBinding"},
            {
              "properties": {
                "next_candidate_index": {"const": 9},
                "status": {"const": "completed"}
              }
            }
          ]
        }
      ],
      "type": "array"
    },
    "publication": {
      "additionalProperties": false,
      "properties": {
        "final_checkpoint": {"$ref": "#/$defs/checkpointArtifactBinding"},
        "frozen_policy": {"$ref": "#/$defs/frozenPolicyArtifactBinding"},
        "policy_sha256": {"$ref": "#/$defs/sha256"},
        "selection_sha256": {"$ref": "#/$defs/sha256"},
        "selected_candidate_id": {
          "const": "fixture-valid-alpha",
          "type": "string"
        }
      },
      "required": [
        "final_checkpoint",
        "frozen_policy",
        "policy_sha256",
        "selection_sha256",
        "selected_candidate_id"
      ],
      "type": "object"
    }
  },
  "required": [
    "schema_version",
    "phase_id",
    "artifact_kind",
    "result_status",
    "processing_identity",
    "processing_identity_sha256",
    "source_files",
    "raw_evaluation_catalog_binding",
    "semantic_evaluator_sha256",
    "execution_contract",
    "checkpoint_bindings",
    "publication"
  ],
  "type": "object"
}
