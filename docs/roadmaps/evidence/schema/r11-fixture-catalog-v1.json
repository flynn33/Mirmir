{
  "$id": "https://github.com/flynn33/Mirmir/docs/roadmaps/evidence/schema/r11-fixture-catalog-v1.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "aggregate_cases": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "expected_aggregate": {
            "$ref": "#/$defs/aggregate"
          },
          "id": {
            "pattern": "^aggregate-[a-z0-9-]+$",
            "type": "string"
          },
          "observation_ids": {
            "items": {
              "pattern": "^observation-[a-z0-9-]+$",
              "type": "string"
            },
            "minItems": 1,
            "type": "array",
            "uniqueItems": true
          }
        },
        "required": [
          "id",
          "observation_ids",
          "expected_aggregate"
        ],
        "type": "object"
      },
      "maxItems": 1,
      "minItems": 1,
      "type": "array"
    },
    "catalog_state": {
      "const": "frozen_for_r11_implementation"
    },
    "claim_boundary": {
      "$ref": "#/$defs/claimBoundary"
    },
    "comparison_policy": {
      "additionalProperties": false,
      "properties": {
        "acceptance_dependency": {
          "const": "none"
        },
        "comparison_method": {
          "const": "absent_not_required"
        },
        "comparison_success_case": {
          "const": "absent"
        }
      },
      "required": [
        "comparison_method",
        "comparison_success_case",
        "acceptance_dependency"
      ],
      "type": "object"
    },
    "identity_component_order": {
      "$ref": "#/$defs/identityComponentOrder"
    },
    "observation_state_order": {
      "$ref": "#/$defs/observationStateOrder"
    },
    "observations": {
      "items": {
        "$ref": "#/$defs/observation"
      },
      "maxItems": 5,
      "minItems": 5,
      "type": "array"
    },
    "phase_id": {
      "const": "R11"
    },
    "rejection_cases": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "expected_reason": {
            "enum": [
              "missing_identity_component",
              "duplicate_identity_component",
              "identity_digest_mismatch",
              "claim_scope_out_of_scope",
              "forged_authorization"
            ]
          },
          "expected_status": {
            "const": "rejected"
          },
          "id": {
            "pattern": "^reject-[a-z0-9-]+$",
            "type": "string"
          },
          "mutation": {
            "additionalProperties": false,
            "properties": {
              "operation": {
                "enum": [
                  "remove_identity_component",
                  "duplicate_identity_component",
                  "replace_identity_value_without_digest",
                  "set_claim_scope_out_of_scope",
                  "set_production_auto_mode_authorized"
                ]
              },
              "target": {
                "minLength": 1,
                "type": "string"
              }
            },
            "required": [
              "operation",
              "target"
            ],
            "type": "object"
          },
          "source_observation_id": {
            "pattern": "^observation-[a-z0-9-]+$",
            "type": "string"
          }
        },
        "required": [
          "id",
          "source_observation_id",
          "mutation",
          "expected_status",
          "expected_reason"
        ],
        "type": "object"
      },
      "maxItems": 5,
      "minItems": 5,
      "type": "array"
    },
    "roadmap_version": {
      "const": "1.0.1"
    },
    "schema_version": {
      "const": "1.0.0"
    }
  },
  "required": [
    "schema_version",
    "roadmap_version",
    "phase_id",
    "catalog_state",
    "identity_component_order",
    "observation_state_order",
    "observations",
    "aggregate_cases",
    "rejection_cases",
    "claim_boundary",
    "comparison_policy"
  ],
  "title": "R11 traceability fixture catalog",
  "type": "object",
  "$defs": {
    "aggregate": {
      "additionalProperties": false,
      "properties": {
        "aggregate_state": {
          "enum": [
            "observed",
            "not_applicable",
            "not_observed",
            "failed",
            "absent",
            "mixed"
          ]
        },
        "expected_observation_ids": {
          "items": {
            "pattern": "^observation-[a-z0-9-]+$",
            "type": "string"
          },
          "minItems": 1,
          "type": "array",
          "uniqueItems": true
        },
        "identity": {
          "$ref": "#/$defs/evidenceIdentity"
        },
        "observation_sha256_values": {
          "items": {
            "pattern": "^[0-9a-f]{64}$",
            "type": "string"
          },
          "minItems": 1,
          "type": "array",
          "uniqueItems": true
        },
        "observed_values": {
          "items": {
            "additionalProperties": false,
            "properties": {
              "observation_id": {
                "pattern": "^observation-[a-z0-9-]+$",
                "type": "string"
              },
              "value": {
                "type": [
                  "string",
                  "number",
                  "integer",
                  "boolean"
                ]
              }
            },
            "required": [
              "observation_id",
              "value"
            ],
            "type": "object"
          },
          "type": "array"
        },
        "state_counts": {
          "$ref": "#/$defs/stateCounts"
        }
      },
      "required": [
        "identity",
        "expected_observation_ids",
        "observation_sha256_values",
        "observed_values",
        "state_counts",
        "aggregate_state"
      ],
      "type": "object"
    },
    "claimBoundary": {
      "additionalProperties": false,
      "properties": {
        "claim_scope": {
          "const": "software_behavior_report"
        },
        "market_disposition": {
          "const": "no_market_claim"
        },
        "market_leading_claim": {
          "const": "blocked"
        },
        "production_auto_mode": {
          "const": "blocked"
        }
      },
      "required": [
        "claim_scope",
        "market_disposition",
        "production_auto_mode",
        "market_leading_claim"
      ],
      "type": "object"
    },
    "evidenceIdentity": {
      "additionalProperties": false,
      "properties": {
        "derived_digest_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        "execution": {
          "additionalProperties": false,
          "properties": {
            "execution_id": {
              "pattern": "^[a-z0-9][a-z0-9._:-]*$",
              "type": "string"
            },
            "execution_mode": {
              "pattern": "^[a-z0-9][a-z0-9._:-]*$",
              "type": "string"
            },
            "invocation_sha256": {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            }
          },
          "required": [
            "execution_id",
            "execution_mode",
            "invocation_sha256"
          ],
          "type": "object"
        },
        "input": {
          "additionalProperties": false,
          "properties": {
            "input_id": {
              "pattern": "^[a-z0-9][a-z0-9._:-]*$",
              "type": "string"
            },
            "input_kind": {
              "pattern": "^[a-z0-9][a-z0-9._:-]*$",
              "type": "string"
            },
            "payload_sha256": {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            }
          },
          "required": [
            "input_id",
            "input_kind",
            "payload_sha256"
          ],
          "type": "object"
        },
        "preprocessing": {
          "additionalProperties": false,
          "properties": {
            "configuration_sha256": {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            },
            "pipeline_id": {
              "pattern": "^[a-z0-9][a-z0-9._:-]*$",
              "type": "string"
            }
          },
          "required": [
            "pipeline_id",
            "configuration_sha256"
          ],
          "type": "object"
        },
        "software": {
          "additionalProperties": false,
          "properties": {
            "component_id": {
              "pattern": "^[a-z0-9][a-z0-9._:-]*$",
              "type": "string"
            },
            "contract_sha256": {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            },
            "implementation_manifest_sha256": {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            }
          },
          "required": [
            "component_id",
            "implementation_manifest_sha256",
            "contract_sha256"
          ],
          "type": "object"
        },
        "source": {
          "additionalProperties": false,
          "properties": {
            "commit": {
              "pattern": "^[0-9a-f]{40}$",
              "type": "string"
            },
            "tree": {
              "pattern": "^[0-9a-f]{40}$",
              "type": "string"
            }
          },
          "required": [
            "commit",
            "tree"
          ],
          "type": "object"
        },
        "subject": {
          "additionalProperties": false,
          "properties": {
            "behavior_contract_sha256": {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            },
            "subject_id": {
              "pattern": "^[a-z0-9][a-z0-9._:-]*$",
              "type": "string"
            },
            "subject_kind": {
              "pattern": "^[a-z0-9][a-z0-9._:-]*$",
              "type": "string"
            }
          },
          "required": [
            "subject_id",
            "subject_kind",
            "behavior_contract_sha256"
          ],
          "type": "object"
        },
        "toolchain": {
          "additionalProperties": false,
          "properties": {
            "architecture": {
              "pattern": "^[a-z0-9][a-z0-9._:-]*$",
              "type": "string"
            },
            "command_sha256": {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            },
            "platform": {
              "pattern": "^[a-z0-9][a-z0-9._:-]*$",
              "type": "string"
            },
            "runtime_id": {
              "pattern": "^[a-z0-9][a-z0-9._:-]*$",
              "type": "string"
            },
            "runtime_version": {
              "pattern": "^[a-z0-9][a-z0-9._:+-]*$",
              "type": "string"
            }
          },
          "required": [
            "platform",
            "architecture",
            "runtime_id",
            "runtime_version",
            "command_sha256"
          ],
          "type": "object"
        }
      },
      "required": [
        "source",
        "software",
        "subject",
        "input",
        "preprocessing",
        "toolchain",
        "execution",
        "derived_digest_sha256"
      ],
      "type": "object"
    },
    "identityComponentOrder": {
      "items": false,
      "maxItems": 7,
      "minItems": 7,
      "prefixItems": [
        {
          "const": "source"
        },
        {
          "const": "software"
        },
        {
          "const": "subject"
        },
        {
          "const": "input"
        },
        {
          "const": "preprocessing"
        },
        {
          "const": "toolchain"
        },
        {
          "const": "execution"
        }
      ],
      "type": "array"
    },
    "observation": {
      "additionalProperties": false,
      "properties": {
        "failure_code": {
          "type": [
            "string",
            "null"
          ]
        },
        "identity": {
          "$ref": "#/$defs/evidenceIdentity"
        },
        "observation_id": {
          "pattern": "^observation-[a-z0-9-]+$",
          "type": "string"
        },
        "reason_code": {
          "type": [
            "string",
            "null"
          ]
        },
        "state": {
          "enum": [
            "observed",
            "not_applicable",
            "not_observed",
            "failed",
            "absent"
          ]
        },
        "value": {
          "type": [
            "string",
            "number",
            "integer",
            "boolean",
            "null"
          ]
        }
      },
      "required": [
        "observation_id",
        "identity",
        "state",
        "value",
        "reason_code",
        "failure_code"
      ],
      "type": "object"
    },
    "observationStateOrder": {
      "items": false,
      "maxItems": 5,
      "minItems": 5,
      "prefixItems": [
        {
          "const": "observed"
        },
        {
          "const": "not_applicable"
        },
        {
          "const": "not_observed"
        },
        {
          "const": "failed"
        },
        {
          "const": "absent"
        }
      ],
      "type": "array"
    },
    "stateCounts": {
      "additionalProperties": false,
      "properties": {
        "absent": {
          "minimum": 0,
          "type": "integer"
        },
        "failed": {
          "minimum": 0,
          "type": "integer"
        },
        "not_applicable": {
          "minimum": 0,
          "type": "integer"
        },
        "not_observed": {
          "minimum": 0,
          "type": "integer"
        },
        "observed": {
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "observed",
        "not_applicable",
        "not_observed",
        "failed",
        "absent"
      ],
      "type": "object"
    }
  }
}
