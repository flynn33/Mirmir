{
  "$id": "https://github.com/flynn33/Mirmir/docs/roadmaps/evidence/schema/r13-functional-execution-receipt-v1.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "acceptance_basis": {
      "const": "software_does_what_it_says_it_does"
    },
    "acceptance_scope": {
      "const": "declared_software_function_only"
    },
    "artifact_bindings": {
      "items": {
        "$ref": "#/$defs/namedFileBinding"
      },
      "maxItems": 8,
      "minItems": 8,
      "type": "array"
    },
    "claim_boundary": {
      "$ref": "#/$defs/claimBoundary"
    },
    "commands": {
      "$ref": "#/$defs/commands"
    },
    "comparison_policy": {
      "$ref": "#/$defs/comparisonPolicy"
    },
    "distribution_boundary": {
      "$ref": "#/$defs/distributionBoundary"
    },
    "contract_coverage": {
      "items": {
        "$ref": "#/$defs/contractCoverage"
      },
      "minItems": 1,
      "type": "array"
    },
    "evidence_kind": {
      "const": "r13_exact_source_software_function_execution_receipt_v1"
    },
    "execution_boundary": {
      "$ref": "#/$defs/executionBoundary"
    },
    "execution_identities": {
      "$ref": "#/$defs/executionIdentities"
    },
    "limitations": {
      "$ref": "#/$defs/limitations"
    },
    "observations": {
      "$ref": "#/$defs/observations"
    },
    "outcome": {
      "const": "release_ready_candidate"
    },
    "phase_id": {
      "const": "R13"
    },
    "predecessor_bindings": {
      "items": {
        "$ref": "#/$defs/predecessorBinding"
      },
      "maxItems": 2,
      "minItems": 2,
      "type": "array"
    },
    "roadmap_version": {
      "const": "1.0.1"
    },
    "schema_version": {
      "const": "1.0.0"
    },
    "source": {
      "$ref": "#/$defs/source"
    },
    "source_bindings": {
      "items": {
        "$ref": "#/$defs/sourceBinding"
      },
      "minItems": 20,
      "type": "array"
    },
    "test_inventory": {
      "items": {
        "$ref": "#/$defs/testSuite"
      },
      "minItems": 15,
      "type": "array"
    },
    "verification": {
      "$ref": "#/$defs/verification"
    }
  },
  "required": [
    "schema_version",
    "roadmap_version",
    "phase_id",
    "evidence_kind",
    "source",
    "predecessor_bindings",
    "source_bindings",
    "artifact_bindings",
    "commands",
    "execution_identities",
    "verification",
    "test_inventory",
    "contract_coverage",
    "acceptance_basis",
    "acceptance_scope",
    "outcome",
    "execution_boundary",
    "distribution_boundary",
    "observations",
    "claim_boundary",
    "comparison_policy",
    "limitations"
  ],
  "title": "R13 exact-source functional execution receipt",
  "type": "object",
  "$defs": {
    "checkpoint": {
      "additionalProperties": false,
      "properties": {
        "clean_after": {
          "const": true
        },
        "clean_before": {
          "const": true
        },
        "commit_after": {
          "$ref": "#/$defs/gitOid"
        },
        "commit_before": {
          "$ref": "#/$defs/gitOid"
        },
        "kind": {
          "const": "detached_clean_exact_git_checkpoint"
        },
        "tree_after": {
          "$ref": "#/$defs/gitOid"
        },
        "tree_before": {
          "$ref": "#/$defs/gitOid"
        }
      },
      "required": [
        "clean_after",
        "clean_before",
        "commit_after",
        "commit_before",
        "kind",
        "tree_after",
        "tree_before"
      ],
      "type": "object"
    },
    "claimBoundary": {
      "additionalProperties": false,
      "properties": {
        "auto_mode": {
          "const": "not_authorized"
        },
        "claim_scope": {
          "const": "software_behavior_report"
        },
        "fallback": {
          "const": "none"
        },
        "market_claim": {
          "const": "not_authorized"
        },
        "model": {
          "const": "not_required"
        },
        "product_publication": {
          "const": "not_authorized"
        },
        "release_publication": {
          "const": "not_authorized"
        },
        "tag_publication": {
          "const": "not_authorized"
        }
      },
      "required": [
        "auto_mode",
        "claim_scope",
        "fallback",
        "market_claim",
        "model",
        "product_publication",
        "release_publication",
        "tag_publication"
      ],
      "type": "object"
    },
    "commands": {
      "additionalProperties": false,
      "properties": {
        "build_for_testing": {
          "minLength": 1,
          "type": "string"
        },
        "output_reopen": {
          "minLength": 1,
          "type": "string"
        },
        "release_app_build": {
          "minLength": 1,
          "type": "string"
        },
        "swiftlint": {
          "const": "swiftlint lint --strict --no-cache"
        },
        "targeted_tests": {
          "minLength": 1,
          "type": "string"
        }
      },
      "required": [
        "build_for_testing",
        "targeted_tests",
        "release_app_build",
        "swiftlint",
        "output_reopen"
      ],
      "type": "object"
    },
    "comparisonPolicy": {
      "additionalProperties": false,
      "properties": {
        "ab_test": {
          "const": "absent_not_required"
        },
        "acceptance_dependency": {
          "const": "none"
        },
        "comparison_method": {
          "const": "absent_not_required"
        }
      },
      "required": [
        "ab_test",
        "acceptance_dependency",
        "comparison_method"
      ],
      "type": "object"
    },
    "contractCoverage": {
      "additionalProperties": false,
      "properties": {
        "contract_area": {
          "enum": [
            "assets_bootstrap_ui",
            "backend_routes_modes_auto",
            "identity_metadata_prepublish",
            "resource_fault_diagnostics",
            "resume_cache_bookmark_storage"
          ]
        },
        "contract_id": {
          "pattern": "^[a-z0-9_]+\\.[a-z0-9_]+$",
          "type": "string"
        },
        "status": {
          "const": "passed"
        },
        "test_identifier": {
          "pattern": "^MirmirTests\\.[A-Za-z0-9_]+Tests\\.test[A-Za-z0-9_]+$",
          "type": "string"
        }
      },
      "required": [
        "contract_area",
        "contract_id",
        "status",
        "test_identifier"
      ],
      "type": "object"
    },
    "distributionBoundary": {
      "additionalProperties": false,
      "properties": {
        "distributable_claim": {
          "const": "not_authorized"
        },
        "distribution_authority": {
          "const": "not_authorized"
        },
        "distribution_signing_identity": {
          "const": "not_observed"
        },
        "gatekeeper": {
          "const": "not_observed"
        },
        "launch_smoke": {
          "const": "not_observed"
        },
        "notarization": {
          "const": "not_observed"
        },
        "notarized_claim": {
          "const": "not_authorized"
        }
      },
      "required": [
        "distributable_claim",
        "distribution_authority",
        "distribution_signing_identity",
        "gatekeeper",
        "launch_smoke",
        "notarization",
        "notarized_claim"
      ],
      "type": "object"
    },
    "executionBoundary": {
      "additionalProperties": false,
      "properties": {
        "output_execution": {
          "const": "debug_xctest_genuine_a11_mps_avfoundation"
        },
        "release_app_execution": {
          "const": "not_observed"
        },
        "release_app_produced_output": {
          "const": false
        }
      },
      "required": [
        "output_execution",
        "release_app_execution",
        "release_app_produced_output"
      ],
      "type": "object"
    },
    "executionIdentities": {
      "additionalProperties": false,
      "properties": {
        "build_for_testing": {
          "$ref": "#/$defs/executionIdentity"
        },
        "output_reopen": {
          "$ref": "#/$defs/executionIdentity"
        },
        "release_app_build": {
          "$ref": "#/$defs/executionIdentity"
        },
        "swiftlint": {
          "$ref": "#/$defs/executionIdentity"
        },
        "targeted_tests": {
          "$ref": "#/$defs/executionIdentity"
        }
      },
      "required": [
        "build_for_testing",
        "targeted_tests",
        "release_app_build",
        "swiftlint",
        "output_reopen"
      ],
      "type": "object"
    },
    "executionIdentity": {
      "additionalProperties": false,
      "allOf": [
        {
          "else": {
            "not": {
              "required": [
                "release_app_tree_sha256"
              ]
            }
          },
          "if": {
            "properties": {
              "command_id": {
                "const": "release_app_build"
              }
            },
            "required": [
              "command_id"
            ]
          },
          "then": {
            "required": [
              "release_app_tree_sha256"
            ]
          }
        }
      ],
      "properties": {
        "argv": {
          "items": {
            "maxLength": 4096,
            "minLength": 1,
            "type": "string"
          },
          "minItems": 3,
          "type": "array"
        },
        "checkpoint": {
          "$ref": "#/$defs/checkpoint"
        },
        "command": {
          "minLength": 1,
          "type": "string"
        },
        "command_id": {
          "enum": [
            "build_for_testing",
            "output_reopen",
            "release_app_build",
            "swiftlint",
            "targeted_tests"
          ]
        },
        "exit_code": {
          "const": 0
        },
        "release_app_tree_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "source": {
          "$ref": "#/$defs/source"
        },
        "tool": {
          "$ref": "#/$defs/tool"
        }
      },
      "required": [
        "argv",
        "checkpoint",
        "command",
        "command_id",
        "exit_code",
        "source",
        "tool"
      ],
      "type": "object"
    },
    "fileBinding": {
      "additionalProperties": false,
      "properties": {
        "path": {
          "minLength": 1,
          "type": "string"
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        },
        "size_bytes": {
          "minimum": 1,
          "type": "integer"
        }
      },
      "required": [
        "path",
        "sha256",
        "size_bytes"
      ],
      "type": "object"
    },
    "gitOid": {
      "pattern": "^(?!0{40}$)[0-9a-f]{40}$",
      "type": "string"
    },
    "limitations": {
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "minItems": 1,
      "type": "array"
    },
    "namedFileBinding": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "pattern": "^[a-z0-9_]+$",
          "type": "string"
        },
        "path": {
          "minLength": 1,
          "type": "string"
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        },
        "size_bytes": {
          "minimum": 1,
          "type": "integer"
        }
      },
      "required": [
        "id",
        "path",
        "sha256",
        "size_bytes"
      ],
      "type": "object"
    },
    "observations": {
      "additionalProperties": false,
      "properties": {
        "debug_xctest_mps_lanczos_execution": {
          "const": "observed_both_product_routes"
        },
        "gpu_profiling": {
          "const": "not_observed"
        },
        "hardware_qualification": {
          "const": "not_observed"
        },
        "instruments": {
          "const": "not_observed"
        },
        "nonblocking_for_software_function_acceptance": {
          "const": true
        },
        "operator": {
          "const": "not_observed"
        },
        "release_candidate_gpu_execution": {
          "const": "not_observed"
        },
        "simulator": {
          "const": "not_observed"
        }
      },
      "required": [
        "debug_xctest_mps_lanczos_execution",
        "gpu_profiling",
        "hardware_qualification",
        "instruments",
        "operator",
        "release_candidate_gpu_execution",
        "simulator",
        "nonblocking_for_software_function_acceptance"
      ],
      "type": "object"
    },
    "predecessorBinding": {
      "additionalProperties": false,
      "properties": {
        "acceptance_scope": {
          "const": "declared_software_function_only"
        },
        "accepted_source": {
          "$ref": "#/$defs/source"
        },
        "functional_phase_acceptance": {
          "$ref": "#/$defs/fileBinding"
        },
        "phase_id": {
          "enum": [
            "R11",
            "R12"
          ]
        },
        "phase_result": {
          "const": "passed"
        }
      },
      "required": [
        "acceptance_scope",
        "accepted_source",
        "functional_phase_acceptance",
        "phase_id",
        "phase_result"
      ],
      "type": "object"
    },
    "sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "source": {
      "additionalProperties": false,
      "properties": {
        "commit": {
          "$ref": "#/$defs/gitOid"
        },
        "tree": {
          "$ref": "#/$defs/gitOid"
        }
      },
      "required": [
        "commit",
        "tree"
      ],
      "type": "object"
    },
    "sourceBinding": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "pattern": "^[a-z0-9_]+$",
          "type": "string"
        },
        "path": {
          "minLength": 1,
          "type": "string"
        },
        "role": {
          "enum": [
            "product_source",
            "project",
            "schema",
            "test_source",
            "validator",
            "validator_test"
          ]
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        },
        "size_bytes": {
          "minimum": 1,
          "type": "integer"
        }
      },
      "required": [
        "id",
        "path",
        "role",
        "sha256",
        "size_bytes"
      ],
      "type": "object"
    },
    "testSuite": {
      "additionalProperties": false,
      "properties": {
        "class_name": {
          "pattern": "^[A-Za-z0-9_]+Tests$",
          "type": "string"
        },
        "methods": {
          "items": {
            "pattern": "^test[A-Za-z0-9_]+$",
            "type": "string"
          },
          "minItems": 1,
          "type": "array"
        },
        "only_testing": {
          "pattern": "^MirmirTests/[A-Za-z0-9_]+Tests$",
          "type": "string"
        },
        "path": {
          "pattern": "^MirmirTests/.+Tests\\.swift$",
          "type": "string"
        }
      },
      "required": [
        "class_name",
        "methods",
        "only_testing",
        "path"
      ],
      "type": "object"
    },
    "tool": {
      "additionalProperties": false,
      "properties": {
        "executable_path": {
          "minLength": 1,
          "type": "string"
        },
        "executable_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "name": {
          "enum": [
            "swiftlint",
            "xcodebuild",
            "xcrun"
          ]
        },
        "version": {
          "minLength": 1,
          "type": "string"
        }
      },
      "required": [
        "executable_path",
        "executable_sha256",
        "name",
        "version"
      ],
      "type": "object"
    },
    "verification": {
      "additionalProperties": false,
      "properties": {
        "build_for_testing": {
          "additionalProperties": false,
          "properties": {
            "configuration": {
              "const": "Debug"
            },
            "status": {
              "const": "passed"
            }
          },
          "required": [
            "configuration",
            "status"
          ],
          "type": "object"
        },
        "output_reopen": {
          "additionalProperties": false,
          "properties": {
            "artifact_sha256": {
              "$ref": "#/$defs/sha256"
            },
            "status": {
              "const": "passed"
            }
          },
          "required": [
            "artifact_sha256",
            "status"
          ],
          "type": "object"
        },
        "release_app_build": {
          "additionalProperties": false,
          "properties": {
            "configuration": {
              "const": "Release"
            },
            "outcome": {
              "const": "release_ready_candidate"
            },
            "release_app_tree_sha256": {
              "$ref": "#/$defs/sha256"
            },
            "status": {
              "const": "passed"
            }
          },
          "required": [
            "configuration",
            "outcome",
            "release_app_tree_sha256",
            "status"
          ],
          "type": "object"
        },
        "swiftlint": {
          "additionalProperties": false,
          "properties": {
            "linted_file_count": {
              "minimum": 1,
              "type": "integer"
            },
            "serious_violation_count": {
              "const": 0
            },
            "status": {
              "const": "passed"
            },
            "violation_count": {
              "const": 0
            }
          },
          "required": [
            "linted_file_count",
            "serious_violation_count",
            "status",
            "violation_count"
          ],
          "type": "object"
        },
        "targeted_tests": {
          "additionalProperties": false,
          "properties": {
            "configuration": {
              "const": "Debug"
            },
            "failed_test_count": {
              "const": 0
            },
            "passed_test_count": {
              "minimum": 1,
              "type": "integer"
            },
            "selected_test_count": {
              "minimum": 1,
              "type": "integer"
            },
            "skipped_test_count": {
              "const": 0
            },
            "status": {
              "const": "passed"
            }
          },
          "required": [
            "configuration",
            "failed_test_count",
            "passed_test_count",
            "selected_test_count",
            "skipped_test_count",
            "status"
          ],
          "type": "object"
        }
      },
      "required": [
        "build_for_testing",
        "targeted_tests",
        "release_app_build",
        "swiftlint",
        "output_reopen"
      ],
      "type": "object"
    },
    "status": {
      "additionalProperties": false,
      "properties": {
        "status": {
          "const": "passed"
        }
      },
      "required": [
        "status"
      ],
      "type": "object"
    }
  }
}
