{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mirmir.local/docs/roadmaps/evidence/schema/r02-functional-phase-acceptance-v1.json",
  "title": "R02 declared-software-function phase acceptance",
  "$defs": {
    "binding": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$",
          "type": "string"
        },
        "path": {
          "minLength": 1,
          "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))[A-Za-z0-9._/-]+$",
          "type": "string"
        },
        "sha256": {
          "pattern": "^(?!0{64}$)[0-9a-f]{64}$",
          "type": "string"
        },
        "size_bytes": {
          "minimum": 1,
          "type": "integer"
        }
      },
      "required": [
        "id",
        "path",
        "size_bytes",
        "sha256"
      ],
      "type": "object"
    },
    "passedCheck": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "enum": [
            "source_checkpoint_exact",
            "frozen_evidence_valid_and_unchanged",
            "implementation_bindings_exact",
            "execution_artifacts_exact",
            "selected_test_set_exact",
            "capability_registry_and_common_protocols",
            "stage_protocols_and_immutable_plan",
            "planner_single_primary_and_visible_fallback",
            "fifo_order_and_actor_reentrancy",
            "reset_finish_cancel_lifecycle",
            "typed_outcomes_and_complete_identity",
            "resource_lifetime_exactly_once",
            "multiple_backends_common_session",
            "media_contract_preservation",
            "reopen_verification_and_atomic_publication",
            "production_unavailable",
            "native_observation_boundary_truthful",
            "authorization_boundary_exact"
          ],
          "type": "string"
        },
        "status": {
          "const": "passed",
          "type": "string"
        }
      },
      "required": [
        "id",
        "status"
      ],
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "1.0.0",
      "type": "string"
    },
    "roadmap_version": {
      "const": "1.0.1",
      "type": "string"
    },
    "phase_id": {
      "const": "R02",
      "type": "string"
    },
    "evidence_kind": {
      "const": "r02_operator_functional_phase_acceptance_v1",
      "type": "string"
    },
    "source": {
      "additionalProperties": false,
      "properties": {
        "commit": {
          "const": "eeabc4224100bc8ed86ae1208189bee508844210",
          "type": "string"
        },
        "tree": {
          "const": "ac402f993805cca499d2f688c6186c4684ce8dba",
          "type": "string"
        }
      },
      "required": [
        "commit",
        "tree"
      ],
      "type": "object"
    },
    "operator_override": {
      "additionalProperties": false,
      "properties": {
        "authority": {
          "const": "operator",
          "type": "string"
        },
        "authorization_date": {
          "const": "2026-07-23",
          "type": "string"
        },
        "acceptance_basis": {
          "const": "software_does_what_it_says_it_does",
          "type": "string"
        },
        "override_id": {
          "const": "r02.software-function-only-phase-acceptance.v1",
          "type": "string"
        },
        "hardware_simulator_operator_observation": {
          "const": "waived_not_a_blocker",
          "type": "string"
        },
        "comparative_requirement": {
          "const": "not_required_for_phase_acceptance",
          "type": "string"
        },
        "historical_evidence_policy": {
          "const": "preserve_r02_preregistration_and_conformance_unchanged",
          "type": "string"
        }
      },
      "required": [
        "authority",
        "authorization_date",
        "acceptance_basis",
        "override_id",
        "hardware_simulator_operator_observation",
        "comparative_requirement",
        "historical_evidence_policy"
      ],
      "type": "object"
    },
    "functional_gate": {
      "additionalProperties": false,
      "properties": {
        "acceptance_scope": {
          "const": "declared_software_function_only",
          "type": "string"
        },
        "execution_mode": {
          "const": "deterministic_fixture_execution",
          "type": "string"
        },
        "required_test_suites": {
          "items": {
            "enum": [
              "AppleUpscaleContractsTests",
              "EnhancementPipelineContractsTests",
              "AppleUpscaleFIFOSessionTests",
              "R02FixtureConformanceTests",
              "ArchitectureGuardrailTests",
              "UpscalerEngineAvailabilityTests"
            ],
            "type": "string"
          },
          "maxItems": 6,
          "minItems": 6,
          "type": "array",
          "uniqueItems": true
        },
        "required_selected_test_count": {
          "const": 27,
          "type": "integer"
        },
        "required_conformance_check_ids": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "maxItems": 29,
          "minItems": 29,
          "type": "array",
          "uniqueItems": true
        },
        "required_metric_ids": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "maxItems": 18,
          "minItems": 18,
          "type": "array",
          "uniqueItems": true
        },
        "hardware_simulator_operator_observation": {
          "const": "not_required_not_observed",
          "type": "string"
        },
        "raw_xcresult_ci_validation": {
          "const": "required",
          "type": "string"
        }
      },
      "required": [
        "acceptance_scope",
        "execution_mode",
        "required_test_suites",
        "required_selected_test_count",
        "required_conformance_check_ids",
        "required_metric_ids",
        "hardware_simulator_operator_observation",
        "raw_xcresult_ci_validation"
      ],
      "type": "object"
    },
    "comparison_policy": {
      "additionalProperties": false,
      "properties": {
        "comparative_quality_testing": {
          "const": "not_run_not_required",
          "type": "string"
        },
        "a_b_testing": {
          "const": "not_run_not_required",
          "type": "string"
        },
        "blinded_testing": {
          "const": "not_run_not_required",
          "type": "string"
        },
        "superiority_requirement": {
          "const": "not_applicable",
          "type": "string"
        },
        "acceptance_dependency": {
          "const": "none",
          "type": "string"
        },
        "common_session_multiple_backend_test": {
          "const": "required_noncomparative_interface_conformance",
          "type": "string"
        }
      },
      "required": [
        "comparative_quality_testing",
        "a_b_testing",
        "blinded_testing",
        "superiority_requirement",
        "acceptance_dependency",
        "common_session_multiple_backend_test"
      ],
      "type": "object"
    },
    "evidence_bindings": {
      "items": {
        "$ref": "#/$defs/binding"
      },
      "maxItems": 3,
      "minItems": 3,
      "type": "array",
      "uniqueItems": true
    },
    "implementation_bindings": {
      "items": {
        "$ref": "#/$defs/binding"
      },
      "maxItems": 24,
      "minItems": 24,
      "type": "array",
      "uniqueItems": true
    },
    "artifact_bindings": {
      "items": {
        "$ref": "#/$defs/binding"
      },
      "maxItems": 2,
      "minItems": 2,
      "type": "array",
      "uniqueItems": true
    },
    "derived_checks": {
      "items": {
        "$ref": "#/$defs/passedCheck"
      },
      "maxItems": 18,
      "minItems": 18,
      "type": "array",
      "uniqueItems": true
    },
    "result": {
      "additionalProperties": false,
      "properties": {
        "status": {
          "const": "passed",
          "type": "string"
        },
        "phase_status_before": {
          "const": "in_progress",
          "type": "string"
        },
        "phase_status_after": {
          "const": "passed",
          "type": "string"
        },
        "acceptance": {
          "const": "accepted",
          "type": "string"
        },
        "acceptance_scope": {
          "const": "declared_software_function_only",
          "type": "string"
        },
        "execution_mode": {
          "const": "deterministic_fixture_execution",
          "type": "string"
        }
      },
      "required": [
        "status",
        "phase_status_before",
        "phase_status_after",
        "acceptance",
        "acceptance_scope",
        "execution_mode"
      ],
      "type": "object"
    },
    "authorizations": {
      "additionalProperties": false,
      "properties": {
        "r02_phase_acceptance": {
          "const": "authorized",
          "type": "string"
        },
        "r02_phase_status": {
          "const": "passed",
          "type": "string"
        },
        "phase_progression": {
          "const": "authorized",
          "type": "string"
        },
        "product_qualification": {
          "const": "not_claimed",
          "type": "string"
        },
        "production_upscaling": {
          "const": "not_authorized",
          "type": "string"
        },
        "production_default": {
          "const": "not_authorized",
          "type": "string"
        },
        "auto_mode": {
          "const": "not_authorized",
          "type": "string"
        },
        "holdout": {
          "const": "not_authorized",
          "type": "string"
        },
        "quality_claims": {
          "const": "not_authorized",
          "type": "string"
        },
        "performance_claims": {
          "const": "not_authorized",
          "type": "string"
        },
        "product_publication": {
          "const": "not_authorized",
          "type": "string"
        },
        "release": {
          "const": "not_authorized",
          "type": "string"
        },
        "native_framework_claims": {
          "const": "not_authorized",
          "type": "string"
        }
      },
      "required": [
        "r02_phase_acceptance",
        "r02_phase_status",
        "phase_progression",
        "product_qualification",
        "production_upscaling",
        "production_default",
        "auto_mode",
        "holdout",
        "quality_claims",
        "performance_claims",
        "product_publication",
        "release",
        "native_framework_claims"
      ],
      "type": "object"
    },
    "limitations": {
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "maxItems": 4,
      "minItems": 4,
      "type": "array"
    }
  },
  "required": [
    "schema_version",
    "roadmap_version",
    "phase_id",
    "evidence_kind",
    "source",
    "operator_override",
    "functional_gate",
    "comparison_policy",
    "evidence_bindings",
    "implementation_bindings",
    "artifact_bindings",
    "derived_checks",
    "result",
    "authorizations",
    "limitations"
  ],
  "type": "object"
}
