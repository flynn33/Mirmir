{
  "$id": "https://mirmir.local/docs/roadmaps/evidence/schema/r10-fixture-catalog-v1.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "fileBinding": {
      "additionalProperties": false,
      "properties": {
        "path": {"minLength": 1, "type": "string"},
        "size_bytes": {"minimum": 1, "type": "integer"},
        "sha256": {"pattern": "^(?!0{64}$)[0-9a-f]{64}$", "type": "string"}
      },
      "required": ["path", "size_bytes", "sha256"],
      "type": "object"
    },
    "constraint": {
      "additionalProperties": false,
      "properties": {
        "name": {
          "enum": ["route", "plane", "temporal", "protected_region", "resource", "safety"],
          "type": "string"
        },
        "observed": {"type": "number"},
        "minimum": {"type": ["number", "null"]},
        "maximum": {"type": ["number", "null"]},
        "satisfied": {"type": "boolean"}
      },
      "required": ["name", "observed", "minimum", "maximum", "satisfied"],
      "type": "object"
    },
    "candidate": {
      "additionalProperties": false,
      "properties": {
        "candidate_id": {"pattern": "^fixture-(valid|reject)-[a-z-]+$", "type": "string"},
        "causal_variables": {
          "additionalProperties": false,
          "properties": {
            "quality_confidence_weight": {"enum": [4, 5], "type": "integer"},
            "minimum_dwell_frames": {"enum": [12, 16], "type": "integer"},
            "hysteresis_margin_q16": {
              "enum": [8192, 12288, 16384],
              "type": "integer"
            }
          },
          "required": [
            "quality_confidence_weight",
            "minimum_dwell_frames",
            "hysteresis_margin_q16"
          ],
          "type": "object"
        },
        "constraints": {
          "items": {"$ref": "#/$defs/constraint"},
          "maxItems": 6,
          "minItems": 6,
          "type": "array"
        }
      },
      "required": ["candidate_id", "causal_variables", "constraints"],
      "type": "object"
    },
    "expected": {
      "additionalProperties": false,
      "properties": {
        "disposition": {"enum": ["scored", "rejected"], "type": "string"},
        "rejected_constraints": {
          "items": {
            "enum": ["route", "plane", "temporal", "protected_region", "resource", "safety"],
            "type": "string"
          },
          "maxItems": 1,
          "type": "array"
        }
      },
      "required": ["disposition", "rejected_constraints"],
      "type": "object"
    },
    "candidateFixture": {
      "additionalProperties": false,
      "properties": {
        "candidate_sha256": {
          "pattern": "^(?!0{64}$)[0-9a-f]{64}$",
          "type": "string"
        },
        "candidate": {"$ref": "#/$defs/candidate"},
        "expected": {"$ref": "#/$defs/expected"}
      },
      "required": ["candidate_sha256", "candidate", "expected"],
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schema_version": {"const": "1.0.0", "type": "string"},
    "phase_id": {"const": "R10", "type": "string"},
    "artifact_kind": {
      "const": "r10_bounded_candidate_fixture_catalog",
      "type": "string"
    },
    "contract_id": {
      "const": "r10-bounded-calibration-fixtures-v1",
      "type": "string"
    },
    "maximum_candidates": {"const": 9, "type": "integer"},
    "candidate_value_scope": {
      "const": "software_test_inputs_not_product_or_quality_thresholds",
      "type": "string"
    },
    "causal_variable_names": {
      "items": false,
      "prefixItems": [
        {"const": "quality_confidence_weight", "type": "string"},
        {"const": "minimum_dwell_frames", "type": "string"},
        {"const": "hysteresis_margin_q16", "type": "string"}
      ],
      "type": "array"
    },
    "constraint_order": {
      "items": false,
      "prefixItems": [
        {"const": "route", "type": "string"},
        {"const": "plane", "type": "string"},
        {"const": "temporal", "type": "string"},
        {"const": "protected_region", "type": "string"},
        {"const": "resource", "type": "string"},
        {"const": "safety", "type": "string"}
      ],
      "type": "array"
    },
    "evaluation_catalog_binding": {"$ref": "#/$defs/fileBinding"},
    "policy_catalog_binding": {"$ref": "#/$defs/fileBinding"},
    "candidates": {
      "items": {"$ref": "#/$defs/candidateFixture"},
      "maxItems": 9,
      "minItems": 9,
      "type": "array"
    },
    "observation_boundary": {
      "additionalProperties": false,
      "properties": {
        "deterministic_fixture_simulation": {"const": "required", "type": "string"},
        "physical_hardware_execution": {"const": "not_observed", "type": "string"},
        "simulator_execution": {"const": "not_observed", "type": "string"},
        "operator_observation": {"const": "not_observed", "type": "string"},
        "unavailable_observation_blocks_phase": {"const": false, "type": "boolean"}
      },
      "required": [
        "deterministic_fixture_simulation",
        "physical_hardware_execution",
        "simulator_execution",
        "operator_observation",
        "unavailable_observation_blocks_phase"
      ],
      "type": "object"
    },
    "comparison_methods_used": {"const": false, "type": "boolean"}
  },
  "required": [
    "schema_version",
    "phase_id",
    "artifact_kind",
    "contract_id",
    "maximum_candidates",
    "candidate_value_scope",
    "causal_variable_names",
    "constraint_order",
    "evaluation_catalog_binding",
    "policy_catalog_binding",
    "candidates",
    "observation_boundary",
    "comparison_methods_used"
  ],
  "type": "object"
}
