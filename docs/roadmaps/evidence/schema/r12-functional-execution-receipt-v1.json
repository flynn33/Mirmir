{
  "$id": "https://github.com/flynn33/Mirmir/docs/roadmaps/evidence/schema/r12-functional-execution-receipt-v1.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "acceptance_basis": {
      "const": "software_does_what_it_says_it_does"
    },
    "artifact_bindings": {
      "items": {
        "$ref": "#/$defs/namedFileBinding"
      },
      "maxItems": 3,
      "minItems": 3,
      "type": "array"
    },
    "claim_boundary": {
      "$ref": "#/$defs/claimBoundary"
    },
    "commands": {
      "additionalProperties": false,
      "properties": {
        "build_for_testing": {
          "minLength": 1,
          "type": "string"
        },
        "swiftlint": {
          "const": "swiftlint lint --strict --no-cache"
        },
        "targeted_tests": {
          "minLength": 1,
          "type": "string"
        }
      },
      "required": [
        "build_for_testing",
        "targeted_tests",
        "swiftlint"
      ],
      "type": "object"
    },
    "comparison_policy": {
      "$ref": "#/$defs/comparisonPolicy"
    },
    "contract_coverage": {
      "items": {
        "$ref": "#/$defs/contractCoverage"
      },
      "minItems": 1,
      "type": "array"
    },
    "evidence_kind": {
      "const": "r12_exact_source_software_function_execution_receipt_v1"
    },
    "execution_identities": {
      "$ref": "#/$defs/executionIdentities"
    },
    "limitations": {
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "minItems": 1,
      "type": "array"
    },
    "observations": {
      "$ref": "#/$defs/observations"
    },
    "phase_id": {
      "const": "R12"
    },
    "predecessor_binding": {
      "$ref": "#/$defs/predecessorBinding"
    },
    "roadmap_version": {
      "const": "1.0.1"
    },
    "schema_version": {
      "const": "1.0.0"
    },
    "source": {
      "$ref": "#/$defs/source"
    },
    "source_bindings": {
      "items": {
        "$ref": "#/$defs/namedFileBinding"
      },
      "maxItems": 11,
      "minItems": 11,
      "type": "array"
    },
    "verification": {
      "$ref": "#/$defs/verification"
    }
  },
  "required": [
    "schema_version",
    "roadmap_version",
    "phase_id",
    "evidence_kind",
    "source",
    "predecessor_binding",
    "source_bindings",
    "artifact_bindings",
    "commands",
    "execution_identities",
    "verification",
    "contract_coverage",
    "acceptance_basis",
    "observations",
    "claim_boundary",
    "comparison_policy",
    "limitations"
  ],
  "title": "R12 functional execution receipt",
  "type": "object",
  "$defs": {
    "claimBoundary": {
      "additionalProperties": false,
      "properties": {
        "claim_scope": {
          "const": "software_behavior_report"
        },
        "market_disposition": {
          "const": "no_market_claim"
        },
        "product_qualification": {
          "const": "not_authorized"
        },
        "production_auto_mode": {
          "const": "not_authorized"
        },
        "release_publication": {
          "const": "not_authorized"
        }
      },
      "required": [
        "claim_scope",
        "product_qualification",
        "production_auto_mode",
        "market_disposition",
        "release_publication"
      ],
      "type": "object"
    },
    "comparisonPolicy": {
      "additionalProperties": false,
      "properties": {
        "ab_test": {
          "const": "absent_not_required"
        },
        "acceptance_dependency": {
          "const": "none"
        },
        "comparison_method": {
          "const": "absent_not_required"
        }
      },
      "required": [
        "comparison_method",
        "ab_test",
        "acceptance_dependency"
      ],
      "type": "object"
    },
    "contractCoverage": {
      "additionalProperties": false,
      "properties": {
        "contract_areas": {
          "items": {
            "enum": [
              "format",
              "route",
              "backend",
              "resume"
            ]
          },
          "minItems": 1,
          "type": "array",
          "uniqueItems": true
        },
        "contract_id": {
          "pattern": "^(format|route|resume)\\.[a-z0-9_]+$",
          "type": "string"
        },
        "status": {
          "const": "passed"
        },
        "test_identifier": {
          "pattern": "^MirmirTests\\.R12[A-Za-z0-9_]+Tests\\.test[A-Za-z0-9_]+$",
          "type": "string"
        }
      },
      "required": [
        "contract_id",
        "contract_areas",
        "test_identifier",
        "status"
      ],
      "type": "object"
    },
    "executionIdentities": {
      "additionalProperties": false,
      "properties": {
        "build_for_testing": {
          "$ref": "#/$defs/executionIdentity"
        },
        "swiftlint": {
          "$ref": "#/$defs/executionIdentity"
        },
        "targeted_tests": {
          "$ref": "#/$defs/executionIdentity"
        }
      },
      "required": [
        "build_for_testing",
        "targeted_tests",
        "swiftlint"
      ],
      "type": "object"
    },
    "executionIdentity": {
      "additionalProperties": false,
      "properties": {
        "argv": {
          "items": {
            "maxLength": 4096,
            "minLength": 1,
            "type": "string"
          },
          "maxItems": 32,
          "minItems": 4,
          "type": "array"
        },
        "checkpoint": {
          "additionalProperties": false,
          "properties": {
            "clean_after": {
              "const": true
            },
            "clean_before": {
              "const": true
            },
            "commit_after": {
              "pattern": "^(?!0{40}$)[0-9a-f]{40}$",
              "type": "string"
            },
            "commit_before": {
              "pattern": "^(?!0{40}$)[0-9a-f]{40}$",
              "type": "string"
            },
            "kind": {
              "const": "detached_clean_exact_git_checkpoint"
            },
            "tree_after": {
              "pattern": "^(?!0{40}$)[0-9a-f]{40}$",
              "type": "string"
            },
            "tree_before": {
              "pattern": "^(?!0{40}$)[0-9a-f]{40}$",
              "type": "string"
            }
          },
          "required": [
            "clean_before",
            "clean_after",
            "commit_before",
            "commit_after",
            "tree_before",
            "tree_after",
            "kind"
          ],
          "type": "object"
        },
        "command": {
          "minLength": 1,
          "type": "string"
        },
        "command_id": {
          "enum": [
            "build_for_testing",
            "targeted_tests",
            "swiftlint"
          ]
        },
        "exit_code": {
          "const": 0
        },
        "source": {
          "$ref": "#/$defs/source"
        },
        "tool": {
          "additionalProperties": false,
          "properties": {
            "executable_path": {
              "pattern": "^/[^\\u0000]+$",
              "type": "string"
            },
            "executable_sha256": {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            },
            "name": {
              "enum": [
                "swiftlint",
                "xcodebuild"
              ]
            },
            "version": {
              "maxLength": 4096,
              "minLength": 1,
              "type": "string"
            }
          },
          "required": [
            "name",
            "executable_path",
            "executable_sha256",
            "version"
          ],
          "type": "object"
        }
      },
      "required": [
        "argv",
        "checkpoint",
        "command",
        "command_id",
        "exit_code",
        "source",
        "tool"
      ],
      "type": "object"
    },
    "fileBinding": {
      "additionalProperties": false,
      "properties": {
        "path": {
          "pattern": "^[a-zA-Z0-9._/-]+$",
          "type": "string"
        },
        "sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        "size_bytes": {
          "minimum": 1,
          "type": "integer"
        }
      },
      "required": [
        "path",
        "size_bytes",
        "sha256"
      ],
      "type": "object"
    },
    "namedFileBinding": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "pattern": "^[a-z0-9][a-z0-9_-]*$",
          "type": "string"
        },
        "path": {
          "pattern": "^[a-zA-Z0-9._/-]+$",
          "type": "string"
        },
        "sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        "size_bytes": {
          "minimum": 1,
          "type": "integer"
        }
      },
      "required": [
        "id",
        "path",
        "size_bytes",
        "sha256"
      ],
      "type": "object"
    },
    "observations": {
      "additionalProperties": false,
      "properties": {
        "native_hardware": {
          "const": "not_observed"
        },
        "nonblocking_for_software_function_acceptance": {
          "const": true
        },
        "operator": {
          "const": "not_observed"
        },
        "simulator": {
          "const": "not_observed"
        }
      },
      "required": [
        "native_hardware",
        "simulator",
        "operator",
        "nonblocking_for_software_function_acceptance"
      ],
      "type": "object"
    },
    "predecessorBinding": {
      "additionalProperties": false,
      "properties": {
        "acceptance_scope": {
          "const": "declared_software_function_only"
        },
        "accepted_source": {
          "$ref": "#/$defs/source"
        },
        "functional_phase_acceptance": {
          "$ref": "#/$defs/fileBinding"
        },
        "phase_id": {
          "const": "R11"
        },
        "phase_result": {
          "const": "passed"
        }
      },
      "required": [
        "phase_id",
        "phase_result",
        "acceptance_scope",
        "accepted_source",
        "functional_phase_acceptance"
      ],
      "type": "object"
    },
    "source": {
      "additionalProperties": false,
      "properties": {
        "commit": {
          "pattern": "^(?!0{40}$)[0-9a-f]{40}$",
          "type": "string"
        },
        "tree": {
          "pattern": "^(?!0{40}$)[0-9a-f]{40}$",
          "type": "string"
        }
      },
      "required": [
        "commit",
        "tree"
      ],
      "type": "object"
    },
    "suiteCount": {
      "additionalProperties": false,
      "properties": {
        "passed_test_count": {
          "minimum": 1,
          "type": "integer"
        },
        "suite": {
          "enum": [
            "R12MediaFormatContractV2Tests",
            "R12RouteAndHardwareResolverTests",
            "R12ChunkCheckpointLedgerTests"
          ]
        }
      },
      "required": [
        "suite",
        "passed_test_count"
      ],
      "type": "object"
    },
    "verification": {
      "additionalProperties": false,
      "properties": {
        "build_for_testing": {
          "additionalProperties": false,
          "properties": {
            "status": {
              "const": "passed"
            }
          },
          "required": [
            "status"
          ],
          "type": "object"
        },
        "swiftlint": {
          "additionalProperties": false,
          "properties": {
            "linted_file_count": {
              "minimum": 1,
              "type": "integer"
            },
            "serious_violation_count": {
              "const": 0
            },
            "status": {
              "const": "passed"
            },
            "violation_count": {
              "const": 0
            }
          },
          "required": [
            "status",
            "violation_count",
            "serious_violation_count",
            "linted_file_count"
          ],
          "type": "object"
        },
        "targeted_tests": {
          "additionalProperties": false,
          "properties": {
            "failed_test_count": {
              "const": 0
            },
            "passed_test_count": {
              "minimum": 1,
              "type": "integer"
            },
            "selected_test_count": {
              "minimum": 1,
              "type": "integer"
            },
            "skipped_test_count": {
              "const": 0
            },
            "suite_counts": {
              "items": {
                "$ref": "#/$defs/suiteCount"
              },
              "maxItems": 3,
              "minItems": 3,
              "type": "array"
            }
          },
          "required": [
            "selected_test_count",
            "passed_test_count",
            "failed_test_count",
            "skipped_test_count",
            "suite_counts"
          ],
          "type": "object"
        }
      },
      "required": [
        "build_for_testing",
        "targeted_tests",
        "swiftlint"
      ],
      "type": "object"
    }
  }
}
