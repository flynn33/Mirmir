    {"id": "candidate_order_invariance", "description": "Require identical candidate records and selection for every candidate input permutation."},
    {"id": "lexical_route_tie_break", "description": "Resolve exact score ties by ascending lexical route identity."},
    {"id": "one_whole_frame_route", "description": "Select no more than one primary whole-frame route per decision interval and forbid per-tile primary routes."},
    {"id": "hysteresis_exact", "description": "Require the constructor-bound Q16 hysteresis margin and typed hold reason."},
    {"id": "minimum_dwell_exact", "description": "Require the constructor-bound minimum dwell and typed hold reason."},
    {"id": "scene_cut_reset_exact", "description": "Require thresholded scene cuts to reset history and bypass transition holds with a typed reason."},
    {"id": "fatal_failover_exact", "description": "Require fatal failure to remove the failed backend and bypass transition holds with a typed reason."},
    {"id": "bounded_masks_exact", "description": "Require exact bounded Q0.15 luma, chroma, and postprocess masks that reject invalid dimensions or samples."},
    {"id": "ablation_matrix_complete", "description": "Require all six roadmap ablation identities and deterministic fixture contracts."},
    {"id": "product_gate_closed", "description": "Return no_product_qualified_primary_backend with zero eligible backends and no route, plan, or output."},
    {"id": "product_ablations_not_observed", "description": "Record every product ablation as not_observed while the product eligibility set is empty."},
    {"id": "observation_override_nonblocking", "description": "Continue deterministic software work without hardware, simulator, or operator observation and make no observation claim."},
    {"id": "no_quality_or_performance_claim", "description": "Forbid quality or performance claims from fixture-only deterministic conformance."},
    {"id": "no_silent_fallback", "description": "Require typed failure, hold, cut, failover, or blocked reasons without silent substitution."},
    {"id": "production_default_disabled", "description": "Keep production default, Auto, holdout, acceptance, publication, and release disabled or unclaimed."}
