  "stop_rules": [
    {
      "description": "Stop when the implementation commit, source tree, host identity, or toolchain identity differs from the frozen assignment.",
      "id": "identity_drift"
    },
    {
      "description": "Invalidate the prior host report and preregister a replacement before any rerun when an assigned host changes.",
      "id": "assignment_change"
    },
    {
      "description": "Stop rather than alter a frozen fixture or probe model; an incompatible public contract receives a restricted or unsupported disposition.",
      "id": "fixture_or_model_change"
    },
    {
      "description": "Stop when the preregistration schema, fixture catalog binding, fixture order, or capability assignment does not validate exactly.",
      "id": "schema_or_catalog_drift"
    },
    {
      "description": "Stop a session at 120 seconds and classify timeout, unsupported contract, setup failure, processing failure, and resource failure separately.",
      "id": "session_failure"
    },
    {
      "description": "Stop any interpretation of R01 runnable evidence as perceptual superiority, product qualification, or backend eligibility.",
      "id": "qualification_boundary"
    }
  ]
