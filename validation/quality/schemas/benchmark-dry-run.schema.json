{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mirmir.local/validation/quality/benchmark-dry-run-v1.schema.json",
  "type": "object",
  "required": [
    "schema_version",
    "run_id",
    "split",
    "corpus_mode",
    "configuration_sha256",
    "corpus_manifest_sha256",
    "development_source_asset_count",
    "degradation_policy_sha256",
    "degradation_profile_ids",
    "metric_policy_sha256",
    "case_count",
    "completed_case_count",
    "resumed_from_failure",
    "fixture_dimensions",
    "comparison_domains_executed",
    "actual_codec_fixture_used",
    "holdout_accessed",
    "gate_status",
    "status"
  ],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "run_id": {"type": "string", "minLength": 1},
    "split": {"const": "development"},
    "corpus_mode": {"enum": ["synthetic_development", "production_locked"]},
    "configuration_sha256": {"$ref": "#/$defs/sha256"},
    "corpus_manifest_sha256": {"$ref": "#/$defs/sha256"},
    "sample_manifest_sha256": {"$ref": "#/$defs/sha256"},
    "development_source_asset_count": {"type": "integer", "minimum": 1},
    "candidate_id": {"type": "string", "minLength": 1},
    "candidate_configuration_sha256": {"$ref": "#/$defs/sha256"},
    "candidate_input_pixel_representation": {
      "type": "string",
      "minLength": 1
    },
    "baseline_id": {"type": "string", "minLength": 1},
    "degradation_policy_sha256": {"$ref": "#/$defs/sha256"},
    "degradation_profile_ids": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "metric_policy_sha256": {"$ref": "#/$defs/sha256"},
    "case_count": {"type": "integer", "minimum": 1},
    "completed_case_count": {"type": "integer", "minimum": 1},
    "resumed_from_failure": {"type": "boolean"},
    "resume_checkpoint_semantics": {"enum": ["not_applicable", "recomputed"]},
    "actual_codec_fixture_reverified": {"type": "boolean"},
    "postencode_results_recomputed": {"type": "boolean"},
    "postencode_isolation_mode": {
      "enum": ["one-case-per-product-hevc-container"]
    },
    "postencode_isolated_container_count": {
      "type": "integer",
      "minimum": 1
    },
    "postencode_metric_rows_from_isolated_containers": {"type": "boolean"},
    "postencode_smoke_batch_executed": {"type": "boolean"},
    "stale_partial_preservation_enabled": {"type": "boolean"},
    "artifact_semantic_reverification": {"type": "boolean"},
    "artifact_publish_freeze": {
      "const": "detached owner-read-only immutable inodes before hashing and atomic rename"
    },
    "published_directory_immutable": {"type": "boolean"},
    "fixture_dimensions": {
      "type": "object",
      "required": ["width", "height"],
      "properties": {
        "width": {"type": "integer", "minimum": 128},
        "height": {"type": "integer", "minimum": 128}
      },
      "additionalProperties": false
    },
    "routes_executed": {
      "type": "array",
      "items": {"enum": ["direct-2x", "direct-3over2"]},
      "uniqueItems": true
    },
    "comparison_domains_executed": {
      "oneOf": [
        {"const": ["engine_raw"]},
        {"const": ["container_decoded"]},
        {"const": ["engine_raw", "container_decoded"]}
      ]
    },
    "actual_codec_fixture_used": {"type": "boolean"},
    "actual_codec_fixture_conformance_only": {"type": "boolean"},
    "actual_codec_fixture_id": {"type": "string", "minLength": 1},
    "actual_codec_fixture_evidence_sha256": {"$ref": "#/$defs/sha256"},
    "common_writer_id": {"type": "string", "minLength": 1},
    "production_output_writer_id": {"type": "string", "minLength": 1},
    "product_settings_source": {"$ref": "#/$defs/fileBinding"},
    "product_settings_evidence": {"$ref": "#/$defs/fileBinding"},
    "common_writer_runs": {
      "type": "array",
      "minItems": 26,
      "maxItems": 26,
      "prefixItems": [
        {
          "$ref": "#/$defs/writerRun",
          "properties": {
            "purpose": {"const": "low_resolution_degradation"},
            "writer_id": {"const": "apple-h264-software-common-writer-v1"},
            "profile_id": {"const": "actual-h264-software-direct-2x-v1"},
            "target_route": {"const": "direct-2x"},
            "source_profile_id": {"const": "hq-binomial7-decimate-2x-v1"},
            "dimensions": {"const": {"width": 162, "height": 96}}
          }
        },
        {
          "$ref": "#/$defs/writerRun",
          "properties": {
            "purpose": {"const": "low_resolution_degradation"},
            "writer_id": {"const": "apple-h264-software-common-writer-v1"},
            "profile_id": {"const": "actual-h264-software-direct-3over2-v1"},
            "target_route": {"const": "direct-3over2"},
            "source_profile_id": {"const": "hq-binomial7-resample-2over3-v1"},
            "dimensions": {"const": {"width": 216, "height": 128}}
          }
        }
      ],
      "items": {"$ref": "#/$defs/isolatedWriterRun"}
    },
    "low_resolution_actual_codec_frame_count": {"type": "integer", "minimum": 1},
    "engine_raw_frame_count": {"type": "integer", "minimum": 1},
    "container_decoded_frame_count": {"type": "integer", "minimum": 1},
    "engine_raw_result": {"$ref": "#/$defs/fileBinding"},
    "container_decoded_result": {"$ref": "#/$defs/fileBinding"},
    "comparison_case_order_sha256": {"$ref": "#/$defs/sha256"},
    "mp4_byte_identity_across_runs_claimed": {"type": "boolean"},
    "holdout_accessed": {"const": false},
    "gate_interpretation": {"type": "string", "minLength": 1},
    "gate_status": {"enum": ["blocked", "pass"]},
    "status": {"enum": ["pass", "fail"]}
  },
  "additionalProperties": false,
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "fileBinding": {
      "type": "object",
      "required": ["path", "sha256", "size_bytes"],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1,
          "pattern": "^(?!/)(?!.*\\\\)(?!.*//)(?!.*(?:^|/)\\.\\.?(?:/|$))[^\\u0000]+$"
        },
        "sha256": {"$ref": "#/$defs/sha256"},
        "size_bytes": {"type": "integer", "minimum": 1}
      },
      "additionalProperties": false
    },
    "writerRun": {
      "type": "object",
      "required": [
        "purpose",
        "writer_id",
        "profile_id",
        "target_route",
        "source_profile_id",
        "frame_count",
        "dimensions",
        "report",
        "source_payload",
        "source_lock",
        "encoded",
        "encoder_settings_sha256",
        "mp4_byte_identity_across_runs_claimed"
      ],
      "properties": {
        "purpose": {
          "enum": [
            "low_resolution_degradation",
            "candidate_postencode_isolated",
            "candidate_postencode_smoke"
          ]
        },
        "writer_id": {
          "enum": [
            "apple-h264-software-common-writer-v1",
            "mirmir-product-hevc-avassetwriter-v1"
          ]
        },
        "profile_id": {"type": "string", "minLength": 1},
        "target_route": {"type": ["string", "null"]},
        "source_profile_id": {"type": ["string", "null"]},
        "frame_count": {"type": "integer", "minimum": 1},
        "dimensions": {
          "type": "object",
          "required": ["width", "height"],
          "properties": {
            "width": {"type": "integer", "minimum": 2, "multipleOf": 2},
            "height": {"type": "integer", "minimum": 2, "multipleOf": 2}
          },
          "additionalProperties": false
        },
        "report": {"$ref": "#/$defs/fileBinding"},
        "source_payload": {"$ref": "#/$defs/fileBinding"},
        "source_lock": {"$ref": "#/$defs/fileBinding"},
        "encoded": {"$ref": "#/$defs/fileBinding"},
        "case_id": {"type": "string", "minLength": 1},
        "decoded_payload": {"$ref": "#/$defs/fileBinding"},
        "metric_eligible": {"type": "boolean"},
        "container_scope": {"$ref": "#/$defs/isolatedContainerScope"},
        "encoder_settings_sha256": {"$ref": "#/$defs/sha256"},
        "requested_codec": {"const": "hevc"},
        "reopened_codec": {"enum": ["hvc1", "hev1"]},
        "requested_average_bit_rate": {"const": 2000000},
        "observed_estimated_data_rate": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "product_settings_source": {"$ref": "#/$defs/fileBinding"},
        "validated_attachments": {
          "type": "object",
          "required": [
            "color_primaries",
            "transfer_function",
            "ycbcr_matrix",
            "chroma_location_top_field",
            "range"
          ],
          "properties": {
            "color_primaries": {"const": "ITU_R_709_2"},
            "transfer_function": {"const": "ITU_R_709_2"},
            "ycbcr_matrix": {"const": "ITU_R_709_2"},
            "chroma_location_top_field": {"const": "Left"},
            "range": {"const": "video"}
          },
          "additionalProperties": false
        },
        "mp4_byte_identity_across_runs_claimed": {"const": false}
      },
      "additionalProperties": false
    },
    "isolatedContainerScope": {
      "type": "object",
      "required": [
        "frame_count",
        "single_frame_container",
        "neighbor_frames_present",
        "metric_role"
      ],
      "properties": {
        "frame_count": {"const": 1},
        "single_frame_container": {"const": true},
        "neighbor_frames_present": {"const": false},
        "metric_role": {"const": "isolated_metric_case"}
      },
      "additionalProperties": false
    },
    "isolatedWriterRun": {
      "allOf": [
        {"$ref": "#/$defs/writerRun"},
        {
          "required": [
            "case_id",
            "decoded_payload",
            "metric_eligible",
            "container_scope",
            "requested_codec",
            "reopened_codec",
            "requested_average_bit_rate",
            "observed_estimated_data_rate",
            "product_settings_source",
            "validated_attachments"
          ],
          "properties": {
            "purpose": {"const": "candidate_postencode_isolated"},
            "writer_id": {"const": "mirmir-product-hevc-avassetwriter-v1"},
            "profile_id": {"const": "candidate-postencode-isolated"},
            "target_route": {"const": null},
            "source_profile_id": {"const": null},
            "frame_count": {"const": 1},
            "dimensions": {"const": {"width": 324, "height": 192}},
            "metric_eligible": {"const": true},
            "container_scope": {"$ref": "#/$defs/isolatedContainerScope"}
          }
        }
      ]
    }
  },
  "allOf": [
    {
      "if": {
        "required": ["actual_codec_fixture_used"],
        "properties": {"actual_codec_fixture_used": {"const": true}}
      },
      "then": {
        "required": ["actual_codec_fixture_id", "container_decoded_frame_count"],
        "properties": {
          "comparison_domains_executed": {"contains": {"const": "container_decoded"}}
        }
      }
    },
    {
      "if": {
        "required": ["gate_status"],
        "properties": {"gate_status": {"const": "pass"}}
      },
      "then": {
        "required": [
          "sample_manifest_sha256",
          "candidate_id",
          "candidate_configuration_sha256",
          "candidate_input_pixel_representation",
          "baseline_id",
          "resume_checkpoint_semantics",
          "actual_codec_fixture_reverified",
          "postencode_results_recomputed",
          "postencode_isolation_mode",
          "postencode_isolated_container_count",
          "postencode_metric_rows_from_isolated_containers",
          "postencode_smoke_batch_executed",
          "stale_partial_preservation_enabled",
          "artifact_semantic_reverification",
          "artifact_publish_freeze",
          "published_directory_immutable",
          "routes_executed",
          "actual_codec_fixture_conformance_only",
          "actual_codec_fixture_id",
          "actual_codec_fixture_evidence_sha256",
          "common_writer_id",
          "production_output_writer_id",
          "product_settings_source",
          "product_settings_evidence",
          "common_writer_runs",
          "low_resolution_actual_codec_frame_count",
          "engine_raw_frame_count",
          "container_decoded_frame_count",
          "engine_raw_result",
          "container_decoded_result",
          "comparison_case_order_sha256",
          "mp4_byte_identity_across_runs_claimed",
          "gate_interpretation"
        ],
        "properties": {
          "corpus_mode": {"const": "production_locked"},
          "development_source_asset_count": {"const": 6},
          "candidate_input_pixel_representation": {
            "const": "bt709-video-range-420v-8bit-nv12-v1"
          },
          "degradation_profile_ids": {
            "const": [
              "actual-h264-software-direct-2x-v1",
              "actual-h264-software-direct-3over2-v1",
              "camera-blur9-decimate-2x-v1",
              "camera-blur9-resample-2over3-v1",
              "codec-quantized-proxy-2over3-v1",
              "codec-quantized-proxy-v1",
              "hq-binomial7-decimate-2x-v1",
              "hq-binomial7-resample-2over3-v1"
            ]
          },
          "case_count": {"const": 24},
          "completed_case_count": {"const": 24},
          "fixture_dimensions": {"const": {"width": 324, "height": 192}},
          "routes_executed": {"const": ["direct-2x", "direct-3over2"]},
          "comparison_domains_executed": {"const": ["engine_raw", "container_decoded"]},
          "actual_codec_fixture_used": {"const": true},
          "actual_codec_fixture_conformance_only": {"const": true},
          "actual_codec_fixture_reverified": {"const": true},
          "postencode_results_recomputed": {"const": true},
          "postencode_isolation_mode": {
            "const": "one-case-per-product-hevc-container"
          },
          "postencode_isolated_container_count": {"const": 24},
          "postencode_metric_rows_from_isolated_containers": {"const": true},
          "postencode_smoke_batch_executed": {"const": false},
          "stale_partial_preservation_enabled": {"const": true},
          "artifact_semantic_reverification": {"const": true},
          "published_directory_immutable": {"const": true},
          "common_writer_id": {"const": "apple-h264-software-common-writer-v1"},
          "production_output_writer_id": {
            "const": "mirmir-product-hevc-avassetwriter-v1"
          },
          "product_settings_source": {
            "properties": {
              "path": {
                "const": "Mirmir/Modules/MediaPipeline/MediaTypes.swift"
              }
            }
          },
          "product_settings_evidence": {
            "properties": {
              "path": {"const": "product-settings-source/MediaTypes.swift"}
            }
          },
          "low_resolution_actual_codec_frame_count": {"const": 6},
          "engine_raw_frame_count": {"const": 24},
          "container_decoded_frame_count": {"const": 24},
          "engine_raw_result": {
            "properties": {"path": {"const": "quality-result-engine-raw.json"}}
          },
          "container_decoded_result": {
            "properties": {"path": {"const": "quality-result-container-decoded.json"}}
          },
          "mp4_byte_identity_across_runs_claimed": {"const": false},
          "holdout_accessed": {"const": false},
          "gate_interpretation": {"const": "harness integrity pass; no algorithm-quality claim"},
          "status": {"const": "pass"}
        }
      }
    },
    {
      "if": {
        "required": ["resumed_from_failure"],
        "properties": {
          "gate_status": {"const": "pass"},
          "resumed_from_failure": {"const": true}
        }
      },
      "then": {"properties": {"resume_checkpoint_semantics": {"const": "recomputed"}}}
    },
    {
      "if": {
        "required": ["resumed_from_failure"],
        "properties": {
          "gate_status": {"const": "pass"},
          "resumed_from_failure": {"const": false}
        }
      },
      "then": {"properties": {"resume_checkpoint_semantics": {"const": "not_applicable"}}}
    }
  ]
}
