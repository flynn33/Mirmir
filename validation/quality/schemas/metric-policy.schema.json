{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mirmir.local/validation/quality/metric-policy-v1.schema.json",
  "type": "object",
  "required": [
    "schema_version",
    "status",
    "comparison_domains",
    "domain_aggregation_forbidden",
    "numeric_precision",
    "normalization",
    "psnr",
    "ssim",
    "ms_ssim",
    "artifact_metrics",
    "independent_oracle",
    "analytic_fixture_manifest",
    "bootstrap",
    "unlocked_release_fields",
    "policy_sha256"
  ],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "status": {"enum": ["development_seed", "locked"]},
    "comparison_domains": {
      "const": ["engine_raw", "container_decoded"]
    },
    "domain_aggregation_forbidden": {"const": true},
    "numeric_precision": {"const": "IEEE-754 binary64"},
    "normalization": {
      "type": "object",
      "required": ["luma", "chroma", "peak", "missing_metadata"]
    },
    "psnr": {
      "type": "object",
      "required": ["mse", "zero_mse"]
    },
    "ssim": {
      "type": "object",
      "required": [
        "window",
        "sigma",
        "kernel_construction",
        "k1",
        "k2",
        "peak",
        "boundary",
        "aggregation"
      ],
      "properties": {
        "window": {"const": 11},
        "sigma": {"const": 1.5},
        "k1": {"const": 0.01},
        "k2": {"const": 0.03},
        "peak": {"const": 1.0},
        "boundary": {"const": "reflect-101"}
      }
    },
    "ms_ssim": {
      "type": "object",
      "required": [
        "scales",
        "weights",
        "downsample",
        "odd_extent",
        "minimum_side",
        "negative_component_policy"
      ],
      "properties": {
        "scales": {"const": 5},
        "weights": {"const": [0.0448, 0.2856, 0.3001, 0.2363, 0.1333]},
        "minimum_side": {"const": 32}
      }
    },
    "artifact_metrics": {
      "type": "object",
      "required": ["edge_crossing", "ringing", "thin_line", "chroma_displacement", "alias"]
    },
    "independent_oracle": {
      "type": "object",
      "required": ["implementation", "vector_path", "vector_sha256", "required_cases"],
      "properties": {
        "implementation": {"const": "direct two-dimensional convolution independent of production metric helpers"},
        "vector_path": {"const": "validation/quality/reference/metric-vectors-v1.json"},
        "vector_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "required_cases": {
          "const": ["non-identical SSIM", "non-identical five-scale MS-SSIM"]
        }
      },
      "additionalProperties": false
    },
    "analytic_fixture_manifest": {
      "type": "object",
      "required": ["path", "manifest_sha256", "file_sha256"],
      "properties": {
        "path": {"const": "reference/analytic-fixtures-v2.json"},
        "manifest_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "file_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      },
      "additionalProperties": false
    },
    "bootstrap": {
      "type": "object",
      "required": [
        "unit",
        "per_asset_aggregation",
        "aggregate",
        "replicates",
        "seed",
        "generator",
        "ordering",
        "interval",
        "quantile"
      ],
      "properties": {
        "unit": {"const": "source_asset"},
        "replicates": {"const": 10000},
        "seed": {"const": 20260710},
        "interval": {"const": [0.025, 0.975]}
      }
    },
    "unlocked_release_fields": {
      "type": "array",
      "minItems": 6,
      "items": {"type": "string", "minLength": 1}
    },
    "policy_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  },
  "additionalProperties": false
}
