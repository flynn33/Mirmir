{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mirmir.local/validation/quality/common-writer-source-v1.schema.json",
  "type": "object",
  "required": [
    "schema_version",
    "artifact_kind",
    "source_id",
    "payload_path",
    "pixel_layout",
    "frame_count",
    "frames",
    "payload_size_bytes",
    "payload_sha256"
  ],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "artifact_kind": {"const": "common_writer_source_lock"},
    "source_id": {"type": "string", "minLength": 1},
    "payload_path": {"type": "string", "pattern": "^[^/]+\\.nv12$"},
    "pixel_layout": {"$ref": "#/$defs/pixelLayout"},
    "frame_count": {"type": "integer", "minimum": 1},
    "frames": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/sourceFrame"}
    },
    "payload_size_bytes": {"type": "integer", "minimum": 1},
    "payload_sha256": {"$ref": "#/$defs/sha256"}
  },
  "additionalProperties": false,
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "time": {
      "type": "object",
      "required": ["value", "timescale"],
      "properties": {
        "value": {"type": "integer", "minimum": 0},
        "timescale": {"type": "integer", "minimum": 1}
      },
      "additionalProperties": false
    },
    "duration": {
      "type": "object",
      "required": ["value", "timescale"],
      "properties": {
        "value": {"type": "integer", "minimum": 1},
        "timescale": {"type": "integer", "minimum": 1}
      },
      "additionalProperties": false
    },
    "planeHashes": {
      "type": "object",
      "required": ["Y", "Cb", "Cr"],
      "properties": {
        "Y": {"$ref": "#/$defs/sha256"},
        "Cb": {"$ref": "#/$defs/sha256"},
        "Cr": {"$ref": "#/$defs/sha256"}
      },
      "additionalProperties": false
    },
    "pixelLayout": {
      "type": "object",
      "required": [
        "pixel_format",
        "range",
        "color_primaries",
        "transfer_function",
        "ycbcr_matrix",
        "chroma_location_top_field",
        "chroma_location_bottom_field",
        "width",
        "height"
      ],
      "properties": {
        "pixel_format": {"const": "420v"},
        "range": {"const": "video"},
        "color_primaries": {"const": "ITU_R_709_2"},
        "transfer_function": {"const": "ITU_R_709_2"},
        "ycbcr_matrix": {"const": "ITU_R_709_2"},
        "chroma_location_top_field": {"const": "Left"},
        "chroma_location_bottom_field": {"const": "Left"},
        "width": {"type": "integer", "minimum": 2, "multipleOf": 2},
        "height": {"type": "integer", "minimum": 2, "multipleOf": 2}
      },
      "additionalProperties": false
    },
    "sourceFrame": {
      "type": "object",
      "required": [
        "case_id",
        "index",
        "presentation_time",
        "duration",
        "active_row_sha256",
        "frame_nv12_sha256"
      ],
      "properties": {
        "case_id": {"type": "string", "minLength": 1},
        "index": {"type": "integer", "minimum": 0},
        "presentation_time": {"$ref": "#/$defs/time"},
        "duration": {"$ref": "#/$defs/duration"},
        "active_row_sha256": {"$ref": "#/$defs/planeHashes"},
        "frame_nv12_sha256": {"$ref": "#/$defs/sha256"}
      },
      "additionalProperties": false
    }
  }
}
