{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mirmir.local/validation/quality/quality-result-v1.schema.json",
  "type": "object",
  "required": [
    "schema_version",
    "run_id",
    "configuration_sha256",
    "corpus_manifest_sha256",
    "split",
    "comparison_domain",
    "asset_results",
    "status"
  ],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "run_id": {"type": "string", "minLength": 1},
    "configuration_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "corpus_manifest_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "split": {"enum": ["development", "validation", "holdout"]},
    "comparison_domain": {"enum": ["engine_raw", "container_decoded"]},
    "asset_results": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["source_asset_id", "degradation_profile", "metrics", "status"],
        "properties": {
          "source_asset_id": {"type": "string", "minLength": 1},
          "degradation_profile": {"type": "string", "minLength": 1},
          "metrics": {"type": "object", "minProperties": 1},
          "status": {"enum": ["pass", "fail"]}
        },
        "additionalProperties": true
      }
    },
    "status": {"enum": ["pass", "fail"]},
    "holdout_opened_utc": {"type": ["string", "null"], "format": "date-time"},
    "configuration_files_modified_after_holdout": {"const": false}
  },
  "allOf": [
    {
      "if": {
        "required": ["status"],
        "properties": {"status": {"const": "pass"}}
      },
      "then": {
        "properties": {
          "asset_results": {
            "items": {
              "required": ["status"],
              "properties": {"status": {"const": "pass"}}
            }
          }
        }
      }
    },
    {
      "if": {
        "required": ["status"],
        "properties": {"status": {"const": "fail"}}
      },
      "then": {
        "properties": {
          "asset_results": {
            "contains": {
              "required": ["status"],
              "properties": {"status": {"const": "fail"}}
            },
            "minContains": 1
          }
        }
      }
    }
  ],
  "additionalProperties": false
}
