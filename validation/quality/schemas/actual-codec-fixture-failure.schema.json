{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mirmir.local/validation/quality/actual-codec-fixture-failure-v1.schema.json",
  "type": "object",
  "required": [
    "schema_version",
    "artifact_kind",
    "status",
    "error_type",
    "message",
    "requested_fixture_path"
  ],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "artifact_kind": {"const": "actual_codec_fixture_failure"},
    "status": {"const": "fail"},
    "error_type": {"type": "string", "minLength": 1},
    "message": {"type": "string", "minLength": 1},
    "requested_fixture_path": {"type": "string", "minLength": 1}
  },
  "additionalProperties": false
}
