{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mirmir.local/validation/quality/holdout-access-anchor-v1.schema.json",
  "type": "object",
  "required": [
    "schema_version",
    "artifact_kind",
    "corpus_manifest_sha256",
    "configuration_sha256",
    "open_intent_utc",
    "persistence",
    "threat_boundary"
  ],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "artifact_kind": {"const": "holdout_access_anchor"},
    "corpus_manifest_sha256": {"$ref": "#/$defs/sha256"},
    "configuration_sha256": {"$ref": "#/$defs/sha256"},
    "open_intent_utc": {"type": "string", "format": "date-time"},
    "persistence": {"const": "macos-user-immutable-v1"},
    "threat_boundary": {
      "const": "cooperating-processes-v1; deliberate owner-or-administrator flag clearing, direct media access, code bypass, and filesystem rollback are outside scope"
    }
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  },
  "additionalProperties": false
}
