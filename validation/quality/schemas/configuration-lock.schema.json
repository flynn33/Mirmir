{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mirmir.local/validation/quality/configuration-lock-v1.schema.json",
  "type": "object",
  "required": [
    "schema_version",
    "locked_utc",
    "release_fields_complete",
    "configuration_files_modified_after_lock",
    "mapping_sha256",
    "operator_bank_sha256",
    "quality_policy_sha256",
    "metric_policy_sha256",
    "metric_implementation_sha256",
    "metric_conformance_sha256",
    "degradation_policy_sha256",
    "actual_codec_fixture_sha256",
    "actual_codec_evidence_sha256",
    "quality_harness_implementation_manifest_sha256",
    "compiler_inputs_sha256",
    "route_luts_sha256",
    "corpus_manifest_sha256",
    "holdout_opened_utc"
  ],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "locked_utc": {"type": "string", "format": "date-time"},
    "release_fields_complete": {"const": true},
    "configuration_files_modified_after_lock": {"const": false},
    "mapping_sha256": {"$ref": "#/$defs/sha256"},
    "operator_bank_sha256": {"$ref": "#/$defs/sha256"},
    "quality_policy_sha256": {"$ref": "#/$defs/sha256"},
    "metric_policy_sha256": {"$ref": "#/$defs/sha256"},
    "metric_implementation_sha256": {"$ref": "#/$defs/sha256"},
    "metric_conformance_sha256": {"$ref": "#/$defs/sha256"},
    "degradation_policy_sha256": {"$ref": "#/$defs/sha256"},
    "actual_codec_fixture_sha256": {"$ref": "#/$defs/sha256"},
    "actual_codec_evidence_sha256": {"$ref": "#/$defs/sha256"},
    "quality_harness_implementation_manifest_sha256": {"$ref": "#/$defs/sha256"},
    "compiler_inputs_sha256": {"$ref": "#/$defs/sha256"},
    "route_luts_sha256": {"$ref": "#/$defs/sha256"},
    "corpus_manifest_sha256": {"$ref": "#/$defs/sha256"},
    "holdout_opened_utc": {"type": ["string", "null"], "format": "date-time"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  },
  "additionalProperties": false
}
