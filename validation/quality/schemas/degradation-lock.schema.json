{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mirmir.local/validation/quality/degradation-lock-v1.schema.json",
  "type": "object",
  "required": ["schema_version", "status", "profiles", "policy_sha256"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "status": {"enum": ["development_seed", "locked"]},
    "preintegration_policy_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "profiles": {
      "type": "array",
      "minItems": 4,
      "items": {
        "type": "object",
        "required": [
          "id",
          "kind",
          "version",
          "boundary",
          "conformance_fixture",
          "determinism_contract"
        ],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "kind": {
            "enum": [
              "lowpass_decimate",
              "camera_blur_decimate",
              "codec_quantized_proxy",
              "synthetic_motion"
            ]
          },
          "version": {"type": "string", "minLength": 1},
          "boundary": {"const": "reflect-101"},
          "conformance_fixture": {"type": "string", "minLength": 1},
          "expected_output_sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "expected_sequence_sha256": {
            "type": "array",
            "minItems": 1,
            "items": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
          },
          "determinism_contract": {"type": "string", "minLength": 1}
        },
        "allOf": [
          {
            "if": {"properties": {"kind": {"const": "synthetic_motion"}}},
            "then": {"required": ["expected_sequence_sha256"]},
            "else": {"required": ["expected_output_sha256"]}
          }
        ],
        "additionalProperties": true
      }
    },
    "actual_codec_fixture_required_for_gate": {"type": "boolean"},
    "common_writer_profiles": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "items": {
        "type": "object",
        "required": [
          "id",
          "kind",
          "version",
          "target_route",
          "source_profile_id",
          "writer_id",
          "determinism_contract"
        ],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "kind": {"const": "actual_codec"},
          "version": {"type": "string", "minLength": 1},
          "target_route": {"enum": ["direct-2x", "direct-3over2"]},
          "source_profile_id": {"type": "string", "minLength": 1},
          "writer_id": {"type": "string", "minLength": 1},
          "determinism_contract": {"type": "string", "minLength": 1}
        },
        "additionalProperties": false
      }
    },
    "actual_codec_fixture": {"$ref": "#/$defs/actualCodecFixture"},
    "policy_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  },
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "required": ["status"],
        "properties": {
          "status": {"const": "locked"}
        }
      },
      "then": {
        "required": [
          "actual_codec_fixture_required_for_gate",
          "actual_codec_fixture",
          "common_writer_profiles",
          "preintegration_policy_sha256"
        ],
        "properties": {
          "actual_codec_fixture_required_for_gate": {"const": true}
        }
      }
    }
  ],
  "$defs": {
    "actualCodecFixture": {
      "type": "object",
      "required": [
        "id",
        "kind",
        "version",
        "source_profile_id",
        "fixture_path",
        "fixture_sha256",
        "evidence_path",
        "evidence_sha256",
        "deterministic_decoded_pixels_on_recorded_environment"
      ],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "kind": {"const": "actual_codec"},
        "version": {"type": "string", "minLength": 1},
        "source_profile_id": {"type": "string", "minLength": 1},
        "fixture_path": {"type": "string", "pattern": "\\.mp4$"},
        "fixture_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "evidence_path": {"type": "string", "pattern": "\\.json$"},
        "evidence_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "deterministic_decoded_pixels_on_recorded_environment": {"const": true}
      },
      "additionalProperties": false
    }
  }
}
