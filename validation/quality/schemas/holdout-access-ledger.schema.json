{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mirmir.local/validation/quality/holdout-access-ledger-v1.schema.json",
  "type": "object",
  "required": [
    "schema_version",
    "corpus_manifest_sha256",
    "state",
    "open_intent_utc",
    "opened_utc",
    "completed_utc",
    "events"
  ],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "corpus_manifest_sha256": {"$ref": "#/$defs/sha256"},
    "state": {
      "enum": ["sealed", "intent_recorded", "opened", "completed", "failed"]
    },
    "open_intent_utc": {"type": ["string", "null"], "format": "date-time"},
    "opened_utc": {"type": ["string", "null"], "format": "date-time"},
    "completed_utc": {"type": ["string", "null"], "format": "date-time"},
    "events": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "sequence",
          "event",
          "occurred_utc",
          "previous_entry_sha256",
          "details",
          "entry_sha256"
        ],
        "properties": {
          "sequence": {"type": "integer", "minimum": 0},
          "event": {
            "enum": ["sealed", "open_intent", "opened", "completed", "failed_after_open"]
          },
          "occurred_utc": {"type": "string", "format": "date-time"},
          "previous_entry_sha256": {"$ref": "#/$defs/sha256"},
          "details": {"type": "object"},
          "entry_sha256": {"$ref": "#/$defs/sha256"}
        },
        "additionalProperties": false
      }
    }
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  },
  "additionalProperties": false
}
