        "serialization_rebind_applied": {"type": "boolean"},
        "serialization_rebind_sha256": {"$ref": "#/$defs/sha256"}
      },
      "oneOf": [
        {
          "required": [
            "original_coordinate_policy",
            "serialized_coordinate_policy"
          ],
          "not": {
            "anyOf": [
              {"required": ["original_luma_coordinate_policy"]},
              {"required": ["original_chroma_coordinate_policy"]},
              {"required": ["serialized_luma_coordinate_policy"]},
              {"required": ["serialized_chroma_coordinate_policy"]}
            ]
          }
        },
        {
          "required": [
            "original_luma_coordinate_policy",
            "original_chroma_coordinate_policy",
            "serialized_luma_coordinate_policy",
            "serialized_chroma_coordinate_policy"
          ],
          "not": {
            "anyOf": [
              {"required": ["original_coordinate_policy"]},
              {"required": ["serialized_coordinate_policy"]}
            ]
          }
        }
      ],
      "additionalProperties": false
    },
