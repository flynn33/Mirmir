{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mirmir.local/validation/calibration-v2/p08-instruments-manifest-v1.schema.json",
  "type": "object",
  "required": [
    "schema_version", "artifact_kind", "evidence_identity",
    "xctrace_version", "profiles", "route_observations",
    "hash_scope", "artifact_sha256"
  ],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "artifact_kind": {"const": "p08_instruments_manifest"},
    "evidence_identity": {
      "$ref": "https://mirmir.local/validation/calibration-v2/p08-common-v1.schema.json#/$defs/identity"
    },
    "xctrace_version": {"type": "string", "minLength": 1},
    "profiles": {
      "type": "array", "minItems": 6, "maxItems": 6,
      "items": {"$ref": "#/$defs/profile"}
    },
    "route_observations": {
      "type": "array", "minItems": 2, "maxItems": 2,
      "items": {"$ref": "#/$defs/observation"}
    },
    "hash_scope": {
      "const": "canonical sorted-key compact UTF-8 JSON excluding /artifact_sha256"
    },
    "artifact_sha256": {
      "$ref": "https://mirmir.local/validation/calibration-v2/p08-common-v1.schema.json#/$defs/sha256"
    }
  },
  "additionalProperties": false,
  "$defs": {
    "profile": {
      "type": "object",
      "required": ["tool", "route", "archive"],
      "properties": {
        "tool": {"enum": ["time_profiler", "allocations", "metal_system_trace"]},
        "route": {"enum": ["direct_2x", "direct_3_over_2"]},
        "archive": {
          "$ref": "https://mirmir.local/validation/calibration-v2/p08-common-v1.schema.json#/$defs/treeBinding"
        }
      },
      "additionalProperties": false
    },
    "observation": {
      "type": "object",
      "required": [
        "route", "benchmark_conditions_sha256", "observed_frames",
        "analysis_gpu_frame_count", "reconstruction_gpu_frame_count",
        "full_frame_cpu_reconstruction_loop_count",
        "runtime_leaf_tree_generation_count",
        "candidate_evaluation_maximum_from_gpu_summary",
        "command_completion_mode", "submitted_command_buffer_count",
        "completed_command_buffer_count", "failed_command_buffer_count",
        "command_buffer_observation_count",
        "command_buffer_error_observation_count",
        "avoidable_full_frame_gpu_readback_count"
      ],
      "properties": {
        "route": {"enum": ["direct_2x", "direct_3_over_2"]},
        "benchmark_conditions_sha256": {
          "$ref": "https://mirmir.local/validation/calibration-v2/p08-common-v1.schema.json#/$defs/sha256"
        },
        "observed_frames": {"type": "integer", "minimum": 1},
        "analysis_gpu_frame_count": {"type": "integer", "minimum": 0},
        "reconstruction_gpu_frame_count": {"type": "integer", "minimum": 0},
        "full_frame_cpu_reconstruction_loop_count": {"type": "integer", "minimum": 0},
        "runtime_leaf_tree_generation_count": {"type": "integer", "minimum": 0},
        "candidate_evaluation_maximum_from_gpu_summary": {"type": "integer", "minimum": 0},
        "command_completion_mode": {
          "enum": ["asynchronous_completion_handler", "unverified"]
        },
        "submitted_command_buffer_count": {"type": "integer", "minimum": 0},
        "completed_command_buffer_count": {"type": "integer", "minimum": 0},
        "failed_command_buffer_count": {"type": "integer", "minimum": 0},
        "command_buffer_observation_count": {"type": "integer", "minimum": 0},
        "command_buffer_error_observation_count": {"type": "integer", "minimum": 0},
        "avoidable_full_frame_gpu_readback_count": {"type": "integer", "minimum": 0}
      },
      "additionalProperties": false
    }
  }
}
