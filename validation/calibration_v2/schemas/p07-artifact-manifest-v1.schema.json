{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mirmir.local/validation/calibration-v2/p07-artifact-manifest-v1.schema.json",
  "type": "object",
  "required": [
    "schema_version",
    "artifact_kind",
    "status",
    "publication_kind",
    "configuration_id",
    "configuration_sha256",
    "release_bundle_manifest_sha256",
    "sampling_plan_manifest_sha256",
    "holdout_accessed",
    "holdout_access_consumed",
    "producer",
    "command",
    "platform",
    "gate_ids",
    "artifacts",
    "exact_file_names",
    "self_reference_boundary",
    "manifest_sha256"
  ],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "artifact_kind": {"const": "p07_artifact_manifest"},
    "status": {"enum": ["complete", "failed"]},
    "publication_kind": {"enum": ["g07_evidence", "execution_failure"]},
    "configuration_id": {"type": ["string", "null"], "minLength": 1},
    "configuration_sha256": {"$ref": "#/$defs/sha256"},
    "release_bundle_manifest_sha256": {"anyOf": [{"$ref": "#/$defs/sha256"}, {"type": "null"}]},
    "sampling_plan_manifest_sha256": {"anyOf": [{"$ref": "#/$defs/sha256"}, {"type": "null"}]},
    "holdout_accessed": {"type": "boolean"},
    "holdout_access_consumed": {"type": ["boolean", "null"]},
    "producer": {"const": "Mirmir P07 locked-holdout harness"},
    "command": {"type": "string", "minLength": 1},
    "platform": {"type": "string", "minLength": 1},
    "gate_ids": {"const": ["P07", "G07"]},
    "artifacts": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/artifact"}
    },
    "exact_file_names": {
      "type": "array",
      "minItems": 2,
      "uniqueItems": true,
      "contains": {"const": "artifact-manifest.json"},
      "minContains": 1,
      "maxContains": 1,
      "items": {"$ref": "#/$defs/safeName"}
    },
    "self_reference_boundary": {
      "const": "artifact-manifest.json is excluded from its own artifacts list and bound by manifest_sha256 over this document without that field"
    },
    "manifest_sha256": {"$ref": "#/$defs/sha256"}
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^(?!0{64}$)[0-9a-f]{64}$"
    },
    "safeName": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!\\.\\.?$)(?!.*[/\\\\\\u0000])[^/\\\\]+\\.json$"
    },
    "artifact": {
      "type": "object",
      "required": [
        "path",
        "sha256",
        "size_bytes",
        "producer",
        "command",
        "platform",
        "gate_ids"
      ],
      "properties": {
        "path": {"$ref": "#/$defs/safeName"},
        "sha256": {"$ref": "#/$defs/sha256"},
        "size_bytes": {"type": "integer", "minimum": 1},
        "producer": {"const": "Mirmir P07 locked-holdout harness"},
        "command": {"type": "string", "minLength": 1},
        "platform": {"type": "string", "minLength": 1},
        "gate_ids": {"const": ["P07", "G07"]}
      },
      "additionalProperties": false
    }
  },
  "allOf": [
    {
      "if": {"properties": {"status": {"const": "complete"}}},
      "then": {
        "properties": {
          "publication_kind": {"const": "g07_evidence"},
          "configuration_id": {"type": "string", "minLength": 1},
          "release_bundle_manifest_sha256": {"$ref": "#/$defs/sha256"},
          "sampling_plan_manifest_sha256": {"$ref": "#/$defs/sha256"},
          "holdout_accessed": {"const": true},
          "holdout_access_consumed": {"const": true}
        }
      }
    },
    {
      "if": {"properties": {"status": {"const": "failed"}}},
      "then": {
        "properties": {
          "publication_kind": {"const": "execution_failure"}
        }
      }
    }
  ],
  "additionalProperties": false
}
