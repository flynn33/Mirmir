{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mirmir.local/validation/calibration-v2/p07-transaction-intent-v1.schema.json",
  "type": "object",
  "required": [
    "schema_version",
    "artifact_kind",
    "transaction_id",
    "transaction_state",
    "requested_output_directory",
    "configuration_id",
    "configuration_sha256",
    "release_bundle_manifest_sha256",
    "input_bundle_sha256",
    "corpus_lock_bundle_sha256",
    "corpus_manifest_sha256",
    "sampling_plan_file_sha256",
    "sampling_plan_manifest_sha256",
    "no_pixel_attestation_file_sha256",
    "outer_wrapper_file_sha256",
    "outer_wrapper_manifest_sha256",
    "loader_executable_sha256",
    "authorized_execution_bindings",
    "p07_preopen_cache_tree_sha256",
    "inner_inventory_sha256",
    "direct_input_bindings",
    "unmount_script_path",
    "unmount_script_sha256",
    "live_ledger_path",
    "live_anchor_path",
    "live_preopen_receipt_path",
    "expected_live_ledger_root_identity_sha256",
    "expected_live_anchor_root_identity_sha256",
    "expected_live_preopen_receipt_sha256",
    "command",
    "platform",
    "manifest_sha256"
  ],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "artifact_kind": {"const": "p07_durable_transaction_intent"},
    "transaction_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "transaction_state": {"const": "pre_guard"},
    "requested_output_directory": {"type": "string", "pattern": "^/"},
    "configuration_id": {"type": "string", "minLength": 1},
    "configuration_sha256": {"$ref": "#/$defs/sha256"},
    "release_bundle_manifest_sha256": {"$ref": "#/$defs/sha256"},
    "input_bundle_sha256": {"$ref": "#/$defs/sha256"},
    "corpus_lock_bundle_sha256": {"$ref": "#/$defs/sha256"},
    "corpus_manifest_sha256": {"$ref": "#/$defs/sha256"},
    "sampling_plan_file_sha256": {"$ref": "#/$defs/sha256"},
    "sampling_plan_manifest_sha256": {"$ref": "#/$defs/sha256"},
    "no_pixel_attestation_file_sha256": {"$ref": "#/$defs/sha256"},
    "outer_wrapper_file_sha256": {"$ref": "#/$defs/sha256"},
    "outer_wrapper_manifest_sha256": {"$ref": "#/$defs/sha256"},
    "loader_executable_sha256": {"$ref": "#/$defs/sha256"},
    "authorized_execution_bindings": {
      "anyOf": [
        {"$ref": "#/$defs/authorizedExecutionBindings"},
        {"type": "null"}
      ]
    },
    "p07_preopen_cache_tree_sha256": {"$ref": "#/$defs/sha256"},
    "inner_inventory_sha256": {"$ref": "#/$defs/sha256"},
    "direct_input_bindings": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "required": ["id", "path", "sha256", "size_bytes"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "path": {"type": "string", "minLength": 1, "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))[^\\u0000\\\\]+$"},
          "sha256": {"$ref": "#/$defs/sha256"},
          "size_bytes": {"type": "integer", "minimum": 1}
        },
        "additionalProperties": false
      }
    },
    "unmount_script_path": {"type": "string", "pattern": "^/"},
    "unmount_script_sha256": {"$ref": "#/$defs/sha256"},
    "live_ledger_path": {"type": "string", "pattern": "^/"},
    "live_anchor_path": {"type": "string", "pattern": "^/"},
    "live_preopen_receipt_path": {"type": "string", "pattern": "^/"},
    "expected_live_ledger_root_identity_sha256": {"$ref": "#/$defs/sha256"},
    "expected_live_anchor_root_identity_sha256": {"$ref": "#/$defs/sha256"},
    "expected_live_preopen_receipt_sha256": {"$ref": "#/$defs/sha256"},
    "command": {"type": "string", "minLength": 1},
    "platform": {"type": "string", "minLength": 1},
    "manifest_sha256": {"$ref": "#/$defs/sha256"}
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^(?!0{64}$)[0-9a-f]{64}$"
    },
    "codeIdentity": {
      "type": "object",
      "required": ["schema_version", "artifact_kind", "architecture", "file_sha256", "unique_cdhash", "all_cdhashes", "digest_algorithms", "static_code_flags", "signing_kind", "identifier"],
      "properties": {
        "schema_version": {"const": "1.0.0"},
        "artifact_kind": {"const": "macos_code_identity_v1"},
        "architecture": {"type": "string", "minLength": 1},
        "file_sha256": {"$ref": "#/$defs/sha256"},
        "unique_cdhash": {"type": "string", "pattern": "^[0-9a-f]{40,128}$"},
        "all_cdhashes": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^[0-9a-f]{40,128}$"}},
        "digest_algorithms": {"type": "array", "minItems": 1, "items": {"type": "integer", "minimum": 1}},
        "static_code_flags": {"type": "integer", "minimum": 0},
        "signing_kind": {"enum": ["ad_hoc", "cms"]},
        "identifier": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    },
    "codeBinding": {
      "type": "object",
      "required": ["path", "file_sha256", "code_identity"],
      "properties": {
        "path": {"type": "string", "pattern": "^/"},
        "file_sha256": {"$ref": "#/$defs/sha256"},
        "code_identity": {"$ref": "#/$defs/codeIdentity"}
      },
      "additionalProperties": false
    },
    "fileBinding": {
      "type": "object",
      "required": ["path", "file_sha256"],
      "properties": {
        "path": {"type": "string", "pattern": "^/"},
        "file_sha256": {"$ref": "#/$defs/sha256"}
      },
      "additionalProperties": false
    },
    "scriptBinding": {
      "type": "object",
      "required": ["path", "file_sha256", "interpreter"],
      "properties": {
        "path": {"type": "string", "pattern": "^/"},
        "file_sha256": {"$ref": "#/$defs/sha256"},
        "interpreter": {"$ref": "#/$defs/codeBinding"}
      },
      "additionalProperties": false
    },
    "authorizedExecutionBindings": {
      "type": "object",
      "required": ["schema_version", "artifact_kind", "status", "authorized_environment", "authorized_spawn_policy_version", "direct_mount_template_sha256", "direct_mount_template_digest_contract", "unavailable_reason", "loader", "sampling_plan", "mount_script", "unmount_script", "key_helper", "mount_table", "hdiutil", "production_execution_binding_fragment", "manifest_sha256"],
      "properties": {
        "schema_version": {"const": "1.0.0"},
        "artifact_kind": {"const": "p07_authorized_execution_bindings"},
        "status": {"const": "bound"},
        "authorized_environment": {
          "type": "object",
          "required": ["LANG", "LC_ALL", "PATH", "TMPDIR"],
          "properties": {
            "LANG": {"const": "C"},
            "LC_ALL": {"const": "C"},
            "PATH": {"const": "/usr/bin:/bin:/usr/sbin:/sbin"},
            "TMPDIR": {"const": "/private/tmp"}
          },
          "additionalProperties": false
        },
        "authorized_spawn_policy_version": {"const": "p07-mandatory-suspended-runtime-identity-v1"},
        "direct_mount_template_sha256": {"$ref": "#/$defs/sha256"},
        "direct_mount_template_digest_contract": {"const": "SHA-256 of b'mount\\0' + mount-script bytes + b'\\0unmount\\0' + unmount-script bytes"},
        "unavailable_reason": {"const": null},
        "loader": {"$ref": "#/$defs/codeBinding"},
        "sampling_plan": {"$ref": "#/$defs/fileBinding"},
        "mount_script": {"$ref": "#/$defs/scriptBinding"},
        "unmount_script": {"$ref": "#/$defs/scriptBinding"},
        "key_helper": {"$ref": "#/$defs/codeBinding"},
        "mount_table": {"$ref": "#/$defs/codeBinding"},
        "hdiutil": {"$ref": "#/$defs/codeBinding"},
        "production_execution_binding_fragment": {"type": "object"},
        "manifest_sha256": {"$ref": "#/$defs/sha256"}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
