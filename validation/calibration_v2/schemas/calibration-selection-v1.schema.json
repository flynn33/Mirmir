{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mirmir.local/validation/calibration-v2/calibration-selection-v1.schema.json",
  "type": "object",
  "required": [
    "schema_version",
    "artifact_kind",
    "run_id",
    "input_bundle_sha256",
    "live_holdout_preopen_verification",
    "development_terminal_vector",
    "development_terminal_vector_sha256",
    "validation_candidate_vector_sha256_values",
    "validation_candidate_development_evidence",
    "validation_feasible_vector_sha256_values",
    "pareto_frontier_vector_sha256_values",
    "selected_vector",
    "selected_vector_sha256",
    "selected_summary",
    "selected_evaluation_sha256",
    "selected_controls",
    "selected_control_selection_artifacts",
    "baseline_ablation_contract_sha256",
    "quality_policy_seed_sha256",
    "corpus_lock_bundle_sha256",
    "dispatch_budget",
    "holdout_accessed",
    "release_locks_written",
    "status",
    "manifest_sha256"
  ],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "artifact_kind": {"const": "p06_calibration_selection"},
    "run_id": {"type": "string", "minLength": 1},
    "input_bundle_sha256": {"$ref": "#/$defs/sha256"},
    "live_holdout_preopen_verification": {"$ref": "#/$defs/liveHoldoutPreopenVerification"},
    "development_terminal_vector": {"$ref": "#/$defs/candidateVector"},
    "development_terminal_vector_sha256": {"$ref": "#/$defs/sha256"},
    "validation_candidate_vector_sha256_values": {"$ref": "#/$defs/nonemptyHashes"},
    "validation_candidate_development_evidence": {
      "type": "object",
      "required": ["path", "sha256", "size_bytes"],
      "properties": {
        "path": {"const": "validation-candidate-evidence.json"},
        "sha256": {"$ref": "#/$defs/sha256"},
        "size_bytes": {"type": "integer", "minimum": 1}
      },
      "additionalProperties": false
    },
    "validation_feasible_vector_sha256_values": {"$ref": "#/$defs/nonemptyHashes"},
    "pareto_frontier_vector_sha256_values": {"$ref": "#/$defs/nonemptyHashes"},
    "selected_vector": {"$ref": "#/$defs/candidateVector"},
    "selected_vector_sha256": {"$ref": "#/$defs/sha256"},
    "selected_summary": {"$ref": "#/$defs/domainSummaries"},
    "selected_evaluation_sha256": {"$ref": "#/$defs/sha256"},
    "selected_controls": {"$ref": "#/$defs/selectedControls"},
    "selected_control_selection_artifacts": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": {
        "type": "object",
        "required": ["control", "path", "sha256", "size_bytes"],
        "properties": {
          "control": {"enum": ["best_fixed", "conventional", "non_ash_selector"]},
          "path": {"type": "string", "pattern": "^control-selections/[0-9a-f]{64}\\.json$"},
          "sha256": {"$ref": "#/$defs/sha256"},
          "size_bytes": {"type": "integer", "minimum": 1}
        },
        "additionalProperties": false
      }
    },
    "baseline_ablation_contract_sha256": {"$ref": "#/$defs/sha256"},
    "quality_policy_seed_sha256": {"const": "38336d27e0ceba9020b05a62038c6c822ea20daca32f45a8f8891459ea82fff2"},
    "corpus_lock_bundle_sha256": {"$ref": "#/$defs/sha256"},
    "dispatch_budget": {"$ref": "#/$defs/dispatchBudget"},
    "holdout_accessed": {"const": false},
    "release_locks_written": {"const": false},
    "status": {"const": "selection_ready_not_release_locked"},
    "manifest_sha256": {"$ref": "#/$defs/sha256"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "nonemptyHashes": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/sha256"}
    },
    "liveHoldoutPreopenVerification": {
      "type": "object",
      "required": [
        "schema_version", "artifact_kind", "verification_status",
        "access_status", "access_count", "open_intent_anchor_present",
        "pixel_content_included", "live_ledger_sha256",
        "live_ledger_root_identity_sha256", "live_anchor_root_identity_sha256",
        "live_preopen_receipt_sha256", "repository_sealed_copy_sha256",
        "repository_attestation_sha256", "corpus_binding_sha256",
        "verification_receipt_sha256"
      ],
      "properties": {
        "schema_version": {"const": "1.0.0"},
        "artifact_kind": {"const": "live_holdout_preopen_verification"},
        "verification_status": {"const": "pass"},
        "access_status": {"const": "unopened"},
        "access_count": {"const": 0},
        "open_intent_anchor_present": {"const": false},
        "pixel_content_included": {"const": false},
        "live_ledger_sha256": {"$ref": "#/$defs/sha256"},
        "live_ledger_root_identity_sha256": {"$ref": "#/$defs/sha256"},
        "live_anchor_root_identity_sha256": {"$ref": "#/$defs/sha256"},
        "live_preopen_receipt_sha256": {"$ref": "#/$defs/sha256"},
        "repository_sealed_copy_sha256": {"$ref": "#/$defs/sha256"},
        "repository_attestation_sha256": {"$ref": "#/$defs/sha256"},
        "corpus_binding_sha256": {"$ref": "#/$defs/sha256"},
        "verification_receipt_sha256": {"$ref": "#/$defs/sha256"}
      },
      "additionalProperties": false
    },
    "candidateVector": {
      "type": "object",
      "minProperties": 42,
      "maxProperties": 42,
      "additionalProperties": {
        "oneOf": [
          {"type": "integer"},
          {"type": "string", "minLength": 1}
        ]
      }
    },
    "selectedControls": {
      "type": "object",
      "required": ["shared_bank_configuration_sha256", "quality_policy_seed_sha256", "baseline_ablation_contract_sha256", "best_fixed", "conventional", "non_ash_selector", "state_only", "state_plus_branch", "h07_direct_3_over_2", "nearest_same_writer", "current_production_ash"],
      "properties": {
        "shared_bank_configuration_sha256": {"$ref": "#/$defs/sha256"},
        "quality_policy_seed_sha256": {"const": "38336d27e0ceba9020b05a62038c6c822ea20daca32f45a8f8891459ea82fff2"},
        "baseline_ablation_contract_sha256": {"$ref": "#/$defs/sha256"},
        "best_fixed": {"type": "object", "required": ["control_id", "descriptor_id", "configuration_sha256", "selection_sha256", "shared_bank_configuration_sha256"]},
        "conventional": {"type": "object", "required": ["control_id", "algorithm_id", "configuration_sha256", "selection_sha256", "shared_bank_configuration_sha256"]},
        "non_ash_selector": {"type": "object", "required": ["selector_id", "configuration_sha256", "selection_sha256", "rule_sha256", "candidate_evaluation_budget", "shared_bank_configuration_sha256"]},
        "state_only": {"type": "object", "required": ["control_id", "configuration_sha256", "selection_sha256", "shared_bank_configuration_sha256"]},
        "state_plus_branch": {"type": "object", "required": ["control_id", "configuration_sha256", "selection_sha256", "shared_bank_configuration_sha256"]},
        "h07_direct_3_over_2": {"type": "object", "required": ["experiment_id", "direct_id", "control_id", "configuration_sha256", "selection_sha256", "shared_bank_configuration_sha256", "evidence_sha256"]},
        "nearest_same_writer": {"type": "object", "required": ["control_id", "configuration_sha256", "selection_sha256", "shared_bank_configuration_sha256"]},
        "current_production_ash": {"type": "object", "required": ["control_id", "configuration_sha256", "selection_sha256", "shared_bank_configuration_sha256"]}
      },
      "additionalProperties": false
    },
    "bootstrap": {
      "type": "object",
      "required": [
        "method",
        "replicates",
        "seed",
        "asset_count",
        "asset_ids",
        "asset_deltas",
        "point_delta",
        "ci_low",
        "ci_high",
        "category_estimates",
        "resample_index_sha256"
      ],
      "properties": {
        "method": {"const": "paired_source_asset_mean_splitmix64_v1"},
        "replicates": {"const": 10000},
        "seed": {"const": 20260710},
        "asset_count": {"type": "integer", "minimum": 1},
        "asset_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "asset_deltas": {"type": "array", "minItems": 1, "items": {"type": "number"}},
        "point_delta": {"type": "number"},
        "ci_low": {"type": "number"},
        "ci_high": {"type": "number"},
        "category_estimates": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": {"type": "number"}
        },
        "resample_index_sha256": {"$ref": "#/$defs/sha256"}
      },
      "additionalProperties": false
    },
    "summary": {
      "type": "object",
      "required": [
        "mean_y_psnr_delta_vs_fixed_db",
        "mean_y_psnr_delta_vs_non_ash_db",
        "mean_y_psnr_delta_vs_conventional_db",
        "mean_ms_ssim_delta_vs_conventional",
        "maximum_ringing_excursion",
        "maximum_ringing_increase",
        "maximum_alias_ratio",
        "maximum_alias_increase",
        "maximum_chroma_displacement_pixels",
        "maximum_chroma_displacement_increase_pixels",
        "minimum_per_asset_y_psnr_delta_db",
        "category_mean_y_psnr_deltas_db",
        "category_source_family_counts",
        "bootstraps",
        "estimated_dispatch_cost"
      ],
      "properties": {
        "mean_y_psnr_delta_vs_fixed_db": {"type": "number"},
        "mean_y_psnr_delta_vs_non_ash_db": {"type": "number"},
        "mean_y_psnr_delta_vs_conventional_db": {"type": "number"},
        "mean_ms_ssim_delta_vs_conventional": {"type": "number"},
        "maximum_ringing_excursion": {"type": "number"},
        "maximum_ringing_increase": {"type": "number"},
        "maximum_alias_ratio": {"type": "number"},
        "maximum_alias_increase": {"type": "number"},
        "maximum_chroma_displacement_pixels": {"type": "number"},
        "maximum_chroma_displacement_increase_pixels": {"type": "number"},
        "minimum_per_asset_y_psnr_delta_db": {"type": "number"},
        "category_mean_y_psnr_deltas_db": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": {"type": "number"}
        },
        "category_source_family_counts": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": {"type": "integer", "minimum": 1}
        },
        "bootstraps": {
          "type": "object",
          "required": [
            "y_vs_fixed",
            "y_vs_non_ash",
            "y_vs_conventional",
            "ms_ssim_vs_conventional",
            "y_vs_state_only",
            "h07_direct_vs_control",
            "h07_ms_ssim_direct_vs_control"
          ],
          "properties": {
            "y_vs_fixed": {"$ref": "#/$defs/bootstrap"},
            "y_vs_non_ash": {"$ref": "#/$defs/bootstrap"},
            "y_vs_conventional": {"$ref": "#/$defs/bootstrap"},
            "ms_ssim_vs_conventional": {"$ref": "#/$defs/bootstrap"},
            "y_vs_state_only": {"$ref": "#/$defs/bootstrap"},
            "h07_direct_vs_control": {"$ref": "#/$defs/bootstrap"},
            "h07_ms_ssim_direct_vs_control": {"$ref": "#/$defs/bootstrap"}
          },
          "additionalProperties": false
        },
        "estimated_dispatch_cost": {"type": "number", "minimum": 0}
      },
      "additionalProperties": false
    },
    "domainSummaries": {
      "type": "object",
      "required": ["engine_raw", "container_decoded"],
      "properties": {
        "engine_raw": {"$ref": "#/$defs/summary"},
        "container_decoded": {"$ref": "#/$defs/summary"}
      },
      "additionalProperties": false
    },
    "dispatchBudget": {
      "type": "object",
      "required": [
        "measurement_method",
        "shared_bank_configuration_sha256",
        "full_ash_configuration_sha256",
        "measured_validation_p95_percent",
        "uncertainty_margin_percentage_points",
        "derived_budget_percent",
        "measurement_run_ids",
        "measurement_artifact_sha256_values",
        "measurement_evidence_bindings",
        "derivation_formula",
        "locked_before_g08",
        "post_g08_adjustment_allowed",
        "measurement_records"
      ],
      "properties": {
        "measurement_method": {"const": "native-cpu-reference-precomputed-dispatch-control-p95-v1"},
        "shared_bank_configuration_sha256": {"$ref": "#/$defs/sha256"},
        "full_ash_configuration_sha256": {"$ref": "#/$defs/sha256"},
        "measured_validation_p95_percent": {"type": "number", "minimum": 0},
        "uncertainty_margin_percentage_points": {"const": 5.0},
        "derived_budget_percent": {"type": "integer", "minimum": 5, "maximum": 25},
        "measurement_run_ids": {
          "type": "array",
          "minItems": 1,
          "maxItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "measurement_artifact_sha256_values": {"$ref": "#/$defs/nonemptyHashes"},
        "measurement_evidence_bindings": {
          "type": "array",
          "minItems": 1,
          "maxItems": 1,
          "items": {
            "type": "object",
            "required": ["path", "sha256", "size_bytes"],
            "properties": {
              "path": {"type": "string", "pattern": "^[a-zA-Z0-9._/-]+\\.json$"},
              "sha256": {"$ref": "#/$defs/sha256"},
              "size_bytes": {"type": "integer", "minimum": 1}
            },
            "additionalProperties": false
          }
        },
        "derivation_formula": {"const": "max(5, ceil(measured_validation_p95_percent + 5))"},
        "locked_before_g08": {"const": true},
        "post_g08_adjustment_allowed": {"const": false}
        ,
        "measurement_records": {"type": "array", "minItems": 1, "maxItems": 1, "items": {"type": "object"}}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
