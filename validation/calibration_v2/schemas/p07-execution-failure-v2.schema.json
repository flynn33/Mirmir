{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mirmir.local/validation/calibration-v2/p07-execution-failure-v2.schema.json",
  "type": "object",
  "required": [
    "schema_version", "artifact_kind", "p06_v2_identity", "status",
    "configuration_id", "configuration_sha256", "release_bundle_manifest_sha256",
    "input_bundle_sha256", "direct_input_bindings", "corpus_lock_bundle_sha256",
    "sampling_plan_file_sha256", "sampling_plan_manifest_sha256",
    "no_pixel_attestation_file_sha256", "outer_wrapper_file_sha256",
    "outer_wrapper_manifest_sha256", "loader_executable_sha256",
    "authorized_execution_bindings_file_sha256",
    "authorized_execution_bindings_manifest_sha256", "p07_preopen_cache_tree_sha256",
    "failure_type", "failure_message", "failure_message_sha256",
    "failure_traceback", "failure_traceback_sha256", "secondary_failure",
    "archive_publication_failure", "failure_log_file_sha256", "failure_stage",
    "transaction_state", "cleanup_result", "media_asset_id", "media_case_id",
    "frame_index", "presentation_timestamp", "media_context_available",
    "requested_output_directory", "temporary_run_path", "command", "platform",
    "holdout_access_consumed", "holdout_access_state", "holdout_access_evidence_source",
    "holdout_access_ledger_file_sha256", "holdout_access_ledger_tip_sha256",
    "holdout_access_ledger_event_count", "holdout_access_ledger_event_order",
    "holdout_access_configuration_sha256", "holdout_access_immutable_anchor_file_sha256",
    "holdout_access_open_intent_linked", "holdout_access_ledger_verification_error_sha256",
    "result_reusable_for_same_version", "manifest_sha256"
  ],
  "properties": {
    "schema_version": {"const": "2.0.0"},
    "artifact_kind": {"const": "p07_execution_failure_archive_v2"},
    "p06_v2_identity": {"$ref": "#/$defs/p06Identity"},
    "status": {"const": "failed"},
    "configuration_id": {"type": "string", "minLength": 1},
    "configuration_sha256": {"$ref": "#/$defs/sha256"},
    "release_bundle_manifest_sha256": {"$ref": "#/$defs/sha256"},
    "input_bundle_sha256": {"$ref": "#/$defs/sha256"},
    "direct_input_bindings": {"type": "array"},
    "corpus_lock_bundle_sha256": {"$ref": "#/$defs/sha256"},
    "sampling_plan_file_sha256": {"$ref": "#/$defs/sha256"},
    "sampling_plan_manifest_sha256": {"$ref": "#/$defs/sha256"},
    "no_pixel_attestation_file_sha256": {"$ref": "#/$defs/sha256"},
    "outer_wrapper_file_sha256": {"$ref": "#/$defs/sha256"},
    "outer_wrapper_manifest_sha256": {"$ref": "#/$defs/sha256"},
    "loader_executable_sha256": {"$ref": "#/$defs/sha256"},
    "authorized_execution_bindings_file_sha256": {"$ref": "#/$defs/sha256"},
    "authorized_execution_bindings_manifest_sha256": {"$ref": "#/$defs/sha256"},
    "p07_preopen_cache_tree_sha256": {"$ref": "#/$defs/sha256"},
    "failure_type": {"type": "string", "minLength": 1},
    "failure_message": {"type": "string"},
    "failure_message_sha256": {"$ref": "#/$defs/sha256"},
    "failure_traceback": {"type": "string"},
    "failure_traceback_sha256": {"$ref": "#/$defs/sha256"},
    "secondary_failure": {"type": ["object", "null"]},
    "archive_publication_failure": {"type": ["object", "null"]},
    "failure_log_file_sha256": {"$ref": "#/$defs/sha256"},
    "failure_stage": {"enum": ["pre_guard_validation", "guard_or_authorized_execution", "post_guard_publication", "restart_recovery"]},
    "transaction_state": {"type": "object"},
    "cleanup_result": {"type": "object"},
    "media_asset_id": {"type": ["string", "null"]},
    "media_case_id": {"type": ["string", "null"]},
    "frame_index": {"type": ["integer", "null"], "minimum": 0},
    "presentation_timestamp": {"type": ["object", "null"]},
    "media_context_available": {"type": "boolean"},
    "requested_output_directory": {"type": "string", "minLength": 1},
    "temporary_run_path": {"type": ["string", "null"]},
    "command": {"type": "string", "minLength": 1},
    "platform": {"type": "string", "minLength": 1},
    "holdout_access_consumed": {"type": ["boolean", "null"]},
    "holdout_access_state": {"enum": ["sealed", "anchor_only", "intent_recorded", "opened", "completed", "failed", "unavailable"]},
    "holdout_access_evidence_source": {"enum": ["live_guard_ledger", "anchor_only_guard_evidence", "guard_return", "pre_guard_validation", "unavailable"]},
    "holdout_access_ledger_file_sha256": {"$ref": "#/$defs/nullableSha256"},
    "holdout_access_ledger_tip_sha256": {"$ref": "#/$defs/nullableSha256"},
    "holdout_access_ledger_event_count": {"type": ["integer", "null"], "minimum": 0},
    "holdout_access_ledger_event_order": {"type": ["array", "null"]},
    "holdout_access_configuration_sha256": {"$ref": "#/$defs/nullableSha256"},
    "holdout_access_immutable_anchor_file_sha256": {"$ref": "#/$defs/nullableSha256"},
    "holdout_access_open_intent_linked": {"type": ["boolean", "null"]},
    "holdout_access_ledger_verification_error_sha256": {"$ref": "#/$defs/nullableSha256"},
    "result_reusable_for_same_version": {"const": false},
    "manifest_sha256": {"$ref": "#/$defs/sha256"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^(?!0{64}$)[0-9a-f]{64}$"},
    "nullableSha256": {"oneOf": [{"$ref": "#/$defs/sha256"}, {"type": "null"}]},
    "p06Identity": {
      "type": "object", "minProperties": 8, "maxProperties": 8,
      "required": [
        "calibration_plan_v2_file_sha256", "candidate_vector_sha256",
        "shared_bank_configuration_sha256", "input_bundle_sha256",
        "p06_release_bundle_artifact_sha256", "selected_evaluation_file_sha256",
        "selected_evaluation_artifact_sha256", "selected_evaluation_semantic_sha256"
      ],
      "properties": {
        "calibration_plan_v2_file_sha256": {"$ref": "#/$defs/sha256"},
        "candidate_vector_sha256": {"$ref": "#/$defs/sha256"},
        "shared_bank_configuration_sha256": {"$ref": "#/$defs/sha256"},
        "input_bundle_sha256": {"$ref": "#/$defs/sha256"},
        "p06_release_bundle_artifact_sha256": {"$ref": "#/$defs/sha256"},
        "selected_evaluation_file_sha256": {"$ref": "#/$defs/sha256"},
        "selected_evaluation_artifact_sha256": {"$ref": "#/$defs/sha256"},
        "selected_evaluation_semantic_sha256": {"$ref": "#/$defs/sha256"}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
