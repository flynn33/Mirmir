{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mirmir.local/validation/calibration-v2/native-parity-manifest-v1.schema.json",
  "type": "object",
  "required": [
    "schema_version",
    "manifest_id",
    "status",
    "conflict_record",
    "input_hashes",
    "implementations",
    "routes",
    "all_routes_byte_identical",
    "canonicalization"
  ],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "manifest_id": {"const": "mirmir-native-lut-parity-v1"},
    "status": {"const": "pass"},
    "conflict_record": {"type": "string", "minLength": 1},
    "input_hashes": {
      "type": "object",
      "required": [
        "mapping_sha256",
        "operator_bank_sha256",
        "metric_policy_sha256",
        "compiler_inputs_sha256",
        "calibration_plan_sha256",
        "corpus_lock_bundle_sha256"
      ],
      "properties": {
        "mapping_sha256": {"$ref": "#/$defs/nonzeroSha256"},
        "operator_bank_sha256": {"$ref": "#/$defs/nonzeroSha256"},
        "metric_policy_sha256": {"$ref": "#/$defs/nonzeroSha256"},
        "compiler_inputs_sha256": {"$ref": "#/$defs/nonzeroSha256"},
        "calibration_plan_sha256": {"$ref": "#/$defs/nonzeroSha256"},
        "corpus_lock_bundle_sha256": {"$ref": "#/$defs/nonzeroSha256"}
      },
      "additionalProperties": false
    },
    "implementations": {
      "type": "object",
      "required": ["production_swift", "independent_test_python"],
      "properties": {
        "production_swift": {"$ref": "#/$defs/implementation"},
        "independent_test_python": {"$ref": "#/$defs/implementation"}
      },
      "additionalProperties": false
    },
    "routes": {
      "type": "array",
      "prefixItems": [
        {"$ref": "#/$defs/direct2xComparison"},
        {"$ref": "#/$defs/direct3Over2Comparison"}
      ],
      "items": false
    },
    "all_routes_byte_identical": {"const": true},
    "canonicalization": {"const": "sorted-key compact UTF-8 JSON with a trailing newline"}
  },
  "additionalProperties": false,
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "nonzeroSha256": {
      "type": "string",
      "pattern": "^(?!0{64}$)[0-9a-f]{64}$"
    },
    "safeRelativePath": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?!.*\\\\)(?!.*//)(?!.*(?:^|/)\\.\\.?(?:/|$))[^\\u0000]+$"
    },
    "crc32": {"type": "string", "pattern": "^0x[0-9A-F]{8}$"},
    "implementation": {
      "type": "object",
      "required": [
        "implementation_id",
        "implementation_version",
        "source_manifest_path",
        "source_manifest_sha256",
        "source_manifest_size_bytes",
        "independence_attested"
      ],
      "properties": {
        "implementation_id": {"type": "string", "minLength": 1},
        "implementation_version": {"type": "string", "minLength": 1},
        "source_manifest_path": {"$ref": "#/$defs/safeRelativePath"},
        "source_manifest_sha256": {"$ref": "#/$defs/nonzeroSha256"},
        "source_manifest_size_bytes": {"type": "integer", "minimum": 1},
        "independence_attested": {"const": true}
      },
      "additionalProperties": false
    },
    "output": {
      "type": "object",
      "required": [
        "path",
        "whole_file_size_bytes",
        "whole_file_sha256",
        "payload_sha256",
        "header_crc32",
        "payload_crc32",
        "entry_count",
        "parameter_count"
      ],
      "properties": {
        "path": {"$ref": "#/$defs/safeRelativePath"},
        "whole_file_size_bytes": {"type": "integer", "minimum": 1},
        "whole_file_sha256": {"$ref": "#/$defs/nonzeroSha256"},
        "payload_sha256": {"$ref": "#/$defs/nonzeroSha256"},
        "header_crc32": {"$ref": "#/$defs/crc32"},
        "payload_crc32": {"$ref": "#/$defs/crc32"},
        "entry_count": {"type": "integer", "minimum": 1},
        "parameter_count": {"type": "integer", "minimum": 1}
      },
      "additionalProperties": false
    },
    "comparisonBase": {
      "type": "object",
      "required": [
        "route",
        "route_id",
        "expected_entry_count",
        "production_swift",
        "independent_test_python",
        "byte_identical",
        "payload_hash_identical",
        "first_differing_byte_offset"
      ],
      "properties": {
        "route": {"enum": ["direct_2x", "direct_3_over_2"]},
        "route_id": {"enum": [1, 2]},
        "expected_entry_count": {"enum": [4096, 9216]},
        "production_swift": {"$ref": "#/$defs/output"},
        "independent_test_python": {"$ref": "#/$defs/output"},
        "byte_identical": {"const": true},
        "payload_hash_identical": {"const": true},
        "first_differing_byte_offset": {"type": "null"}
      },
      "additionalProperties": false
    },
    "direct2xComparison": {
      "allOf": [
        {"$ref": "#/$defs/comparisonBase"},
        {
          "type": "object",
          "properties": {
            "route": {"const": "direct_2x"},
            "route_id": {"const": 1},
            "expected_entry_count": {"const": 4096},
            "production_swift": {
              "allOf": [
                {"$ref": "#/$defs/output"},
                {"type": "object", "properties": {"entry_count": {"const": 4096}}}
              ]
            },
            "independent_test_python": {
              "allOf": [
                {"$ref": "#/$defs/output"},
                {"type": "object", "properties": {"entry_count": {"const": 4096}}}
              ]
            }
          }
        }
      ]
    },
    "direct3Over2Comparison": {
      "allOf": [
        {"$ref": "#/$defs/comparisonBase"},
        {
          "type": "object",
          "properties": {
            "route": {"const": "direct_3_over_2"},
            "route_id": {"const": 2},
            "expected_entry_count": {"const": 9216},
            "production_swift": {
              "allOf": [
                {"$ref": "#/$defs/output"},
                {"type": "object", "properties": {"entry_count": {"const": 9216}}}
              ]
            },
            "independent_test_python": {
              "allOf": [
                {"$ref": "#/$defs/output"},
                {"type": "object", "properties": {"entry_count": {"const": 9216}}}
              ]
            }
          }
        }
      ]
    }
  }
}
