{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mirmir.local/validation/calibration-v2/validation-candidate-development-evidence-v1.schema.json",
  "type": "object",
  "required": ["schema_version", "artifact_kind", "development_terminal_vector_sha256", "neighbor_evidence", "validation_candidate_vector_sha256_values", "validation_accessed_while_building", "manifest_sha256"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "artifact_kind": {"const": "p06_validation_candidate_development_evidence"},
    "development_terminal_vector_sha256": {"$ref": "#/$defs/sha256"},
    "neighbor_evidence": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["candidate_vector_sha256", "development_feasible", "development_summary_sha256", "development_evaluation"],
        "properties": {
          "candidate_vector_sha256": {"$ref": "#/$defs/sha256"},
          "development_feasible": {"type": "boolean"},
          "development_summary_sha256": {"$ref": "#/$defs/sha256"},
          "development_evaluation": {"$ref": "#/$defs/evaluationBinding"}
        },
        "additionalProperties": false
      }
    },
    "validation_candidate_vector_sha256_values": {
      "type": "array", "minItems": 1, "uniqueItems": true,
      "items": {"$ref": "#/$defs/sha256"}
    },
    "validation_accessed_while_building": {"const": false},
    "manifest_sha256": {"$ref": "#/$defs/sha256"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "evaluationBinding": {
      "type": "object",
      "required": ["path", "sha256", "size_bytes"],
      "properties": {
        "path": {"type": "string", "pattern": "^evaluations/[0-9a-f]{64}\\.json$"},
        "sha256": {"$ref": "#/$defs/sha256"},
        "size_bytes": {"type": "integer", "minimum": 1}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
