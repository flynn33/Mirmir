{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mirmir.local/validation/calibration-v2/preexecution-contract-corrections-v1.schema.json",
  "type": "object",
  "required": [
    "schema_version",
    "artifact_kind",
    "status",
    "corrections",
    "validation_commands",
    "manifest_sha256"
  ],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "artifact_kind": {"const": "p06_preexecution_contract_corrections"},
    "status": {"const": "closed_before_calibration_execution"},
    "corrections": {
      "type": "array",
      "minItems": 7,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/correction"}
    },
    "validation_commands": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/commandEvidence"}
    },
    "manifest_sha256": {"$ref": "#/$defs/sha256"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "fileHash": {
      "type": "object",
      "required": ["path", "sha256"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "sha256": {"$ref": "#/$defs/sha256"}
      },
      "additionalProperties": false
    },
    "commandEvidence": {
      "type": "object",
      "required": ["command", "expected", "observed", "output_summary_sha256"],
      "properties": {
        "command": {"type": "string", "minLength": 1},
        "expected": {"type": "string", "minLength": 1},
        "observed": {"type": "string", "minLength": 1},
        "output_summary_sha256": {"$ref": "#/$defs/sha256"}
      },
      "additionalProperties": false
    },
    "correction": {
      "type": "object",
      "required": [
        "correction_id",
        "failure_category",
        "observation",
        "observation_sha256",
        "affected_paths",
        "before_file_sha256_values",
        "unavailable_before_hash_reason",
        "correction",
        "after_file_sha256_values",
        "verification"
      ],
      "properties": {
        "correction_id": {"type": "string", "pattern": "^P06-C[0-9]{2}$"},
        "failure_category": {"type": "string", "minLength": 1},
        "observation": {"type": "string", "minLength": 1},
        "observation_sha256": {"$ref": "#/$defs/sha256"},
        "affected_paths": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "before_file_sha256_values": {
          "type": "array",
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/fileHash"}
        },
        "unavailable_before_hash_reason": {"type": ["string", "null"], "minLength": 1},
        "correction": {"type": "string", "minLength": 1},
        "after_file_sha256_values": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/fileHash"}
        },
        "verification": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/commandEvidence"}
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
