{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mirmir.local/validation/calibration-v2/candidate-lut-runtime-manifest-v1.schema.json",
  "title": "P06 calibration-candidate native LUT runtime manifest",
  "type": "object",
  "required": [
    "schema_version",
    "manifest_id",
    "status",
    "configuration_id",
    "compiler_input",
    "hash_bindings",
    "routes",
    "swift_cli",
    "native_parity_claimed",
    "manifest_sha256"
  ],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "manifest_id": {"const": "mirmir-ash-candidate-route-luts-v1"},
    "status": {"const": "calibration_candidate"},
    "configuration_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]{2,127}$"
    },
    "compiler_input": {
      "allOf": [
        {"$ref": "#/$defs/fileBinding"},
        {"type": "object", "properties": {"path": {"const": "locked-compiler-input.json"}}}
      ]
    },
    "hash_bindings": {"$ref": "#/$defs/hashBindings"},
    "routes": {
      "type": "array",
      "prefixItems": [
        {"$ref": "#/$defs/direct2x"},
        {"$ref": "#/$defs/direct3Over2"}
      ],
      "items": false
    },
    "swift_cli": {
      "type": "object",
      "required": ["executable_sha256", "source_manifest_sha256"],
      "properties": {
        "executable_sha256": {"$ref": "#/$defs/nonzeroSha256"},
        "source_manifest_sha256": {"$ref": "#/$defs/nonzeroSha256"}
      },
      "additionalProperties": false
    },
    "native_parity_claimed": {"const": false},
    "manifest_sha256": {"$ref": "#/$defs/nonzeroSha256"}
  },
  "additionalProperties": false,
  "$defs": {
    "nonzeroSha256": {
      "type": "string",
      "pattern": "^(?!0{64}$)[0-9a-f]{64}$"
    },
    "crc32": {"type": "string", "pattern": "^0x[0-9A-F]{8}$"},
    "fileBinding": {
      "type": "object",
      "required": ["path", "sha256", "size_bytes"],
      "properties": {
        "path": {"type": "string", "pattern": "^(?!/)(?!.*\\\\)(?!.*//)(?!.*(?:^|/)\\.\\.?(?:/|$))[^\\u0000]+$"},
        "sha256": {"$ref": "#/$defs/nonzeroSha256"},
        "size_bytes": {"type": "integer", "minimum": 1}
      },
      "additionalProperties": false
    },
    "hashBindings": {
      "type": "object",
      "required": [
        "mapping_sha256",
        "operator_bank_sha256",
        "metric_policy_sha256",
        "compiler_inputs_sha256",
        "calibration_plan_sha256",
        "corpus_lock_bundle_sha256"
      ],
      "properties": {
        "mapping_sha256": {"$ref": "#/$defs/nonzeroSha256"},
        "operator_bank_sha256": {"$ref": "#/$defs/nonzeroSha256"},
        "metric_policy_sha256": {"$ref": "#/$defs/nonzeroSha256"},
        "compiler_inputs_sha256": {"$ref": "#/$defs/nonzeroSha256"},
        "calibration_plan_sha256": {"$ref": "#/$defs/nonzeroSha256"},
        "corpus_lock_bundle_sha256": {"$ref": "#/$defs/nonzeroSha256"}
      },
      "additionalProperties": false
    },
    "routeBase": {
      "type": "object",
      "required": [
        "route", "route_id", "scale_numerator", "scale_denominator",
        "phase_count", "context_count", "valid_state_count",
        "luma_coordinate_policy", "chroma_coordinate_policy",
        "analysis_grid_source_step", "entry_count", "parameter_count", "path",
        "whole_file_size_bytes", "whole_file_sha256", "payload_sha256",
        "header_crc32", "payload_crc32"
      ],
      "properties": {
        "route": {"enum": ["direct_2x", "direct_3_over_2"]},
        "route_id": {"enum": [1, 2]},
        "scale_numerator": {"enum": [2, 3]},
        "scale_denominator": {"enum": [1, 2]},
        "phase_count": {"enum": [4, 9]},
        "context_count": {"const": 4},
        "valid_state_count": {"const": 256},
        "luma_coordinate_policy": {"enum": ["source_aligned_rational", "half_pixel_center"]},
        "chroma_coordinate_policy": {"enum": ["source_aligned_rational", "half_pixel_center"]},
        "analysis_grid_source_step": {"enum": [1, 2, 4]},
        "entry_count": {"enum": [4096, 9216]},
        "parameter_count": {"type": "integer", "minimum": 1},
        "path": {"enum": ["direct2x.ashlut", "direct3over2.ashlut"]},
        "whole_file_size_bytes": {"type": "integer", "minimum": 1},
        "whole_file_sha256": {"$ref": "#/$defs/nonzeroSha256"},
        "payload_sha256": {"$ref": "#/$defs/nonzeroSha256"},
        "header_crc32": {"$ref": "#/$defs/crc32"},
        "payload_crc32": {"$ref": "#/$defs/crc32"}
      },
      "additionalProperties": false
    },
    "direct2x": {
      "allOf": [
        {"$ref": "#/$defs/routeBase"},
        {"type": "object", "properties": {
          "route": {"const": "direct_2x"}, "route_id": {"const": 1},
          "scale_numerator": {"const": 2}, "scale_denominator": {"const": 1},
          "phase_count": {"const": 4}, "entry_count": {"const": 4096},
          "path": {"const": "direct2x.ashlut"}
        }}
      ]
    },
    "direct3Over2": {
      "allOf": [
        {"$ref": "#/$defs/routeBase"},
        {"type": "object", "properties": {
          "route": {"const": "direct_3_over_2"}, "route_id": {"const": 2},
          "scale_numerator": {"const": 3}, "scale_denominator": {"const": 2},
          "phase_count": {"const": 9}, "entry_count": {"const": 9216},
          "path": {"const": "direct3over2.ashlut"}
        }}
      ]
    }
  }
}
