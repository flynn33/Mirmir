{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mirmir.local/validation/calibration-v2/p08-common-v1.schema.json",
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^(?!0{64}$)[0-9a-f]{64}$"
    },
    "sourceCommit": {
      "type": "string",
      "pattern": "^(?!0{40}$)[0-9a-f]{40}$"
    },
    "safeRelativePath": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.?/)(?!.*\\\\)[^\\u0000]+$"
    },
    "fileBinding": {
      "type": "object",
      "required": ["path", "sha256", "size_bytes"],
      "properties": {
        "path": {"$ref": "#/$defs/safeRelativePath"},
        "sha256": {"$ref": "#/$defs/sha256"},
        "size_bytes": {"type": "integer", "minimum": 1}
      },
      "additionalProperties": false
    },
    "treeBinding": {
      "type": "object",
      "required": [
        "path", "tree_sha256", "file_count", "directory_count",
        "total_size_bytes", "hash_scope"
      ],
      "properties": {
        "path": {"$ref": "#/$defs/safeRelativePath"},
        "tree_sha256": {"$ref": "#/$defs/sha256"},
        "file_count": {"type": "integer", "minimum": 1},
        "directory_count": {"type": "integer", "minimum": 0},
        "total_size_bytes": {"type": "integer", "minimum": 1},
        "hash_scope": {
          "const": "SHA-256 of canonical sorted-key compact UTF-8 JSON array of ascending relative directory/file records; files bind path, size_bytes, and SHA-256"
        }
      },
      "additionalProperties": false
    },
    "device": {
      "type": "object",
      "required": [
        "platform", "hardware_model", "os_version", "os_build",
        "metal_device_name", "metal_registry_id", "metal_low_power",
        "metal_removable", "metal_unified_memory"
      ],
      "properties": {
        "platform": {"const": "macOS"},
        "hardware_model": {"type": "string", "minLength": 1},
        "os_version": {"type": "string", "minLength": 1},
        "os_build": {"type": "string", "minLength": 1},
        "metal_device_name": {"type": "string", "minLength": 1},
        "metal_registry_id": {"type": "string", "pattern": "^[1-9][0-9]*$"},
        "metal_low_power": {"type": "boolean"},
        "metal_removable": {"type": "boolean"},
        "metal_unified_memory": {"type": "boolean"}
      },
      "additionalProperties": false
    },
    "dispatchBudget": {
      "type": "object",
      "required": [
        "measured_validation_p95_percent",
        "uncertainty_margin_percentage_points", "derived_budget_percent",
        "measurement_run_ids", "measurement_artifact_sha256_values",
        "derivation_formula", "locked_before_g08",
        "post_g08_adjustment_allowed"
      ],
      "properties": {
        "measured_validation_p95_percent": {
          "type": "number", "minimum": 0, "maximum": 20
        },
        "uncertainty_margin_percentage_points": {"const": 5.0},
        "derived_budget_percent": {
          "type": "integer", "minimum": 5, "maximum": 25
        },
        "measurement_run_ids": {
          "type": "array", "minItems": 1, "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "measurement_artifact_sha256_values": {
          "type": "array", "minItems": 1, "uniqueItems": true,
          "items": {"$ref": "#/$defs/sha256"}
        },
        "derivation_formula": {
          "const": "max(5, ceil(measured_validation_p95_percent + 5))"
        },
        "locked_before_g08": {"const": true},
        "post_g08_adjustment_allowed": {"const": false}
      },
      "additionalProperties": false
    },
    "identity": {
      "type": "object",
      "required": [
        "run_id", "source_commit", "source_tree_sha256",
        "configuration_id", "p06_release_bundle",
        "selected_evaluation_file", "selected_evaluation_artifact_sha256",
        "g07_publication", "pre_g07_seal", "pre_g07_native_measurements",
        "metric_tolerances_file_sha256",
        "locked_metric_policy", "production_app_bundle", "production_executable",
        "metal_library", "bundled_release_resources", "route_lut_files",
        "device", "device_identity_sha256"
      ],
      "properties": {
        "run_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
        },
        "source_commit": {"$ref": "#/$defs/sourceCommit"},
        "source_tree_sha256": {"$ref": "#/$defs/sha256"},
        "configuration_id": {
          "type": "string", "pattern": "^ash-p06-[0-9a-f]{24}$"
        },
        "p06_release_bundle": {
          "type": "object",
          "required": ["file", "artifact_sha256"],
          "properties": {
            "file": {"$ref": "#/$defs/fileBinding"},
            "artifact_sha256": {"$ref": "#/$defs/sha256"}
          },
          "additionalProperties": false
        },
        "selected_evaluation_file": {"$ref": "#/$defs/fileBinding"},
        "selected_evaluation_artifact_sha256": {"$ref": "#/$defs/sha256"},
        "g07_publication": {
          "type": "object",
          "required": ["file", "manifest_sha256"],
          "properties": {
            "file": {"$ref": "#/$defs/fileBinding"},
            "manifest_sha256": {"$ref": "#/$defs/sha256"}
          },
          "additionalProperties": false
        },
        "pre_g07_seal": {
          "type": "object",
          "required": ["file", "artifact_sha256"],
          "properties": {
            "file": {"$ref": "#/$defs/fileBinding"},
            "artifact_sha256": {"$ref": "#/$defs/sha256"}
          },
          "additionalProperties": false
        },
        "pre_g07_native_measurements": {
          "type": "object",
          "required": ["file", "artifact_sha256"],
          "properties": {
            "file": {"$ref": "#/$defs/fileBinding"},
            "artifact_sha256": {"$ref": "#/$defs/sha256"}
          },
          "additionalProperties": false
        },
        "metric_tolerances_file_sha256": {"$ref": "#/$defs/sha256"},
        "locked_metric_policy": {
          "type": "object",
          "required": ["file", "policy_sha256", "dispatch_overhead_budget"],
          "properties": {
            "file": {"$ref": "#/$defs/fileBinding"},
            "policy_sha256": {"$ref": "#/$defs/sha256"},
            "dispatch_overhead_budget": {"$ref": "#/$defs/dispatchBudget"}
          },
          "additionalProperties": false
        },
        "production_app_bundle": {"$ref": "#/$defs/treeBinding"},
        "production_executable": {"$ref": "#/$defs/fileBinding"},
        "metal_library": {"$ref": "#/$defs/fileBinding"},
        "bundled_release_resources": {
          "type": "object",
          "required": [
            "root", "lut_manifest_v3", "locked_compiler_input_v2",
            "locked_mapping", "direct2x_lut", "direct3over2_lut",
            "native_lut_parity_manifest_v3"
          ],
          "properties": {
            "root": {"$ref": "#/$defs/treeBinding"},
            "lut_manifest_v3": {"$ref": "#/$defs/fileBinding"},
            "locked_compiler_input_v2": {"$ref": "#/$defs/fileBinding"},
            "locked_mapping": {"$ref": "#/$defs/fileBinding"},
            "direct2x_lut": {"$ref": "#/$defs/fileBinding"},
            "direct3over2_lut": {"$ref": "#/$defs/fileBinding"},
            "native_lut_parity_manifest_v3": {"$ref": "#/$defs/fileBinding"}
          },
          "additionalProperties": false
        },
        "route_lut_files": {
          "type": "object",
          "required": ["direct_2x", "direct_3_over_2"],
          "properties": {
            "direct_2x": {"$ref": "#/$defs/fileBinding"},
            "direct_3_over_2": {"$ref": "#/$defs/fileBinding"}
          },
          "additionalProperties": false
        },
        "device": {"$ref": "#/$defs/device"},
        "device_identity_sha256": {"$ref": "#/$defs/sha256"}
      },
      "additionalProperties": false
    },
    "evidenceBinding": {
      "type": "object",
      "required": ["id", "path", "sha256", "size_bytes", "artifact_sha256"],
      "properties": {
        "id": {
          "enum": [
            "metal_parity", "performance_results", "resource_ring_results",
            "instruments_manifest", "gpu_capture_manifest"
          ]
        },
        "path": {"$ref": "#/$defs/safeRelativePath"},
        "sha256": {"$ref": "#/$defs/sha256"},
        "size_bytes": {"type": "integer", "minimum": 1},
        "artifact_sha256": {"$ref": "#/$defs/sha256"}
      },
      "additionalProperties": false
    }
  }
}
