{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mirmir.local/validation/calibration-v2/corrective-diagnostic-envelope-v1.schema.json",
  "type": "object",
  "required": [
    "schema_version",
    "artifact_kind",
    "status",
    "split",
    "validation_accessed",
    "holdout_accessed",
    "selected_winner",
    "coordinate_anisotropy_artifact",
    "risk_state_artifact",
    "envelope_sha256"
  ],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "artifact_kind": {"const": "p06_open_development_corrective_diagnostic_envelope"},
    "status": {"const": "development_diagnostic_no_selection"},
    "split": {"const": "development"},
    "validation_accessed": {"const": false},
    "holdout_accessed": {"const": false},
    "selected_winner": {"type": "null"},
    "coordinate_anisotropy_artifact": {"$ref": "#/$defs/artifactBinding"},
    "risk_state_artifact": {"$ref": "#/$defs/artifactBinding"},
    "envelope_sha256": {"$ref": "#/$defs/sha256"}
  },
  "additionalProperties": false,
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "artifactBinding": {
      "type": "object",
      "required": ["artifact_sha256", "file_sha256", "size_bytes"],
      "properties": {
        "artifact_sha256": {"$ref": "#/$defs/sha256"},
        "file_sha256": {"$ref": "#/$defs/sha256"},
        "size_bytes": {"type": "integer", "minimum": 1}
      },
      "additionalProperties": false
    }
  }
}
