{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mirmir.local/validation/calibration-v2/live-holdout-preopen-receipt-v1.schema.json",
  "type": "object",
  "required": [
    "schema_version",
    "artifact_kind",
    "version_id",
    "created_utc",
    "state",
    "access_count",
    "open_intent_anchor_present",
    "pixel_content_included",
    "corpus_manifest_sha256",
    "live_ledger_sha256",
    "live_ledger_root_identity_sha256",
    "live_anchor_root_identity_sha256",
    "repository_sealed_copy_sha256",
    "repository_attestation_sha256",
    "persistence",
    "threat_boundary",
    "hash_scope",
    "receipt_sha256"
  ],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "artifact_kind": {"const": "live_holdout_preopen_receipt"},
    "version_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$"
    },
    "created_utc": {"type": "string", "format": "date-time"},
    "state": {"const": "sealed"},
    "access_count": {"const": 0},
    "open_intent_anchor_present": {"const": false},
    "pixel_content_included": {"const": false},
    "corpus_manifest_sha256": {"$ref": "#/$defs/sha256"},
    "live_ledger_sha256": {"$ref": "#/$defs/sha256"},
    "live_ledger_root_identity_sha256": {"$ref": "#/$defs/sha256"},
    "live_anchor_root_identity_sha256": {"$ref": "#/$defs/sha256"},
    "repository_sealed_copy_sha256": {"$ref": "#/$defs/sha256"},
    "repository_attestation_sha256": {"$ref": "#/$defs/sha256"},
    "persistence": {"const": "macos-user-immutable-v1"},
    "threat_boundary": {
      "const": "cooperating-processes-v1; deliberate owner-or-administrator flag clearing, direct media access, code bypass, and filesystem rollback are outside scope"
    },
    "hash_scope": {"const": "canonical document excluding receipt_sha256"},
    "receipt_sha256": {"$ref": "#/$defs/sha256"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  },
  "additionalProperties": false
}
