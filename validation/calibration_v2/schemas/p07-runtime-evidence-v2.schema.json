{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mirmir.local/validation/calibration-v2/p07-runtime-evidence-v2.schema.json",
  "type": "object",
  "required": [
    "schema_version", "artifact_kind", "p06_v2_identity", "status",
    "configuration_sha256", "p06_release_bundle_manifest_sha256",
    "release_native_executable_sha256", "release_native_source_manifest_sha256",
    "release_lut_manifest_sha256", "release_lut_independent_recompile",
    "sampling_plan_manifest_sha256", "frame_extraction_manifest_sha256",
    "measurement_core_sha256", "preopen_cache_snapshot_before",
    "preopen_cache_snapshot_after", "preopen_cache_unchanged",
    "loader_preopen_verification", "p00_continuity_evidence",
    "analytic_preopen_evidence", "corpus_case_evidence",
    "persistent_holdout_binary_artifact_count", "temporary_binary_artifacts_published",
    "holdout_accessed", "configuration_files_modified_after_holdout", "manifest_sha256"
  ],
  "properties": {
    "schema_version": {"const": "2.0.0"},
    "artifact_kind": {"const": "p07_runtime_evidence_v2"},
    "p06_v2_identity": {"$ref": "#/$defs/p06Identity"},
    "status": {"const": "complete"},
    "configuration_sha256": {"$ref": "#/$defs/sha256"},
    "p06_release_bundle_manifest_sha256": {"$ref": "#/$defs/sha256"},
    "release_native_executable_sha256": {"$ref": "#/$defs/sha256"},
    "release_native_source_manifest_sha256": {"$ref": "#/$defs/sha256"},
    "release_lut_manifest_sha256": {"$ref": "#/$defs/sha256"},
    "release_lut_independent_recompile": {"type": "object"},
    "sampling_plan_manifest_sha256": {"$ref": "#/$defs/sha256"},
    "frame_extraction_manifest_sha256": {"$ref": "#/$defs/sha256"},
    "measurement_core_sha256": {"$ref": "#/$defs/sha256"},
    "preopen_cache_snapshot_before": {"type": "object"},
    "preopen_cache_snapshot_after": {"type": "object"},
    "preopen_cache_unchanged": {"const": true},
    "loader_preopen_verification": {"type": "object"},
    "p00_continuity_evidence": {"type": "object"},
    "analytic_preopen_evidence": {"type": "object"},
    "corpus_case_evidence": {"type": "array"},
    "persistent_holdout_binary_artifact_count": {"const": 0},
    "temporary_binary_artifacts_published": {"type": "boolean"},
    "holdout_accessed": {"const": true},
    "configuration_files_modified_after_holdout": {"const": false},
    "manifest_sha256": {"$ref": "#/$defs/sha256"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^(?!0{64}$)[0-9a-f]{64}$"},
    "p06Identity": {
      "type": "object",
      "required": [
        "calibration_plan_v2_file_sha256", "candidate_vector_sha256",
        "shared_bank_configuration_sha256", "input_bundle_sha256",
        "p06_release_bundle_artifact_sha256", "selected_evaluation_file_sha256",
        "selected_evaluation_artifact_sha256", "selected_evaluation_semantic_sha256"
      ],
      "properties": {
        "calibration_plan_v2_file_sha256": {"$ref": "#/$defs/sha256"},
        "candidate_vector_sha256": {"$ref": "#/$defs/sha256"},
        "shared_bank_configuration_sha256": {"$ref": "#/$defs/sha256"},
        "input_bundle_sha256": {"$ref": "#/$defs/sha256"},
        "p06_release_bundle_artifact_sha256": {"$ref": "#/$defs/sha256"},
        "selected_evaluation_file_sha256": {"$ref": "#/$defs/sha256"},
        "selected_evaluation_artifact_sha256": {"$ref": "#/$defs/sha256"},
        "selected_evaluation_semantic_sha256": {"$ref": "#/$defs/sha256"}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
