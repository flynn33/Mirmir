{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mirmir.local/validation/calibration-v2/g05-gate-assessment-v2.schema.json",
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "file_binding": {
      "type": "object",
      "required": ["path", "sha256", "size_bytes"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "sha256": {"$ref": "#/$defs/sha256"},
        "size_bytes": {"type": "integer", "minimum": 1}
      },
      "additionalProperties": false
    },
    "criterion": {
      "type": "object",
      "required": ["id", "criterion", "status", "evidence", "verified_assertion_count"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "criterion": {"type": "string", "minLength": 1},
        "status": {"const": "pass"},
        "evidence": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string", "minLength": 1},
          "uniqueItems": true
        },
        "verified_assertion_count": {"type": "integer", "minimum": 1}
      },
      "additionalProperties": false
    }
  },
  "type": "object",
  "required": [
    "schema_version",
    "artifact_kind",
    "gate_id",
    "phase",
    "source_commit",
    "status",
    "finding_register_sha256",
    "input_scope",
    "holdout_accessed",
    "evidence_closure",
    "provenance",
    "mandatory_criteria",
    "assessment_sha256"
  ],
  "properties": {
    "schema_version": {"const": "2.0.0"},
    "artifact_kind": {"const": "g05_gate_assessment"},
    "gate_id": {"const": "G05"},
    "phase": {"const": "P05"},
    "source_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "status": {"const": "pass"},
    "finding_register_sha256": {"$ref": "#/$defs/sha256"},
    "input_scope": {"const": "synthetic_only"},
    "holdout_accessed": {"const": false},
    "evidence_closure": {
      "type": "object",
      "required": [
        "status",
        "run_count",
        "files_per_run",
        "document_names",
        "document_bindings",
        "run_sha256",
        "byte_identical"
      ],
      "properties": {
        "status": {"const": "pass"},
        "run_count": {"const": 3},
        "files_per_run": {"const": 8},
        "document_names": {
          "type": "array",
          "minItems": 8,
          "maxItems": 8,
          "prefixItems": [
            {"const": "development-mapping.json"},
            {"const": "state-fixtures.json"},
            {"const": "operator-discrimination.json"},
            {"const": "operator-distinctness.json"},
            {"const": "coordinate-comparison.json"},
            {"const": "state-causality-results.json"},
            {"const": "cpu-reference-results.json"},
            {"const": "cpu-reference-vectors.json"}
          ],
          "items": false
        },
        "document_bindings": {
          "type": "array",
          "minItems": 8,
          "maxItems": 8,
          "items": {"$ref": "#/$defs/file_binding"}
        },
        "run_sha256": {
          "type": "array",
          "minItems": 3,
          "maxItems": 3,
          "items": {"$ref": "#/$defs/sha256"}
        },
        "byte_identical": {"const": true}
      },
      "additionalProperties": false
    },
    "provenance": {
      "type": "object",
      "required": ["status", "current_repository_bytes_verified", "manifest_sha256"],
      "properties": {
        "status": {"const": "pass"},
        "current_repository_bytes_verified": {"const": true},
        "manifest_sha256": {
          "type": "object",
          "required": ["production_sources", "configuration", "harness"],
          "properties": {
            "production_sources": {"$ref": "#/$defs/sha256"},
            "configuration": {"$ref": "#/$defs/sha256"},
            "harness": {"$ref": "#/$defs/sha256"}
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "mandatory_criteria": {
      "type": "array",
      "minItems": 8,
      "maxItems": 8,
      "prefixItems": [
        {"allOf": [{"$ref": "#/$defs/criterion"}, {"properties": {"id": {"const": "all_state_bits_controlled"}, "criterion": {"const": "Every state bit has controlled fixture coverage"}}}]},
        {"allOf": [{"$ref": "#/$defs/criterion"}, {"properties": {"id": {"const": "normal_tangent_convention"}, "criterion": {"const": "Structure-tensor normal/tangent convention passes orientation fixtures"}}}]},
        {"allOf": [{"$ref": "#/$defs/criterion"}, {"properties": {"id": {"const": "direct_routes_synthetic"}, "criterion": {"const": "Direct 2x and 3/2 CPU reference passes synthetic tests"}}}]},
        {"allOf": [{"$ref": "#/$defs/criterion"}, {"properties": {"id": {"const": "descriptor_semantic_behavioral_distinctness"}, "criterion": {"const": "16 descriptor records are semantically and behaviorally distinct"}}}]},
        {"allOf": [{"$ref": "#/$defs/criterion"}, {"properties": {"id": {"const": "no_nearest_substrate"}, "criterion": {"const": "nearest is not the production reconstruction substrate"}}}]},
        {"allOf": [{"$ref": "#/$defs/criterion"}, {"properties": {"id": {"const": "nonconstant_valid_state_dispatch"}, "criterion": {"const": "dispatch is not constant across valid states"}}}]},
        {"allOf": [{"$ref": "#/$defs/criterion"}, {"properties": {"id": {"const": "first_frame_not_universal"}, "criterion": {"const": "first-frame top operator is not universal by construction"}}}]},
        {"allOf": [{"$ref": "#/$defs/criterion"}, {"properties": {"id": {"const": "state_disabled_delta"}, "criterion": {"const": "state-disabled result differs on controlled fixtures"}}}]}
      ],
      "items": false
    },
    "assessment_sha256": {"$ref": "#/$defs/sha256"}
  },
  "additionalProperties": false
}
