{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mirmir.local/validation/calibration-v2/g05-command-plan-v1.schema.json",
  "$defs": {
    "command": {
      "type": "object",
      "required": [
        "id",
        "argv",
        "cwd",
        "environment",
        "exit_status",
        "output_path"
      ],
      "properties": {
        "id": {
          "enum": [
            "run-a",
            "run-b",
            "independent-run",
            "quality-lock-a",
            "quality-lock-b",
            "swiftlint",
            "attribution",
            "instruction-package",
            "diff-check"
          ]
        },
        "argv": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string", "minLength": 1}
        },
        "cwd": {"type": "string", "minLength": 1},
        "environment": {
          "type": "object",
          "propertyNames": {"type": "string", "minLength": 1},
          "additionalProperties": {"type": "string"}
        },
        "exit_status": {"const": 0},
        "output_path": {
          "type": "string",
          "pattern": "^outputs/[a-z0-9][a-z0-9-]*\\.log$"
        }
      },
      "additionalProperties": false
    }
  },
  "type": "object",
  "required": ["schema_version", "artifact_kind", "source_commit", "commands"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "artifact_kind": {"const": "g05_current_source_command_plan"},
    "source_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "commands": {
      "type": "array",
      "minItems": 9,
      "maxItems": 9,
      "items": {"$ref": "#/$defs/command"}
    }
  },
  "additionalProperties": false
}
