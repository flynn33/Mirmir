{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mirmir.local/validation/calibration-v2/lut-manifest-v2.schema.json",
  "title": "Locked P06 ASH route LUT manifest",
  "type": "object",
  "required": [
    "schema_version",
    "manifest_id",
    "status",
    "configuration_id",
    "compiler_input",
    "lut_binary_contract",
    "hash_bindings",
    "routes",
    "runtime_load_policy",
    "native_parity_manifest",
    "holdout_accessed",
    "manifest_sha256"
  ],
  "properties": {
    "schema_version": {"const": "2.0.0"},
    "manifest_id": {"const": "mirmir-ash-route-luts-v2"},
    "status": {"const": "locked_before_p07"},
    "configuration_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]{2,127}$"
    },
    "compiler_input": {
      "allOf": [
        {"$ref": "#/$defs/fileBinding"},
        {
          "type": "object",
          "properties": {
            "path": {"const": "locked-compiler-input.json"}
          }
        }
      ]
    },
    "lut_binary_contract": {
      "allOf": [
        {"$ref": "#/$defs/fileBinding"},
        {
          "type": "object",
          "properties": {
            "path": {
              "const": "validation/calibration_v2/contracts/lut-binary-contract-v1.json"
            }
          }
        }
      ]
    },
    "hash_bindings": {
      "type": "object",
      "required": [
        "mapping_sha256",
        "operator_bank_sha256",
        "metric_policy_sha256",
        "compiler_inputs_sha256",
        "calibration_plan_sha256",
        "corpus_lock_bundle_sha256"
      ],
      "properties": {
        "mapping_sha256": {"$ref": "#/$defs/nonzeroSha256"},
        "operator_bank_sha256": {"$ref": "#/$defs/nonzeroSha256"},
        "metric_policy_sha256": {"$ref": "#/$defs/nonzeroSha256"},
        "compiler_inputs_sha256": {"$ref": "#/$defs/nonzeroSha256"},
        "calibration_plan_sha256": {"$ref": "#/$defs/nonzeroSha256"},
        "corpus_lock_bundle_sha256": {"$ref": "#/$defs/nonzeroSha256"}
      },
      "additionalProperties": false
    },
    "routes": {
      "type": "array",
      "prefixItems": [
        {"$ref": "#/$defs/direct2x"},
        {"$ref": "#/$defs/direct3Over2"}
      ],
      "items": false
    },
    "runtime_load_policy": {
      "const": {
        "immutability": "validate complete bytes before publication and retain immutable bytes",
        "load_frequency": "once_per_route_per_configuration",
        "per_frame_load_count": 0,
        "runtime_tree_generation_count": 0,
        "maximum_operator_evaluations_per_output_cell": 2
      }
    },
    "native_parity_manifest": {
      "allOf": [
        {"$ref": "#/$defs/fileBinding"},
        {
          "type": "object",
          "properties": {
            "path": {"const": "native-lut-parity-manifest.json"}
          }
        }
      ]
    },
    "holdout_accessed": {"const": false},
    "manifest_sha256": {"$ref": "#/$defs/nonzeroSha256"}
  },
  "additionalProperties": false,
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "nonzeroSha256": {
      "type": "string",
      "pattern": "^(?!0{64}$)[0-9a-f]{64}$"
    },
    "crc32": {
      "type": "string",
      "pattern": "^0x[0-9A-F]{8}$"
    },
    "safeRelativePath": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?!.*\\\\)(?!.*//)(?!.*(?:^|/)\\.\\.?(?:/|$))[^\\u0000]+$"
    },
    "fileBinding": {
      "type": "object",
      "required": ["path", "sha256", "size_bytes"],
      "properties": {
        "path": {"$ref": "#/$defs/safeRelativePath"},
        "sha256": {"$ref": "#/$defs/nonzeroSha256"},
        "size_bytes": {"type": "integer", "minimum": 1}
      },
      "additionalProperties": false
    },
    "routeBase": {
      "type": "object",
      "required": [
        "route",
        "route_id",
        "scale_numerator",
        "scale_denominator",
        "phase_count",
        "context_count",
        "valid_state_count",
        "coordinate_policy",
        "analysis_grid_source_step",
        "entry_count",
        "parameter_count",
        "path",
        "whole_file_size_bytes",
        "whole_file_sha256",
        "payload_sha256",
        "header_crc32",
        "payload_crc32"
      ],
      "properties": {
        "route": {"enum": ["direct_2x", "direct_3_over_2"]},
        "route_id": {"enum": [1, 2]},
        "scale_numerator": {"enum": [2, 3]},
        "scale_denominator": {"enum": [1, 2]},
        "phase_count": {"enum": [4, 9]},
        "context_count": {"const": 4},
        "valid_state_count": {"const": 256},
        "coordinate_policy": {
          "enum": ["source_aligned_rational", "half_pixel_center"]
        },
        "analysis_grid_source_step": {"enum": [1, 2, 4]},
        "entry_count": {"enum": [4096, 9216]},
        "parameter_count": {"type": "integer", "minimum": 1},
        "path": {"enum": ["direct2x.ashlut", "direct3over2.ashlut"]},
        "whole_file_size_bytes": {"type": "integer", "minimum": 1},
        "whole_file_sha256": {"$ref": "#/$defs/nonzeroSha256"},
        "payload_sha256": {"$ref": "#/$defs/nonzeroSha256"},
        "header_crc32": {"$ref": "#/$defs/crc32"},
        "payload_crc32": {"$ref": "#/$defs/crc32"}
      },
      "additionalProperties": false
    },
    "direct2x": {
      "allOf": [
        {"$ref": "#/$defs/routeBase"},
        {
          "type": "object",
          "properties": {
            "route": {"const": "direct_2x"},
            "route_id": {"const": 1},
            "scale_numerator": {"const": 2},
            "scale_denominator": {"const": 1},
            "phase_count": {"const": 4},
            "entry_count": {"const": 4096},
            "path": {"const": "direct2x.ashlut"}
          }
        }
      ]
    },
    "direct3Over2": {
      "allOf": [
        {"$ref": "#/$defs/routeBase"},
        {
          "type": "object",
          "properties": {
            "route": {"const": "direct_3_over_2"},
            "route_id": {"const": 2},
            "scale_numerator": {"const": 3},
            "scale_denominator": {"const": 2},
            "phase_count": {"const": 9},
            "entry_count": {"const": 9216},
            "path": {"const": "direct3over2.ashlut"}
          }
        }
      ]
    }
  }
}
