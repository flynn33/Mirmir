{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mirmir.local/validation/calibration-v2/evidence-wrapper-artifact-manifest-v1.schema.json",
  "type": "object",
  "required": [
    "schema_version",
    "created_utc",
    "project_commit",
    "working_tree_clean",
    "artifacts"
  ],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "created_utc": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]{1,6})?Z$"
    },
    "project_commit": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "working_tree_clean": {"const": true},
    "artifacts": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/artifact"}
    }
  },
  "additionalProperties": false,
  "$defs": {
    "safeRelativePath": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?!.*\\\\)(?!.*//)(?!.*(?:^|/)\\.\\.?(?:/|$))[^\\u0000]+$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "artifact": {
      "type": "object",
      "required": [
        "path",
        "sha256",
        "size_bytes",
        "producer",
        "gate_ids",
        "command",
        "machine"
      ],
      "properties": {
        "path": {"$ref": "#/$defs/safeRelativePath"},
        "sha256": {"$ref": "#/$defs/sha256"},
        "size_bytes": {"type": "integer", "minimum": 0},
        "producer": {"type": "string", "minLength": 1},
        "gate_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[A-Z][A-Z0-9._-]{1,31}$"
          }
        },
        "command": {"type": "string", "minLength": 1},
        "machine": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    }
  }
}
