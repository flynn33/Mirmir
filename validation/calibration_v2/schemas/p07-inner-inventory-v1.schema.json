{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mirmir.local/validation/calibration-v2/p07-inner-inventory-v1.schema.json",
  "type": "object",
  "required": [
    "schema_version",
    "revision_id",
    "created_utc",
    "hash_scope",
    "entries",
    "entry_count",
    "payload_file_count",
    "payload_bytes",
    "rejected_payload_file_count",
    "rejected_payload_bytes",
    "preview_files_present",
    "scratch_files_present",
    "partial_files_present",
    "evaluation_ledger_status",
    "evaluation_opened_utc",
    "verification_failures_before_seal"
  ],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "revision_id": {"type": "string", "minLength": 1},
    "created_utc": {"type": "string", "format": "date-time"},
    "hash_scope": {"const": "all regular files except .fseventsd and this inventory document"},
    "entries": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["sha256", "size_bytes", "relative_path"],
        "properties": {
          "sha256": {"$ref": "#/$defs/sha256"},
          "size_bytes": {"type": "integer", "minimum": 0},
          "relative_path": {"type": "string", "minLength": 1}
        },
        "additionalProperties": false
      }
    },
    "entry_count": {"type": "integer", "minimum": 1},
    "payload_file_count": {"type": "integer", "minimum": 1},
    "payload_bytes": {"type": "integer", "minimum": 1},
    "rejected_payload_file_count": {"type": "integer", "minimum": 0},
    "rejected_payload_bytes": {"type": "integer", "minimum": 0},
    "preview_files_present": {"const": false},
    "scratch_files_present": {"const": false},
    "partial_files_present": {"const": false},
    "evaluation_ledger_status": {"const": "unopened"},
    "evaluation_opened_utc": {"const": null},
    "verification_failures_before_seal": {"const": 0}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  },
  "additionalProperties": false
}
