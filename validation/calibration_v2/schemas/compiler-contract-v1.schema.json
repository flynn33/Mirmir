{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mirmir.local/validation/calibration-v2/compiler-contract-v1.schema.json",
  "type": "object",
  "required": [
    "schema_version",
    "contract_id",
    "status",
    "canonical_branch",
    "index_domain",
    "temporal_disabled_semantics",
    "source_aligned_exact_semantics",
    "base_descriptor",
    "descriptor_application",
    "semantic_steps",
    "hard_compatibility",
    "penalty",
    "mass_and_ranking",
    "parameter_table",
    "failure_taxonomy",
    "runtime_invariants"
  ],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "contract_id": {"const": "mirmir-state-conditioned-leaf-compiler-v1"},
    "status": {"const": "preregistered_not_executed"},
    "canonical_branch": {
      "type": "object",
      "required": [
        "depth",
        "leaf_count_per_cell",
        "action_alphabet",
        "action_digit",
        "path_ordinal",
        "path_order",
        "action_mass_numerator_over_4",
        "leaf_mass_denominator",
        "message_transition",
        "message_bit_order",
        "affine_state",
        "required_recovery"
      ],
      "properties": {
        "depth": {"const": 4},
        "leaf_count_per_cell": {"const": 81},
        "action_alphabet": {"const": ["0", "+", "-"]},
        "action_digit": {"const": {"0": 0, "+": 1, "-": 2}},
        "path_ordinal": {"type": "string", "minLength": 1},
        "path_order": {"type": "string", "minLength": 1},
        "action_mass_numerator_over_4": {"const": {"0": 2, "+": 1, "-": 1}},
        "leaf_mass_denominator": {"const": 256},
        "message_transition": {
          "type": "object",
          "required": ["0", "+", "-"],
          "additionalProperties": {"type": "string", "minLength": 1}
        },
        "message_bit_order": {"type": "string", "minLength": 1},
        "affine_state": {"type": "string", "minLength": 1},
        "required_recovery": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    },
    "index_domain": {
      "type": "object",
      "required": ["routes", "phase_order", "contexts", "valid_state_order", "logical_index", "entry_counts"],
      "properties": {
        "routes": {
          "type": "array",
          "prefixItems": [
            {"const": {"name": "direct_2x", "route_id": 1, "scale_numerator": 2, "phase_count": 4}},
            {"const": {"name": "direct_3_over_2", "route_id": 2, "scale_numerator": 3, "phase_count": 9}}
          ],
          "items": false
        },
        "phase_order": {"type": "string", "minLength": 1},
        "contexts": {
          "type": "array",
          "minItems": 4,
          "maxItems": 4,
          "items": {
            "type": "object",
            "required": ["name", "id"],
            "properties": {
              "name": {"type": "string", "minLength": 1},
              "id": {"type": "integer", "minimum": 0, "maximum": 3}
            },
            "additionalProperties": false
          }
        },
        "valid_state_order": {"type": "string", "minLength": 1},
        "logical_index": {"type": "string", "minLength": 1},
        "entry_counts": {"const": {"direct_2x": 4096, "direct_3_over_2": 9216}}
      },
      "additionalProperties": false
    },
    "temporal_disabled_semantics": {
      "type": "object",
      "required": ["enabled", "semantic_state", "affine_anchor", "context_rule", "entry_flag_rule", "parameter_rule", "runtime_rule"],
      "properties": {
        "enabled": {"const": false},
        "semantic_state": {"type": "string", "minLength": 1},
        "affine_anchor": {"type": "string", "minLength": 1},
        "context_rule": {"type": "string", "minLength": 1},
        "entry_flag_rule": {"type": "string", "minLength": 1},
        "parameter_rule": {"type": "string", "minLength": 1},
        "runtime_rule": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    },
    "source_aligned_exact_semantics": {
      "type": "object",
      "required": [
        "predicate",
        "compiler_order",
        "primary_message",
        "primary_descriptor",
        "primary_affine_state",
        "primary_weight_unorm16",
        "margin_unorm16",
        "secondary",
        "entry_flag",
        "parameter_slot",
        "reconstruction",
        "half_pixel_rule"
      ],
      "properties": {
        "predicate": {"type": "string", "minLength": 1},
        "compiler_order": {"type": "string", "minLength": 1},
        "primary_message": {"const": 0},
        "primary_descriptor": {"const": 0},
        "primary_affine_state": {"const": "original source anchor"},
        "primary_weight_unorm16": {"const": 65535},
        "margin_unorm16": {"const": 65535},
        "secondary": {"const": "inactive sentinel"},
        "entry_flag": {"const": "source_aligned_exact"},
        "parameter_slot": {"type": "string", "minLength": 1},
        "reconstruction": {"type": "string", "minLength": 1},
        "half_pixel_rule": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    },
    "base_descriptor": {"$ref": "#/$defs/nonemptyObject"},
    "descriptor_application": {
      "type": "object",
      "required": [
        "kernel_bit",
        "orientation_sector",
        "support_bit",
        "support_radius_q8_8",
        "detail_gain_q12",
        "detail_bit",
        "relaxed_limiter_alpha_q12",
        "limiter_bit",
        "descriptor_id"
      ],
      "additionalProperties": {"type": "string", "minLength": 1}
    },
    "semantic_steps": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "items": {
        "type": "object",
        "required": ["level", "axis", "zero", "positive", "negative", "scale", "storage"],
        "properties": {
          "level": {"type": "integer", "minimum": 0, "maximum": 3},
          "axis": {"type": "string", "minLength": 1},
          "zero": {"const": 0},
          "positive": {"const": 1},
          "negative": {"const": -1},
          "scale": {"type": "string", "minLength": 1},
          "storage": {"type": "string", "minLength": 1}
        },
        "additionalProperties": false
      }
    },
    "hard_compatibility": {"$ref": "#/$defs/nonemptyStringArray"},
    "penalty": {"$ref": "#/$defs/nonemptyObject"},
    "mass_and_ranking": {"$ref": "#/$defs/nonemptyObject"},
    "parameter_table": {"$ref": "#/$defs/nonemptyObject"},
    "failure_taxonomy": {"$ref": "#/$defs/nonemptyStringArray"},
    "runtime_invariants": {
      "const": {
        "tree_generations_per_frame": 0,
        "path_allocations_per_frame": 0,
        "maximum_operator_evaluations_per_output_cell": 2,
        "json_parsing_in_frame_path": 0,
        "lut_loads_per_route_configuration": 1
      }
    }
  },
  "additionalProperties": false,
  "$defs": {
    "nonemptyObject": {"type": "object", "minProperties": 1},
    "nonemptyStringArray": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "minLength": 1}
    }
  }
}
