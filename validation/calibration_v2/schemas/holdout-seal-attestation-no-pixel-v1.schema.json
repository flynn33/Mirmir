{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mirmir.local/validation/calibration-v2/holdout-seal-attestation-no-pixel-v1.schema.json",
  "type": "object",
  "required": [
    "schema_version",
    "attestation_type",
    "revision_id",
    "created_utc",
    "pixel_content_included",
    "result",
    "container",
    "keychain",
    "inner_inventory",
    "holdout_wrapper",
    "canonical_payload_hashes",
    "failed_candidate_preservation",
    "outer_record_hashes",
    "production_corpus_lock",
    "evaluation_access",
    "read_only_provisioning_workflow"
  ],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "attestation_type": {"const": "sealed_holdout_no_pixel_outer"},
    "revision_id": {"type": "string", "minLength": 1},
    "created_utc": {"type": "string", "format": "date-time"},
    "pixel_content_included": {"const": false},
    "result": {"const": "holdout_sealed_and_production_corpus_lock_validated"},
    "container": {"$ref": "#/$defs/container"},
    "keychain": {"$ref": "#/$defs/keychain"},
    "inner_inventory": {"$ref": "#/$defs/innerInventory"},
    "holdout_wrapper": {"$ref": "#/$defs/holdoutWrapper"},
    "canonical_payload_hashes": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/payloadHash"}
    },
    "failed_candidate_preservation": {"$ref": "#/$defs/failedCandidate"},
    "outer_record_hashes": {"$ref": "#/$defs/outerRecordHashes"},
    "production_corpus_lock": {"$ref": "#/$defs/productionCorpusLock"},
    "evaluation_access": {"$ref": "#/$defs/evaluationAccess"},
    "read_only_provisioning_workflow": {"$ref": "#/$defs/readOnlyWorkflow"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "nonempty": {"type": "string", "minLength": 1},
    "container": {
      "type": "object",
      "required": [
        "relative_path",
        "disk_image_type",
        "disk_image_format",
        "encryption",
        "filesystem",
        "volume_uuid",
        "container_file_count",
        "container_physical_file_bytes",
        "container_file_hashes_path",
        "container_file_hashes_sha256",
        "tree_hash_contract",
        "mounted",
        "final_detached_utc"
      ],
      "properties": {
        "relative_path": {"$ref": "#/$defs/nonempty"},
        "disk_image_type": {"const": "sparsebundle"},
        "disk_image_format": {"const": "UDSB"},
        "encryption": {"const": "AES-256"},
        "filesystem": {"const": "APFS"},
        "volume_uuid": {"type": "string", "pattern": "^[0-9A-F-]{36}$"},
        "container_file_count": {"type": "integer", "minimum": 1},
        "container_physical_file_bytes": {"type": "integer", "minimum": 1},
        "container_file_hashes_path": {"$ref": "#/$defs/nonempty"},
        "container_file_hashes_sha256": {"$ref": "#/$defs/sha256"},
        "tree_hash_contract": {"$ref": "#/$defs/nonempty"},
        "mounted": {"const": false},
        "final_detached_utc": {"type": "string", "format": "date-time"}
      },
      "additionalProperties": false
    },
    "keychain": {
      "type": "object",
      "required": ["service", "account", "item_present", "secret_in_attestation"],
      "properties": {
        "service": {"$ref": "#/$defs/nonempty"},
        "account": {"$ref": "#/$defs/nonempty"},
        "item_present": {"const": true},
        "secret_in_attestation": {"const": false}
      },
      "additionalProperties": false
    },
    "innerInventory": {
      "type": "object",
      "required": [
        "container_relative_path",
        "sha256",
        "entry_count",
        "canonical_payload_file_count",
        "canonical_payload_bytes",
        "rejected_payload_file_count",
        "rejected_payload_bytes",
        "preview_files_present",
        "scratch_files_present",
        "partial_files_present",
        "verification_failures_before_seal"
      ],
      "properties": {
        "container_relative_path": {"$ref": "#/$defs/nonempty"},
        "sha256": {"$ref": "#/$defs/sha256"},
        "entry_count": {"type": "integer", "minimum": 1},
        "canonical_payload_file_count": {"type": "integer", "minimum": 1},
        "canonical_payload_bytes": {"type": "integer", "minimum": 1},
        "rejected_payload_file_count": {"type": "integer", "minimum": 0},
        "rejected_payload_bytes": {"type": "integer", "minimum": 0},
        "preview_files_present": {"const": false},
        "scratch_files_present": {"const": false},
        "partial_files_present": {"const": false},
        "verification_failures_before_seal": {"const": 0}
      },
      "additionalProperties": false
    },
    "holdoutWrapper": {
      "type": "object",
      "required": [
        "path",
        "file_sha256",
        "manifest_sha256",
        "asset_count",
        "source_family_count",
        "schema_semantic_and_byte_bindings",
        "production_metadata_contract",
        "all_twelve_categories",
        "development_validation_family_collision"
      ],
      "properties": {
        "path": {"$ref": "#/$defs/nonempty"},
        "file_sha256": {"$ref": "#/$defs/sha256"},
        "manifest_sha256": {"$ref": "#/$defs/sha256"},
        "asset_count": {"type": "integer", "minimum": 1},
        "source_family_count": {"type": "integer", "minimum": 1},
        "schema_semantic_and_byte_bindings": {"const": "pass"},
        "production_metadata_contract": {"const": "pass"},
        "all_twelve_categories": {"const": "pass"},
        "development_validation_family_collision": {"const": false}
      },
      "additionalProperties": false
    },
    "payloadHash": {
      "type": "object",
      "required": ["asset_id", "bytes", "sha256"],
      "properties": {
        "asset_id": {"$ref": "#/$defs/nonempty"},
        "bytes": {"type": "integer", "minimum": 1},
        "sha256": {"$ref": "#/$defs/sha256"}
      },
      "additionalProperties": false
    },
    "failedCandidate": {
      "type": "object",
      "required": [
        "asset_id",
        "reason",
        "payload_sha256",
        "retention",
        "included_in_canonical_wrapper",
        "included_in_evaluation_payloads",
        "outer_supersession_path",
        "outer_supersession_sha256"
      ],
      "properties": {
        "asset_id": {"$ref": "#/$defs/nonempty"},
        "reason": {"$ref": "#/$defs/nonempty"},
        "payload_sha256": {"$ref": "#/$defs/sha256"},
        "retention": {"$ref": "#/$defs/nonempty"},
        "included_in_canonical_wrapper": {"const": false},
        "included_in_evaluation_payloads": {"const": false},
        "outer_supersession_path": {"$ref": "#/$defs/nonempty"},
        "outer_supersession_sha256": {"$ref": "#/$defs/sha256"}
      },
      "additionalProperties": false
    },
    "outerRecordHashes": {
      "type": "object",
      "required": [
        "category_attestation",
        "rights_review",
        "candidate_decision_log",
        "transport_and_media_verification",
        "evidence_file_inventory",
        "provisioning_access_log",
        "evaluation_access_ledger_sealed_copy",
        "production_corpus_lock_validation"
      ],
      "properties": {
        "category_attestation": {"$ref": "#/$defs/sha256"},
        "rights_review": {"$ref": "#/$defs/sha256"},
        "candidate_decision_log": {"$ref": "#/$defs/sha256"},
        "transport_and_media_verification": {"$ref": "#/$defs/sha256"},
        "evidence_file_inventory": {"$ref": "#/$defs/sha256"},
        "provisioning_access_log": {"$ref": "#/$defs/sha256"},
        "evaluation_access_ledger_sealed_copy": {"$ref": "#/$defs/sha256"},
        "production_corpus_lock_validation": {"$ref": "#/$defs/sha256"}
      },
      "additionalProperties": false
    },
    "productionCorpusLock": {
      "type": "object",
      "required": [
        "path",
        "created_utc",
        "manifest_sha256",
        "file_sha256",
        "asset_count",
        "source_family_count",
        "split_counts",
        "schema_exact_allocation_category_metadata_and_all_byte_bindings"
      ],
      "properties": {
        "path": {"$ref": "#/$defs/nonempty"},
        "created_utc": {"type": "string", "format": "date-time"},
        "manifest_sha256": {"$ref": "#/$defs/sha256"},
        "file_sha256": {"$ref": "#/$defs/sha256"},
        "asset_count": {"type": "integer", "minimum": 1},
        "source_family_count": {"type": "integer", "minimum": 1},
        "split_counts": {
          "type": "object",
          "required": ["development", "validation", "holdout"],
          "properties": {
            "development": {"type": "integer", "minimum": 1},
            "validation": {"type": "integer", "minimum": 1},
            "holdout": {"type": "integer", "minimum": 1}
          },
          "additionalProperties": false
        },
        "schema_exact_allocation_category_metadata_and_all_byte_bindings": {"const": "pass"}
      },
      "additionalProperties": false
    },
    "evaluationAccess": {
      "type": "object",
      "required": [
        "status",
        "evaluation_opened_utc",
        "first_evaluation_access_utc",
        "last_evaluation_access_utc",
        "evaluation_access_count",
        "evaluation_run_id"
      ],
      "properties": {
        "status": {"enum": ["unopened", "opened", "completed", "failed"]},
        "evaluation_opened_utc": {"type": ["string", "null"], "format": "date-time"},
        "first_evaluation_access_utc": {"type": ["string", "null"], "format": "date-time"},
        "last_evaluation_access_utc": {"type": ["string", "null"], "format": "date-time"},
        "evaluation_access_count": {"type": "integer", "minimum": 0},
        "evaluation_run_id": {"type": ["string", "null"]}
      },
      "additionalProperties": false
    },
    "readOnlyWorkflow": {
      "type": "object",
      "required": [
        "mount_script_path",
        "mount_script_sha256",
        "unmount_script_path",
        "unmount_script_sha256",
        "key_helper_path",
        "key_helper_sha256"
      ],
      "properties": {
        "mount_script_path": {"$ref": "#/$defs/nonempty"},
        "mount_script_sha256": {"$ref": "#/$defs/sha256"},
        "unmount_script_path": {"$ref": "#/$defs/nonempty"},
        "unmount_script_sha256": {"$ref": "#/$defs/sha256"},
        "key_helper_path": {"$ref": "#/$defs/nonempty"},
        "key_helper_sha256": {"$ref": "#/$defs/sha256"}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
