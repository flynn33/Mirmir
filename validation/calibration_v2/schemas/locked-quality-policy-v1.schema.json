{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mirmir.local/validation/calibration-v2/locked-quality-policy-v1.schema.json",
  "type": "object",
  "required": [
    "schema_version",
    "artifact_kind",
    "status",
    "quality_policy_seed_sha256",
    "baseline_ablation_contract_sha256",
    "baseline_ablation_contract_id",
    "input_bundle_sha256",
    "shared_bank_configuration_sha256",
    "selected_controls",
    "holdout_accessed",
    "manifest_sha256"
  ],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "artifact_kind": {"const": "p06_locked_quality_policy"},
    "status": {"const": "locked_before_p07"},
    "quality_policy_seed_sha256": {"const": "38336d27e0ceba9020b05a62038c6c822ea20daca32f45a8f8891459ea82fff2"},
    "baseline_ablation_contract_sha256": {"$ref": "#/$defs/sha256"},
    "baseline_ablation_contract_id": {"const": "mirmir-p06-baselines-ablations-v1"},
    "input_bundle_sha256": {"$ref": "#/$defs/sha256"},
    "shared_bank_configuration_sha256": {"$ref": "#/$defs/sha256"},
    "selected_controls": {"$ref": "#/$defs/selectedControls"},
    "holdout_accessed": {"const": false},
    "manifest_sha256": {"$ref": "#/$defs/sha256"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "selectedControls": {
      "type": "object",
      "required": ["best_fixed", "conventional", "non_ash_selector", "state_only", "state_plus_branch", "h07_direct_3_over_2", "nearest_same_writer", "current_production_ash"],
      "properties": {
        "best_fixed": {
          "type": "object",
          "required": ["control_id", "descriptor_id", "configuration_sha256", "selection_sha256", "shared_bank_configuration_sha256"],
          "properties": {
            "control_id": {"const": "fixed-descriptor-uniform-v1"},
            "descriptor_id": {"type": "integer", "minimum": 0, "maximum": 15},
            "configuration_sha256": {"$ref": "#/$defs/sha256"},
            "selection_sha256": {"$ref": "#/$defs/sha256"},
            "shared_bank_configuration_sha256": {"$ref": "#/$defs/sha256"}
          },
          "additionalProperties": false
        },
        "conventional": {
          "type": "object",
          "required": ["control_id", "algorithm_id", "configuration_sha256", "selection_sha256", "shared_bank_configuration_sha256"],
          "properties": {
            "control_id": {"const": "uniform-conventional-selection-v1"},
            "algorithm_id": {"enum": ["bilinear-separable-v1", "keys-cubic-a-minus-0.5-separable-v1", "lanczos3-separable-v1"]},
            "configuration_sha256": {"$ref": "#/$defs/sha256"},
            "selection_sha256": {"$ref": "#/$defs/sha256"},
            "shared_bank_configuration_sha256": {"$ref": "#/$defs/sha256"}
          },
          "additionalProperties": false
        },
        "non_ash_selector": {
          "type": "object",
          "required": ["selector_id", "configuration_sha256", "selection_sha256", "rule_sha256", "candidate_evaluation_budget", "shared_bank_configuration_sha256"],
          "properties": {
            "selector_id": {"const": "continuous-linear-bank-selector-q15-v1"},
            "configuration_sha256": {"$ref": "#/$defs/sha256"},
            "selection_sha256": {"$ref": "#/$defs/sha256"},
            "rule_sha256": {"$ref": "#/$defs/sha256"},
            "candidate_evaluation_budget": {"const": 1513},
            "shared_bank_configuration_sha256": {"$ref": "#/$defs/sha256"}
          },
          "additionalProperties": false
        },
        "state_only": {"$ref": "#/$defs/stateOnly"},
        "state_plus_branch": {"$ref": "#/$defs/statePlusBranch"},
        "h07_direct_3_over_2": {"$ref": "#/$defs/h07"},
        "nearest_same_writer": {"$ref": "#/$defs/nearest"},
        "current_production_ash": {"$ref": "#/$defs/currentProduction"}
      },
      "additionalProperties": false
    },
    "stateOnly": {
      "type": "object",
      "required": ["control_id", "configuration_sha256", "selection_sha256", "shared_bank_configuration_sha256"],
      "properties": {
        "control_id": {"const": "ash-state-only-base-descriptor-v1"},
        "configuration_sha256": {"$ref": "#/$defs/sha256"},
        "selection_sha256": {"$ref": "#/$defs/sha256"},
        "shared_bank_configuration_sha256": {"$ref": "#/$defs/sha256"}
      },
      "additionalProperties": false
    },
    "statePlusBranch": {
      "type": "object",
      "required": ["control_id", "configuration_sha256", "selection_sha256", "shared_bank_configuration_sha256"],
      "properties": {
        "control_id": {"const": "ash-state-plus-branch-compiler-v1"},
        "configuration_sha256": {"$ref": "#/$defs/sha256"},
        "selection_sha256": {"$ref": "#/$defs/sha256"},
        "shared_bank_configuration_sha256": {"$ref": "#/$defs/sha256"}
      },
      "additionalProperties": false
    },
    "h07": {
      "type": "object",
      "required": ["experiment_id", "direct_id", "control_id", "configuration_sha256", "selection_sha256", "shared_bank_configuration_sha256", "evidence_sha256"],
      "properties": {
        "experiment_id": {"const": "H07"},
        "direct_id": {"const": "direct3over2-locked-route-v1"},
        "control_id": {"const": "direct2x-then-lanczos3-control-v1"},
        "configuration_sha256": {"$ref": "#/$defs/sha256"},
        "selection_sha256": {"$ref": "#/$defs/sha256"},
        "shared_bank_configuration_sha256": {"$ref": "#/$defs/sha256"},
        "evidence_sha256": {"$ref": "#/$defs/sha256"}
      },
      "additionalProperties": false
    },
    "nearest": {
      "type": "object",
      "required": ["control_id", "configuration_sha256", "selection_sha256", "shared_bank_configuration_sha256"],
      "properties": {
        "control_id": {"const": "nearest-same-writer-420v-v1"},
        "configuration_sha256": {"$ref": "#/$defs/sha256"},
        "selection_sha256": {"$ref": "#/$defs/sha256"},
        "shared_bank_configuration_sha256": {"$ref": "#/$defs/sha256"}
      },
      "additionalProperties": false
    },
    "currentProduction": {
      "type": "object",
      "required": ["control_id", "configuration_sha256", "selection_sha256", "shared_bank_configuration_sha256"],
      "properties": {
        "control_id": {"const": "p00-current-production-ash-baseline-v1"},
        "configuration_sha256": {"$ref": "#/$defs/sha256"},
        "selection_sha256": {"$ref": "#/$defs/sha256"},
        "shared_bank_configuration_sha256": {"$ref": "#/$defs/sha256"}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
