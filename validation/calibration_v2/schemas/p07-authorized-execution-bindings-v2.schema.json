{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mirmir.local/validation/calibration-v2/p07-authorized-execution-bindings-v2.schema.json",
  "type": "object",
  "required": [
    "schema_version", "artifact_kind", "p06_v2_identity", "status",
    "authorized_environment", "authorized_spawn_policy_version",
    "direct_mount_template_sha256", "direct_mount_template_digest_contract",
    "unavailable_reason", "loader", "sampling_plan", "mount_script",
    "unmount_script", "key_helper", "mount_table", "hdiutil",
    "production_execution_binding_fragment", "manifest_sha256"
  ],
  "properties": {
    "schema_version": {"const": "2.0.0"},
    "artifact_kind": {"const": "p07_authorized_execution_bindings_v2"},
    "p06_v2_identity": {"$ref": "#/$defs/p06Identity"},
    "status": {"const": "bound"},
    "authorized_environment": {"type": "object"},
    "authorized_spawn_policy_version": {"const": "p07-mandatory-suspended-runtime-identity-v1"},
    "direct_mount_template_sha256": {"$ref": "#/$defs/sha256"},
    "direct_mount_template_digest_contract": {"type": "string", "minLength": 1},
    "unavailable_reason": {"type": "null"},
    "loader": {"type": "object"},
    "sampling_plan": {"type": "object"},
    "mount_script": {"type": "object"},
    "unmount_script": {"type": "object"},
    "key_helper": {"type": "object"},
    "mount_table": {"type": "object"},
    "hdiutil": {"type": "object"},
    "production_execution_binding_fragment": {"type": "object"},
    "manifest_sha256": {"$ref": "#/$defs/sha256"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^(?!0{64}$)[0-9a-f]{64}$"},
    "p06Identity": {
      "type": "object", "minProperties": 8, "maxProperties": 8,
      "required": [
        "calibration_plan_v2_file_sha256", "candidate_vector_sha256",
        "shared_bank_configuration_sha256", "input_bundle_sha256",
        "p06_release_bundle_artifact_sha256", "selected_evaluation_file_sha256",
        "selected_evaluation_artifact_sha256", "selected_evaluation_semantic_sha256"
      ],
      "properties": {
        "calibration_plan_v2_file_sha256": {"$ref": "#/$defs/sha256"},
        "candidate_vector_sha256": {"$ref": "#/$defs/sha256"},
        "shared_bank_configuration_sha256": {"$ref": "#/$defs/sha256"},
        "input_bundle_sha256": {"$ref": "#/$defs/sha256"},
        "p06_release_bundle_artifact_sha256": {"$ref": "#/$defs/sha256"},
        "selected_evaluation_file_sha256": {"$ref": "#/$defs/sha256"},
        "selected_evaluation_artifact_sha256": {"$ref": "#/$defs/sha256"},
        "selected_evaluation_semantic_sha256": {"$ref": "#/$defs/sha256"}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
