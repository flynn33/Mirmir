{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mirmir.local/validation/calibration-v2/p06-run-input-manifest-v2.schema.json",
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^(?!0{64}$)[0-9a-f]{64}$"
    },
    "safeRelativePath": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?!.*\\\\)(?!.*//)(?!.*(?:^|/)\\.\\.?(?:/|$))(?!.*/$)[A-Za-z0-9._/-]+$"
    },
    "typedBinding": {
      "type": "object",
      "required": [
        "id",
        "artifact_kind",
        "content_type",
        "schema_sha256",
        "path",
        "sha256",
        "size_bytes"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
        },
        "artifact_kind": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
        },
        "content_type": {
          "enum": ["canonical_json", "json_schema", "opaque_bytes"]
        },
        "schema_sha256": {
          "oneOf": [
            {"$ref": "#/$defs/sha256"},
            {"type": "null"}
          ]
        },
        "path": {"$ref": "#/$defs/safeRelativePath"},
        "sha256": {"$ref": "#/$defs/sha256"},
        "size_bytes": {"type": "integer", "minimum": 1}
      },
      "allOf": [
        {
          "if": {
            "properties": {"content_type": {"const": "canonical_json"}},
            "required": ["content_type"]
          },
          "then": {"properties": {"schema_sha256": {"$ref": "#/$defs/sha256"}}},
          "else": {"properties": {"schema_sha256": {"type": "null"}}}
        }
      ],
      "additionalProperties": false
    },
    "authorityBindings": {
      "const": {
        "baseline_ablation_budget_v2": {
          "file_sha256": "1885aa30b46f72ed1de0570a3de5f615cf788ec0d494ed5396731279763da4c8",
          "schema_file_sha256": "080cc48a86569d68aecb0ca9384c89300df57dbeaa995e0651cf6082c969416b",
          "self_sha256": "405d9ca4413e7e291315257682f206d951a081f052d5ecee6f3a36ac72cd22be"
        },
        "calibration_plan_v2": {
          "file_sha256": "1977c85b9a3b7001294a04d33e7654ae20ffb4266ac0c8d2dc76880bdec99fef",
          "schema_file_sha256": "09a21861104bd1b03667d1207a79d523386ad4431e710ba44e4d298180753c09",
          "self_sha256": "e6070a7cdd8f3b53231635027055669c8319d311af1790d672723d6e7e048d0f"
        },
        "candidate_evidence_policy_v2": {
          "file_sha256": "d6df835467485f59b253e12d8e80cb8c8fa21dd308566ab3634495ccc8604433",
          "schema_file_sha256": "581a3bb6ba0ec3ea288076685124a9e7fd332aa883ee2165f18a27a4fb1c249e",
          "self_sha256": "70860c19f36efe41401e16381c80d6102b37f683056b2e3210a67e9d0b66dc75"
        },
        "compiler_contract_v2": {
          "file_sha256": "8c2f532ff126fd5517040a05c9f8669d2a83d1d7220f61fed5933d5fa470470a",
          "schema_file_sha256": "5f7a49e1f585e4f0e108e733ae3c6f28b47869b3cc2909419688714e76f57897",
          "self_sha256": "797d6fda359a6bfaca9487a31b0078a5eba8e41fdb6fd0985390e20c25df8237"
        },
        "shared_bank_configuration_identity_v2": {
          "file_sha256": "48f5eef7cf9f7c513cf8e6568b3eeb4d607845c1e70e6c39b6ca0192a4c297de",
          "schema_file_sha256": "0cee4c9ed9083d734491d90eaa3f02265b07295d7873733c006cce9df317147c",
          "self_sha256": "e522afa73e8dc01c51303d1d1d99a95fe2ea78f968a2696dc0583f695fce7c37"
        }
      }
    },
    "fixedExclusions": {
      "const": [
        {
          "path": "calibration-run-ledger-v2.json",
          "reason": "run_ledger_binds_run_input_manifest"
        },
        {
          "path": "p06-run-input-manifest-v2.json",
          "reason": "manifest_self"
        }
      ]
    },
    "failureCycleExclusion": {
      "type": "object",
      "required": ["failure_identity_sha256", "relation"],
      "properties": {
        "failure_identity_sha256": {"$ref": "#/$defs/sha256"},
        "relation": {"const": "failure_binds_this_manifest_and_is_cycle_excluded"}
      },
      "additionalProperties": false
    }
  },
  "type": "object",
  "required": [
    "schema_version",
    "artifact_kind",
    "manifest_role",
    "manifest_path",
    "authority_bindings",
    "run_id",
    "plan_id",
    "input_bundle_sha256",
    "source_commit",
    "working_tree_clean",
    "current_source",
    "provenance_status",
    "holdout_accessed",
    "provenance_receipt",
    "fixed_exclusions",
    "failure_cycle_exclusions",
    "failure_cycle_exclusion_count",
    "artifacts",
    "artifact_count",
    "directories",
    "closure_sha256",
    "manifest_sha256"
  ],
  "properties": {
    "schema_version": {"const": "2.0.0"},
    "artifact_kind": {"const": "p06_run_input_manifest_v2"},
    "manifest_role": {"const": "exact_authenticated_noncyclic_p06_run_input_closure"},
    "manifest_path": {"const": "p06-run-input-manifest-v2.json"},
    "authority_bindings": {"$ref": "#/$defs/authorityBindings"},
    "run_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
    },
    "plan_id": {"const": "mirmir-p06-spatial-calibration-v2"},
    "input_bundle_sha256": {
      "const": "ad46b6ec3d3629c3a29f17898c6a9b4eec1bca731276ff626dfe58f87bcadd20"
    },
    "source_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "working_tree_clean": {"const": true},
    "current_source": {"const": true},
    "provenance_status": {"const": "pass"},
    "holdout_accessed": {"const": false},
    "provenance_receipt": {
      "allOf": [
        {"$ref": "#/$defs/typedBinding"},
        {
          "properties": {
            "id": {"const": "p06_run_provenance_receipt_v2"},
            "artifact_kind": {"const": "p06_run_provenance_receipt_v2"},
            "content_type": {"const": "canonical_json"},
            "schema_sha256": {
              "const": "1eebdd2608bf4f10b2f62eb926b2974065fb00c74595ef9331c7752da679550c"
            },
            "path": {"const": "p06-run-provenance-receipt-v2.json"}
          }
        }
      ]
    },
    "fixed_exclusions": {"$ref": "#/$defs/fixedExclusions"},
    "failure_cycle_exclusions": {
      "type": "array",
      "items": {"$ref": "#/$defs/failureCycleExclusion"}
    },
    "failure_cycle_exclusion_count": {"type": "integer", "minimum": 0},
    "artifacts": {
      "type": "array",
      "minItems": 24,
      "items": {"$ref": "#/$defs/typedBinding"}
    },
    "artifact_count": {"type": "integer", "minimum": 24},
    "directories": {
      "type": "array",
      "items": {"$ref": "#/$defs/safeRelativePath"},
      "uniqueItems": true
    },
    "closure_sha256": {"$ref": "#/$defs/sha256"},
    "manifest_sha256": {"$ref": "#/$defs/sha256"}
  },
  "additionalProperties": false
}
