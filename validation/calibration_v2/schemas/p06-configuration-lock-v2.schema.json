{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mirmir.local/validation/calibration-v2/p06-configuration-lock-v2.schema.json",
  "title": "Mirmir P06 schema-2 selected-candidate configuration lock",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "artifact_kind",
    "status",
    "locked_utc",
    "configuration_id",
    "candidate_vector_sha256",
    "shared_bank_configuration_sha256",
    "calibration_selection",
    "selected_evaluation",
    "configuration_files",
    "candidate_bytes_rewritten_after_selection",
    "holdout_accessed",
    "manifest_sha256"
  ],
  "properties": {
    "schema_version": {"const": "2.0.0"},
    "artifact_kind": {"const": "p06_configuration_lock_v2"},
    "status": {"const": "locked_before_p07"},
    "locked_utc": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]{1,6})?Z$"
    },
    "configuration_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]{2,127}$"
    },
    "candidate_vector_sha256": {"$ref": "#/$defs/sha256"},
    "shared_bank_configuration_sha256": {"$ref": "#/$defs/sha256"},
    "calibration_selection": {
      "allOf": [
        {"$ref": "#/$defs/fileBinding"},
        {"properties": {"path": {"const": "calibration-selection-v2.json"}}}
      ]
    },
    "selected_evaluation": {
      "allOf": [
        {"$ref": "#/$defs/fileBinding"},
        {"properties": {"path": {"pattern": "^evaluations/[0-9a-f]{64}\\.json$"}}}
      ]
    },
    "configuration_files": {
      "type": "array",
      "minItems": 9,
      "maxItems": 9,
      "prefixItems": [
        {"$ref": "#/$defs/lockedMapping"},
        {"$ref": "#/$defs/lockedOperatorBank"},
        {"$ref": "#/$defs/lockedQualityPolicy"},
        {"$ref": "#/$defs/lockedMetricPolicy"},
        {"$ref": "#/$defs/lockedCompilerInputV2"},
        {"$ref": "#/$defs/direct2xLut"},
        {"$ref": "#/$defs/direct3Over2Lut"},
        {"$ref": "#/$defs/nativeParityManifest"},
        {"$ref": "#/$defs/lutManifest"}
      ],
      "items": false
    },
    "candidate_bytes_rewritten_after_selection": {"const": false},
    "holdout_accessed": {"const": false},
    "manifest_sha256": {"$ref": "#/$defs/sha256"}
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^(?!0{64}$)[0-9a-f]{64}$"
    },
    "safeRelativePath": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?!.*\\\\)(?!.*//)(?!.*(?:^|/)\\.\\.?(?:/|$))(?!.*/$)[A-Za-z0-9._/-]+$"
    },
    "fileBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256", "size_bytes"],
      "properties": {
        "path": {"$ref": "#/$defs/safeRelativePath"},
        "sha256": {"$ref": "#/$defs/sha256"},
        "size_bytes": {"type": "integer", "minimum": 1}
      }
    },
    "configurationFile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "path", "sha256", "size_bytes"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "path": {"$ref": "#/$defs/safeRelativePath"},
        "sha256": {"$ref": "#/$defs/sha256"},
        "size_bytes": {"type": "integer", "minimum": 1}
      }
    },
    "lockedMapping": {
      "allOf": [
        {"$ref": "#/$defs/configurationFile"},
        {"properties": {"id": {"const": "locked_mapping"}, "path": {"const": "locked-mapping.json"}}}
      ]
    },
    "lockedOperatorBank": {
      "allOf": [
        {"$ref": "#/$defs/configurationFile"},
        {"properties": {"id": {"const": "locked_operator_bank"}, "path": {"const": "locked-operator-bank.json"}}}
      ]
    },
    "lockedQualityPolicy": {
      "allOf": [
        {"$ref": "#/$defs/configurationFile"},
        {"properties": {"id": {"const": "locked_quality_policy"}, "path": {"const": "locked-quality-policy.json"}}}
      ]
    },
    "lockedMetricPolicy": {
      "allOf": [
        {"$ref": "#/$defs/configurationFile"},
        {"properties": {"id": {"const": "locked_metric_policy"}, "path": {"const": "locked-metric-policy.json"}}}
      ]
    },
    "lockedCompilerInputV2": {
      "allOf": [
        {"$ref": "#/$defs/configurationFile"},
        {"properties": {"id": {"const": "locked_compiler_input_v2"}, "path": {"const": "locked-compiler-input-v2.json"}}}
      ]
    },
    "direct2xLut": {
      "allOf": [
        {"$ref": "#/$defs/configurationFile"},
        {"properties": {"id": {"const": "direct2x_lut"}, "path": {"const": "direct2x.ashlut"}}}
      ]
    },
    "direct3Over2Lut": {
      "allOf": [
        {"$ref": "#/$defs/configurationFile"},
        {"properties": {"id": {"const": "direct3over2_lut"}, "path": {"const": "direct3over2.ashlut"}}}
      ]
    },
    "nativeParityManifest": {
      "allOf": [
        {"$ref": "#/$defs/configurationFile"},
        {"properties": {"id": {"const": "native_parity_manifest"}, "path": {"const": "native-lut-parity-manifest-v3.json"}}}
      ]
    },
    "lutManifest": {
      "allOf": [
        {"$ref": "#/$defs/configurationFile"},
        {"properties": {"id": {"const": "lut_manifest"}, "path": {"const": "lut-manifest-v3.json"}}}
      ]
    }
  }
}
