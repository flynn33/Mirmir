{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mirmir.local/validation/calibration-v2/g08-gate-manifest-v1.schema.json",
  "type": "object",
  "required": [
    "schema_version", "artifact_kind", "gate_id", "evidence_identity",
    "status", "all_mandatory_checks_passed", "checks", "evidence",
    "holdout_accessed", "raw_artifacts_preserved", "hash_scope",
    "artifact_sha256"
  ],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "artifact_kind": {"const": "g08_gate_manifest"},
    "gate_id": {"const": "G08"},
    "evidence_identity": {
      "$ref": "https://mirmir.local/validation/calibration-v2/p08-common-v1.schema.json#/$defs/identity"
    },
    "status": {"enum": ["pass", "fail"]},
    "all_mandatory_checks_passed": {"type": "boolean"},
    "checks": {
      "type": "array", "minItems": 15, "maxItems": 15,
      "items": {"$ref": "#/$defs/check"}
    },
    "evidence": {
      "type": "array", "minItems": 5, "maxItems": 5,
      "items": {
        "$ref": "https://mirmir.local/validation/calibration-v2/p08-common-v1.schema.json#/$defs/evidenceBinding"
      }
    },
    "holdout_accessed": {"const": false},
    "raw_artifacts_preserved": {"const": true},
    "hash_scope": {
      "const": "canonical sorted-key compact UTF-8 JSON excluding /artifact_sha256"
    },
    "artifact_sha256": {
      "$ref": "https://mirmir.local/validation/calibration-v2/p08-common-v1.schema.json#/$defs/sha256"
    }
  },
  "additionalProperties": false,
  "$defs": {
    "check": {
      "type": "object",
      "required": ["check_id", "status", "evidence_ids", "observed"],
      "properties": {
        "check_id": {
          "enum": [
            "metal_execution", "parity_coverage", "numeric_parity",
            "exact_state_message_lut", "same_device_determinism",
            "performance_protocol", "same_machine_speedup",
            "frames_per_second", "dispatch_overhead_budget",
            "calibration_estimate_error", "no_runtime_tree_or_cpu_loop",
            "no_production_wait", "no_avoidable_readback",
            "resource_ring_and_memory", "profile_and_capture_closure"
          ]
        },
        "status": {"enum": ["pass", "fail"]},
        "evidence_ids": {
          "type": "array", "minItems": 1, "uniqueItems": true,
          "items": {
            "enum": [
              "metal_parity", "performance_results", "resource_ring_results",
              "instruments_manifest", "gpu_capture_manifest"
            ]
          }
        },
        "observed": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": {
            "type": ["string", "number", "integer", "boolean"]
          }
        }
      },
      "additionalProperties": false
    }
  }
}
