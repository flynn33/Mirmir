{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mirmir.local/validation/calibration-v2/instruction-conflict-normalization-v1.schema.json",
  "title": "Mirmir instruction-package conflict normalization",
  "type": "object",
  "required": [
    "schema_version",
    "artifact_kind",
    "contract_id",
    "status",
    "source_root_contract",
    "authority",
    "resolutions",
    "hash_scope",
    "manifest_sha256",
    "source_package_manifest_sha256"
  ],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "artifact_kind": {"const": "instruction_conflict_normalization"},
    "contract_id": {"const": "mirmir-ash-instruction-conflict-normalization-v1"},
    "status": {"const": "locked_pre_holdout_normalization"},
    "source_root_contract": {
      "const": "Every source path is relative to the immutable instruction-package root; every SHA-256 covers the complete source file bytes."
    },
    "authority": {"$ref": "#/$defs/sourceReference"},
    "resolutions": {
      "type": "array",
      "minItems": 6,
      "maxItems": 6,
      "prefixItems": [
        {
          "allOf": [
            {"$ref": "#/$defs/resolution"},
            {
              "properties": {
                "id": {"const": "p07_failed_version_archive_failure_only"},
                "decision": {"$ref": "#/$defs/p07FailureArchiveDecision"}
              }
            }
          ]
        },
        {
          "allOf": [
            {"$ref": "#/$defs/resolution"},
            {
              "properties": {
                "id": {"const": "p08_canonical_metal_parity_artifact"},
                "decision": {"$ref": "#/$defs/p08ParityDecision"}
              }
            }
          ]
        },
        {
          "allOf": [
            {"$ref": "#/$defs/resolution"},
            {
              "properties": {
                "id": {"const": "p08_media_plan_interface_boundary"},
                "decision": {"$ref": "#/$defs/p08MediaPlanDecision"}
              }
            }
          ]
        },
        {
          "allOf": [
            {"$ref": "#/$defs/resolution"},
            {
              "properties": {
                "id": {"const": "p11_macos_xcode_targets_and_swift_oracle"},
                "decision": {"$ref": "#/$defs/p11TargetsDecision"}
              }
            }
          ]
        },
        {
          "allOf": [
            {"$ref": "#/$defs/resolution"},
            {
              "properties": {
                "id": {"const": "p11_visual_studio_evidence_normalization"},
                "decision": {"$ref": "#/$defs/p11VisualStudioDecision"}
              }
            }
          ]
        },
        {
          "allOf": [
            {"$ref": "#/$defs/resolution"},
            {
              "properties": {
                "id": {"const": "p11_macos_conformance_destination_normalization"},
                "decision": {"$ref": "#/$defs/p11DestinationDecision"}
              }
            }
          ]
        }
      ],
      "items": false
    },
    "hash_scope": {
      "const": "canonical sorted-key compact UTF-8 JSON excluding /manifest_sha256"
    },
    "manifest_sha256": {"$ref": "#/$defs/sha256"},
    "source_package_manifest_sha256": {
      "const": "bac31029e2aa0e9ef89cb25f36c9cfd9ac5ce0920e546bd3dea0edea06520afd"
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^(?!0{64}$)[0-9a-f]{64}$"
    },
    "sourceReference": {
      "type": "object",
      "required": ["path", "line_start", "line_end", "sha256", "role"],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1,
          "pattern": "^(config|instructions)/[^/].*"
        },
        "line_start": {"type": "integer", "minimum": 1},
        "line_end": {"type": "integer", "minimum": 1},
        "sha256": {"$ref": "#/$defs/sha256"},
        "role": {"enum": ["authority", "conflicting", "controlling", "context"]}
      },
      "additionalProperties": false
    },
    "resolution": {
      "type": "object",
      "required": ["id", "conflict", "decision", "source_references"],
      "properties": {
        "id": {
          "enum": [
            "p07_failed_version_archive_failure_only",
            "p08_canonical_metal_parity_artifact",
            "p08_media_plan_interface_boundary",
            "p11_macos_xcode_targets_and_swift_oracle",
            "p11_visual_studio_evidence_normalization",
            "p11_macos_conformance_destination_normalization"
          ]
        },
        "conflict": {"type": "string", "minLength": 1},
        "decision": {"type": "object"},
        "source_references": {
          "type": "array",
          "minItems": 2,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/sourceReference"}
        }
      },
      "additionalProperties": false
    },
    "p07FailureArchiveDecision": {
      "type": "object",
      "required": ["artifact", "emission", "success_presence", "failure_presence"],
      "properties": {
        "artifact": {"const": "failed-version-archive.json"},
        "emission": {"const": "failure_only"},
        "success_presence": {"const": false},
        "failure_presence": {"const": true}
      },
      "additionalProperties": false
    },
    "p08ParityDecision": {
      "type": "object",
      "required": ["canonical_artifact", "rejected_aliases", "component"],
      "properties": {
        "canonical_artifact": {"const": "metal-parity.json"},
        "rejected_aliases": {
          "const": ["metal-parity-results.json"]
        },
        "component": {"const": "C10"}
      },
      "additionalProperties": false
    },
    "p08MediaPlanDecision": {
      "type": "object",
      "required": [
        "p08_allowed_scope",
        "p09_required_scope",
        "early_g09_claim_allowed"
      ],
      "properties": {
        "p08_allowed_scope": {"const": ["immutable_media_plan_interface_required_by_C09"]},
        "p09_required_scope": {
          "const": [
            "complete_C08_media_semantics_implementation",
            "complete_G09_evidence"
          ]
        },
        "early_g09_claim_allowed": {"const": false}
      },
      "additionalProperties": false
    },
    "p11TargetsDecision": {
      "type": "object",
      "required": [
        "platform",
        "required_xcode_targets",
        "reference_oracle_language",
        "python_role",
        "contradictory_text_nonoperative"
      ],
      "properties": {
        "platform": {"const": "macOS"},
        "required_xcode_targets": {
          "const": [
            "Mirmir",
            "MirmirTests",
            "ASHCoreConformanceTests",
            "ASHMetalParityTests",
            "MirmirPipelineTests",
            "MirmirPerformanceTests"
          ]
        },
        "reference_oracle_language": {"const": "Swift"},
        "python_role": {"const": "test_and_automation_only"},
        "contradictory_text_nonoperative": {"const": true}
      },
      "additionalProperties": false
    },
    "p11VisualStudioDecision": {
      "type": "object",
      "required": ["canonical_artifact", "rejected_artifacts", "platform"],
      "properties": {
        "canonical_artifact": {"const": "xcode-evidence.json"},
        "rejected_artifacts": {"const": ["visual-studio-evidence.json"]},
        "platform": {"const": "macOS"}
      },
      "additionalProperties": false
    },
    "p11DestinationDecision": {
      "type": "object",
      "required": [
        "conformance_target",
        "destination",
        "simulator_host_required",
        "cli_reproduction_required"
      ],
      "properties": {
        "conformance_target": {"const": "ASHCoreConformanceTests"},
        "destination": {"const": "Apple Silicon Mac"},
        "simulator_host_required": {"const": false},
        "cli_reproduction_required": {"const": true}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
