{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mirmir.local/validation/calibration-v2/p07-failure-log-v2.schema.json",
  "type": "object",
  "required": [
    "schema_version", "artifact_kind", "p06_v2_identity", "status",
    "failure_type", "failure_message", "failure_message_sha256",
    "failure_traceback", "failure_traceback_sha256", "secondary_failure",
    "archive_publication_failure", "failure_stage", "transaction_state",
    "cleanup_result", "media_asset_id", "media_case_id", "frame_index",
    "presentation_timestamp", "media_context_available",
    "requested_output_directory", "temporary_run_path", "holdout_access_consumed",
    "command", "platform", "manifest_sha256"
  ],
  "properties": {
    "schema_version": {"const": "2.0.0"},
    "artifact_kind": {"const": "p07_failure_log_v2"},
    "p06_v2_identity": {"$ref": "#/$defs/p06Identity"},
    "status": {"const": "failed"},
    "failure_type": {"type": "string", "minLength": 1},
    "failure_message": {"type": "string"},
    "failure_message_sha256": {"$ref": "#/$defs/sha256"},
    "failure_traceback": {"type": "string"},
    "failure_traceback_sha256": {"$ref": "#/$defs/sha256"},
    "secondary_failure": {"type": ["object", "null"]},
    "archive_publication_failure": {"type": ["object", "null"]},
    "failure_stage": {"enum": ["pre_guard_validation", "guard_or_authorized_execution", "post_guard_publication", "restart_recovery"]},
    "transaction_state": {"type": "object"},
    "cleanup_result": {"type": "object"},
    "media_asset_id": {"type": ["string", "null"]},
    "media_case_id": {"type": ["string", "null"]},
    "frame_index": {"type": ["integer", "null"], "minimum": 0},
    "presentation_timestamp": {"type": ["object", "null"]},
    "media_context_available": {"type": "boolean"},
    "requested_output_directory": {"type": "string", "minLength": 1},
    "temporary_run_path": {"type": ["string", "null"]},
    "holdout_access_consumed": {"type": ["boolean", "null"]},
    "command": {"type": "string", "minLength": 1},
    "platform": {"type": "string", "minLength": 1},
    "manifest_sha256": {"$ref": "#/$defs/sha256"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^(?!0{64}$)[0-9a-f]{64}$"},
    "p06Identity": {
      "type": "object", "minProperties": 8, "maxProperties": 8,
      "required": [
        "calibration_plan_v2_file_sha256", "candidate_vector_sha256",
        "shared_bank_configuration_sha256", "input_bundle_sha256",
        "p06_release_bundle_artifact_sha256", "selected_evaluation_file_sha256",
        "selected_evaluation_artifact_sha256", "selected_evaluation_semantic_sha256"
      ],
      "properties": {
        "calibration_plan_v2_file_sha256": {"$ref": "#/$defs/sha256"},
        "candidate_vector_sha256": {"$ref": "#/$defs/sha256"},
        "shared_bank_configuration_sha256": {"$ref": "#/$defs/sha256"},
        "input_bundle_sha256": {"$ref": "#/$defs/sha256"},
        "p06_release_bundle_artifact_sha256": {"$ref": "#/$defs/sha256"},
        "selected_evaluation_file_sha256": {"$ref": "#/$defs/sha256"},
        "selected_evaluation_artifact_sha256": {"$ref": "#/$defs/sha256"},
        "selected_evaluation_semantic_sha256": {"$ref": "#/$defs/sha256"}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
