{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mirmir.local/validation/calibration-v2/p06-run-provenance-receipt-v2.schema.json",
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^(?!0{64}$)[0-9a-f]{64}$"
    },
    "safeRelativePath": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?!.*\\\\)(?!.*//)(?!.*(?:^|/)\\.\\.?(?:/|$))(?!.*/$)[A-Za-z0-9._/-]+$"
    },
    "typedBinding": {
      "type": "object",
      "required": [
        "id",
        "artifact_kind",
        "content_type",
        "schema_sha256",
        "path",
        "sha256",
        "size_bytes"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
        },
        "artifact_kind": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
        },
        "content_type": {
          "enum": ["canonical_json", "json_schema", "opaque_bytes"]
        },
        "schema_sha256": {
          "oneOf": [
            {"$ref": "#/$defs/sha256"},
            {"type": "null"}
          ]
        },
        "path": {"$ref": "#/$defs/safeRelativePath"},
        "sha256": {"$ref": "#/$defs/sha256"},
        "size_bytes": {"type": "integer", "minimum": 1}
      },
      "allOf": [
        {
          "if": {
            "properties": {"content_type": {"const": "canonical_json"}},
            "required": ["content_type"]
          },
          "then": {"properties": {"schema_sha256": {"$ref": "#/$defs/sha256"}}},
          "else": {"properties": {"schema_sha256": {"type": "null"}}}
        }
      ],
      "additionalProperties": false
    },
    "gateReceipt": {
      "type": "object",
      "required": [
        "id",
        "artifact_kind",
        "content_type",
        "schema_sha256",
        "path",
        "sha256",
        "size_bytes",
        "source_commit",
        "working_tree_clean",
        "current_source",
        "status",
        "holdout_accessed",
        "closure_bindings"
      ],
      "properties": {
        "id": {"enum": ["G04", "G05", "G06"]},
        "artifact_kind": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
        },
        "content_type": {"const": "canonical_json"},
        "schema_sha256": {"$ref": "#/$defs/sha256"},
        "path": {"$ref": "#/$defs/safeRelativePath"},
        "sha256": {"$ref": "#/$defs/sha256"},
        "size_bytes": {"type": "integer", "minimum": 1},
        "source_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "working_tree_clean": {"const": true},
        "current_source": {"const": true},
        "status": {"const": "pass"},
        "holdout_accessed": {"const": false},
        "closure_bindings": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/typedBinding"}
        }
      },
      "additionalProperties": false
    },
    "tool": {
      "type": "object",
      "required": [
        "id",
        "executable",
        "executable_sha256",
        "version",
        "version_sha256"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
        },
        "executable": {"type": "string", "minLength": 1},
