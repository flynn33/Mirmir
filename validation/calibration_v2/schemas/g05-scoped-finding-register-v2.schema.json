{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mirmir.local/validation/calibration-v2/g05-scoped-finding-register-v2.schema.json",
  "type": "object",
  "required": [
    "schema_version",
    "artifact_kind",
    "gate_id",
    "phase",
    "source_commit",
    "review_status",
    "scope",
    "open_counts",
    "findings",
    "register_sha256"
  ],
  "properties": {
    "schema_version": {"const": "2.0.0"},
    "artifact_kind": {"const": "g05_scoped_finding_register"},
    "gate_id": {"const": "G05"},
    "phase": {"const": "P05"},
    "source_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "review_status": {"const": "pass"},
    "scope": {
      "type": "array",
      "minItems": 8,
      "maxItems": 8,
      "prefixItems": [
        {"const": "development-mapping.json"},
        {"const": "state-fixtures.json"},
        {"const": "operator-discrimination.json"},
        {"const": "operator-distinctness.json"},
        {"const": "coordinate-comparison.json"},
        {"const": "state-causality-results.json"},
        {"const": "cpu-reference-results.json"},
        {"const": "cpu-reference-vectors.json"}
      ],
      "items": false
    },
    "open_counts": {
      "type": "object",
      "required": ["severity_1", "severity_2"],
      "properties": {
        "severity_1": {"const": 0},
        "severity_2": {"const": 0}
      },
      "additionalProperties": false
    },
    "findings": {
      "type": "array",
      "maxItems": 0
    },
    "register_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  },
  "additionalProperties": false
}
