{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mirmir.local/validation/calibration-v2/p07-execution-result-v1.schema.json",
  "type": "object",
  "required": [
    "schema_version",
    "artifact_kind",
    "status",
    "configuration_sha256",
    "configuration_id",
    "release_bundle_manifest_sha256",
    "input_bundle_sha256",
    "direct_input_bindings",
    "corpus_lock_bundle_sha256",
    "sampling_plan_file_sha256",
    "sampling_plan_manifest_sha256",
    "no_pixel_attestation_file_sha256",
    "loader_executable_sha256",
    "authorized_execution_bindings_file_sha256",
    "authorized_execution_bindings_manifest_sha256",
    "p07_preopen_cache_tree_sha256",
    "inner_inventory_sha256",
    "frame_extraction_manifest_sha256",
    "evaluation_sha256",
    "runtime_evidence_manifest_sha256",
    "g07_gate_pass",
    "support_evidence_revalidated_after_evaluation",
    "direct_p06_inputs_revalidated_after_evaluation",
    "mount_detached_before_publication",
    "temporary_nv12_crops_published",
    "holdout_accessed",
    "configuration_files_modified_after_holdout",
    "holdout_access_consumed",
    "holdout_access_state",
    "holdout_access_evidence_source",
    "holdout_access_ledger_file_sha256",
    "holdout_access_ledger_tip_sha256",
    "holdout_access_ledger_event_count",
    "holdout_access_ledger_event_order",
    "holdout_access_configuration_sha256",
    "holdout_access_immutable_anchor_file_sha256",
    "holdout_access_open_intent_linked",
    "holdout_access_ledger_verification_error_sha256",
    "manifest_sha256"
  ],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "artifact_kind": {"const": "p07_locked_holdout_execution"},
    "status": {"const": "complete"},
    "configuration_sha256": {"$ref": "#/$defs/sha256"},
    "configuration_id": {"type": "string", "minLength": 1},
    "release_bundle_manifest_sha256": {"$ref": "#/$defs/sha256"},
    "input_bundle_sha256": {"$ref": "#/$defs/sha256"},
    "direct_input_bindings": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/directInputBinding"}
    },
    "corpus_lock_bundle_sha256": {"$ref": "#/$defs/sha256"},
    "sampling_plan_file_sha256": {"$ref": "#/$defs/sha256"},
    "sampling_plan_manifest_sha256": {"$ref": "#/$defs/sha256"},
    "no_pixel_attestation_file_sha256": {"$ref": "#/$defs/sha256"},
    "loader_executable_sha256": {"$ref": "#/$defs/sha256"},
    "authorized_execution_bindings_file_sha256": {"$ref": "#/$defs/sha256"},
    "authorized_execution_bindings_manifest_sha256": {"$ref": "#/$defs/sha256"},
    "p07_preopen_cache_tree_sha256": {"$ref": "#/$defs/sha256"},
    "inner_inventory_sha256": {"$ref": "#/$defs/sha256"},
    "frame_extraction_manifest_sha256": {"$ref": "#/$defs/sha256"},
    "evaluation_sha256": {"$ref": "#/$defs/sha256"},
    "runtime_evidence_manifest_sha256": {"$ref": "#/$defs/sha256"},
    "g07_gate_pass": {"type": "boolean"},
    "support_evidence_revalidated_after_evaluation": {"const": true},
    "direct_p06_inputs_revalidated_after_evaluation": {"const": true},
    "mount_detached_before_publication": {"const": true},
    "temporary_nv12_crops_published": {"const": false},
    "holdout_accessed": {"const": true},
    "configuration_files_modified_after_holdout": {"const": false},
    "holdout_access_consumed": {"const": true},
    "holdout_access_state": {"const": "completed"},
    "holdout_access_evidence_source": {"const": "live_guard_ledger"},
    "holdout_access_ledger_file_sha256": {"$ref": "#/$defs/sha256"},
    "holdout_access_ledger_tip_sha256": {"$ref": "#/$defs/sha256"},
    "holdout_access_ledger_event_count": {"const": 4},
    "holdout_access_ledger_event_order": {
      "const": ["sealed", "open_intent", "opened", "completed"]
    },
    "holdout_access_configuration_sha256": {"$ref": "#/$defs/sha256"},
    "holdout_access_immutable_anchor_file_sha256": {"$ref": "#/$defs/sha256"},
    "holdout_access_open_intent_linked": {"const": true},
    "holdout_access_ledger_verification_error_sha256": {"const": null},
    "manifest_sha256": {"$ref": "#/$defs/sha256"}
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^(?!0{64}$)[0-9a-f]{64}$"
    },
    "directInputBinding": {
      "type": "object",
      "required": ["id", "path", "sha256", "size_bytes"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "path": {"type": "string", "minLength": 1},
        "sha256": {"$ref": "#/$defs/sha256"},
        "size_bytes": {"type": "integer", "minimum": 1}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
