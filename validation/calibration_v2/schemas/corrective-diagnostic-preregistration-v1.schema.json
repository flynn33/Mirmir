{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "corrective-diagnostic-preregistration-v1.schema.json",
  "title": "P06 open-development corrective diagnostic preregistration",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "artifact_kind",
    "status",
    "preregistered_utc",
    "split",
    "validation_accessed",
    "holdout_accessed",
    "selected_winner",
    "bindings",
    "candidate",
    "dimension_contracts",
    "incumbent_derivation",
    "artifact_sha256"
  ],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "artifact_kind": {"const": "p06_open_development_corrective_diagnostic_preregistration"},
    "status": {"const": "preregistered_not_executed"},
    "preregistered_utc": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{1,9})?Z$"
    },
    "split": {"const": "development"},
    "validation_accessed": {"const": false},
    "holdout_accessed": {"const": false},
    "selected_winner": {"type": "null"},
    "bindings": {"$ref": "#/$defs/bindings"},
    "candidate": {"$ref": "#/$defs/candidate"},
    "dimension_contracts": {"$ref": "#/$defs/dimensionContracts"},
    "incumbent_derivation": {"$ref": "#/$defs/incumbentDerivation"},
    "artifact_sha256": {"$ref": "#/$defs/sha256"}
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "gitObject": {
      "type": "string",
      "pattern": "^(?:[0-9a-f]{40}|[0-9a-f]{64})$"
    },
    "absolutePath": {
      "type": "string",
      "pattern": "^/"
    },
    "directoryIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["lexical_path", "real_path", "device", "inode"],
      "properties": {
        "lexical_path": {"$ref": "#/$defs/absolutePath"},
        "real_path": {"$ref": "#/$defs/absolutePath"},
        "device": {"type": "integer", "minimum": 0},
        "inode": {"type": "integer", "minimum": 1}
      }
    },
    "fileBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "lexical_path",
        "file_sha256",
        "size_bytes",
        "device",
        "inode"
      ],
      "properties": {
        "lexical_path": {"$ref": "#/$defs/absolutePath"},
        "file_sha256": {"$ref": "#/$defs/sha256"},
        "size_bytes": {"type": "integer", "minimum": 1},
        "device": {"type": "integer", "minimum": 0},
        "inode": {"type": "integer", "minimum": 1}
      }
    },
    "gateBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["artifact_root", "manifest", "receipt", "report"],
      "properties": {
        "artifact_root": {"$ref": "#/$defs/directoryIdentity"},
        "manifest": {"$ref": "#/$defs/fileBinding"},
        "receipt": {"$ref": "#/$defs/fileBinding"},
        "report": {"$ref": "#/$defs/fileBinding"}
      }
    },
    "repositoryBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "root",
        "git_head_commit",
        "git_index_tree",
        "tracked_status_sha256",
        "tracked_status_size_bytes",
        "modified_tracked_file_count",
        "modified_tracked_manifest_sha256"
      ],
      "properties": {
        "root": {"$ref": "#/$defs/directoryIdentity"},
        "git_head_commit": {"$ref": "#/$defs/gitObject"},
        "git_index_tree": {"$ref": "#/$defs/gitObject"},
        "tracked_status_sha256": {"$ref": "#/$defs/sha256"},
        "tracked_status_size_bytes": {"type": "integer", "minimum": 0},
        "modified_tracked_file_count": {"type": "integer", "minimum": 0},
        "modified_tracked_manifest_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "calibrationPlanBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["file", "document_sha256"],
      "properties": {
        "file": {"$ref": "#/$defs/fileBinding"},
        "document_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "failedRunBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "archive_root",
        "attempt_ledger",
        "failure_record",
        "input_bindings",
        "transaction_intent",
        "attempt_count",
        "tail_record_sha256",
        "referenced_binding_count",
        "unique_evaluation_file_count",
        "unique_control_file_count",
        "archive_closure_manifest_sha256"
      ],
      "properties": {
        "archive_root": {"$ref": "#/$defs/directoryIdentity"},
        "attempt_ledger": {"$ref": "#/$defs/fileBinding"},
        "failure_record": {"$ref": "#/$defs/fileBinding"},
        "input_bindings": {"$ref": "#/$defs/fileBinding"},
        "transaction_intent": {"$ref": "#/$defs/fileBinding"},
        "attempt_count": {"type": "integer", "minimum": 1},
        "tail_record_sha256": {"$ref": "#/$defs/sha256"},
        "referenced_binding_count": {"type": "integer", "minimum": 4},
        "unique_evaluation_file_count": {"type": "integer", "minimum": 1},
        "unique_control_file_count": {"type": "integer", "minimum": 1},
        "archive_closure_manifest_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "liveHoldoutBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "live_ledger_path",
        "live_anchor_path",
        "live_preopen_receipt_path",
        "repository_sealed_copy_path",
        "repository_attestation_path",
        "expected_live_ledger_root_identity_sha256",
        "expected_live_anchor_root_identity_sha256",
        "expected_live_preopen_receipt_sha256",
        "expected_repository_sealed_copy_sha256",
        "expected_repository_attestation_sha256",
        "fresh_verification",
        "fresh_verification_sha256"
      ],
      "properties": {
        "live_ledger_path": {"$ref": "#/$defs/absolutePath"},
        "live_anchor_path": {"$ref": "#/$defs/absolutePath"},
        "live_preopen_receipt_path": {"$ref": "#/$defs/absolutePath"},
        "repository_sealed_copy_path": {"$ref": "#/$defs/absolutePath"},
        "repository_attestation_path": {"$ref": "#/$defs/absolutePath"},
        "expected_live_ledger_root_identity_sha256": {"$ref": "#/$defs/sha256"},
        "expected_live_anchor_root_identity_sha256": {"$ref": "#/$defs/sha256"},
        "expected_live_preopen_receipt_sha256": {"$ref": "#/$defs/sha256"},
        "expected_repository_sealed_copy_sha256": {"$ref": "#/$defs/sha256"},
        "expected_repository_attestation_sha256": {"$ref": "#/$defs/sha256"},
        "fresh_verification": {"$ref": "#/$defs/freshVerification"},
        "fresh_verification_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "freshVerification": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "artifact_kind",
        "verification_status",
        "access_status",
        "access_count",
        "open_intent_anchor_present",
        "pixel_content_included",
        "live_ledger_sha256",
        "live_ledger_root_identity_sha256",
        "live_anchor_root_identity_sha256",
        "live_preopen_receipt_sha256",
        "repository_sealed_copy_sha256",
        "repository_attestation_sha256",
        "corpus_binding_sha256",
        "verification_receipt_sha256"
      ],
      "properties": {
        "schema_version": {"const": "1.0.0"},
        "artifact_kind": {"const": "live_holdout_preopen_verification"},
        "verification_status": {"const": "pass"},
        "access_status": {"const": "unopened"},
        "access_count": {"const": 0},
        "open_intent_anchor_present": {"const": false},
        "pixel_content_included": {"const": false},
        "live_ledger_sha256": {"$ref": "#/$defs/sha256"},
        "live_ledger_root_identity_sha256": {"$ref": "#/$defs/sha256"},
        "live_anchor_root_identity_sha256": {"$ref": "#/$defs/sha256"},
        "live_preopen_receipt_sha256": {"$ref": "#/$defs/sha256"},
        "repository_sealed_copy_sha256": {"$ref": "#/$defs/sha256"},
        "repository_attestation_sha256": {"$ref": "#/$defs/sha256"},
        "corpus_binding_sha256": {"$ref": "#/$defs/sha256"},
        "verification_receipt_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "developmentCorpusBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "open_split_root",
        "corpus_lock_file_sha256",
        "corpus_lock_manifest_sha256",
        "development_sample_lock_file_sha256",
        "development_sample_lock_manifest_sha256",
        "development_sample_count",
        "development_sample_bindings_sha256"
      ],
      "properties": {
        "open_split_root": {"$ref": "#/$defs/directoryIdentity"},
        "corpus_lock_file_sha256": {"$ref": "#/$defs/sha256"},
        "corpus_lock_manifest_sha256": {"$ref": "#/$defs/sha256"},
        "development_sample_lock_file_sha256": {"$ref": "#/$defs/sha256"},
        "development_sample_lock_manifest_sha256": {"$ref": "#/$defs/sha256"},
        "development_sample_count": {"const": 6},
        "development_sample_bindings_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "runtimeBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "native_executable_sha256",
        "native_source_manifest_sha256",
        "native_code_identity_sha256",
        "native_configuration_sha256",
        "writer_executable_sha256",
        "writer_product_settings_source_sha256",
        "writer_settings_sha256",
        "writer_code_identity_sha256",
        "coordinate_model_contract_file_sha256",
        "coordinate_model_contract_sha256",
        "video_profile_contract_file_sha256",
        "video_profile_contract_sha256",
        "quality_harness_implementation_manifest_file_sha256",
        "quality_harness_implementation_manifest_sha256",
        "metric_policy_file_sha256",
        "metric_policy_sha256",
        "metric_implementation_binding_sha256"
      ],
      "properties": {
        "native_executable_sha256": {"$ref": "#/$defs/sha256"},
        "native_source_manifest_sha256": {"$ref": "#/$defs/sha256"},
        "native_code_identity_sha256": {"$ref": "#/$defs/sha256"},
        "native_configuration_sha256": {"$ref": "#/$defs/sha256"},
        "writer_executable_sha256": {"$ref": "#/$defs/sha256"},
        "writer_product_settings_source_sha256": {"$ref": "#/$defs/sha256"},
        "writer_settings_sha256": {"$ref": "#/$defs/sha256"},
        "writer_code_identity_sha256": {"$ref": "#/$defs/sha256"},
        "coordinate_model_contract_file_sha256": {"$ref": "#/$defs/sha256"},
        "coordinate_model_contract_sha256": {"$ref": "#/$defs/sha256"},
        "video_profile_contract_file_sha256": {"$ref": "#/$defs/sha256"},
        "video_profile_contract_sha256": {"$ref": "#/$defs/sha256"},
        "quality_harness_implementation_manifest_file_sha256": {"$ref": "#/$defs/sha256"},
        "quality_harness_implementation_manifest_sha256": {"$ref": "#/$defs/sha256"},
        "metric_policy_file_sha256": {"$ref": "#/$defs/sha256"},
        "metric_policy_sha256": {"$ref": "#/$defs/sha256"},
        "metric_implementation_binding_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "executionRootsBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "run_id",
        "output_root_lexical_path",
        "output_parent",
        "work_parent",
        "native_cache_root",
        "writer_root"
      ],
      "properties": {
        "run_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"},
        "output_root_lexical_path": {"$ref": "#/$defs/absolutePath"},
        "output_parent": {"$ref": "#/$defs/directoryIdentity"},
        "work_parent": {"$ref": "#/$defs/directoryIdentity"},
        "native_cache_root": {"$ref": "#/$defs/directoryIdentity"},
        "writer_root": {"$ref": "#/$defs/directoryIdentity"}
      }
    },
    "bindings": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "repository",
        "g04",
        "g05",
        "calibration_plan",
        "failed_run",
        "live_holdout",
        "development_corpus",
        "runtime",
        "execution_roots"
      ],
      "properties": {
        "repository": {"$ref": "#/$defs/repositoryBinding"},
        "g04": {"$ref": "#/$defs/gateBinding"},
        "g05": {"$ref": "#/$defs/gateBinding"},
        "calibration_plan": {"$ref": "#/$defs/calibrationPlanBinding"},
        "failed_run": {"$ref": "#/$defs/failedRunBinding"},
        "live_holdout": {"$ref": "#/$defs/liveHoldoutBinding"},
        "development_corpus": {"$ref": "#/$defs/developmentCorpusBinding"},
        "runtime": {"$ref": "#/$defs/runtimeBinding"},
        "execution_roots": {"$ref": "#/$defs/executionRootsBinding"}
      }
    },
    "candidate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "vector",
        "plan_ordered_vector_sha256",
        "canonical_vector_object_sha256",
        "canonical_vector_file_sha256"
      ],
      "properties": {
        "vector": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": {
            "oneOf": [
              {"type": "integer"},
              {"type": "string", "minLength": 1}
            ]
          }
        },
        "plan_ordered_vector_sha256": {"$ref": "#/$defs/sha256"},
        "canonical_vector_object_sha256": {"$ref": "#/$defs/sha256"},
        "canonical_vector_file_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "dimensionContracts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "coordinate_dimension_sha256",
        "anisotropy_dimension_sha256",
        "coordinate_anisotropy_contract_sha256",
        "risk_state_contract_sha256"
      ],
      "properties": {
        "coordinate_dimension_sha256": {"$ref": "#/$defs/sha256"},
        "anisotropy_dimension_sha256": {"$ref": "#/$defs/sha256"},
        "coordinate_anisotropy_contract_sha256": {"$ref": "#/$defs/sha256"},
        "risk_state_contract_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "incumbentDerivation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "derivation_contract",
        "source_sequence",
        "source_record_sha256",
        "source_previous_record_sha256",
        "source_record_canonical_sha256",
        "source_candidate_vector_sha256",
        "source_evaluation_sha256",
        "source_summary_sha256",
        "source_development_search_rank_sha256",
        "source_coordinate",
        "source_value",
        "carry_forward_sequence",
        "carry_forward_record_sha256",
        "carry_forward_previous_record_sha256",
        "carry_forward_coordinate",
        "carry_forward_value",
        "carry_forward_candidate_vector_sha256",
        "unchanged_coordinate_count",
        "changed_coordinates",
        "derivation_sha256"
      ],
      "properties": {
        "derivation_contract": {"const": "p06-next-coordinate-input-carry-forward-v1"},
        "source_sequence": {"type": "integer", "minimum": 0},
        "source_record_sha256": {"$ref": "#/$defs/sha256"},
        "source_previous_record_sha256": {"$ref": "#/$defs/sha256"},
        "source_record_canonical_sha256": {"$ref": "#/$defs/sha256"},
        "source_candidate_vector_sha256": {"$ref": "#/$defs/sha256"},
        "source_evaluation_sha256": {"$ref": "#/$defs/sha256"},
        "source_summary_sha256": {"$ref": "#/$defs/sha256"},
        "source_development_search_rank_sha256": {"$ref": "#/$defs/sha256"},
        "source_coordinate": {"type": "string", "minLength": 1},
        "source_value": {"oneOf": [{"type": "integer"}, {"type": "string"}]},
        "carry_forward_sequence": {"type": "integer", "minimum": 1},
        "carry_forward_record_sha256": {"$ref": "#/$defs/sha256"},
        "carry_forward_previous_record_sha256": {"$ref": "#/$defs/sha256"},
        "carry_forward_coordinate": {"type": "string", "minLength": 1},
        "carry_forward_value": {"oneOf": [{"type": "integer"}, {"type": "string"}]},
        "carry_forward_candidate_vector_sha256": {"$ref": "#/$defs/sha256"},
        "unchanged_coordinate_count": {"type": "integer", "minimum": 1},
        "changed_coordinates": {
          "type": "array",
          "minItems": 1,
          "maxItems": 1,
          "items": {"type": "string", "minLength": 1}
        },
        "derivation_sha256": {"$ref": "#/$defs/sha256"}
      }
    }
  }
}
