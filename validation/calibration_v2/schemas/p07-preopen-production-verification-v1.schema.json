{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mirmir.local/validation/calibration-v2/p07-preopen-production-verification-v1.schema.json",
  "type": "object",
  "required": [
    "schema_version",
    "artifact_kind",
    "status",
    "configuration_sha256",
    "p06_release_bundle_manifest_sha256",
    "release_native_executable_sha256",
    "release_native_source_manifest_sha256",
    "release_lut_independent_recompile",
    "loader_preopen_verification",
    "p00_continuity_evidence",
    "analytic_fixture_row_count",
    "analytic_fixture_rows_sha256",
    "analytic_runtime_case_count",
    "analytic_runtime_cases_sha256",
    "analytic_p06_comparison",
    "preopen_cache_snapshot",
    "holdout_guard_constructed",
    "holdout_accessed",
    "manifest_sha256"
  ],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "artifact_kind": {"const": "p07_preopen_production_verification"},
    "status": {"const": "pass"},
    "configuration_sha256": {"$ref": "#/$defs/sha256"},
    "p06_release_bundle_manifest_sha256": {"$ref": "#/$defs/sha256"},
    "release_native_executable_sha256": {"$ref": "#/$defs/sha256"},
    "release_native_source_manifest_sha256": {"$ref": "#/$defs/sha256"},
    "release_lut_independent_recompile": {"type": "object", "minProperties": 1},
    "loader_preopen_verification": {"type": "object", "minProperties": 1},
    "p00_continuity_evidence": {"type": "object", "minProperties": 1},
    "analytic_fixture_row_count": {"const": 28},
    "analytic_fixture_rows_sha256": {"$ref": "#/$defs/sha256"},
    "analytic_runtime_case_count": {"const": 14},
    "analytic_runtime_cases_sha256": {"$ref": "#/$defs/sha256"},
    "analytic_p06_comparison": {"type": "object", "minProperties": 1},
    "preopen_cache_snapshot": {"type": "object", "minProperties": 1},
    "holdout_guard_constructed": {"const": false},
    "holdout_accessed": {"const": false},
    "manifest_sha256": {"$ref": "#/$defs/sha256"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^(?!0{64}$)[0-9a-f]{64}$"}
  },
  "additionalProperties": false
}
