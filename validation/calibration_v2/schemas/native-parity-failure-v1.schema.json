{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mirmir.local/validation/calibration-v2/native-parity-failure-v1.schema.json",
  "title": "Preserved failed P06 native LUT parity comparison",
  "type": "object",
  "required": [
    "schema_version",
    "artifact_kind",
    "status",
    "configuration_id",
    "input_hashes",
    "route",
    "production_swift",
    "independent_test_python",
    "first_differing_byte_offset",
    "holdout_accessed",
    "manifest_sha256"
  ],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "artifact_kind": {"const": "p06_native_lut_parity_failure"},
    "status": {"const": "failed_preserved"},
    "configuration_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]{2,127}$"
    },
    "input_hashes": {
      "type": "object",
      "required": [
        "mapping_sha256",
        "operator_bank_sha256",
        "metric_policy_sha256",
        "compiler_inputs_sha256",
        "calibration_plan_sha256",
        "corpus_lock_bundle_sha256"
      ],
      "properties": {
        "mapping_sha256": {"$ref": "#/$defs/sha256"},
        "operator_bank_sha256": {"$ref": "#/$defs/sha256"},
        "metric_policy_sha256": {"$ref": "#/$defs/sha256"},
        "compiler_inputs_sha256": {"$ref": "#/$defs/sha256"},
        "calibration_plan_sha256": {"$ref": "#/$defs/sha256"},
        "corpus_lock_bundle_sha256": {"$ref": "#/$defs/sha256"}
      },
      "additionalProperties": false
    },
    "route": {"enum": ["direct_2x", "direct_3_over_2"]},
    "production_swift": {"$ref": "#/$defs/fileBinding"},
    "independent_test_python": {"$ref": "#/$defs/fileBinding"},
    "first_differing_byte_offset": {"type": "integer", "minimum": 0},
    "holdout_accessed": {"const": false},
    "manifest_sha256": {"$ref": "#/$defs/sha256"}
  },
  "additionalProperties": false,
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^(?!0{64}$)[0-9a-f]{64}$"
    },
    "safeRelativePath": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?!.*\\\\)(?!.*//)(?!.*(?:^|/)\\.\\.?(?:/|$))[^\\u0000]+$"
    },
    "fileBinding": {
      "type": "object",
      "required": ["path", "sha256", "size_bytes"],
      "properties": {
        "path": {"$ref": "#/$defs/safeRelativePath"},
        "sha256": {"$ref": "#/$defs/sha256"},
        "size_bytes": {"type": "integer", "minimum": 1}
      },
      "additionalProperties": false
    }
  }
}
