{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mirmir.local/validation/calibration-v2/p07-artifact-manifest-v2.schema.json",
  "type": "object",
  "required": [
    "schema_version", "artifact_kind", "p06_v2_identity", "status",
    "publication_kind", "configuration_id", "configuration_sha256",
    "release_bundle_manifest_sha256", "sampling_plan_manifest_sha256",
    "holdout_accessed", "holdout_access_consumed", "producer", "command",
    "platform", "gate_ids", "artifacts", "exact_file_names",
    "self_reference_boundary", "manifest_sha256"
  ],
  "properties": {
    "schema_version": {"const": "2.0.0"},
    "artifact_kind": {"const": "p07_artifact_manifest_v2"},
    "p06_v2_identity": {"$ref": "#/$defs/p06Identity"},
    "status": {"enum": ["complete", "failed"]},
    "publication_kind": {"enum": ["g07_evidence", "execution_failure"]},
    "configuration_id": {"type": "string", "minLength": 1},
    "configuration_sha256": {"$ref": "#/$defs/sha256"},
    "release_bundle_manifest_sha256": {"$ref": "#/$defs/sha256"},
    "sampling_plan_manifest_sha256": {"$ref": "#/$defs/sha256"},
    "holdout_accessed": {"type": "boolean"},
    "holdout_access_consumed": {"type": ["boolean", "null"]},
    "producer": {"const": "Mirmir P07 locked-holdout harness"},
    "command": {"type": "string", "minLength": 1},
    "platform": {"type": "string", "minLength": 1},
    "gate_ids": {"const": ["P07", "G07"]},
    "artifacts": {"type": "array", "minItems": 1},
    "exact_file_names": {"type": "array", "minItems": 2, "uniqueItems": true},
    "self_reference_boundary": {"type": "string", "minLength": 1},
    "manifest_sha256": {"$ref": "#/$defs/sha256"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^(?!0{64}$)[0-9a-f]{64}$"},
    "p06Identity": {
      "type": "object", "minProperties": 8, "maxProperties": 8,
      "required": [
        "calibration_plan_v2_file_sha256", "candidate_vector_sha256",
        "shared_bank_configuration_sha256", "input_bundle_sha256",
        "p06_release_bundle_artifact_sha256", "selected_evaluation_file_sha256",
        "selected_evaluation_artifact_sha256", "selected_evaluation_semantic_sha256"
      ],
      "properties": {
        "calibration_plan_v2_file_sha256": {"$ref": "#/$defs/sha256"},
        "candidate_vector_sha256": {"$ref": "#/$defs/sha256"},
        "shared_bank_configuration_sha256": {"$ref": "#/$defs/sha256"},
        "input_bundle_sha256": {"$ref": "#/$defs/sha256"},
        "p06_release_bundle_artifact_sha256": {"$ref": "#/$defs/sha256"},
        "selected_evaluation_file_sha256": {"$ref": "#/$defs/sha256"},
        "selected_evaluation_artifact_sha256": {"$ref": "#/$defs/sha256"},
        "selected_evaluation_semantic_sha256": {"$ref": "#/$defs/sha256"}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
