{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mirmir.local/validation/calibration-v2/dispatch-measurement-v1.schema.json",
  "title": "P06 validation-derived native dispatch-overhead evidence",
  "type": "object",
  "required": [
    "schema_version",
    "artifact_kind",
    "status",
    "run_id",
    "split",
    "measurement_domain",
    "production_metal_constraint_satisfied",
    "method",
    "environment",
    "input_bindings",
    "samples",
    "aggregate",
    "holdout_accessed",
    "manifest_sha256"
  ],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "artifact_kind": {"const": "p06_dispatch_overhead_measurement"},
    "status": {"const": "pass"},
    "run_id": {"type": "string", "minLength": 1},
    "split": {"const": "validation"},
    "measurement_domain": {"const": "native_cpu_reference_projection_not_metal"},
    "production_metal_constraint_satisfied": {"const": false},
    "method": {
      "const": {
        "control": "reconstruct identical output from the full run's precomputed immutable dispatch grid",
        "full": "form immutable LUT dispatch grid then reconstruct",
        "overhead_percent": "100 * (full_dispatch_milliseconds / control_reconstruction_milliseconds)",
        "ordering": "alternate full_then_control and control_then_full by repetition index",
        "percentile": "ascending values with linear interpolation at (n-1)*0.95",
        "repetitions_per_sample": 10,
        "warmup_repetitions_per_sample": 3
      }
    },
    "environment": {
      "type": "object",
      "required": [
        "hardware_model",
        "chip",
        "logical_cpu_count",
        "physical_memory_bytes",
        "os_version",
        "os_build",
        "swift_version",
        "xcode_version",
        "executable_sha256",
        "source_manifest_sha256"
      ],
      "properties": {
        "hardware_model": {"type": "string", "minLength": 1},
        "chip": {"type": "string", "minLength": 1},
        "logical_cpu_count": {"type": "integer", "minimum": 1},
        "physical_memory_bytes": {"type": "integer", "minimum": 1},
        "os_version": {"type": "string", "minLength": 1},
        "os_build": {"type": "string", "minLength": 1},
        "swift_version": {"type": "string", "minLength": 1},
        "xcode_version": {"type": "string", "minLength": 1},
        "executable_sha256": {"$ref": "#/$defs/sha256"},
        "source_manifest_sha256": {"$ref": "#/$defs/sha256"}
      },
      "additionalProperties": false
    },
    "input_bindings": {
      "type": "object",
      "required": [
        "configuration_id",
        "candidate_vector_sha256",
        "shared_bank_configuration_sha256",
        "mapping_sha256",
        "operator_bank_sha256",
        "metric_policy_sha256",
        "compiler_inputs_sha256",
        "calibration_plan_sha256",
        "corpus_lock_bundle_sha256",
        "validation_sample_lock_sha256",
        "degradation_policy_sha256",
        "validation_sample_profile_matrix_sha256",
        "raw_output_contract_sha256",
        "full_control_configuration_sha256"
      ],
      "properties": {
        "configuration_id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9._-]{2,127}$"
        },
        "candidate_vector_sha256": {"$ref": "#/$defs/sha256"},
        "shared_bank_configuration_sha256": {"$ref": "#/$defs/sha256"},
        "mapping_sha256": {"$ref": "#/$defs/sha256"},
        "operator_bank_sha256": {"$ref": "#/$defs/sha256"},
        "metric_policy_sha256": {"$ref": "#/$defs/sha256"},
        "compiler_inputs_sha256": {"$ref": "#/$defs/sha256"},
        "calibration_plan_sha256": {"$ref": "#/$defs/sha256"},
        "corpus_lock_bundle_sha256": {"$ref": "#/$defs/sha256"},
        "validation_sample_lock_sha256": {"$ref": "#/$defs/sha256"},
        "degradation_policy_sha256": {"$ref": "#/$defs/sha256"},
        "validation_sample_profile_matrix_sha256": {"$ref": "#/$defs/sha256"},
        "raw_output_contract_sha256": {"$ref": "#/$defs/sha256"},
        "full_control_configuration_sha256": {"$ref": "#/$defs/sha256"}
      },
      "additionalProperties": false
    },
    "samples": {
      "type": "array",
      "minItems": 9,
      "maxItems": 9,
      "items": {"$ref": "#/$defs/sample"}
    },
    "aggregate": {
      "type": "object",
      "required": [
        "sample_count",
        "repetition_count",
        "ordered_overhead_percent_values",
        "measured_validation_p95_percent",
        "maximum_admissible_p95_percent",
        "derivation_sha256"
      ],
      "properties": {
        "sample_count": {"const": 9},
        "repetition_count": {"const": 90},
        "ordered_overhead_percent_values": {
          "type": "array",
          "minItems": 90,
          "maxItems": 90,
          "items": {"type": "number", "minimum": 0}
        },
        "measured_validation_p95_percent": {
          "type": "number",
          "minimum": 0,
          "maximum": 20
        },
        "maximum_admissible_p95_percent": {"const": 20.0},
        "derivation_sha256": {"$ref": "#/$defs/sha256"}
      },
      "additionalProperties": false
    },
    "holdout_accessed": {"const": false},
    "manifest_sha256": {"$ref": "#/$defs/sha256"}
  },
  "additionalProperties": false,
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^(?!0{64}$)[0-9a-f]{64}$"
    },
    "route": {"enum": ["direct-2x", "direct-3over2"]},
    "repetition": {
      "type": "object",
      "required": [
        "index",
        "order",
        "full_analysis_milliseconds",
        "full_dispatch_milliseconds",
        "full_reconstruction_milliseconds",
        "control_reconstruction_milliseconds",
        "overhead_percent"
      ],
      "properties": {
        "index": {"type": "integer", "minimum": 0, "maximum": 9},
        "order": {"enum": ["full_then_control", "control_then_full"]},
        "full_analysis_milliseconds": {"type": "number", "minimum": 0},
        "full_dispatch_milliseconds": {"type": "number", "minimum": 0},
        "full_reconstruction_milliseconds": {"type": "number", "exclusiveMinimum": 0},
        "control_reconstruction_milliseconds": {"type": "number", "exclusiveMinimum": 0},
        "overhead_percent": {"type": "number", "minimum": 0}
      },
      "additionalProperties": false
    },
    "sample": {
      "type": "object",
      "required": [
        "source_asset_id",
        "degradation_profile_id",
        "degradation_profile_sha256",
        "target_route",
        "input_frame_sha256",
        "full_output_sha256",
        "control_output_sha256",
        "lut_whole_file_sha256",
        "repetitions",
        "ordered_overhead_percent_values",
        "p95_overhead_percent"
      ],
      "properties": {
        "source_asset_id": {"type": "string", "minLength": 1},
        "degradation_profile_id": {"type": "string", "minLength": 1},
        "degradation_profile_sha256": {
          "allOf": [{"$ref": "#/$defs/sha256"}],
          "description": "SHA-256 of canonical sorted-key compact UTF-8 JSON for the exact locked degradation profile object"
        },
        "target_route": {"$ref": "#/$defs/route"},
        "input_frame_sha256": {"$ref": "#/$defs/sha256"},
        "full_output_sha256": {"$ref": "#/$defs/sha256"},
        "control_output_sha256": {"$ref": "#/$defs/sha256"},
        "lut_whole_file_sha256": {"$ref": "#/$defs/sha256"},
        "repetitions": {
          "type": "array",
          "minItems": 10,
          "maxItems": 10,
          "items": {"$ref": "#/$defs/repetition"}
        },
        "ordered_overhead_percent_values": {
          "type": "array",
          "minItems": 10,
          "maxItems": 10,
          "items": {"type": "number", "minimum": 0}
        },
        "p95_overhead_percent": {"type": "number", "minimum": 0}
      },
      "additionalProperties": false
    }
  }
}
