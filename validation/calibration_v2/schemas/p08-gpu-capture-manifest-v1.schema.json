{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mirmir.local/validation/calibration-v2/p08-gpu-capture-manifest-v1.schema.json",
  "type": "object",
  "required": [
    "schema_version", "artifact_kind", "evidence_identity",
    "capture_tool", "captures", "hash_scope", "artifact_sha256"
  ],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "artifact_kind": {"const": "p08_gpu_capture_manifest"},
    "evidence_identity": {
      "$ref": "https://mirmir.local/validation/calibration-v2/p08-common-v1.schema.json#/$defs/identity"
    },
    "capture_tool": {
      "type": "object",
      "required": ["name", "version"],
      "properties": {
        "name": {"const": "MTLCaptureManager"},
        "version": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    },
    "captures": {
      "type": "array", "minItems": 2, "maxItems": 2,
      "items": {"$ref": "#/$defs/capture"}
    },
    "hash_scope": {
      "const": "canonical sorted-key compact UTF-8 JSON excluding /artifact_sha256"
    },
    "artifact_sha256": {
      "$ref": "https://mirmir.local/validation/calibration-v2/p08-common-v1.schema.json#/$defs/sha256"
    }
  },
  "additionalProperties": false,
  "$defs": {
    "planeCoverage": {
      "type": "object",
      "required": ["plane", "phase_ordinals", "descriptor_ids"],
      "properties": {
        "plane": {"enum": ["y", "cbcr"]},
        "phase_ordinals": {
          "type": "array", "minItems": 4, "maxItems": 9,
          "uniqueItems": true,
          "items": {"type": "integer", "minimum": 0, "maximum": 8}
        },
        "descriptor_ids": {
          "type": "array", "minItems": 16, "maxItems": 16,
          "uniqueItems": true,
          "items": {"type": "integer", "minimum": 0, "maximum": 15}
        }
      },
      "additionalProperties": false
    },
    "capture": {
      "type": "object",
      "required": [
        "route", "archive", "capture_scope", "capture_succeeded",
        "command_buffer_count",
        "command_buffer_status", "command_buffer_error",
        "compute_encoder_count", "kernel_names", "plane_coverage"
      ],
      "properties": {
        "route": {"enum": ["direct_2x", "direct_3_over_2"]},
        "capture_scope": {
          "const": "exhaustive synthetic route-plane-phase-descriptor parity fixtures; not a natural-frame coverage claim"
        },
        "archive": {
          "$ref": "https://mirmir.local/validation/calibration-v2/p08-common-v1.schema.json#/$defs/treeBinding"
        },
        "capture_succeeded": {"type": "boolean"},
        "command_buffer_count": {"type": "integer", "minimum": 0},
        "command_buffer_status": {"type": "string", "minLength": 1},
        "command_buffer_error": {
          "oneOf": [
            {"type": "null"},
            {
              "type": "object",
              "required": ["domain", "code", "message"],
              "properties": {
                "domain": {"type": "string", "minLength": 1},
                "code": {"type": "integer"},
                "message": {"type": "string", "minLength": 1}
              },
              "additionalProperties": false
            }
          ]
        },
        "compute_encoder_count": {"type": "integer", "minimum": 0},
        "kernel_names": {
          "type": "array", "minItems": 1, "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "plane_coverage": {
          "type": "array", "minItems": 2, "maxItems": 2,
          "items": {"$ref": "#/$defs/planeCoverage"}
        }
      },
      "additionalProperties": false
    }
  }
}
