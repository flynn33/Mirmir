    "claims": {
      "type": "object",
      "required": [
        "route_and_plane_coordinate_policy_effect_evidenced",
        "fixed_anisotropy_strength_q12_3072_authorized",
        "formal_gate_result_established",
        "winner_selected",
        "current_source_equivalence_established",
        "required_next_evidence"
      ],
      "properties": {
        "route_and_plane_coordinate_policy_effect_evidenced": {"const": true},
        "fixed_anisotropy_strength_q12_3072_authorized": {"const": false},
        "formal_gate_result_established": {"const": false},
        "winner_selected": {"const": false},
        "current_source_equivalence_established": {"const": false},
        "required_next_evidence": {
          "const": "fresh_current_source_formal_gate_evaluation"
        }
      },
      "additionalProperties": false
    },
    "hash_scope": {
      "const": "canonical sorted-key compact UTF-8 JSON excluding /receipt_sha256"
    },
    "receipt_sha256": {"$ref": "#/$defs/sha256"}
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^(?!0{64}$)[0-9a-f]{64}$"
    },
    "relativePath": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._/-]*$"
    },
    "artifactBinding": {
      "type": "object",
      "required": [
        "role",
        "path",
        "self_hash_field",
        "self_sha256",
        "file_sha256",
        "size_bytes"
      ],
      "properties": {
        "role": {
          "enum": [
            "coordinate_anisotropy_diagnostic",
            "risk_state_diagnostic",
            "corrective_diagnostic_envelope"
          ]
        },
        "path": {"$ref": "#/$defs/relativePath"},
        "self_hash_field": {"enum": ["artifact_sha256", "envelope_sha256"]},
        "self_sha256": {"$ref": "#/$defs/sha256"},
        "file_sha256": {"$ref": "#/$defs/sha256"},
        "size_bytes": {"type": "integer", "minimum": 1}
      },
      "additionalProperties": false
    },
    "blockReference": {
      "type": "object",
      "required": ["block_id", "json_pointer"],
      "properties": {
        "block_id": {
          "type": "string",
          "pattern": "^direct_(2x|3_over_2)-(HH|HS|SH|SS)-(00|03|30|33)$"
        },
        "json_pointer": {
          "type": "string",
          "pattern": "^/route_cell_blocks/(0|[1-9][0-9]*)$"
        }
      },
      "additionalProperties": false
    },
    "routeBlockReference": {
      "type": "object",
      "required": ["route", "block_id", "json_pointer"],
      "properties": {
        "route": {"enum": ["direct_2x", "direct_3_over_2"]},
        "block_id": {"type": "string", "minLength": 1},
        "json_pointer": {
          "type": "string",
          "pattern": "^/route_cell_blocks/(0|[1-9][0-9]*)$"
        }
      },
      "additionalProperties": false
    },
    "metricMap": {
      "type": "object",
      "minProperties": 3,
      "maxProperties": 9,
      "propertyNames": {
        "enum": [
          "y_psnr_db",
          "y_ssim",
          "y_ms_ssim",
          "cb_psnr_db",
          "cb_ssim",
          "cb_ms_ssim",
          "cr_psnr_db",
          "cr_ssim",
          "cr_ms_ssim"
        ]
      },
      "additionalProperties": {"type": "number"}
    },
    "improvedCountMap": {
      "type": "object",
      "minProperties": 3,
      "maxProperties": 9,
      "propertyNames": {
        "enum": [
          "y_psnr_db",
          "y_ssim",
          "y_ms_ssim",
          "cb_psnr_db",
          "cb_ssim",
          "cb_ms_ssim",
          "cr_psnr_db",
          "cr_ssim",
          "cr_ms_ssim"
        ]
      },
      "additionalProperties": {"type": "integer", "minimum": 0, "maximum": 12}
    },
    "comparison": {
      "type": "object",
      "required": ["left_block", "right_block", "observation_count", "metrics"],
      "properties": {
        "left_block": {"$ref": "#/$defs/blockReference"},
        "right_block": {"$ref": "#/$defs/blockReference"},
        "observation_count": {"enum": [6, 12]},
        "metrics": {"$ref": "#/$defs/metricMap"},
        "improved_observation_count_by_metric": {
          "$ref": "#/$defs/improvedCountMap"
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
