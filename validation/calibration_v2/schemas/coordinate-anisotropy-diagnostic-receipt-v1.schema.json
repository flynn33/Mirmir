          ],
          "properties": {
            "path": {
              "const": "Artifacts/ASH/20260713-p06-corrective-5c6ace2c-6501-40e4-b393-0db03f200c47/native-cache/executables/8d42b85ee4d9a13adf929f3e1376ad04f8b5d870a6c4fe90dbc49633bb0de04b/source-manifest.json"
            },
            "file_sha256": {
              "const": "8d42b85ee4d9a13adf929f3e1376ad04f8b5d870a6c4fe90dbc49633bb0de04b"
            },
            "source_file_count": {"const": 39},
            "matching_current_source_file_count": {"const": 23},
            "mismatching_current_source_file_count": {"const": 16},
            "source_commit_binding_present": {"const": false}
          },
          "additionalProperties": false
        },
        "current_source_equivalence_established": {"const": false}
      },
      "additionalProperties": false
