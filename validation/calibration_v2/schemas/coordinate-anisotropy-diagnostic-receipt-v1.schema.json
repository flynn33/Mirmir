      "properties": {
        "production_v2_exact_output_matches": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "prefixItems": [
            {
              "allOf": [
                {"$ref": "#/$defs/routeBlockReference"},
                {
                  "properties": {
                    "route": {"const": "direct_2x"},
                    "block_id": {"const": "direct_2x-HH-00"},
                    "json_pointer": {"const": "/route_cell_blocks/0"}
                  }
                }
              ]
            },
            {
              "allOf": [
                {"$ref": "#/$defs/routeBlockReference"},
                {
                  "properties": {
                    "route": {"const": "direct_3_over_2"},
                    "block_id": {"const": "direct_3_over_2-SS-00"},
                    "json_pointer": {"const": "/route_cell_blocks/28"}
                  }
                }
              ]
            }
          ],
          "items": false
        },
        "comparison_baseline": {
          "type": "object",
          "required": [
            "composition_id",
            "json_pointer",
            "direct_2x_block_id",
            "direct_3_over_2_block_id",
            "selected_winner"
          ],
          "properties": {
            "composition_id": {"const": "baseline"},
            "json_pointer": {"const": "/full_corpus_compositions/0"},
            "direct_2x_block_id": {"const": "direct_2x-SS-33"},
            "direct_3_over_2_block_id": {"const": "direct_3_over_2-SS-33"},
            "selected_winner": {"const": false}
