{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mirmir.local/validation/calibration-v2/p07-g07-publication-v1.schema.json",
  "type": "object",
  "required": [
    "schema_version",
    "artifact_kind",
    "status",
    "gate_pass",
    "artifact_file_sha256",
    "holdout_accessed",
    "configuration_files_modified_after_holdout",
    "manifest_sha256"
  ],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "artifact_kind": {"const": "p07_g07_publication"},
    "status": {"enum": ["pass", "fail"]},
    "gate_pass": {"type": "boolean"},
    "artifact_file_sha256": {
      "type": "object",
      "minProperties": 4,
      "maxProperties": 5,
      "propertyNames": {
        "enum": [
          "spatial-holdout-results.json",
          "paired-bootstrap-results.json",
          "ablation-results.json",
          "g07-decision.json",
          "failed-version-archive.json"
        ]
      },
      "additionalProperties": {"$ref": "#/$defs/sha256"}
    },
    "holdout_accessed": {"const": true},
    "configuration_files_modified_after_holdout": {"const": false},
    "manifest_sha256": {"$ref": "#/$defs/sha256"}
  },
  "allOf": [
    {
      "if": {"properties": {"gate_pass": {"const": true}}},
      "then": {
        "properties": {
          "status": {"const": "pass"},
          "artifact_file_sha256": {"minProperties": 4, "maxProperties": 4}
        }
      }
    },
    {
      "if": {"properties": {"gate_pass": {"const": false}}},
      "then": {
        "properties": {
          "status": {"const": "fail"},
          "artifact_file_sha256": {"minProperties": 5, "maxProperties": 5}
        }
      }
    }
  ],
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^(?!0{64}$)[0-9a-f]{64}$"
    }
  },
  "additionalProperties": false
}
