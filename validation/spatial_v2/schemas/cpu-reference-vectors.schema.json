{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mirmir.local/schemas/cpu-reference-vectors.schema.json",
  "allOf": [
    {"$ref": "p05-common.schema.json#/$defs/artifact"},
    {
      "properties": {
        "artifact_type": {"const": "cpu-reference-vectors"},
        "data": {
          "required": ["vector_count", "vectors", "vector_signature_sha256", "source_aligned_vectors"],
          "properties": {
            "vector_count": {"const": 192},
            "vectors": {"type": "array", "minItems": 192, "maxItems": 192},
            "vector_signature_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
            "source_aligned_vectors": {"type": "array", "minItems": 32, "maxItems": 32}
          }
        }
      }
    }
  ]
}

