{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mirmir.local/schemas/p05-common.schema.json",
  "$defs": {
    "digest": {
      "type": "object",
      "required": ["path", "sha256", "byte_count"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "byte_count": {"type": "integer", "minimum": 1}
      },
      "additionalProperties": false
    },
    "provenance": {
      "type": "object",
      "required": [
        "production_source_manifest_sha256",
        "configuration_manifest_sha256",
        "harness_manifest_sha256",
        "production_sources",
        "configuration_files",
        "harness_files",
        "reproduction_command"
      ],
      "properties": {
        "production_source_manifest_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "configuration_manifest_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "harness_manifest_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "production_sources": {"type": "array", "minItems": 11, "maxItems": 11, "items": {"$ref": "#/$defs/digest"}},
        "configuration_files": {"type": "array", "minItems": 2, "maxItems": 2, "items": {"$ref": "#/$defs/digest"}},
        "harness_files": {"type": "array", "minItems": 11, "maxItems": 11, "items": {"$ref": "#/$defs/digest"}},
        "reproduction_command": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    },
    "criterion": {
      "type": "object",
      "required": ["id", "status", "evidence"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "status": {"const": "pass"},
        "evidence": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    },
    "artifact": {
      "type": "object",
      "required": [
        "schema_version",
        "artifact_type",
        "phase",
        "gate",
        "status",
        "parameter_status",
        "input_scope",
        "holdout_accessed",
        "provenance",
        "criteria",
        "data"
      ],
      "properties": {
        "schema_version": {"const": "1.0.0"},
        "artifact_type": {"type": "string", "minLength": 1},
        "phase": {"const": "P05"},
        "gate": {"const": "G05"},
        "status": {"const": "pass"},
        "parameter_status": {"const": "development_only_not_release_locked"},
        "input_scope": {"const": "synthetic_only"},
        "holdout_accessed": {"const": false},
        "provenance": {"$ref": "#/$defs/provenance"},
        "criteria": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/criterion"}},
        "data": {"type": "object"}
      },
      "additionalProperties": false
    }
  }
}
