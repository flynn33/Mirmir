{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mirmir.local/schemas/cpu-reference-results.schema.json",
  "allOf": [
    {"$ref": "p05-common.schema.json#/$defs/artifact"},
    {
      "properties": {
        "artifact_type": {"const": "cpu-reference-results"},
        "data": {
          "required": ["route_count", "coordinate_policy_count", "descriptor_count", "channel_count", "vector_count", "source_aligned_preservation_count", "nearest_expansion_used", "maximum_operator_evaluations", "tests"],
          "properties": {
            "route_count": {"const": 2},
            "coordinate_policy_count": {"const": 2},
            "descriptor_count": {"const": 16},
            "channel_count": {"const": 3},
            "vector_count": {"const": 192},
            "source_aligned_preservation_count": {"const": 32},
            "nearest_expansion_used": {"const": false},
            "maximum_operator_evaluations": {"type": "integer", "minimum": 1, "maximum": 2},
            "tests": {"type": "array", "minItems": 8}
          }
        }
      }
    }
  ]
}

