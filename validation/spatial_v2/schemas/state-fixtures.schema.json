{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mirmir.local/schemas/state-fixtures.schema.json",
  "allOf": [
    {"$ref": "p05-common.schema.json#/$defs/artifact"},
    {
      "properties": {
        "artifact_type": {"const": "state-fixtures"},
        "data": {
          "required": ["controlled_state_bit_count", "controlled_fixtures", "orientation_fixture_count", "orientation_fixtures"],
          "properties": {
            "controlled_state_bit_count": {"const": 9},
            "controlled_fixtures": {"type": "array", "minItems": 9, "maxItems": 9},
            "orientation_fixture_count": {"const": 4},
            "orientation_fixtures": {"type": "array", "minItems": 4, "maxItems": 4}
          }
        }
      }
    }
  ]
}

